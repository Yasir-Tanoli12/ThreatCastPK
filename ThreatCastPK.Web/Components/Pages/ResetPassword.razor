@page "/reset-password"
@rendermode InteractiveServer
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Reset Password — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="rp-root">
    <div class="bg-grid"></div>
    <div class="scan-line"></div>
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>

    <div class="rp-center">
        <div class="form-card @(_shake ? "shake" : "")">

            <div class="form-header">
                <a href="/login" class="back-link">← back to login</a>
                <div class="form-title-row">
                    <span class="form-prompt">$</span>
                    <h2 class="form-title">auth.new-password</h2>
                    <span class="form-cursor">_</span>
                </div>
                <p class="form-subtitle">Enter your new password</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="error-banner">
                    <span>⚠</span>
                    <span>@_errorMessage</span>
                </div>
            }

            @if (_invalidLink)
            {
                <div class="form-body">
                    <div class="invalid-state">
                        <div class="inv-icon">🔗</div>
                        <p class="inv-text">This reset link is invalid or has expired.</p>
                        <a href="/forgot-password" class="req-btn">Request a new link →</a>
                    </div>
                </div>
            }
            else if (_done)
            {
                <div class="form-body">
                    <div class="done-state">
                        <div class="done-icon">✅</div>
                        <p class="done-text">Password reset successfully!</p>
                        <a href="/login" class="login-btn">Sign in now →</a>
                    </div>
                </div>
            }
            else
            {
                <div class="form-body">

                    <div class="field-group">
                        <label class="field-label">
                            <span class="label-index">01</span>
                            NEW_PASSWORD
                        </label>
                        <div class="input-wrapper @(_passFocused ? "focused" : "")">
                            <span class="input-prefix">🔒</span>
                            <input type="@(_showPassword ? "text" : "password")"
                                   class="field-input"
                                   placeholder="min. 8 characters"
                                   @bind="_password"
                                   @bind:event="oninput"
                                   @onfocus="() => _passFocused = true"
                                   @onblur="() => _passFocused = false"
                                   disabled="@_loading" />
                            <button type="button" class="toggle-pass"
                                    @onclick="() => _showPassword = !_showPassword">
                                @(_showPassword ? "HIDE" : "SHOW")
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(_password))
                        {
                            var s = GetStrength();
                            <div class="strength-bar">
                                <div class="strength-track">
                                    <div class="strength-fill s-@s.Level" style="width: @(s.Percent)%"></div>
                                </div>
                                <span class="strength-label s-text-@s.Level">@s.Label</span>
                            </div>
                        }
                    </div>

                    <div class="field-group">
                        <label class="field-label">
                            <span class="label-index">02</span>
                            CONFIRM_PASSWORD
                        </label>
                        <div class="input-wrapper @(_confirmFocused ? "focused" : "") @(GetConfirmState())">
                            <span class="input-prefix">🔑</span>
                            <input type="@(_showConfirm ? "text" : "password")"
                                   class="field-input"
                                   placeholder="re-enter password"
                                   @bind="_confirmPassword"
                                   @bind:event="oninput"
                                   @onfocus="() => _confirmFocused = true"
                                   @onblur="() => _confirmFocused = false"
                                   disabled="@_loading" />
                            <button type="button" class="toggle-pass"
                                    @onclick="() => _showConfirm = !_showConfirm">
                                @(_showConfirm ? "HIDE" : "SHOW")
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(_confirmPassword) && _password != _confirmPassword)
                        {
                            <span class="field-error">Passwords do not match</span>
                        }
                    </div>

                    <button class="submit-btn @(_loading ? "loading" : "")"
                            @onclick="HandleReset"
                            disabled="@(!CanSubmit() || _loading)">
                        @if (_loading)
                        {
                            <span class="btn-spinner"></span>
                            <span>RESETTING...</span>
                        }
                        else
                        {
                            <span>SET NEW PASSWORD</span>
                            <span class="btn-arrow">→</span>
                        }
                    </button>

                </div>
            }
        </div>
    </div>
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .rp-root {
        min-height: 100vh; display: flex;
        align-items: center; justify-content: center;
        background: #0d1117; position: relative;
        overflow: hidden; font-family: 'Inter', sans-serif;
    }

    .bg-grid {
        position: fixed; inset: 0;
        background-image:
            linear-gradient(rgba(159,239,0,0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(159,239,0,0.03) 1px, transparent 1px);
        background-size: 40px 40px; pointer-events: none; z-index: 0;
    }

    .scan-line {
        position: fixed; top: -2px; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, #9fef00, transparent);
        animation: scan 6s linear infinite; opacity: 0.4; z-index: 1; pointer-events: none;
    }

    @@keyframes scan { 0% { top: -2px; } 100% { top: 100vh; } }

    .corner { position: fixed; width: 20px; height: 20px; z-index: 2; pointer-events: none; }
    .corner-tl { top: 16px; left: 16px; border-top: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-tr { top: 16px; right: 16px; border-top: 2px solid #9fef00; border-right: 2px solid #9fef00; }
    .corner-bl { bottom: 16px; left: 16px; border-bottom: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-br { bottom: 16px; right: 16px; border-bottom: 2px solid #9fef00; border-right: 2px solid #9fef00; }

    .rp-center { width: 440px; position: relative; z-index: 3; animation: fadeInUp 0.6s ease both; }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .form-card { background: #161b22; border: 1px solid #21262d; border-radius: 8px; overflow: hidden; }
    .shake { animation: shake 0.4s ease !important; }

    @@keyframes shake {
        0%,100% { transform: translateX(0); }
        20% { transform: translateX(-8px); }
        40% { transform: translateX(8px); }
        60% { transform: translateX(-5px); }
        80% { transform: translateX(5px); }
    }

    .form-header { padding: 20px 28px 18px; border-bottom: 1px solid #21262d; background: #0d1117; }

    .back-link {
        display: inline-block; font-family: 'IBM Plex Mono', monospace;
        font-size: 10px; color: #4a5160; text-decoration: none;
        letter-spacing: 1px; margin-bottom: 12px; transition: color 0.15s;
    }
    .back-link:hover { color: #9fef00; }

    .form-title-row { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
    .form-prompt { font-family: 'IBM Plex Mono', monospace; font-size: 17px; color: #9fef00; font-weight: 600; }
    .form-title  { font-family: 'IBM Plex Mono', monospace; font-size: 17px; font-weight: 600; color: #c9d1d9; }
    .form-cursor { font-family: 'IBM Plex Mono', monospace; font-size: 17px; color: #9fef00; animation: blink 1s step-end infinite; }

    @@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }

    .form-subtitle { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #6e7681; }

    .error-banner {
        display: flex; align-items: center; gap: 10px; padding: 12px 28px;
        background: rgba(255,62,62,0.08); border-bottom: 1px solid rgba(255,62,62,0.2);
        font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #ff3e3e;
    }

    .form-body { padding: 24px 28px; display: flex; flex-direction: column; gap: 18px; }

    .field-group { display: flex; flex-direction: column; gap: 7px; }

    .field-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #6e7681; letter-spacing: 2px; display: flex; align-items: center; gap: 8px;
    }

    .label-index { color: #9fef00; opacity: 0.6; }

    .input-wrapper {
        display: flex; align-items: center; background: #0d1117;
        border: 1px solid #21262d; border-radius: 4px;
        transition: border-color 0.15s, box-shadow 0.15s; overflow: hidden;
    }

    .input-wrapper.focused { border-color: #9fef00; box-shadow: 0 0 0 3px rgba(159,239,0,0.08); }
    .input-wrapper.valid-state   { border-color: rgba(159,239,0,0.4); }
    .input-wrapper.invalid-state { border-color: rgba(255,62,62,0.4); }

    .input-prefix {
        padding: 0 12px; font-size: 13px; color: #4a5160;
        border-right: 1px solid #21262d; flex-shrink: 0; user-select: none; line-height: 44px;
    }

    .field-input {
        flex: 1; background: transparent; border: none; outline: none;
        padding: 11px 14px; font-family: 'IBM Plex Mono', monospace;
        font-size: 13px; color: #c9d1d9; caret-color: #9fef00;
    }

    .field-input::placeholder { color: #4a5160; }
    .field-input:disabled { opacity: 0.5; cursor: not-allowed; }

    .toggle-pass {
        background: none; border: none; border-left: 1px solid #21262d;
        padding: 0 12px; font-family: 'IBM Plex Mono', monospace;
        font-size: 9px; color: #4a5160; cursor: pointer;
        letter-spacing: 1px; height: 100%; transition: color 0.15s;
    }
    .toggle-pass:hover { color: #9fef00; }

    .field-error { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #ff3e3e; }

    .strength-bar { display: flex; align-items: center; gap: 10px; margin-top: 2px; }
    .strength-track { flex: 1; height: 3px; background: #21262d; border-radius: 2px; overflow: hidden; }
    .strength-fill { height: 100%; border-radius: 2px; transition: width 0.3s ease; }
    .strength-fill.s-weak   { background: #ff3e3e; }
    .strength-fill.s-medium { background: #ffa500; }
    .strength-fill.s-strong { background: #9fef00; }
    .strength-label { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 1px; flex-shrink: 0; }
    .s-text-weak   { color: #ff3e3e; }
    .s-text-medium { color: #ffa500; }
    .s-text-strong { color: #9fef00; }

    .submit-btn {
        width: 100%; padding: 13px 20px; background: #9fef00; border: none; border-radius: 4px;
        font-family: 'IBM Plex Mono', monospace; font-size: 12px; font-weight: 600;
        color: #0d1117; letter-spacing: 2px; cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: 10px;
        transition: opacity 0.15s, transform 0.1s, box-shadow 0.15s;
    }

    .submit-btn:hover:not(:disabled) {
        opacity: 0.92; transform: translateY(-1px);
        box-shadow: 0 4px 20px rgba(159,239,0,0.3);
    }

    .submit-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .submit-btn.loading { background: #21262d; color: #6e7681; }
    .btn-arrow { font-size: 14px; }

    .btn-spinner {
        width: 13px; height: 13px;
        border: 2px solid #4a5160; border-top-color: #9fef00;
        border-radius: 50%; animation: spin 0.7s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    .invalid-state, .done-state {
        display: flex; flex-direction: column;
        align-items: center; gap: 12px; padding: 16px 0; text-align: center;
    }

    .inv-icon, .done-icon { font-size: 40px; }

    .inv-text, .done-text { font-size: 14px; color: #c9d1d9; line-height: 1.5; }

    .req-btn, .login-btn {
        padding: 9px 20px; border-radius: 4px;
        font-family: 'IBM Plex Mono', monospace; font-size: 12px;
        font-weight: 600; text-decoration: none; letter-spacing: 1px;
        transition: opacity 0.15s, box-shadow 0.15s;
    }

    .req-btn { background: transparent; border: 1px solid #21262d; color: #c9d1d9; }
    .req-btn:hover { border-color: #6e7681; }

    .login-btn { background: #9fef00; color: #0d1117; }
    .login-btn:hover { opacity: 0.9; box-shadow: 0 3px 12px rgba(159,239,0,0.2); }

    @@media (max-width: 500px) { .rp-center { width: 100%; padding: 0 16px; } }
</style>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _loading = false;
    private bool _shake = false;
    private bool _showPassword = false;
    private bool _showConfirm = false;
    private bool _passFocused = false;
    private bool _confirmFocused = false;
    private bool _invalidLink = false;
    private bool _done = false;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Token) || string.IsNullOrWhiteSpace(Email))
            _invalidLink = true;
    }

    private bool CanSubmit() =>
        _password.Length >= 8 && _password == _confirmPassword;

    private string GetConfirmState()
    {
        if (string.IsNullOrEmpty(_confirmPassword)) return string.Empty;
        return _password == _confirmPassword ? "valid-state" : "invalid-state";
    }

    private record StrengthResult(string Level, int Percent, string Label);

    private StrengthResult GetStrength()
    {
        var p = _password;
        int score = 0;
        if (p.Length >= 8)  score++;
        if (p.Length >= 12) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(p, @"[A-Z]")) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(p, @"[0-9]")) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(p, @"[^a-zA-Z0-9]")) score++;

        return score switch
        {
            <= 2 => new("weak",   33, "WEAK"),
            <= 3 => new("medium", 66, "MEDIUM"),
            _    => new("strong", 100, "STRONG")
        };
    }

    private async Task HandleReset()
    {
        _errorMessage = string.Empty;
        if (!CanSubmit()) return;

        _loading = true;
        StateHasChanged();

        var error = await ApiService.PostAsync("/api/auth/reset-password", new
        {
            email = Email,
            token = Token,
            newPassword = _password
        });

        _loading = false;

        if (error == null)
        {
            _done = true;
        }
        else
        {
            if (error.Contains("Invalid") || error.Contains("expired"))
                _invalidLink = true;
            else
            {
                _errorMessage = error;
                _shake = true;
                StateHasChanged();
                await Task.Delay(450);
                _shake = false;
            }
        }

        StateHasChanged();
    }
}