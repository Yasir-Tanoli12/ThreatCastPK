<style>
/* ══════════════════════════════════════════════
   DESIGN TOKENS
══════════════════════════════════════════════ */
:root {
    --pr-bg:            #0d1117;
    --pr-surface:       #161b22;
    --pr-surface-2:     #1c2230;
    --pr-border:        #21262d;
    --pr-border-hover:  #30363d;

    --pr-text:          #e6edf3;
    --pr-text-2:        #8b949e;
    --pr-text-3:        #4a5160;

    --pr-accent:        #9fef00;
    --pr-accent-dim:    rgba(159,239,0,0.10);
    --pr-accent-dimmer: rgba(159,239,0,0.04);
    --pr-accent-border: rgba(159,239,0,0.22);

    --pr-blue:          #00c8ff;
    --pr-blue-dim:      rgba(0,200,255,0.10);
    --pr-orange:        #ffa500;
    --pr-orange-dim:    rgba(255,165,0,0.08);
    --pr-red:           #ff3e3e;
    --pr-red-dim:       rgba(255,62,62,0.08);

    --pr-radius:        6px;
    --pr-radius-sm:     4px;
    --pr-radius-lg:     8px;

    --pr-font:          'Inter', system-ui, sans-serif;
    --pr-mono:          'IBM Plex Mono', 'Fira Code', monospace;

    --pr-dur:           150ms;
    --pr-ease:          cubic-bezier(0.16, 1, 0.3, 1);
}

/* ══════════════════════════════════════════════
   RESET
══════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
button { font-family: inherit; cursor: pointer; }
a { text-decoration: none; }
ul, ol { list-style: none; }
svg { display: block; flex-shrink: 0; }

/* ══════════════════════════════════════════════
   ROOT
══════════════════════════════════════════════ */
.pr-root {
    min-height: 100vh;
    background: var(--pr-bg);
    font-family: var(--pr-font);
    padding: 84px 32px 56px;
    position: relative;
    overflow-x: hidden;
    color: var(--pr-text);
}

/* ══════════════════════════════════════════════
   AMBIENT DECORATORS
══════════════════════════════════════════════ */
.pr-bg-grid {
    position: fixed; inset: 0;
    background-image:
        linear-gradient(rgba(159,239,0,0.022) 1px, transparent 1px),
        linear-gradient(90deg, rgba(159,239,0,0.022) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none; z-index: 0;
}

.pr-scan-line {
    position: fixed; top: -2px; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--pr-accent), transparent);
    animation: pr-scan 10s linear infinite; opacity: 0.22;
    z-index: 1; pointer-events: none;
}

.pr-corner {
    position: fixed; width: 16px; height: 16px;
    z-index: 2; pointer-events: none;
}
.pr-corner--tl { top: 12px; left: 12px;  border-top: 1.5px solid var(--pr-accent); border-left:  1.5px solid var(--pr-accent); }
.pr-corner--tr { top: 12px; right: 12px; border-top: 1.5px solid var(--pr-accent); border-right: 1.5px solid var(--pr-accent); }
.pr-corner--bl { bottom: 12px; left: 12px;  border-bottom: 1.5px solid var(--pr-accent); border-left:  1.5px solid var(--pr-accent); }
.pr-corner--br { bottom: 12px; right: 12px; border-bottom: 1.5px solid var(--pr-accent); border-right: 1.5px solid var(--pr-accent); }

@@keyframes pr-scan { 0% { top: -2px; } 100% { top: 100vh; } }

@@media (prefers-reduced-motion: reduce) {
    .pr-scan-line { animation: none; display: none; }
    .pr-spinner   { animation: none; }
    .pr-pending-dot { animation: none; }
}

/* ══════════════════════════════════════════════
   LAYOUT
══════════════════════════════════════════════ */
.pr-layout {
    max-width: 1120px; margin: 0 auto;
    display: grid;
    grid-template-columns: 300px 1fr;
    grid-template-areas: "left right";
    gap: 20px;
    position: relative; z-index: 3;
    animation: pr-fade-up 0.4s var(--pr-ease) both;
}

.pr-left  { grid-area: left;  display: flex; flex-direction: column; gap: 16px; }
.pr-right { grid-area: right; display: flex; flex-direction: column; gap: 16px; }

@@keyframes pr-fade-up {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* ══════════════════════════════════════════════
   FULLSCREEN STATES (loading / error)
══════════════════════════════════════════════ */
.pr-fullscreen-center {
    min-height: 80vh;
    display: flex; align-items: center; justify-content: center;
    position: relative; z-index: 3;
}

.pr-error-card {
    background: var(--pr-surface); border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius-lg);
    padding: 48px 56px; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    animation: pr-fade-up 0.4s var(--pr-ease) both;
}
.pr-error-icon { color: var(--pr-red); margin-bottom: 4px; }
.pr-error-title {
    font-family: var(--pr-mono); font-size: 13px; font-weight: 600;
    color: var(--pr-red); letter-spacing: 2px;
}
.pr-error-sub { font-size: 13px; color: var(--pr-text-3); }

/* ══════════════════════════════════════════════
   SPINNER
══════════════════════════════════════════════ */
.pr-spinner {
    width: 34px; height: 34px;
    border: 2.5px solid var(--pr-border);
    border-top-color: var(--pr-accent);
    border-radius: 50%;
    animation: pr-spin 0.8s linear infinite;
    margin-bottom: 14px;
}
.pr-spinner--sm { width: 13px; height: 13px; border-width: 2px; margin: 0; }
.pr-loading-label {
    font-family: var(--pr-mono); font-size: 10px; letter-spacing: 2.5px;
    color: var(--pr-text-3);
}
@@keyframes pr-spin { to { transform: rotate(360deg); } }

/* ══════════════════════════════════════════════
   TOAST
══════════════════════════════════════════════ */
.pr-toast {
    position: fixed; top: 88px; right: 24px; z-index: 100;
    display: flex; align-items: center; gap: 10px;
    padding: 12px 18px;
    border-radius: var(--pr-radius);
    font-family: var(--pr-mono); font-size: 12px;
    border: 1px solid;
    opacity: 0; transform: translateY(-8px);
    transition: opacity 0.3s, transform 0.3s;
    pointer-events: none;
}
.pr-toast.is-visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
.pr-toast--success { background: rgba(159,239,0,0.07); border-color: var(--pr-accent-border); color: var(--pr-accent); }
.pr-toast--error   { background: var(--pr-red-dim);   border-color: rgba(255,62,62,0.22);    color: var(--pr-red); }

/* ══════════════════════════════════════════════
   CARD
══════════════════════════════════════════════ */
.pr-card {
    background: var(--pr-surface);
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius-lg);
    overflow: hidden;
    transition: border-color var(--pr-dur);
}
.pr-card:hover { border-color: var(--pr-border-hover); }
.pr-card--danger { border-color: rgba(255,62,62,0.15); }
.pr-card--danger:hover { border-color: rgba(255,62,62,0.3); }

.pr-card__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--pr-border);
    background: rgba(0,0,0,0.18);
}
.pr-card__eyebrow {
    font-family: var(--pr-mono); font-size: 9.5px;
    color: var(--pr-accent); letter-spacing: 2.5px; opacity: 0.8;
}
.pr-card__eyebrow--danger { color: var(--pr-red); }

.pr-card__body { padding: 20px; }

/* ══════════════════════════════════════════════
   IDENTITY BLOCK
══════════════════════════════════════════════ */
.pr-identity {
    padding: 28px 20px 20px;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    border-bottom: 1px solid var(--pr-border);
}

.pr-avatar {
    width: 80px; height: 80px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 2px solid rgba(159,239,0,0.3);
    margin-bottom: 4px;
}
.pr-avatar__initials {
    font-family: var(--pr-mono); font-size: 26px; font-weight: 600;
    color: #fff;
}

.pr-identity__name {
    font-size: 17px; font-weight: 700;
    color: var(--pr-text); letter-spacing: -0.3px;
}
.pr-identity__email {
    font-family: var(--pr-mono); font-size: 11px; color: var(--pr-text-3);
}

/* ══════════════════════════════════════════════
   ROLE BADGE
══════════════════════════════════════════════ */
.pr-role-badge {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--pr-mono); font-size: 10.5px; font-weight: 600;
    padding: 4px 10px; border-radius: var(--pr-radius-sm); letter-spacing: 1px;
    border: 1px solid;
}
.pr-role-badge--sm { font-size: 9.5px; padding: 3px 8px; }

.pr-role-badge--public     { background: rgba(110,118,129,0.12); color: #8b949e;        border-color: var(--pr-border); }
.pr-role-badge--registered { background: var(--pr-blue-dim);    color: var(--pr-blue);  border-color: rgba(0,200,255,0.22); }
.pr-role-badge--reporter   { background: var(--pr-accent-dim);  color: var(--pr-accent);border-color: var(--pr-accent-border); }
.pr-role-badge--admin      { background: var(--pr-orange-dim);  color: var(--pr-orange);border-color: rgba(255,165,0,0.22); }

/* ══════════════════════════════════════════════
   REPUTATION BAR
══════════════════════════════════════════════ */
.pr-rep {
    padding: 16px 20px;
    border-bottom: 1px solid var(--pr-border);
}
.pr-rep__header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 10px;
}
.pr-rep__value {
    font-family: var(--pr-mono); font-size: 22px; font-weight: 600;
    color: var(--pr-accent);
}
.pr-rep__track {
    position: relative;
    height: 3px; background: var(--pr-border); border-radius: 2px;
    overflow: visible; margin-bottom: 7px;
}
.pr-rep__fill {
    height: 100%; background: var(--pr-accent);
    border-radius: 2px; transition: width 0.8s var(--pr-ease);
}
/* The 75-point threshold marker */
.pr-rep__marker {
    position: absolute; top: -4px; left: 75%;
    width: 1px; height: 11px;
    background: var(--pr-orange); opacity: 0.6;
}
.pr-rep__tiers {
    display: flex; justify-content: space-between;
    font-family: var(--pr-mono); font-size: 9px; color: var(--pr-text-3);
}
.pr-rep__tier-mid { color: var(--pr-orange); }

/* ══════════════════════════════════════════════
   SHARED LABEL
══════════════════════════════════════════════ */
.pr-label {
    font-family: var(--pr-mono); font-size: 9.5px;
    color: var(--pr-text-3); letter-spacing: 1.5px;
}

/* ══════════════════════════════════════════════
   META LIST
══════════════════════════════════════════════ */
.pr-meta { padding: 6px 20px 14px; }
.pr-meta__row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 9px 0; border-bottom: 1px solid rgba(33,38,45,0.7);
    transition: background var(--pr-dur);
}
.pr-meta__row:last-child { border-bottom: none; }
.pr-meta__val {
    font-size: 12px; color: var(--pr-text);
}
.pr-mono { font-family: var(--pr-mono); }
.pr-truncate { max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.pr-tier-badge {
    font-family: var(--pr-mono); font-size: 9px; font-weight: 600;
    padding: 2px 7px; border-radius: 3px; letter-spacing: 1px; border: 1px solid;
}
.pr-tier-badge--trusted { color: var(--pr-accent); background: var(--pr-accent-dim); border-color: var(--pr-accent-border); }
.pr-tier-badge--active  { color: var(--pr-blue);   background: var(--pr-blue-dim);   border-color: rgba(0,200,255,0.22); }
.pr-tier-badge--novice  { color: var(--pr-orange);  background: var(--pr-orange-dim); border-color: rgba(255,165,0,0.22); }
.pr-tier-badge--new     { color: var(--pr-text-3); background: rgba(74,81,96,0.1);   border-color: var(--pr-border); }

.pr-meta__link {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--pr-mono); font-size: 11px; color: var(--pr-accent);
    transition: opacity var(--pr-dur);
}
.pr-meta__link:hover { opacity: 0.7; }
.pr-meta__link:focus-visible { outline: 2px solid var(--pr-accent); outline-offset: 2px; border-radius: 2px; }

/* ══════════════════════════════════════════════
   REPORTER SECTION
══════════════════════════════════════════════ */
.pr-reporter-section {
    padding: 14px 20px;
    border-top: 1px solid var(--pr-border);
    display: flex; flex-direction: column; gap: 8px;
}
.pr-reporter-pending {
    display: flex; align-items: center; gap: 8px;
    font-family: var(--pr-mono); font-size: 11px; color: var(--pr-orange);
    padding: 10px 12px;
    background: var(--pr-orange-dim);
    border: 1px solid rgba(255,165,0,0.22);
    border-radius: var(--pr-radius-sm);
}
.pr-pending-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--pr-orange); flex-shrink: 0;
    animation: pr-blink 1.3s ease-in-out infinite;
}
@@keyframes pr-blink { 0%,100%{opacity:1} 50%{opacity:0.2} }

.pr-reporter-hint { font-size: 11px; color: var(--pr-text-3); text-align: center; }

/* ══════════════════════════════════════════════
   STATS
══════════════════════════════════════════════ */
.pr-stats-grid {
    display: grid; grid-template-columns: 1fr 1fr;
}
.pr-stat {
    padding: 20px 16px;
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    border-right: 1px solid var(--pr-border);
}
.pr-stat:last-child { border-right: none; }
.pr-stat__num {
    font-family: var(--pr-mono); font-size: 26px; font-weight: 600;
}
.pr-stat__num--green { color: var(--pr-accent); }
.pr-stat__num--blue  { color: var(--pr-blue); font-size: 16px; letter-spacing: 1px; }
.pr-stat__label { font-size: 11px; color: var(--pr-text-3); }

/* ══════════════════════════════════════════════
   BUTTONS
══════════════════════════════════════════════ */
.pr-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    border-radius: var(--pr-radius-sm);
    font-family: var(--pr-mono); font-size: 11px; font-weight: 600; letter-spacing: 1.5px;
    padding: 8px 16px; border: 1px solid transparent;
    transition: background var(--pr-dur), border-color var(--pr-dur),
                color var(--pr-dur), opacity var(--pr-dur), transform var(--pr-dur);
    white-space: nowrap;
}
.pr-btn:focus-visible { outline: 2px solid var(--pr-accent); outline-offset: 2px; }
.pr-btn:disabled { opacity: 0.4; cursor: not-allowed; }

.pr-btn--sm { padding: 4px 11px; font-size: 10px; }
.pr-btn--full { width: 100%; }

/* Accent (green CTA) */
.pr-btn--accent {
    background: var(--pr-accent); color: var(--pr-bg);
    border-color: transparent;
}
.pr-btn--accent:hover:not(:disabled) {
    opacity: 0.88; transform: translateY(-1px);
}
.pr-btn--accent.is-loading { background: var(--pr-surface-2); color: var(--pr-text-3); }

/* Outline */
.pr-btn--outline {
    background: transparent; color: var(--pr-accent);
    border-color: var(--pr-accent-border);
}
.pr-btn--outline:hover:not(:disabled) { background: var(--pr-accent-dim); border-color: var(--pr-accent); }

/* Ghost (small secondary) */
.pr-btn--ghost {
    background: var(--pr-accent-dim); color: var(--pr-accent);
    border-color: var(--pr-accent-border);
}
.pr-btn--ghost:hover:not(:disabled) { background: rgba(159,239,0,0.16); }

/* Ghost muted (cancel) */
.pr-btn--ghost-muted {
    background: transparent; color: var(--pr-text-3);
    border-color: var(--pr-border);
}
.pr-btn--ghost-muted:hover:not(:disabled) { color: var(--pr-text); border-color: var(--pr-border-hover); }

/* Danger */
.pr-btn--danger {
    background: var(--pr-red-dim); color: var(--pr-red);
    border-color: rgba(255,62,62,0.22);
}
.pr-btn--danger:hover:not(:disabled) { background: rgba(255,62,62,0.14); border-color: var(--pr-red); }

/* ══════════════════════════════════════════════
   ALERT BANNERS
══════════════════════════════════════════════ */
.pr-alert {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 13px; border-radius: var(--pr-radius-sm);
    font-family: var(--pr-mono); font-size: 12px; border: 1px solid;
}
.pr-alert--error { background: var(--pr-red-dim); border-color: rgba(255,62,62,0.22); color: var(--pr-red); }

/* ══════════════════════════════════════════════
   VIEW FIELDS (read-only)
══════════════════════════════════════════════ */
.pr-view-fields { padding: 4px 0; }
.pr-vf {
    display: flex; align-items: center; justify-content: space-between;
    padding: 13px 20px;
    border-bottom: 1px solid var(--pr-border);
    transition: background var(--pr-dur);
}
.pr-vf:last-child { border-bottom: none; }
.pr-vf:hover { background: rgba(159,239,0,0.012); }
.pr-vf__val { font-size: 13px; color: var(--pr-text); }
.pr-vf__val--muted { font-size: 11px; color: var(--pr-text-3); font-family: var(--pr-mono); }

/* ══════════════════════════════════════════════
   EDIT FIELDS
══════════════════════════════════════════════ */
.pr-edit-fields { display: flex; flex-direction: column; gap: 18px; }
.pr-field-group { display: flex; flex-direction: column; gap: 7px; }
.pr-field-label {
    display: flex; align-items: center; gap: 8px;
    font-family: var(--pr-mono); font-size: 9.5px;
    color: var(--pr-text-3); letter-spacing: 2px;
}
.pr-field-idx { color: var(--pr-accent); opacity: 0.55; }

.pr-input-wrap {
    display: flex; align-items: center;
    background: var(--pr-bg); border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius-sm); overflow: hidden;
    transition: border-color var(--pr-dur), box-shadow var(--pr-dur);
}
.pr-input-wrap.is-focused {
    border-color: var(--pr-accent);
    box-shadow: 0 0 0 3px rgba(159,239,0,0.07);
}
.pr-input-wrap.is-error {
    border-color: rgba(255,62,62,0.5);
    box-shadow: 0 0 0 3px rgba(255,62,62,0.05);
}
.pr-input-pre {
    display: flex; align-items: center; justify-content: center;
    padding: 0 12px; color: var(--pr-text-3);
    border-right: 1px solid var(--pr-border);
    align-self: stretch; flex-shrink: 0;
}
.pr-input {
    flex: 1; background: none; border: none; outline: none;
    padding: 11px 13px;
    font-family: var(--pr-mono); font-size: 13px;
    color: var(--pr-text); caret-color: var(--pr-accent);
}
.pr-input::placeholder { color: var(--pr-text-3); }
.pr-input:disabled { opacity: 0.45; }

.pr-field-error {
    display: flex; align-items: center; gap: 5px;
    font-family: var(--pr-mono); font-size: 10px; color: var(--pr-red);
    margin-top: 3px;
}

/* ══════════════════════════════════════════════
   PASSWORD STRENGTH
══════════════════════════════════════════════ */
.pr-pw-strength {
    display: flex; align-items: center; gap: 10px; margin-top: 6px;
}
.pr-pw-strength__track {
    flex: 1; height: 2.5px; background: var(--pr-border); border-radius: 2px; overflow: hidden;
}
.pr-pw-strength__fill {
    height: 100%; border-radius: 2px;
    transition: width 0.3s var(--pr-ease), background 0.3s;
}
.pr-pw-strength__fill--weak   { width: 25%; background: var(--pr-red); }
.pr-pw-strength__fill--fair   { width: 50%; background: var(--pr-orange); }
.pr-pw-strength__fill--good   { width: 75%; background: var(--pr-blue); }
.pr-pw-strength__fill--strong { width: 100%; background: var(--pr-accent); }

.pr-pw-strength__label {
    font-family: var(--pr-mono); font-size: 9px; font-weight: 600;
    letter-spacing: 1px; flex-shrink: 0;
}
.pr-pw-strength__label--weak   { color: var(--pr-red); }
.pr-pw-strength__label--fair   { color: var(--pr-orange); }
.pr-pw-strength__label--good   { color: var(--pr-blue); }
.pr-pw-strength__label--strong { color: var(--pr-accent); }

/* ══════════════════════════════════════════════
   SECURITY CARD ROWS
══════════════════════════════════════════════ */
.pr-sec-row {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--pr-border);
    transition: background var(--pr-dur);
}
.pr-sec-row:last-of-type { border-bottom: none; }
.pr-sec-row:hover { background: rgba(159,239,0,0.012); }
.pr-sec-row--action { border-bottom: none; }

.pr-sec-row__icon {
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; flex-shrink: 0;
    background: var(--pr-surface-2); border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius-sm); color: var(--pr-text-3);
}

.pr-sec-row__body { flex: 1; min-width: 0; }
.pr-sec-row__title {
    font-size: 13px; font-weight: 500; color: var(--pr-text); margin-bottom: 2px;
}
.pr-sec-row__desc { font-size: 12px; color: var(--pr-text-3); }

.pr-status-badge {
    font-family: var(--pr-mono); font-size: 9.5px; font-weight: 600;
    padding: 3px 9px; border-radius: 3px; letter-spacing: 1px; flex-shrink: 0; border: 1px solid;
}
.pr-status-badge--active {
    background: var(--pr-accent-dim); color: var(--pr-accent); border-color: var(--pr-accent-border);
}

.pr-sec-action-link {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--pr-mono); font-size: 10.5px; color: var(--pr-text-3);
    border: 1px solid var(--pr-border); border-radius: var(--pr-radius-sm);
    padding: 4px 10px; transition: color var(--pr-dur), border-color var(--pr-dur);
    flex-shrink: 0;
}
.pr-sec-action-link:hover { color: var(--pr-text); border-color: var(--pr-border-hover); }
.pr-sec-action-link:focus-visible { outline: 2px solid var(--pr-accent); outline-offset: 2px; }

/* ══════════════════════════════════════════════
   PASSWORD CHANGE FORM (inside security card)
══════════════════════════════════════════════ */
.pr-pw-form {
    margin: 0 16px 16px;
    padding: 18px;
    background: var(--pr-bg);
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius);
    display: flex; flex-direction: column; gap: 16px;
    animation: pr-fade-up 0.2s var(--pr-ease) both;
}

.pr-pw-form__actions {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    flex-wrap: wrap;
}

.pr-forgot-link {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--pr-mono); font-size: 10.5px;
    color: var(--pr-text-3);
    transition: color var(--pr-dur);
}
.pr-forgot-link:hover { color: var(--pr-accent); }
.pr-forgot-link:focus-visible { outline: 2px solid var(--pr-accent); outline-offset: 2px; border-radius: 2px; }

/* ══════════════════════════════════════════════
   DANGER ZONE
══════════════════════════════════════════════ */
.pr-danger-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px; gap: 16px;
}
.pr-danger-row__body { flex: 1; }
.pr-danger-row__title { font-size: 13px; font-weight: 500; color: var(--pr-text); margin-bottom: 2px; }
.pr-danger-row__desc  { font-size: 12px; color: var(--pr-text-3); }

/* ══════════════════════════════════════════════
   GLOBAL FOCUS RING
══════════════════════════════════════════════ */
:focus-visible { outline: 2px solid var(--pr-accent); outline-offset: 2px; }

/* ══════════════════════════════════════════════
   RESPONSIVE — TABLET (≤920px)
══════════════════════════════════════════════ */
@@media (max-width: 920px) {
    .pr-layout {
        grid-template-columns: 260px 1fr;
        gap: 16px;
    }
    .pr-root { padding: 76px 24px 48px; }
}

/* ══════════════════════════════════════════════
   RESPONSIVE — STACKED (≤720px)
   Left col moves above right col
══════════════════════════════════════════════ */
@@media (max-width: 720px) {
    .pr-layout {
        grid-template-columns: 1fr;
        grid-template-areas: "left" "right";
    }
    .pr-root  { padding: 72px 16px 40px; }
    .pr-toast { right: 16px; left: 16px; top: 76px; }
    .pr-corner { display: none; }
    .pr-avatar { width: 70px; height: 70px; }
    .pr-avatar__initials { font-size: 22px; }
}

/* ══════════════════════════════════════════════
   RESPONSIVE — MOBILE (≤480px)
   Touch-friendly spacing
══════════════════════════════════════════════ */
@@media (max-width: 480px) {
    .pr-root { padding: 68px 12px 36px; }
    .pr-card__body { padding: 14px; }
    .pr-vf  { padding: 12px 14px; }
    .pr-sec-row { padding: 12px 14px; gap: 10px; }
    .pr-sec-row__icon { display: none; }
    .pr-danger-row { padding: 14px; flex-direction: column; align-items: flex-start; gap: 12px; }
    .pr-btn--danger { align-self: flex-start; }
    .pr-pw-form { margin: 0 10px 12px; padding: 14px; }
    .pr-pw-form__actions { flex-direction: column-reverse; align-items: stretch; }
    .pr-btn--accent { width: 100%; }
    .pr-error-card { padding: 32px 24px; }
}
</style>

@code {
    private ProfileResponse? _profile;
    private bool _loading = true;
    private string _loadError = string.Empty;

    // Edit mode
    private bool _editMode = false;
    private string _editUsername = string.Empty;
    private string _editEmail = string.Empty;
    private bool _userFocused = false;
    private bool _emailFocused = false;
    private bool _saveLoading = false;
    private string _saveError = string.Empty;

    // Password change
    private bool _pwExpanded = false;
    private string _pwCurrent = string.Empty;
    private string _pwNew = string.Empty;
    private string _pwConfirm = string.Empty;
    private bool _pwFocusCurrent = false;
    private bool _pwFocusNew = false;
    private bool _pwFocusConfirm = false;
    private bool _pwLoading = false;
    private string _pwError = string.Empty;

    // Reporter
    private bool _requestLoading = false;

    // Toast
    private string _toastMessage = string.Empty;
    private string _toastType = "success";
    private bool _toastVisible = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadProfile();
            StateHasChanged();
        }
    }

    private async Task LoadProfile()
    {
        _loading = true;
        var (data, error) = await ApiService.GetProfileAsync();
        _loading = false;
        if (error != null) _loadError = error;
        else _profile = data;
    }

    private void EnterEditMode()
    {
        _editUsername = _profile!.Username;
        _editEmail    = _profile.Email;
        _saveError    = string.Empty;
        _editMode     = true;
    }

    private void CancelEdit()
    {
        _editMode  = false;
        _saveError = string.Empty;
    }

    private void TogglePwExpand()
    {
        _pwExpanded = !_pwExpanded;
        if (!_pwExpanded)
        {
            _pwCurrent = _pwNew = _pwConfirm = string.Empty;
            _pwError   = string.Empty;
        }
    }

    private async Task SaveProfile()
    {
        _saveError = string.Empty;
        if (string.IsNullOrWhiteSpace(_editUsername) || string.IsNullOrWhiteSpace(_editEmail))
        {
            _saveError = "Username and email cannot be empty.";
            return;
        }
        _saveLoading = true;
        var error = await ApiService.UpdateProfileAsync(_editUsername, _editEmail);
        _saveLoading = false;
        if (error != null) { _saveError = error; return; }
        _profile!.Username = _editUsername;
        _profile.Email     = _editEmail;
        _editMode          = false;
        await ShowToast("Profile updated successfully.", "success");
    }

    private async Task HandleChangePassword()
    {
        if (!CanSubmitPwChange()) return;
        _pwLoading = true;
        _pwError   = string.Empty;
        var (success, message) = await ApiService.ChangePasswordAsync(_pwCurrent, _pwNew, _pwConfirm);
        _pwLoading = false;
        if (success)
        {
            _pwCurrent = _pwNew = _pwConfirm = string.Empty;
            _pwExpanded = false;
            await ShowToast("Password updated successfully.", "success");
        }
        else
        {
            _pwError = message;
        }
        StateHasChanged();
    }

    private async Task RequestReporter()
    {
        _requestLoading = true;
        var error = await ApiService.RequestReporterAsync();
        _requestLoading = false;
        if (error != null)
            await ShowToast(error, "error");
        else
        {
            _profile!.ReporterRequestPending = true;
            await ShowToast("Reporter access requested. Pending admin review.", "success");
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private async Task ShowToast(string message, string type)
    {
        _toastMessage = message;
        _toastType    = type;
        _toastVisible = true;
        StateHasChanged();
        await Task.Delay(3500);
        _toastVisible = false;
        StateHasChanged();
        await Task.Delay(400);
        _toastMessage = string.Empty;
        StateHasChanged();
    }

    // ── Helpers ──
    private static string GetInitials(string u) =>
        string.IsNullOrEmpty(u) ? "?" : (u.Length >= 2 ? u[..2].ToUpper() : u[..1].ToUpper());

    private static string GetAvatarColor(string u)
    {
        var colors = new[] { "#1a472a","#1e3a5f","#4a1942","#2d2b55","#3d2b1f","#1a3a3a","#2b3a1a","#3a1a2b" };
        return colors[Math.Abs(u.GetHashCode()) % colors.Length];
    }

    private static string GetRepTier(int s) => s switch
    {
        >= 75 => "TRUSTED",
        >= 40 => "ACTIVE",
        >= 10 => "NOVICE",
        _     => "NEW"
    };

    private bool CanSubmitPwChange() =>
        !string.IsNullOrWhiteSpace(_pwCurrent) && _pwNew.Length >= 8 && _pwNew == _pwConfirm;

    private int GetPwStrength(string pwd)
    {
        int s = 0;
        if (pwd.Length >= 8) s++;
        if (pwd.Any(char.IsUpper)) s++;
        if (pwd.Any(char.IsDigit)) s++;
        if (pwd.Any(ch => !char.IsLetterOrDigit(ch))) s++;
        return s;
    }

    private (string css, string label) GetPwStrengthDisplay(string pwd) => GetPwStrength(pwd) switch
    {
        1 => ("weak",   "WEAK"),
        2 => ("fair",   "FAIR"),
        3 => ("good",   "GOOD"),
        _ => ("strong", "STRONG")
    };
}
