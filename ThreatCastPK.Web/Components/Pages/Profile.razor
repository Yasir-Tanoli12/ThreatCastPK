@page "/profile"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Profile — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<AuthGuard>
<div class="pr-root">

    <div class="pr-bg-grid" aria-hidden="true"></div>
    <div class="pr-scan-line" aria-hidden="true"></div>
    <div class="pr-corner pr-corner--tl" aria-hidden="true"></div>
    <div class="pr-corner pr-corner--tr" aria-hidden="true"></div>
    <div class="pr-corner pr-corner--bl" aria-hidden="true"></div>
    <div class="pr-corner pr-corner--br" aria-hidden="true"></div>

    @if (_loading)
    {
        <div class="pr-fullscreen-center" role="status" aria-label="Loading profile">
            <div class="pr-spinner"></div>
            <div class="pr-loading-label">LOADING OPERATOR PROFILE...</div>
        </div>
    }
    else if (_profile == null)
    {
        <div class="pr-fullscreen-center" role="alert">
            <div class="pr-error-card">
                <div class="pr-error-icon" aria-hidden="true">@IcoWarning(24)</div>
                <div class="pr-error-title">FAILED TO LOAD PROFILE</div>
                <div class="pr-error-sub">@_loadError</div>
                <button class="pr-btn pr-btn--accent" @onclick="LoadProfile">
                    @IcoRefresh(14)
                    <span>Retry</span>
                </button>
            </div>
        </div>
    }
    else
    {
        @* ── Toast ── *@
        @if (!string.IsNullOrEmpty(_toastMessage))
        {
            <div class="pr-toast pr-toast--@(_toastType) @(_toastVisible ? "is-visible" : "")"
                 role="status" aria-live="polite">
                @if (_toastType == "success")
                {
                    @IcoCheck(14)
                }
                else
                {
                    @IcoWarning(14)
                }
                <span>@_toastMessage</span>
            </div>
        }

        <div class="pr-layout">

            @* ══════════════════════════════════
               LEFT COLUMN
            ══════════════════════════════════ *@
            <aside class="pr-left" aria-label="Operator identity">

                @* Identity card *@
                <div class="pr-card">
                    <div class="pr-card__header">
                        <span class="pr-card__eyebrow"> OPERATOR IDENTITY</span>
                    </div>

                    <div class="pr-identity">
                        <div class="pr-avatar" style="background:@GetAvatarColor(_profile.Username)" aria-hidden="true">
                            <span class="pr-avatar__initials">@GetInitials(_profile.Username)</span>
                        </div>
                        <div class="pr-identity__name">@_profile.Username</div>
                        <div class="pr-identity__email">@_profile.Email</div>

                        <div class="pr-role-badge pr-role-badge--@_profile.Role.ToLower()">
                            @GetRoleIcon(_profile.Role)
                            <span>@_profile.Role.ToUpper()</span>
                        </div>
                    </div>

                    @* Reputation *@
                    <div class="pr-rep">
                        <div class="pr-rep__header">
                            <span class="pr-label">REPUTATION SCORE</span>
                            <span class="pr-rep__value">@_profile.ReputationScore</span>
                        </div>
                        <div class="pr-rep__track" role="progressbar"
                             aria-valuenow="@_profile.ReputationScore"
                             aria-valuemin="0" aria-valuemax="100"
                             aria-label="Reputation score @_profile.ReputationScore out of 100">
                            <div class="pr-rep__fill" style="width:@Math.Min(_profile.ReputationScore, 100)%"></div>
                            <div class="pr-rep__marker" title="75 — Auto-approve threshold"></div>
                        </div>
                        <div class="pr-rep__tiers">
                            <span>0</span>
                            <span class="pr-rep__tier-mid">75 AUTO-APPROVE</span>
                            <span>100+</span>
                        </div>
                    </div>

                    @* Meta list *@
                    <ul class="pr-meta" role="list">
                        <li class="pr-meta__row">
                            <span class="pr-label">TRUST TIER</span>
                            <span class="pr-meta__val pr-tier-badge pr-tier-badge--@GetRepTier(_profile.ReputationScore).ToLower()">
                                @GetRepTier(_profile.ReputationScore)
                            </span>
                        </li>
                        <li class="pr-meta__row">
                            <span class="pr-label">MEMBER SINCE</span>
                            <span class="pr-meta__val">@_profile.JoinDate.ToString("MMM dd, yyyy")</span>
                        </li>
                        <li class="pr-meta__row">
                            <span class="pr-label">USER ID</span>
                            <span class="pr-meta__val pr-mono pr-truncate" title="@_profile.Id.ToString()">
                                @_profile.Id.ToString()[..8]…
                            </span>
                        </li>
                        <li class="pr-meta__row">
                            <span class="pr-label">REPORTS</span>
                            <a href="/my-reports" class="pr-meta__link">
                                View history
                                @IcoArrow(12)
                            </a>
                        </li>
                        <li class="pr-meta__row">
                            <span class="pr-label">SUBSCRIPTIONS</span>
                            <a href="/subscriptions" class="pr-meta__link">
                                Manage
                                @IcoArrow(12)
                            </a>
                        </li>
                    </ul>

                    @* Reporter request *@
                    @if (_profile.Role == "Registered")
                    {
                        <div class="pr-reporter-section">
                            @if (_profile.ReporterRequestPending)
                            {
                                <div class="pr-reporter-pending" role="status">
                                    <span class="pr-pending-dot" aria-hidden="true"></span>
                                    Reporter request pending admin review
                                </div>
                            }
                            else
                            {
                                <button class="pr-btn pr-btn--outline pr-btn--full @(_requestLoading ? "is-loading" : "")"
                                        @onclick="RequestReporter"
                                        disabled="@_requestLoading"
                                        aria-label="Request reporter access">
                                    @if (_requestLoading)
                                    {
                                        <span class="pr-spinner pr-spinner--sm" aria-hidden="true"></span>
                                        <span>REQUESTING...</span>
                                    }
                                    else
                                    {
                                        @IcoBroadcast(14)
                                        <span>REQUEST REPORTER ACCESS</span>
                                    }
                                </button>
                                <p class="pr-reporter-hint">Reporters can submit live attack events to the map</p>
                            }
                        </div>
                    }
                </div>

                @* Stats card *@
                <div class="pr-card">
                    <div class="pr-card__header">
                        <span class="pr-card__eyebrow"> ACTIVITY</span>
                    </div>
                    <div class="pr-stats-grid">
                        <div class="pr-stat">
                            <span class="pr-stat__num pr-stat__num--green">@_profile.ReputationScore</span>
                            <span class="pr-stat__label">Reputation</span>
                        </div>
                        <div class="pr-stat">
                            <span class="pr-stat__num pr-stat__num--blue">@GetRepTier(_profile.ReputationScore)</span>
                            <span class="pr-stat__label">Trust Tier</span>
                        </div>
                    </div>
                </div>

            </aside>

            @* ══════════════════════════════════
               RIGHT COLUMN
            ══════════════════════════════════ *@
            <div class="pr-right">

                @* ── Account Settings card ── *@
                <div class="pr-card">
                    <div class="pr-card__header">
                        <span class="pr-card__eyebrow"> ACCOUNT SETTINGS</span>
                        @if (!_editMode)
                        {
                            <button class="pr-btn pr-btn--ghost pr-btn--sm"
                                    @onclick="EnterEditMode"
                                    aria-label="Edit profile">
                                @IcoPencil(13)
                                <span>EDIT</span>
                            </button>
                        }
                        else
                        {
                            <button class="pr-btn pr-btn--ghost-muted pr-btn--sm"
                                    @onclick="CancelEdit"
                                    aria-label="Cancel editing">
                                @IcoX(13)
                                <span>CANCEL</span>
                            </button>
                        }
                    </div>

                    <div class="pr-card__body">
                        @if (!_editMode)
                        {
                            <ul class="pr-view-fields" role="list">
                                <li class="pr-vf">
                                    <span class="pr-label">USERNAME</span>
                                    <span class="pr-vf__val pr-mono">@_profile.Username</span>
                                </li>
                                <li class="pr-vf">
                                    <span class="pr-label">EMAIL ADDRESS</span>
                                    <span class="pr-vf__val">@_profile.Email</span>
                                </li>
                                <li class="pr-vf">
                                    <span class="pr-label">PASSWORD</span>
                                    @if (_profile.IsGoogleLinked)
                                    {
                                        <span class="pr-vf__val pr-vf__val--muted">Managed by Google</span>
                                    }
                                    else
                                    {
                                        <span class="pr-vf__val pr-mono">••••••••••</span>
                                    }
                                </li>
                                <li class="pr-vf">
                                    <span class="pr-label">ROLE</span>
                                    <span class="pr-role-badge pr-role-badge--sm pr-role-badge--@_profile.Role.ToLower()">
                                        @_profile.Role
                                    </span>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <div class="pr-edit-fields">

                                <div class="pr-field-group">
                                    <label class="pr-field-label" for="pr-username">
                                        <span class="pr-field-idx" aria-hidden="true">01</span>
                                        USERNAME
                                    </label>
                                    <div class="pr-input-wrap @(_userFocused ? "is-focused" : "")">
                                        <span class="pr-input-pre" aria-hidden="true">@IcoUser(14)</span>
                                        <input id="pr-username" type="text" class="pr-input"
                                               @bind="_editUsername" @bind:event="oninput"
                                               @onfocus="() => _userFocused = true"
                                               @onblur="() => _userFocused = false"
                                               placeholder="@_profile.Username"
                                               disabled="@_saveLoading"
                                               autocomplete="username" />
                                    </div>
                                </div>

                                <div class="pr-field-group">
                                    <label class="pr-field-label" for="pr-email">
                                        <span class="pr-field-idx" aria-hidden="true">02</span>
                                        EMAIL ADDRESS
                                    </label>
                                    <div class="pr-input-wrap @(_emailFocused ? "is-focused" : "")">
                                        <span class="pr-input-pre" aria-hidden="true">@IcoAt(14)</span>
                                        <input id="pr-email" type="email" class="pr-input"
                                               @bind="_editEmail" @bind:event="oninput"
                                               @onfocus="() => _emailFocused = true"
                                               @onblur="() => _emailFocused = false"
                                               placeholder="@_profile.Email"
                                               disabled="@_saveLoading"
                                               autocomplete="email" />
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(_saveError))
                                {
                                    <div class="pr-alert pr-alert--error" role="alert">
                                        @IcoWarning(13)
                                        <span>@_saveError</span>
                                    </div>
                                }

                                <button class="pr-btn pr-btn--accent pr-btn--full @(_saveLoading ? "is-loading" : "")"
                                        @onclick="SaveProfile"
                                        disabled="@_saveLoading"
                                        aria-label="Save profile changes">
                                    @if (_saveLoading)
                                    {
                                        <span class="pr-spinner pr-spinner--sm" aria-hidden="true"></span>
                                        <span>SAVING...</span>
                                    }
                                    else
                                    {
                                        @IcoCheck(14)
                                        <span>SAVE CHANGES</span>
                                    }
                                </button>

                            </div>
                        }
                    </div>
                </div>

                @* ── Security card (replaces the old one) ── *@
                <div class="pr-card">
                    <div class="pr-card__header">
                        <span class="pr-card__eyebrow"> SECURITY</span>
                    </div>

                    @* Auth method row *@
                    <div class="pr-sec-row">
                        <div class="pr-sec-row__icon" aria-hidden="true">
                            @IcoShield(16)
                        </div>
                        <div class="pr-sec-row__body">
                            <div class="pr-sec-row__title">Authentication Method</div>
                            <div class="pr-sec-row__desc">
                                @if (_profile.IsGoogleLinked)
                                {
                                    <span>Google OAuth — credentials managed by Google</span>
                                }
                                else
                                {
                                    <span>Password-based with BCrypt hashing</span>
                                }
                            </div>
                        </div>
                        <span class="pr-status-badge pr-status-badge--active">ACTIVE</span>
                    </div>

                    @* JWT row *@
                    <div class="pr-sec-row">
                        <div class="pr-sec-row__icon" aria-hidden="true">@IcoKey(16)</div>
                        <div class="pr-sec-row__body">
                            <div class="pr-sec-row__title">JWT Session Token</div>
                            <div class="pr-sec-row__desc">Expires 1 hour after login</div>
                        </div>
                        <span class="pr-status-badge pr-status-badge--active">ACTIVE</span>
                    </div>

                    @* Change Password / Forgot Password row *@
                    <div class="pr-sec-row pr-sec-row--action">
                        <div class="pr-sec-row__icon" aria-hidden="true">@IcoLock(16)</div>
                        <div class="pr-sec-row__body">
                            <div class="pr-sec-row__title">Password</div>
                            @if (_profile.IsGoogleLinked)
                            {
                                <div class="pr-sec-row__desc">Managed by your Google account</div>
                            }
                            else if (_pwExpanded)
                            {
                                <div class="pr-sec-row__desc">Enter your current and new password below</div>
                            }
                            else
                            {
                                <div class="pr-sec-row__desc">Last changed: unknown</div>
                            }
                        </div>

                        @if (_profile.IsGoogleLinked)
                        {
                            <a href="/forgot-password" class="pr-sec-action-link">
                                Forgot password
                                @IcoArrow(12)
                            </a>
                        }
                        else
                        {
                            <button class="pr-btn pr-btn--ghost pr-btn--sm"
                                    @onclick="TogglePwExpand"
                                    aria-expanded="@(_pwExpanded ? "true" : "false")"
                                    aria-controls="pr-pw-form">
                                @if (_pwExpanded)
                                {
                                    @IcoX(13)
                                    <span>CANCEL</span>
                                }
                                else
                                {
                                    @IcoPencil(13)
                                    <span>CHANGE</span>
                                }
                            </button>
                        }
                    </div>

                    @* Inline password change form *@
                    @if (_pwExpanded && !_profile.IsGoogleLinked)
                    {
                        <div class="pr-pw-form" id="pr-pw-form" role="region" aria-label="Change password">

                            <div class="pr-field-group">
                                <label class="pr-field-label" for="pr-pw-current">
                                    <span class="pr-field-idx" aria-hidden="true">01</span>
                                    CURRENT PASSWORD
                                </label>
                                <div class="pr-input-wrap @(_pwFocusCurrent ? "is-focused" : "")">
                                    <span class="pr-input-pre" aria-hidden="true">@IcoLock(14)</span>
                                    <input id="pr-pw-current" type="password" class="pr-input"
                                           value="@_pwCurrent"
                                           @oninput="e => _pwCurrent = e.Value?.ToString() ?? string.Empty"
                                           @onfocus="() => _pwFocusCurrent = true"
                                           @onblur="() => _pwFocusCurrent = false"
                                           placeholder="Your current password"
                                           disabled="@_pwLoading"
                                           autocomplete="current-password" />
                                </div>
                            </div>

                            <div class="pr-field-group">
                                <label class="pr-field-label" for="pr-pw-new">
                                    <span class="pr-field-idx" aria-hidden="true">02</span>
                                    NEW PASSWORD
                                </label>
                                <div class="pr-input-wrap @(_pwFocusNew ? "is-focused" : "")">
                                    <span class="pr-input-pre" aria-hidden="true">@IcoKey(14)</span>
                                    <input id="pr-pw-new" type="password" class="pr-input"
                                           value="@_pwNew"
                                           @oninput="e => _pwNew = e.Value?.ToString() ?? string.Empty"
                                           @onfocus="() => _pwFocusNew = true"
                                           @onblur="() => _pwFocusNew = false"
                                           placeholder="At least 8 characters"
                                           disabled="@_pwLoading"
                                           autocomplete="new-password" />
                                </div>
                                @if (!string.IsNullOrEmpty(_pwNew))
                                {
                                    var (css, lbl) = GetPwStrengthDisplay(_pwNew);
                                    <div class="pr-pw-strength">
                                        <div class="pr-pw-strength__track">
                                            <div class="pr-pw-strength__fill pr-pw-strength__fill--@css"></div>
                                        </div>
                                        <span class="pr-pw-strength__label pr-pw-strength__label--@css">@lbl</span>
                                    </div>
                                }
                            </div>

                            <div class="pr-field-group">
                                <label class="pr-field-label" for="pr-pw-confirm">
                                    <span class="pr-field-idx" aria-hidden="true">03</span>
                                    CONFIRM NEW PASSWORD
                                </label>
                                <div class="pr-input-wrap @(_pwFocusConfirm ? "is-focused" : "") @(!string.IsNullOrEmpty(_pwConfirm) && _pwNew != _pwConfirm ? "is-error" : "")">
                                    <span class="pr-input-pre" aria-hidden="true">@IcoKey(14)</span>
                                    <input id="pr-pw-confirm" type="password" class="pr-input"
                                           value="@_pwConfirm"
                                           @oninput="e => _pwConfirm = e.Value?.ToString() ?? string.Empty"
                                           @onfocus="() => _pwFocusConfirm = true"
                                           @onblur="() => _pwFocusConfirm = false"
                                           placeholder="Repeat new password"
                                           disabled="@_pwLoading"
                                           autocomplete="new-password"
                                           aria-describedby="@(!string.IsNullOrEmpty(_pwConfirm) && _pwNew != _pwConfirm ? "pr-pw-mismatch" : null)" />
                                </div>
                                @if (!string.IsNullOrEmpty(_pwConfirm) && _pwNew != _pwConfirm)
                                {
                                    <span id="pr-pw-mismatch" class="pr-field-error" role="alert">
                                        @IcoWarning(11)
                                        Passwords do not match
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(_pwError))
                            {
                                <div class="pr-alert pr-alert--error" role="alert">
                                    @IcoWarning(13)
                                    <span>@_pwError</span>
                                </div>
                            }

                            <div class="pr-pw-form__actions">
                                <a href="/forgot-password" class="pr-forgot-link">
                                    @IcoKey(12)
                                    <span>Forgot current password?</span>
                                </a>
                                <button class="pr-btn pr-btn--accent @(_pwLoading ? "is-loading" : "")"
                                        @onclick="HandleChangePassword"
                                        disabled="@(!CanSubmitPwChange() || _pwLoading)"
                                        aria-label="Save new password">
                                    @if (_pwLoading)
                                    {
                                        <span class="pr-spinner pr-spinner--sm" aria-hidden="true"></span>
                                        <span>SAVING...</span>
                                    }
                                    else
                                    {
                                        @IcoCheck(14)
                                        <span>UPDATE PASSWORD</span>
                                    }
                                </button>
                            </div>

                        </div>
                    }

                </div>

                @* ── Danger zone ── *@
                <div class="pr-card pr-card--danger">
                    <div class="pr-card__header">
                        <span class="pr-card__eyebrow pr-card__eyebrow--danger"> DANGER ZONE</span>
                    </div>
                    <div class="pr-danger-row">
                        <div class="pr-danger-row__body">
                            <div class="pr-danger-row__title">Sign out of all sessions</div>
                            <div class="pr-danger-row__desc">Invalidates your current JWT token immediately</div>
                        </div>
                        <button class="pr-btn pr-btn--danger"
                                @onclick="Logout"
                                aria-label="Log out of all sessions">
                            @IcoLogout(14)
                            <span>LOGOUT</span>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    }

</div>
</AuthGuard>

@* ══════════════════════════════════════════════
   INLINE SVG ICON HELPERS
   All icons are pure SVG paths — no emoji, no
   external font dependency, no network request.
══════════════════════════════════════════════ *@
@code {

    RenderFragment IcoWarning(int size) => b =>
        b.AddMarkupContent(0, $"<svg width='{size}' height='{size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z'/><line x1='12' y1='9' x2='12' y2='13'/><line x1='12' y1='17' x2='12.01' y2='17'/></svg>");

    RenderFragment IcoCheck(int size) => b =>
        b.AddMarkupContent(0, $"<svg width='{size}' height='{size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><polyline points='20 6 9 17 4 12'/></svg>");

    RenderFragment IcoX(int size) => b =>
        b.AddMarkupContent(0, $"<svg width='{size}' height='{size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>");

    RenderFragment IcoRefresh(int size) => b =>
        b.AddMarkupContent(0, $"<svg width='{size}' height='{size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><polyline points='23 4 23 10 17 10'/><path d='M20.49 15a9 9 0 1 1-2.12-9.36L23 10'/></svg>");

    RenderFragment IcoPencil(int size) => b =>
        b.AddMarkupContent(0, $"<svg width='{size}' height='{size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7'/><path d='M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z'/></svg>");

    RenderFragment IcoArrow(int size) => b =>
        b.AddMarkupContent(0, $"<svg width='{size}' height='{size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14'/><path d='m12 5 7 7-7 7'/></svg>");

    RenderFragment IcoUser(int size) => b =>
        b.AddMarkupContent(0, $"<svg width='{size}' height='{size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>");

    RenderFragment IcoAt(int size) => b =>
        b.AddMarkupContent(0, $"<svg width='{size}' height='{size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><circle cx='12' cy='12' r='4'/><path d='M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94'/></svg>");

    RenderFragment IcoShield(int size) => b =>
        b.AddMarkupContent(0, $"<svg width='{size}' height='{size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/><path d='m9 12 2 2 4-4'/></svg>");

    RenderFragment IcoKey(int size) => b =>
        b.AddMarkupContent(0, $"<svg width='{size}' height='{size}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><circle cx='7.5' cy='15.5' r='5.5'/><path d='M21 2 11.5 11.5'/><path d='M15 6 19 2l2 2-2 4'/><path d='M11 15 10 20'/><path d='M13 17 12 22'/></svg>");

    RenderFragment IcoLock(int size) => b =>
