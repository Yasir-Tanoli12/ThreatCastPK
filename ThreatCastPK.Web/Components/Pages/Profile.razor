@code {
    private ProfileResponse? _profile;
    private bool _loading = true;
    private string _loadError = string.Empty;

    private bool _editMode = false;
    private string _editUsername = string.Empty;
    private string _editEmail = string.Empty;
    private bool _userFocused = false;
    private bool _emailFocused = false;
    private bool _saveLoading = false;
    private string _saveError = string.Empty;

    private bool _requestLoading = false;

    private string _toastMessage = string.Empty;
    private string _toastType = "toast-success";
    private bool _toastVisible = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        await LoadProfile();
        StateHasChanged();
    }
}

    private async Task LoadProfile()
    {
        _loading = true;
        var (data, error) = await ApiService.GetProfileAsync();
        _loading = false;

        if (error != null)
            _loadError = error;
        else
            _profile = data;
    }

    private void EnterEditMode()
    {
        _editUsername = _profile!.Username;
        _editEmail = _profile.Email;
        _saveError = string.Empty;
        _editMode = true;
    }

    private void CancelEdit()
    {
        _editMode = false;
        _saveError = string.Empty;
    }

    private async Task SaveProfile()
    {
        _saveError = string.Empty;
        if (string.IsNullOrWhiteSpace(_editUsername) || string.IsNullOrWhiteSpace(_editEmail))
        {
            _saveError = "Username and email cannot be empty.";
            return;
        }

        _saveLoading = true;
        var error = await ApiService.UpdateProfileAsync(_editUsername, _editEmail);
        _saveLoading = false;

        if (error != null)
        {
            _saveError = error;
        }
        else
        {
            _profile!.Username = _editUsername;
            _profile.Email = _editEmail;
            _editMode = false;
            await ShowToast("Profile updated successfully.", "toast-success");
        }
    }

    private async Task RequestReporter()
    {
        _requestLoading = true;
        var error = await ApiService.RequestReporterAsync();
        _requestLoading = false;

        if (error != null)
        {
            await ShowToast(error, "toast-error");
        }
        else
        {
            _profile!.ReporterRequestPending = true;
            await ShowToast("Reporter access requested. Pending admin review.", "toast-success");
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private async Task ShowToast(string message, string type)
    {
        _toastMessage = message;
        _toastType = type;
        _toastVisible = true;
        StateHasChanged();
        await Task.Delay(3500);
        _toastVisible = false;
        StateHasChanged();
        await Task.Delay(500);
        _toastMessage = string.Empty;
        StateHasChanged();
    }

    // ── Helpers ──

    private static string GetInitials(string username)
    {
        if (string.IsNullOrEmpty(username)) return "?";
        return username.Length >= 2 ? username[..2].ToUpper() : username[..1].ToUpper();
    }

    private static string GetAvatarColor(string username)
    {
        // Deterministic color based on username so it stays consistent
        var colors = new[]
        {
            "#1a472a", "#1e3a5f", "#4a1942", "#2d2b55",
            "#3d2b1f", "#1a3a3a", "#2b3a1a", "#3a1a2b"
        };
        var idx = Math.Abs(username.GetHashCode()) % colors.Length;
        return colors[idx];
    }

    private static string GetRoleIcon(string role) => role switch
    {
        "Admin"      => "⚡",
        "Reporter"   => "📡",
        "Registered" => "◈",
        _            => "👁"
    };

    private static string GetRepTier(int score) => score switch
    {
        >= 75  => "TRUSTED",
        >= 40  => "ACTIVE",
        >= 10  => "NOVICE",
        _      => "NEW"
    };
}
