    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSubscriptions();
            StateHasChanged();
        }
    }

    private async Task LoadSubscriptions()
    {
        _loading = true; _loadError = null;
        StateHasChanged();
        var (data, error) = await ApiService.GetSubscriptionsAsync();
        _loading = false;
        if (error != null) _loadError = error;
        else _subscriptions = data ?? new();
        StateHasChanged();
    }

    // ── Form helpers ──

    private void OpenNewForm()
    {
        ResetForm();
        _showForm = true;
        _editingId = null;
    }

    private void CancelNewForm()
    {
        _showForm = false;
        ResetForm();
    }

    private void StartEdit(SubscriptionResponse sub)
    {
        _editingId = sub.Id;
        _showForm = false;
        _formName = sub.Name;
        _formMinSeverity = sub.MinimumSeverity;

        _formAttackTypes = string.IsNullOrWhiteSpace(sub.AttackTypes)
            ? new HashSet<string>()
            : sub.AttackTypes.Split(',').Select(x => x.Trim())
                .Where(x => !string.IsNullOrEmpty(x)).ToHashSet();

        _formCities = string.IsNullOrWhiteSpace(sub.Cities)
            ? new HashSet<string>()
            : sub.Cities.Split(',').Select(x => x.Trim())
                .Where(x => !string.IsNullOrEmpty(x)).ToHashSet();

        _formSectors = string.IsNullOrWhiteSpace(sub.Sectors)
            ? new HashSet<string>()
            : sub.Sectors.Split(',').Select(x => x.Trim())
                .Where(x => !string.IsNullOrEmpty(x)).ToHashSet();

        _formError = string.Empty;
    }

    private void CancelEdit()
    {
        _editingId = null;
        ResetForm();
    }

    private void ResetForm()
    {
        _formName = string.Empty;
        _formAttackTypes = new();
        _formCities = new();
        _formSectors = new();
        _formMinSeverity = 1;
        _formError = string.Empty;
    }

    private void ToggleItem(HashSet<string> set, string item)
    {
        if (set.Contains(item)) set.Remove(item);
        else set.Add(item);
    }

    private async Task SaveNew()
    {
        _formError = string.Empty;
        if (string.IsNullOrWhiteSpace(_formName))
        { _formError = "Subscription name is required."; return; }

        _formLoading = true;
        var error = await ApiService.CreateSubscriptionAsync(new
        {
            name           = _formName.Trim(),
            attackTypes    = string.Join(",", _formAttackTypes),
            cities         = string.Join(",", _formCities),
            sectors        = string.Join(",", _formSectors),
            minimumSeverity = _formMinSeverity
        });
        _formLoading = false;

        if (error != null) { _formError = error; }
        else
        {
            _showForm = false;
            ResetForm();
            await LoadSubscriptions();
            await ShowToast("Subscription created.", "toast-success");
        }
        StateHasChanged();
    }

    private async Task SaveEdit()
    {
        _formError = string.Empty;
        if (string.IsNullOrWhiteSpace(_formName))
        { _formError = "Subscription name is required."; return; }

        _formLoading = true;
        var error = await ApiService.UpdateSubscriptionAsync(_editingId!.Value, new
        {
            name            = _formName.Trim(),
            attackTypes     = string.Join(",", _formAttackTypes),
            cities          = string.Join(",", _formCities),
            sectors         = string.Join(",", _formSectors),
            minimumSeverity = _formMinSeverity
        });
        _formLoading = false;

        if (error != null) { _formError = error; }
        else
        {
            _editingId = null;
            ResetForm();
            await LoadSubscriptions();
            await ShowToast("Subscription updated.", "toast-success");
        }
        StateHasChanged();
    }

    private async Task ToggleSubscription(Guid id)
    {
        _actioningId = id;
        var error = await ApiService.ToggleSubscriptionAsync(id);
        _actioningId = null;

        if (error != null)
            await ShowToast(error, "toast-error");
        else
        {
            var sub = _subscriptions?.FirstOrDefault(s => s.Id == id);
            if (sub != null) sub.IsActive = !sub.IsActive;
        }
        StateHasChanged();
    }

    private void StartDelete(Guid id) => _deleteConfirmId = id;
    private void CancelDelete() => _deleteConfirmId = null;

    private async Task ConfirmDelete(Guid id)
    {
        _actioningId = id;
        var error = await ApiService.DeleteSubscriptionAsync(id);
        _actioningId = null;
        _deleteConfirmId = null;

        if (error != null)
            await ShowToast(error, "toast-error");
        else
        {
            _subscriptions?.RemoveAll(s => s.Id == id);
            await ShowToast("Subscription deleted.", "toast-success");
        }
        StateHasChanged();
    }

    private async Task ShowToast(string message, string type)
    {
        _toastMessage = message; _toastType = type; _toastVisible = true;
        StateHasChanged();
        await Task.Delay(3500);
        _toastVisible = false; StateHasChanged();
        await Task.Delay(400);
        _toastMessage = string.Empty; StateHasChanged();
    }

    private static string GetAttackIcon(string type) => type switch
    {
        "Ransomware"    => "🔐",
        "Phishing"      => "🎣",
        "DDoS"          => "🌊",
        "IdentityTheft" => "👤",
        "Malware"       => "🦠",
        _               => "⚠"
    };

    private static string GetSeverityLabel(int s) => s switch
    {
        1 => "Low", 2 => "Medium", 3 => "High", 4 => "Critical", 5 => "Catastrophic", _ => ""
    };

    private static string GetSeverityDesc(int s) => s switch
    {
        1 => "Minor incidents",
        2 => "Moderate disruption",
        3 => "Significant impact",
        4 => "Critical systems",
        5 => "Catastrophic damage",
        _ => ""
    };

    private static string GetRelativeTime(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalDays >= 1) return $"{(int)diff.TotalDays}d ago";
        if (diff.TotalHours >= 1) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalMinutes}m ago";
    }
}
