@* ThreatCastPK.Web/Components/Pages/Subscriptions.razor *@
@page "/subscriptions"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Alert Subscriptions — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<AuthGuard>
<div class="sub-root">
    <div class="bg-grid"></div>
    <div class="scan-line"></div>
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>

    <div class="sub-layout">

        @* ── Left column — subscriptions ── *@
        <div class="sub-main">

            @* Header *@
            <div class="page-header">
                <div class="ph-left">
                    <div class="ph-label"> ALERT CONFIGURATION</div>
                    <h1 class="ph-title">
                        Alert <span class="ph-accent">Subscriptions</span>
                    </h1>
                    <p class="ph-sub">
                        Define threat filters and receive real-time notifications
                        when matching attacks are detected across Pakistan.
                    </p>
                </div>
                <div class="ph-right">
                    @if (_subscriptions != null)
                    {
                        <div class="slot-counter">
                            <div class="sc-dots">
                                @for (int i = 0; i < 3; i++)
                                {
                                    var idx = i;
                                    <div class="sc-dot @(idx < _subscriptions.Count ? "dot-used" : "dot-free")"></div>
                                }
                            </div>
                            <div class="sc-label">
                                <span class="sc-used">@_subscriptions.Count</span>
                                <span class="sc-sep">/</span>
                                <span class="sc-total">3</span>
                                <span class="sc-text">SLOTS USED</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Toast *@
            @if (!string.IsNullOrEmpty(_toastMessage))
            {
                <div class="toast @_toastType @(_toastVisible ? "toast-show" : "toast-hide")">
                    <span class="toast-icon">@(_toastType == "toast-success" ? "✓" : "⚠")</span>
                    <span>@_toastMessage</span>
                </div>
            }

            @* Loading *@
            @if (_loading)
            {
                <div class="subs-list">
                    @for (int i = 0; i < 2; i++)
                    {
                        <div class="skeleton-sub">
                            <div class="sk-header">
                                <div class="sk-line sk-name"></div>
                                <div class="sk-toggle"></div>
                            </div>
                            <div class="sk-body">
                                <div class="sk-line sk-tags"></div>
                                <div class="sk-line sk-tags sk-tags-sm"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (_loadError != null)
            {
                <div class="state-box">
                    <div class="sb-icon">⚠</div>
                    <div class="sb-title">FAILED TO LOAD</div>
                    <div class="sb-sub">@_loadError</div>
                    <button class="sb-btn" @onclick="LoadSubscriptions">↺ Retry</button>
                </div>
            }
            else
            {
                <div class="subs-list">

                    @* Existing subscriptions *@
                    @foreach (var sub in _subscriptions!)
                    {
                        <div class="sub-card @(!sub.IsActive ? "sub-inactive" : "") @(_editingId == sub.Id ? "sub-editing" : "")">

                            @* Card header *@
                            <div class="sc-top">
                                <div class="sc-name-row">
                                    <div class="sc-icon-wrap">
                                        <span class="sc-icon">⚡</span>
                                    </div>
                                    <div class="sc-name-info">
                                        <span class="sc-name">@sub.Name</span>
                                        <span class="sc-created">
                                            Created @GetRelativeTime(sub.CreatedAt)
                                        </span>
                                    </div>
                                </div>
                                <div class="sc-controls">
                                    @* Toggle *@
                                    <button class="toggle-btn @(sub.IsActive ? "toggle-on" : "toggle-off")"
                                            @onclick="() => ToggleSubscription(sub.Id)"
                                            disabled="@(_actioningId == sub.Id)"
                                            title="@(sub.IsActive ? "Deactivate" : "Activate")">
                                        <span class="toggle-track">
                                            <span class="toggle-thumb"></span>
                                        </span>
                                        <span class="toggle-label">
                                            @(sub.IsActive ? "ON" : "OFF")
                                        </span>
                                    </button>
                                    @* Edit *@
                                    <button class="icon-btn"
                                            title="Edit subscription"
                                            @onclick="() => StartEdit(sub)">
                                        ✎
                                    </button>
                                    @* Delete *@
                                    <button class="icon-btn icon-btn-danger"
                                            title="Delete subscription"
                                            @onclick="() => StartDelete(sub.Id)">
                                        ✕
                                    </button>
                                </div>
                            </div>

                            @* Filter summary *@
                            <div class="sc-filters">

                                <div class="filter-row">
                                    <span class="fr-label">ATTACK TYPES</span>
                                    <div class="fr-tags">
                                        @if (string.IsNullOrWhiteSpace(sub.AttackTypes) || sub.AttackTypes == "All")
                                        {
                                            <span class="tag tag-all">ALL TYPES</span>
                                        }
                                        else
                                        {
                                            @foreach (var t in sub.AttackTypes.Split(',').Select(x => x.Trim()).Where(x => !string.IsNullOrEmpty(x)))
                                            {
                                                <span class="tag tag-type chip-@t.ToLower().Replace(" ","")">
                                                    @GetAttackIcon(t) @t
                                                </span>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="filter-row">
                                    <span class="fr-label">CITIES</span>
                                    <div class="fr-tags">
                                        @if (string.IsNullOrWhiteSpace(sub.Cities))
                                        {
                                            <span class="tag tag-all">ALL CITIES</span>
                                        }
                                        else
                                        {
                                            @foreach (var c in sub.Cities.Split(',').Select(x => x.Trim()).Where(x => !string.IsNullOrEmpty(x)).Take(5))
                                            {
                                                <span class="tag tag-city">📍 @c</span>
                                            }
                                            @if (sub.Cities.Split(',').Length > 5)
                                            {
                                                <span class="tag tag-more">+@(sub.Cities.Split(',').Length - 5)</span>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="filter-row">
                                    <span class="fr-label">SECTORS</span>
                                    <div class="fr-tags">
                                        @if (string.IsNullOrWhiteSpace(sub.Sectors))
                                        {
                                            <span class="tag tag-all">ALL SECTORS</span>
                                        }
                                        else
                                        {
                                            @foreach (var s in sub.Sectors.Split(',').Select(x => x.Trim()).Where(x => !string.IsNullOrEmpty(x)))
                                            {
                                                <span class="tag tag-sector">@s</span>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="filter-row">
                                    <span class="fr-label">MIN SEVERITY</span>
                                    <div class="fr-tags">
                                        <span class="tag sev-tag sev-@sub.MinimumSeverity">
                                            @sub.MinimumSeverity+ — @GetSeverityLabel(sub.MinimumSeverity) and above
                                        </span>
                                    </div>
                                </div>

                            </div>

                            @* Inactive overlay *@
                            @if (!sub.IsActive)
                            {
                                <div class="inactive-notice">
                                    <span>⏸ Subscription paused — no alerts will be sent</span>
                                </div>
                            }

                        </div>

                        @* Delete confirm *@
                        @if (_deleteConfirmId == sub.Id)
                        {
                            <div class="confirm-row">
                                <span class="cr-icon">⚠</span>
                                <span class="cr-text">
                                    Delete <strong>@sub.Name</strong>? This cannot be undone.
                                </span>
                                <div class="cr-actions">
                                    <button class="cr-cancel" @onclick="CancelDelete">CANCEL</button>
                                    <button class="cr-confirm @(_actioningId == sub.Id ? "loading" : "")"
                                            @onclick="() => ConfirmDelete(sub.Id)"
                                            disabled="@(_actioningId == sub.Id)">
                                        @if (_actioningId == sub.Id)
                                        {
                                            <span class="btn-spinner-sm"></span>
                                            <span>DELETING...</span>
                                        }
                                        else
                                        {
                                            <span>✕ DELETE</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    }

                    @* Add new slot *@
                    @if (_subscriptions.Count < 3)
                    {
                        @if (_showForm && _editingId == null)
                        {
                            @* New subscription form *@
                            <div class="sub-form-card">
                                <div class="sfc-header">
                                    <div class="sfc-title-row">
                                        <span class="sfc-prompt">$</span>
                                        <span class="sfc-title">subscription.new</span>
                                        <span class="sfc-cursor">_</span>
                                    </div>
                                </div>
                                <div class="sfc-body">
                                    @RenderSubscriptionForm(false)
                                </div>
                            </div>
                        }
                        else if (!_showForm)
                        {
                            <button class="add-slot-btn" @onclick="OpenNewForm">
                                <span class="asb-icon">+</span>
                                <div class="asb-text">
                                    <span class="asb-primary">CREATE NEW SUBSCRIPTION</span>
                                    <span class="asb-secondary">
                                        @(3 - _subscriptions.Count) slot@(3 - _subscriptions.Count == 1 ? "" : "s") remaining
                                    </span>
                                </div>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="slots-full">
                            <span class="sf-icon">◈</span>
                            <div class="sf-text">
                                <span class="sf-title">MAXIMUM SUBSCRIPTIONS REACHED</span>
                                <span class="sf-sub">Delete an existing subscription to create a new one.</span>
                            </div>
                        </div>
                    }

                </div>
            }

        </div>

        @* ── Right column — info + edit form ── *@
        <div class="sub-side">

            @* Edit form overlay *@
            @if (_editingId != null && _subscriptions != null)
            {
                var editSub = _subscriptions.FirstOrDefault(s => s.Id == _editingId);
                @if (editSub != null)
                {
                    <div class="edit-panel">
                        <div class="ep-header">
                            <div class="ep-title-row">
                                <span class="ep-prompt">$</span>
                                <span class="ep-title">subscription.edit</span>
                                <span class="ep-cursor">_</span>
                            </div>
                            <button class="ep-close" @onclick="CancelEdit">✕</button>
                        </div>
                        <div class="ep-body">
                            @RenderSubscriptionForm(true)
                        </div>
                    </div>
                }
            }
            else
            {
                @* How it works card *@
                <div class="info-card">
                    <div class="ic-header">
                        <span class="ic-icon">◈</span>
                        <span class="ic-title">HOW ALERTS WORK</span>
                    </div>
                    <div class="ic-body">
                        <div class="how-step">
                            <div class="hs-num">01</div>
                            <div class="hs-info">
                                <div class="hs-title">Define your filters</div>
                                <div class="hs-desc">Select attack types, cities, sectors, and minimum severity level.</div>
                            </div>
                        </div>
                        <div class="how-step">
                            <div class="hs-num">02</div>
                            <div class="hs-info">
                                <div class="hs-title">Stay connected</div>
                                <div class="hs-desc">Alerts are delivered in real-time via SignalR when matching events are approved.</div>
                            </div>
                        </div>
                        <div class="how-step">
                            <div class="hs-num">03</div>
                            <div class="hs-info">
                                <div class="hs-title">Review in notifications</div>
                                <div class="hs-desc">All matched alerts appear in your Notifications page with full event details.</div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Limits card *@
                <div class="info-card">
                    <div class="ic-header">
                        <span class="ic-icon">⚡</span>
                        <span class="ic-title">SUBSCRIPTION LIMITS</span>
                    </div>
                    <div class="ic-body">
                        <div class="limit-row">
                            <span class="lr-key">MAX SUBSCRIPTIONS</span>
                            <span class="lr-val">3 per account</span>
                        </div>
                        <div class="limit-row">
                            <span class="lr-key">DELIVERY METHOD</span>
                            <span class="lr-val">In-app + SignalR</span>
                        </div>
                        <div class="limit-row">
                            <span class="lr-key">EMPTY FILTER = </span>
                            <span class="lr-val green">Match all values</span>
                        </div>
                        <div class="limit-row">
                            <span class="lr-key">ALL FILTERS = AND</span>
                            <span class="lr-val">All must match</span>
                        </div>
                    </div>
                </div>

                @* Quick severity reference *@
                <div class="info-card">
                    <div class="ic-header">
                        <span class="ic-icon">🎯</span>
                        <span class="ic-title">SEVERITY REFERENCE</span>
                    </div>
                    <div class="ic-body sev-ref">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var level = i;
                            <div class="sev-ref-row">
                                <span class="sev-badge sev-@level">@level</span>
                                <span class="sev-ref-label">@GetSeverityLabel(level)</span>
                                <span class="sev-ref-desc">@GetSeverityDesc(level)</span>
                            </div>
                        }
                    </div>
                </div>
            }

        </div>
    </div>
</div>
</AuthGuard>

@* ── Subscription form (shared between new + edit) ── *@
@code {
    private RenderFragment RenderSubscriptionForm(bool isEdit) =>
        @<div class="form-fields">

            <div class="field-group">
                <label class="field-label">
                    <span class="fl-idx">01</span> SUBSCRIPTION NAME
                </label>
                <div class="input-wrapper @(_nameFocused ? "focused" : "")">
                    <span class="input-pre">◈</span>
                    <input type="text" class="field-input"
                           placeholder="e.g. Karachi Banking Alerts"
                           value="@_formName"
                           @oninput="e => _formName = e.Value?.ToString() ?? string.Empty"
                           @onfocus="() => _nameFocused = true"
                           @onblur="() => _nameFocused = false"
                           maxlength="60" />
                </div>
            </div>

            <div class="field-group">
                <label class="field-label">
                    <span class="fl-idx">02</span> ATTACK TYPES
                    <span class="fl-hint">empty = all types</span>
                </label>
                <div class="chip-grid">
                    @foreach (var t in _attackTypes)
                    {
                        var type = t;
                        var selected = _formAttackTypes.Contains(type);
                        <button type="button"
                                class="chip-select @(selected ? $"chip-selected chip-{type.ToLower().Replace(" ","")}" : "")"
                                @onclick="() => ToggleItem(_formAttackTypes, type)">
                            @GetAttackIcon(type) @type
                        </button>
                    }
                </div>
            </div>

            <div class="field-group">
                <label class="field-label">
                    <span class="fl-idx">03</span> CITIES
                    <span class="fl-hint">empty = all cities</span>
                </label>
                <div class="chip-grid chip-grid-cities">
                    @foreach (var c in _cities)
                    {
                        var city = c;
                        var selected = _formCities.Contains(city);
                        <button type="button"
                                class="chip-select @(selected ? "chip-selected chip-city" : "")"
                                @onclick="() => ToggleItem(_formCities, city)">
                            @city
                        </button>
                    }
                </div>
            </div>

            <div class="field-group">
                <label class="field-label">
                    <span class="fl-idx">04</span> SECTORS
                    <span class="fl-hint">empty = all sectors</span>
                </label>
                <div class="chip-grid">
                    @foreach (var s in _sectors)
                    {
                        var sector = s;
                        var selected = _formSectors.Contains(sector);
                        <button type="button"
                                class="chip-select @(selected ? "chip-selected chip-sector" : "")"
                                @onclick="() => ToggleItem(_formSectors, sector)">
                            @sector
                        </button>
                    }
                </div>
            </div>

            <div class="field-group">
                <label class="field-label">
                    <span class="fl-idx">05</span> MINIMUM SEVERITY
                </label>
                <div class="sev-select-row">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var level = i;
                        <button type="button"
                                class="sev-btn @(_formMinSeverity == level ? $"sev-active sev-active-{level}" : "")"
                                @onclick="() => _formMinSeverity = level">
                            <span class="sev-num">@level</span>
                            <span class="sev-lbl">@GetSeverityLabel(level)</span>
                        </button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="form-error">⚠ @_formError</div>
            }

            <div class="form-actions">
                <button class="btn-cancel-form"
                        @onclick="@(isEdit ? (Action)CancelEdit : (Action)CancelNewForm)">
                    CANCEL
                </button>
                <button class="btn-save @(_formLoading ? "loading" : "")"
                        @onclick="@(isEdit ? SaveEdit : SaveNew)"
                        disabled="@(_formLoading || string.IsNullOrWhiteSpace(_formName))">
                    @if (_formLoading)
                    {
                        <span class="btn-spinner-sm"></span>
                        <span>SAVING...</span>
                    }
                    else
                    {
                        <span>@(isEdit ? "SAVE CHANGES →" : "CREATE SUBSCRIPTION →")</span>
                    }
                </button>
            </div>

        </div>;
}

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .sub-root {
        min-height: 100vh; background: #0d1117;
        font-family: 'Inter', sans-serif;
        padding: 76px 32px 64px; position: relative; overflow-x: hidden;
    }

    .bg-grid {
        position: fixed; inset: 0;
        background-image:
            linear-gradient(rgba(159,239,0,0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(159,239,0,0.025) 1px, transparent 1px);
        background-size: 40px 40px; pointer-events: none; z-index: 0;
    }

    .scan-line {
        position: fixed; top: -2px; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, #9fef00, transparent);
        animation: scan 8s linear infinite; opacity: 0.3;
        z-index: 1; pointer-events: none;
    }

    .corner { position: fixed; width: 18px; height: 18px; z-index: 2; pointer-events: none; }
    .corner-tl { top: 14px; left: 14px; border-top: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-tr { top: 14px; right: 14px; border-top: 2px solid #9fef00; border-right: 2px solid #9fef00; }
    .corner-bl { bottom: 14px; left: 14px; border-bottom: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-br { bottom: 14px; right: 14px; border-bottom: 2px solid #9fef00; border-right: 2px solid #9fef00; }

    /* ── Layout ── */
    .sub-layout {
        max-width: 1200px; margin: 0 auto;
        display: grid; grid-template-columns: 1fr 320px; gap: 24px;
        position: relative; z-index: 3;
        animation: fadeInUp 0.5s ease both;
    }

    @@keyframes fadeInUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes scan     { 0% { top: -2px; } 100% { top: 100vh; } }
    @@keyframes spin     { to { transform: rotate(360deg); } }
    @@keyframes blink    { 0%,100% { opacity: 1; } 50% { opacity: 0.2; } }
    @@keyframes slideUp  { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    /* ── Header ── */
    .page-header {
        display: flex; align-items: flex-start; justify-content: space-between;
        margin-bottom: 24px; flex-wrap: wrap; gap: 16px;
    }

    .ph-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #9fef00; letter-spacing: 2px; opacity: 0.7; margin-bottom: 8px;
    }

    .ph-title {
        font-size: 38px; font-weight: 700; color: #e6edf3;
        line-height: 1.1; letter-spacing: -0.5px; margin-bottom: 8px;
    }

    .ph-accent { color: #9fef00; }
    .ph-sub { font-size: 13px; color: #6e7681; line-height: 1.6; max-width: 480px; }

    /* Slot counter */
    .slot-counter {
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        padding: 16px 20px; background: #161b22;
        border: 1px solid #21262d; border-radius: 8px; min-width: 130px;
    }

    .sc-dots { display: flex; gap: 8px; }

    .sc-dot {
        width: 12px; height: 12px; border-radius: 50%;
        transition: background 0.3s, box-shadow 0.3s;
    }
    .dot-used {
        background: #9fef00;
        box-shadow: 0 0 8px rgba(159,239,0,0.5);
    }
    .dot-free {
        background: #21262d;
        border: 1px solid #30363d;
    }

    .sc-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        display: flex; align-items: baseline; gap: 3px;
    }

    .sc-used  { color: #9fef00; font-size: 16px; font-weight: 700; }
    .sc-sep   { color: #4a5160; }
    .sc-total { color: #6e7681; }
    .sc-text  { color: #4a5160; font-size: 9px; letter-spacing: 1px; margin-left: 4px; }

    /* ── Toast ── */
    .toast {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 6px;
        font-family: 'IBM Plex Mono', monospace; font-size: 12px;
        border: 1px solid; margin-bottom: 20px;
        transition: opacity 0.4s, transform 0.4s;
    }
    .toast-success { background: rgba(159,239,0,0.07); border-color: rgba(159,239,0,0.3); color: #9fef00; }
    .toast-error   { background: rgba(255,62,62,0.07); border-color: rgba(255,62,62,0.3); color: #ff3e3e; }
    .toast-show { opacity: 1; transform: translateY(0); }
    .toast-hide { opacity: 0; transform: translateY(-6px); pointer-events: none; }
    .toast-icon { font-size: 14px; flex-shrink: 0; }

    /* ── Subscriptions list ── */
    .subs-list { display: flex; flex-direction: column; gap: 12px; }

    /* ── Subscription card ── */
    .sub-card {
        background: #161b22; border: 1px solid #21262d;
        border-radius: 8px; overflow: hidden;
        transition: border-color 0.2s;
    }
    .sub-card:hover { border-color: #30363d; }
    .sub-inactive { opacity: 0.7; }
    .sub-editing { border-color: rgba(159,239,0,0.3); }

    .sc-top {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 18px; border-bottom: 1px solid #21262d;
        background: #0d1117; gap: 12px; flex-wrap: wrap;
    }

    .sc-name-row { display: flex; align-items: center; gap: 12px; }

    .sc-icon-wrap {
        width: 36px; height: 36px; border-radius: 8px;
        background: rgba(159,239,0,0.08); border: 1px solid rgba(159,239,0,0.2);
        display: flex; align-items: center; justify-content: center;
        font-size: 16px; flex-shrink: 0;
    }

    .sc-name-info { display: flex; flex-direction: column; gap: 2px; }

    .sc-name { font-size: 15px; font-weight: 600; color: #e6edf3; }

    .sc-created {
