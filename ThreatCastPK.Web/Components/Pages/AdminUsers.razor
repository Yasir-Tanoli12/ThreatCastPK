    .date-val {
        font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #6e7681;
    }

    /* Actions */
    .td-actions { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    .action-btn {
        padding: 5px 10px; background: transparent; border-radius: 3px;
        font-family: 'IBM Plex Mono', monospace; font-size: 9px; font-weight: 600;
        cursor: pointer; letter-spacing: 1px; display: flex; align-items: center;
        gap: 5px; transition: background 0.15s, border-color 0.15s;
        white-space: nowrap;
    }
    .action-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    .btn-grant    { border: 1px solid rgba(159,239,0,0.3); color: #9fef00; }
    .btn-grant:hover:not(:disabled)    { background: rgba(159,239,0,0.08); border-color: #9fef00; }

    .btn-revoke   { border: 1px solid rgba(255,165,0,0.3); color: #ffa500; }
    .btn-revoke:hover:not(:disabled)   { background: rgba(255,165,0,0.08); border-color: #ffa500; }

    .btn-suspend  { border: 1px solid rgba(255,62,62,0.3); color: #ff3e3e; }
    .btn-suspend:hover:not(:disabled)  { background: rgba(255,62,62,0.08); border-color: #ff3e3e; }

    .btn-unsuspend { border: 1px solid rgba(0,200,255,0.3); color: #00c8ff; }
    .btn-unsuspend:hover:not(:disabled) { background: rgba(0,200,255,0.08); border-color: #00c8ff; }

    .self-note {
        font-family: 'IBM Plex Mono', monospace; font-size: 9px;
        color: #4a5160; font-style: italic;
    }

    /* Confirm row */
    .confirm-row {
        background: rgba(255,62,62,0.04);
        border-bottom: 1px solid rgba(255,62,62,0.15);
        animation: slideUp 0.2s ease both;
    }

    .confirm-content {
        display: flex; align-items: center; gap: 14px;
        padding: 12px 20px; flex-wrap: wrap;
    }

    .confirm-icon { font-size: 16px; flex-shrink: 0; }

    .confirm-text { font-size: 13px; color: #c9d1d9; flex: 1; }
    .confirm-text strong { color: #ff3e3e; }

    .confirm-actions { display: flex; gap: 8px; flex-shrink: 0; }

    .confirm-cancel {
        padding: 7px 14px; background: transparent;
        border: 1px solid #21262d; border-radius: 3px; cursor: pointer;
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #6e7681; letter-spacing: 1px;
        transition: border-color 0.15s, color 0.15s;
    }
    .confirm-cancel:hover { border-color: #6e7681; color: #c9d1d9; }

    .confirm-proceed {
        padding: 7px 14px; background: rgba(255,62,62,0.1);
        border: 1px solid rgba(255,62,62,0.4); border-radius: 3px; cursor: pointer;
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        font-weight: 700; color: #ff3e3e; letter-spacing: 1px;
        display: flex; align-items: center; gap: 6px;
        transition: background 0.15s;
    }
    .confirm-proceed:hover:not(:disabled) { background: rgba(255,62,62,0.18); }
    .confirm-proceed:disabled { opacity: 0.5; cursor: not-allowed; }
    .confirm-proceed.loading { background: #21262d; color: #6e7681; border-color: #21262d; }

    /* Result count */
    .result-count {
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        color: #4a5160; text-align: right; padding: 4px 0;
    }
    .rc-num { color: #9fef00; }

    /* ── State box ── */
    .state-box {
        display: flex; flex-direction: column; align-items: center;
        padding: 60px 40px; background: #161b22;
        border: 1px solid #21262d; border-radius: 8px;
        text-align: center; gap: 10px;
    }

    .sb-icon { font-size: 36px; opacity: 0.4; }
    .sb-title { font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #6e7681; letter-spacing: 2px; }
    .sb-sub   { font-size: 13px; color: #4a5160; }

    .sb-btn {
        padding: 8px 18px; background: transparent;
        border: 1px solid #21262d; border-radius: 4px; cursor: pointer;
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        color: #6e7681; letter-spacing: 1px; margin-top: 4px;
        transition: border-color 0.15s, color 0.15s;
    }
    .sb-btn:hover { border-color: #9fef00; color: #9fef00; }

    /* ── Skeleton ── */
    .skeleton-row {
        display: grid;
        grid-template-columns: 240px 130px 120px 120px 110px 1fr;
        gap: 0; padding: 14px 20px;
        border-bottom: 1px solid #21262d;
        align-items: center;
        animation: shimmer 1.5s ease-in-out infinite;
    }

    .sk-user { display: flex; align-items: center; gap: 12px; }
    .sk-avatar { width: 34px; height: 34px; border-radius: 6px; background: #21262d; flex-shrink: 0; }
    .sk-name-block { display: flex; flex-direction: column; gap: 5px; }
    .sk-line { background: #21262d; border-radius: 2px; }
    .sk-name    { height: 12px; width: 100px; }
    .sk-email   { height: 9px; width: 140px; }
    .sk-role    { height: 20px; width: 80px; border-radius: 3px; }
    .sk-rep     { height: 12px; width: 40px; }
    .sk-status  { height: 18px; width: 80px; border-radius: 3px; }
    .sk-date    { height: 11px; width: 80px; }
    .sk-actions { height: 22px; width: 120px; border-radius: 3px; }

    /* ── Toast ── */
    .toast-fixed {
        position: fixed; bottom: 24px; right: 24px;
        display: flex; align-items: center; gap: 10px;
        padding: 12px 18px; border-radius: 6px;
        font-family: 'IBM Plex Mono', monospace; font-size: 12px;
        border: 1px solid; z-index: 500;
        transition: opacity 0.4s, transform 0.4s;
    }
    .toast-success { background: rgba(159,239,0,0.1); border-color: rgba(159,239,0,0.3); color: #9fef00; }
    .toast-error   { background: rgba(255,62,62,0.1); border-color: rgba(255,62,62,0.3); color: #ff3e3e; }
    .toast-show { opacity: 1; transform: translateY(0); }
    .toast-hide { opacity: 0; transform: translateY(12px); pointer-events: none; }

    /* Shared */
    .btn-spinner-sm {
        width: 11px; height: 11px; border: 2px solid #4a5160;
        border-top-color: currentColor; border-radius: 50%;
        animation: spin 0.7s linear infinite;
    }

    /* ── Responsive ── */
    @@media (max-width: 1024px) {
        .users-table .table-header,
        .user-row,
        .skeleton-row {
            grid-template-columns: 200px 110px 90px 100px 1fr;
        }
        .th:nth-child(5), .td:nth-child(5), .sk-date { display: none; }
    }

    @@media (max-width: 768px) {
        .admin-inner { padding: 20px 16px 0; }
        .admin-subnav { padding: 0 16px; overflow-x: auto; }
        .stats-strip { gap: 12px; }
        .ss-div { display: none; }
        .filter-bar { flex-direction: column; align-items: stretch; }
        .search-box { min-width: unset; }
    }
</style>

@code {
    private List<UserAdminResponse>? _users;
    private bool _loading = true;
    private string? _loadError;
    private string _activeTab = "all";
    private string _searchQuery = string.Empty;
    private bool _searchFocused = false;

    private Guid? _actioningUserId;
    private string _pendingAction = string.Empty;
    private Guid? _suspendConfirmId;

    private string _toastMessage = string.Empty;
    private string _toastType = "toast-success";
    private bool _toastVisible = false;

    private record TabItem(string Key, string Label);

    private readonly TabItem[] _tabs =
    {
        new("all",        "ALL"),
        new("admin",      "ADMIN"),
        new("reporter",   "REPORTER"),
        new("registered", "REGISTERED"),
        new("pending",    "PENDING"),
        new("suspended",  "SUSPENDED"),
    };

    private List<UserAdminResponse> FilteredUsers
    {
        get
        {
            if (_users == null) return new();

            var list = _activeTab switch
            {
                "admin"      => _users.Where(u => u.Role == "Admin").ToList(),
                "reporter"   => _users.Where(u => u.Role == "Reporter").ToList(),
                "registered" => _users.Where(u => u.Role == "Registered").ToList(),
                "pending"    => _users.Where(u => u.ReporterRequestPending).ToList(),
                "suspended"  => _users.Where(u => u.IsSuspended).ToList(),
                _            => _users.ToList()
            };

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.ToLower();
                list = list.Where(u =>
                    u.Username.ToLower().Contains(q) ||
                    u.Email.ToLower().Contains(q)
                ).ToList();
            }

            return list.OrderBy(u => u.Username).ToList();
        }
    }

    private int GetTabCount(string key) => key switch
    {
        "admin"      => _users?.Count(u => u.Role == "Admin") ?? 0,
        "reporter"   => _users?.Count(u => u.Role == "Reporter") ?? 0,
        "registered" => _users?.Count(u => u.Role == "Registered") ?? 0,
        "pending"    => _users?.Count(u => u.ReporterRequestPending) ?? 0,
        "suspended"  => _users?.Count(u => u.IsSuspended) ?? 0,
        _            => _users?.Count ?? 0
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUsers();
            StateHasChanged();
        }
    }

    private async Task LoadUsers()
    {
        _loading = true; _loadError = null;
        StateHasChanged();

        var (data, error) = await ApiService.GetAllUsersAsync();
        _loading = false;

        if (error != null) _loadError = error;
        else _users = data ?? new();

        StateHasChanged();
    }

    private async Task GrantReporter(Guid id)
    {
        _actioningUserId = id; _pendingAction = "grant";
        StateHasChanged();

        var error = await ApiService.GrantReporterAsync(id);
        _actioningUserId = null; _pendingAction = string.Empty;

        if (error != null)
            await ShowToast(error, "toast-error");
        else
        {
            var user = _users?.FirstOrDefault(u => u.Id == id);
            if (user != null)
            {
                user.Role = "Reporter";
                user.ReporterRequestPending = false;
            }
            await ShowToast("Reporter access granted.", "toast-success");
        }
        StateHasChanged();
    }

    private async Task RevokeReporter(Guid id)
    {
        _actioningUserId = id; _pendingAction = "revoke";
        StateHasChanged();

        var error = await ApiService.RevokeReporterAsync(id);
        _actioningUserId = null; _pendingAction = string.Empty;

        if (error != null)
            await ShowToast(error, "toast-error");
        else
        {
            var user = _users?.FirstOrDefault(u => u.Id == id);
            if (user != null) user.Role = "Registered";
            await ShowToast("Reporter access revoked.", "toast-success");
        }
        StateHasChanged();
    }

    private void StartSuspend(Guid id)
    {
        _suspendConfirmId = id;
    }

    private void CancelSuspend()
    {
        _suspendConfirmId = null;
    }

    private async Task ConfirmSuspend(Guid id)
    {
        _actioningUserId = id; _pendingAction = "suspend";
        StateHasChanged();

        var error = await ApiService.SuspendUserAsync(id);
        _actioningUserId = null; _pendingAction = string.Empty;
        _suspendConfirmId = null;

        if (error != null)
            await ShowToast(error, "toast-error");
        else
        {
            var user = _users?.FirstOrDefault(u => u.Id == id);
            if (user != null) user.IsSuspended = true;
            await ShowToast("User suspended.", "toast-success");
        }
        StateHasChanged();
    }

    private async Task UnsuspendUser(Guid id)
    {
        _actioningUserId = id; _pendingAction = "unsuspend";
        StateHasChanged();

        var error = await ApiService.UnsuspendUserAsync(id);
        _actioningUserId = null; _pendingAction = string.Empty;

        if (error != null)
            await ShowToast(error, "toast-error");
        else
        {
            var user = _users?.FirstOrDefault(u => u.Id == id);
            if (user != null) user.IsSuspended = false;
            await ShowToast("User restored.", "toast-success");
        }
        StateHasChanged();
    }

    private async Task ShowToast(string message, string type)
    {
        _toastMessage = message; _toastType = type; _toastVisible = true;
        StateHasChanged();
        await Task.Delay(3000);
        _toastVisible = false; StateHasChanged();
        await Task.Delay(400);
        _toastMessage = string.Empty; StateHasChanged();
    }

    private static string GetAvatarColor(string username)
    {
        var colors = new[] { "#1a472a","#1e3a5f","#4a1942","#2d2b55","#3d2b1f","#1a3a3a","#2b3a1a","#3a1a2b" };
        return colors[Math.Abs(username.GetHashCode()) % colors.Length];
    }

    private static string GetRoleIcon(string role) => role switch
    {
        "Admin"      => "⚡",
        "Reporter"   => "📡",
        "Registered" => "◈",
        _            => "👁"
    };

    private static string GetRepColor(int rep) =>
        rep >= 75 ? "rep-green" : rep >= 30 ? "rep-yellow" : "rep-grey";
}
