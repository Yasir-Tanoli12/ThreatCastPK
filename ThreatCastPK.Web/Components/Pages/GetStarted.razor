@* ThreatCastPK.Web/Components/Pages/GetStarted.razor *@
@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Get Started — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="gs-root">

    @* Animated grid background *@
    <div class="bg-grid"></div>

    @* Floating scan line *@
    <div class="scan-line"></div>

    @* Corner decorations *@
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>


    @* ── Hero section ── *@
    <section class="hero-section">

        <div class="hero-left">

            @* Eyebrow *@
            <div class="hero-eyebrow">
                <span class="ey-dot"></span>
                <span class="ey-text"> PAKISTAN CYBER THREAT INTELLIGENCE</span>
            </div>

            @* Headline *@
            <h1 class="hero-headline">
                See Every Attack.<br />
                <span class="headline-accent">Before It Spreads.</span>
            </h1>

            <p class="hero-body">
                ThreatCast PK is Pakistan's first live, crowdsourced cyberattack intelligence
                platform — aggregating community reports, AbuseIPDB feeds, and official
                advisories onto a single animated map. Open to anyone. No clearance required.
            </p>

            @* Stat row *@
            <div class="hero-stats">
                <div class="hs-item">
                    <span class="hs-val">500K<span class="hs-unit">+</span></span>
                    <span class="hs-label">Attacks/year on Pakistan</span>
                </div>
                <div class="hs-div"></div>
                <div class="hs-item">
                    <span class="hs-val">35<span class="hs-unit">%</span></span>
                    <span class="hs-label">Cybercrime surge in 2025</span>
                </div>
                <div class="hs-div"></div>
                <div class="hs-item">
                    <span class="hs-val">0</span>
                    <span class="hs-label">Real-time platforms before this</span>
                </div>
            </div>

            @* CTA buttons *@
            <div class="hero-ctas">
                <a href="/live-map" class="cta-primary">
                    <span class="cta-icon">◈</span>
                    Open Live Map
                </a>
                <a href="/register" class="cta-secondary">
                    Become a Reporter →
                </a>
            </div>

        </div>

        @* ── Live preview card ── *@
        <div class="hero-right">
            <div class="preview-card">
                <div class="pc-header">
                    <div class="pc-dots">
                        <span class="pcd red"></span>
                        <span class="pcd yellow"></span>
                        <span class="pcd green"></span>
                    </div>
                    <span class="pc-title">threatcast.pk // live_map</span>
                    <div class="pc-live">
                        <span class="pc-live-dot"></span>
                        LIVE
                    </div>
                </div>

                @* Mini map mockup *@
                <div class="map-preview">
                    <div class="mp-bg">
                        <svg viewBox="0 0 380 200" xmlns="http://www.w3.org/2000/svg" class="pk-outline">
                            <path d="M60,40 L80,30 L120,25 L160,20 L200,22 L240,18 L280,28 L310,45 L330,70
                                     L320,100 L300,120 L280,140 L260,155 L240,165 L220,170 L200,168
                                     L180,172 L160,175 L140,168 L120,160 L100,145 L80,130 L65,110
                                     L55,90 L50,65 Z"
                                  fill="none" stroke="rgba(159,239,0,0.15)" stroke-width="1.5"/>
                        </svg>

                        @* Attack blobs *@
                        <div class="blob blob-red"    style="top:38%; left:52%"></div>
                        <div class="blob blob-cyan"   style="top:55%; left:28%"></div>
                        <div class="blob blob-orange" style="top:30%; left:42%"></div>
                        <div class="blob blob-purple" style="top:48%; left:62%"></div>
                        <div class="blob blob-red sm" style="top:65%; left:45%"></div>
                        <div class="blob blob-cyan sm" style="top:25%; left:68%"></div>

                        @* City labels *@
                        <div class="city-pin" style="top:34%; left:49%">
                            <div class="cp-dot"></div>
                            <span class="cp-name">ISB</span>
                        </div>
                        <div class="city-pin" style="top:52%; left:25%">
                            <div class="cp-dot"></div>
                            <span class="cp-name">KHI</span>
                        </div>
                        <div class="city-pin" style="top:27%; left:40%">
                            <div class="cp-dot"></div>
                            <span class="cp-name">LHR</span>
                        </div>
                    </div>
                </div>

                @* Mini live feed *@
                <div class="pc-feed">
                    <div class="pf-header">
                        <span class="pf-dot"></span>
                        <span class="pf-label">THREAT PULSE</span>
                    </div>
                    <div class="pf-item @(_tick % 3 == 0 ? "pf-highlight" : "")">
                        <span class="pft ransom">RANSOMWARE</span>
                        <span class="pfc">Karachi</span>
                        <span class="pfs">Banking</span>
                        <span class="pfv">SEV 4</span>
                    </div>
                    <div class="pf-item @(_tick % 3 == 1 ? "pf-highlight" : "")">
                        <span class="pft ddos">DDoS</span>
                        <span class="pfc">Islamabad</span>
                        <span class="pfs">Government</span>
                        <span class="pfv">SEV 5</span>
                    </div>
                    <div class="pf-item @(_tick % 3 == 2 ? "pf-highlight" : "")">
                        <span class="pft phish">PHISHING</span>
                        <span class="pfc">Lahore</span>
                        <span class="pfs">Education</span>
                        <span class="pfv">SEV 3</span>
                    </div>
                </div>
            </div>

            @* Floating badges *@
            <div class="badge badge-tl">
                <span class="badge-icon">🛡</span>
                <div class="badge-text">
                    <div class="badge-val">AbuseIPDB</div>
                    <div class="badge-sub">Verified Intel</div>
                </div>
            </div>
            <div class="badge badge-br">
                <span class="badge-icon">🤖</span>
                <div class="badge-text">
                    <div class="badge-val">ML Detection</div>
                    <div class="badge-sub">Isolation Forest</div>
                </div>
            </div>
        </div>

    </section>

    @* ── How it works ── *@
    <section class="how-section">
        <div class="how-label"> HOW IT WORKS</div>
        <div class="how-grid">

            <div class="how-card">
                <div class="how-num">01</div>
                <div class="how-icon">📡</div>
                <div class="how-title">Reports Come In</div>
                <div class="how-desc">
                    Verified reporters submit attack observations. Each report is checked
                    against AbuseIPDB and GreyNoise before it touches the map.
                </div>
            </div>

            <div class="how-arrow">→</div>

            <div class="how-card">
                <div class="how-num">02</div>
                <div class="how-icon">⚙</div>
                <div class="how-title">Intel Is Verified</div>
                <div class="how-desc">
                    High-reputation reporters get auto-approved. Others go to admin moderation.
                    API-sourced events are always tagged Verified.
                </div>
            </div>

            <div class="how-arrow">→</div>

            <div class="how-card">
                <div class="how-num">03</div>
                <div class="how-icon">🗺</div>
                <div class="how-title">Map Updates Live</div>
                <div class="how-desc">
                    Approved events hit the map within 2 seconds via SignalR. Every connected
                    viewer sees the same picture at the same time.
                </div>
            </div>

            <div class="how-arrow">→</div>

            <div class="how-card">
                <div class="how-num">04</div>
                <div class="how-icon">🔔</div>
                <div class="how-title">You Get Alerted</div>
                <div class="how-desc">
                    Set subscriptions by city, sector, or attack type. The moment something
                    matches, you're notified — no polling, no delay.
                </div>
            </div>

        </div>
    </section>

    @* ── Feature strip ── *@
    <section class="features-section">
        <div class="features-label"> PLATFORM CAPABILITIES</div>
        <div class="features-grid">

            <div class="feat-card">
                <div class="feat-header">
                    <span class="feat-tag verified">VERIFIED</span>
                    <span class="feat-icon">🌐</span>
                </div>
                <div class="feat-title">Live Threat Map</div>
                <div class="feat-desc">Animated markers across 12 Pakistani cities, color-coded by attack type, sized by severity. Updates in under 2 seconds.</div>
            </div>

            <div class="feat-card">
                <div class="feat-header">
                    <span class="feat-tag ml">ML</span>
                    <span class="feat-icon">🧠</span>
                </div>
                <div class="feat-title">Campaign Detection</div>
                <div class="feat-desc">Isolation Forest algorithm flags coordinated attacks the moment 10+ events share an IP range within 6 hours.</div>
            </div>

            <div class="feat-card">
                <div class="feat-header">
                    <span class="feat-tag api">API</span>
                    <span class="feat-icon">🔍</span>
                </div>
                <div class="feat-title">IP Intelligence</div>
                <div class="feat-desc">Every reported source IP is cross-referenced against AbuseIPDB and GreyNoise. Background scanners are labeled, targeted attackers are flagged.</div>
            </div>

            <div class="feat-card">
                <div class="feat-header">
                    <span class="feat-tag community">COMMUNITY</span>
                    <span class="feat-icon">📊</span>
                </div>
                <div class="feat-title">Sector Risk Scores</div>
                <div class="feat-desc">Banking, Telecom, Healthcare, Education, Government, Energy — each sector carries a live risk level recalculated every 30 minutes.</div>
            </div>

            <div class="feat-card">
                <div class="feat-header">
                    <span class="feat-tag open">OPEN</span>
                    <span class="feat-icon">💬</span>
                </div>
                <div class="feat-title">Discussion Forum</div>
                <div class="feat-desc">Readable by anyone, writable by registered users. Reporters carry a verified badge. Admins can pin and moderate.</div>
            </div>

            <div class="feat-card">
                <div class="feat-header">
                    <span class="feat-tag secure">SECURE</span>
                    <span class="feat-icon">🔐</span>
                </div>
                <div class="feat-title">Role-Based Access</div>
                <div class="feat-desc">Four tiers: Public, Registered, Reporter, Admin. Reporter status is admin-granted. Every action is logged in a tamper-evident audit trail.</div>
            </div>

        </div>
    </section>

    @* ── Role path ── *@
    <section class="roles-section">
        <div class="roles-label"> YOUR PATH ON THE PLATFORM</div>
        <div class="roles-track">

            <div class="rt-node active-node">
                <div class="rtn-icon">👁</div>
                <div class="rtn-title">Public Viewer</div>
                <div class="rtn-desc">Map, ticker, glossary, forum reads. No account needed.</div>
                <div class="rtn-badge open-badge">OPEN ACCESS</div>
            </div>

            <div class="rt-line">
                <div class="rt-line-fill"></div>
                <div class="rt-line-label">Register free →</div>
            </div>

            <div class="rt-node">
                <div class="rtn-icon">📋</div>
                <div class="rtn-title">Registered User</div>
                <div class="rtn-desc">Post in forum, set alert subscriptions, view threat advisories.</div>
                <div class="rtn-badge reg-badge">FREE ACCOUNT</div>
            </div>

            <div class="rt-line">
                <div class="rt-line-fill"></div>
                <div class="rt-line-label">Request access →</div>
            </div>

            <div class="rt-node">
                <div class="rtn-icon">📡</div>
                <div class="rtn-title">Reporter</div>
                <div class="rtn-desc">Submit attack reports. Earn reputation. Auto-approval at score 75+.</div>
                <div class="rtn-badge rep-badge">REPUTATION GATED</div>
            </div>

            <div class="rt-line">
                <div class="rt-line-fill"></div>
                <div class="rt-line-label">Invite only →</div>
            </div>

            <div class="rt-node">
                <div class="rtn-icon">⚡</div>
                <div class="rtn-title">Admin</div>
                <div class="rtn-desc">Moderate reports, manage users, inject verified events, publish advisories.</div>
                <div class="rtn-badge adm-badge">INVITE ONLY</div>
            </div>

        </div>
    </section>

    @* ── Final CTA ── *@
    <section class="final-cta">
        <div class="fc-inner">
            <div class="fc-label"> GET STARTED NOW</div>
            <h2 class="fc-heading">Pakistan's threat landscape<br />is live. Are you watching?</h2>
            <p class="fc-sub">No setup. No installation. Open a browser and see what's happening right now.</p>
            <div class="fc-actions">
                <a href="/live-map" class="fc-btn-primary">
                    <span>Open Live Map</span>
                    <span class="fc-arrow">→</span>
                </a>
                <a href="/register" class="fc-btn-secondary">Create Free Account</a>
            </div>
            <div class="fc-meta">
                <span>Zero cost deployment</span>
                <span class="fc-dot-sep">·</span>
                <span>BCrypt · JWT · TLS</span>
                <span class="fc-dot-sep">·</span>
                <span>AbuseIPDB · GreyNoise</span>
            </div>
        </div>
    </section>

    @* ── Footer strip ── *@
    <footer class="gs-footer">
        <div class="gf-brand">
            <span class="gf-hex">◈</span>
            <span class="gf-name">ThreatCast<span class="gf-pk">PK</span></span>
        </div>
        <div class="gf-links">
            <a href="/live-map" class="gf-link">Live Map</a>
            <a href="/about" class="gf-link">About</a>
            <a href="/glossary" class="gf-link">Glossary</a>
            <a href="/forum" class="gf-link">Forum</a>
            <a href="/login" class="gf-link">Sign In</a>
        </div>
        <div class="gf-copy">
            CS-284L · Air University Islamabad · Spring 2026
        </div>
    </footer>

</div>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .gs-root {
        min-height: 100vh;
        background: #0d1117;
        font-family: 'Inter', sans-serif;
        position: relative;
        overflow-x: hidden;
        color: #c9d1d9;
    }

    /* ── Background ── */
    .bg-grid {
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(159,239,0,0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(159,239,0,0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: 0;
    }

    .scan-line {
        position: fixed;
        top: -2px; left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #9fef00, transparent);
        animation: scan 6s linear infinite;
        opacity: 0.4;
        z-index: 1;
        pointer-events: none;
    }

    @@keyframes scan {
        0%   { top: -2px; }
        100% { top: 100vh; }
    }

    .corner {
        position: fixed;
        width: 20px; height: 20px;
        z-index: 2;
        pointer-events: none;
    }
    .corner-tl { top: 16px; left: 16px; border-top: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-tr { top: 16px; right: 16px; border-top: 2px solid #9fef00; border-right: 2px solid #9fef00; }
    .corner-bl { bottom: 16px; left: 16px; border-bottom: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-br { bottom: 16px; right: 16px; border-bottom: 2px solid #9fef00; border-right: 2px solid #9fef00; }

    /* ── Nav ── */
    .gs-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 48px;
        border-bottom: 1px solid #21262d;
        position: relative;
        z-index: 10;
        background: rgba(13,17,23,0.9);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
    }

    .nav-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 16px;
        font-weight: 600;
        color: #c9d1d9;
    }

    .nav-hex {
        color: #9fef00;
        font-size: 20px;
        filter: drop-shadow(0 0 8px rgba(159,239,0,0.5));
        animation: pulse-glow 3s ease-in-out infinite;
    }

    .nav-pk { color: #9fef00; }

    .nav-status {
        display: flex;
        align-items: center;
        gap: 7px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        color: #4a5160;
        letter-spacing: 2px;
    }

    .status-dot {
        width: 7px; height: 7px;
        border-radius: 50%;
        background: #9fef00;
        box-shadow: 0 0 6px rgba(159,239,0,0.6);
        animation: blink 1.5s ease-in-out infinite;
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .nav-login {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 12px;
        color: #6e7681;
        text-decoration: none;
        padding: 7px 14px;
        border: 1px solid #21262d;
        border-radius: 3px;
        transition: border-color 0.15s, color 0.15s;
    }
    .nav-login:hover { border-color: #6e7681; color: #c9d1d9; }

    .nav-register {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 12px;
        font-weight: 600;
        color: #0d1117;
        background: #9fef00;
        text-decoration: none;
        padding: 7px 16px;
        border-radius: 3px;
        letter-spacing: 0.5px;
        transition: opacity 0.15s, box-shadow 0.15s;
    }
    .nav-register:hover {
        opacity: 0.9;
        box-shadow: 0 3px 14px rgba(159,239,0,0.3);
    }

    /* ── Hero ── */
    .hero-section {
        display: flex;
        align-items: center;
        gap: 64px;
        padding: 80px 48px 72px;
        position: relative;
        z-index: 3;
        max-width: 1280px;
        margin: 0 auto;
    }

    .hero-left {
        flex: 1;
        max-width: 560px;
        animation: fadeInLeft 0.7s ease both;
    }

    @@keyframes fadeInLeft {
        from { opacity: 0; transform: translateX(-24px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    .hero-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 24px;
    }

    .ey-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: #9fef00;
        animation: blink 1.2s ease-in-out infinite;
        box-shadow: 0 0 6px rgba(159,239,0,0.6);
    }

    .ey-text {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        color: #9fef00;
        letter-spacing: 2px;
        opacity: 0.8;
    }

    .hero-headline {
        font-size: 52px;
        font-weight: 700;
        color: #e6edf3;
        line-height: 1.1;
        letter-spacing: -1px;
        margin-bottom: 20px;
    }

    .headline-accent { color: #9fef00; }

    .hero-body {
        font-size: 15px;
        color: #6e7681;
        line-height: 1.8;
        margin-bottom: 36px;
        max-width: 480px;
    }

    .hero-stats {
        display: flex;
        align-items: center;
        gap: 28px;
        padding: 20px 0;
        border-top: 1px solid #21262d;
        border-bottom: 1px solid #21262d;
        margin-bottom: 36px;
    }

    .hs-item { display: flex; flex-direction: column; gap: 3px; }

    .hs-val {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 26px;
        font-weight: 600;
        color: #9fef00;
        line-height: 1;
    }

    .hs-unit {
        font-size: 16px;
        color: #6e7681;
    }

    .hs-label {
        font-size: 11px;
        color: #4a5160;
        line-height: 1.4;
        max-width: 120px;
    }

    .hs-div {
        width: 1px; height: 36px;
        background: #21262d;
        flex-shrink: 0;
    }

    .hero-ctas {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .cta-primary {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 28px;
        background: #9fef00;
        border-radius: 4px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 13px;
        font-weight: 600;
        color: #0d1117;
        text-decoration: none;
        letter-spacing: 1px;
        transition: opacity 0.15s, transform 0.1s, box-shadow 0.15s;
    }
    .cta-primary:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(159,239,0,0.35);
    }

    .cta-icon { font-size: 16px; }

    .cta-secondary {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 12px;
        color: #9fef00;
        text-decoration: none;
        padding: 14px 20px;
        border: 1px solid rgba(159,239,0,0.3);
        border-radius: 4px;
        letter-spacing: 0.5px;
        transition: border-color 0.15s, background 0.15s;
    }
    .cta-secondary:hover {
        border-color: #9fef00;
        background: rgba(159,239,0,0.06);
    }

    /* ── Preview card ── */
    .hero-right {
        flex-shrink: 0;
        width: 440px;
        position: relative;
        animation: fadeInRight 0.7s ease 0.15s both;
    }

    @@keyframes fadeInRight {
        from { opacity: 0; transform: translateX(24px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    .preview-card {
        background: #161b22;
        border: 1px solid #21262d;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 24px 64px rgba(0,0,0,0.5);
    }

    .pc-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        background: #0d1117;
        border-bottom: 1px solid #21262d;
    }

    .pc-dots { display: flex; gap: 6px; }
    .pcd { width: 10px; height: 10px; border-radius: 50%; }
    .pcd.red    { background: #ff5f57; }
    .pcd.yellow { background: #febc2e; }
    .pcd.green  { background: #28c840; }

    .pc-title {
        flex: 1;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        color: #4a5160;
        letter-spacing: 1px;
        text-align: center;
    }

    .pc-live {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 9px;
        color: #9fef00;
        letter-spacing: 2px;
    }

    .pc-live-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: #9fef00;
        animation: blink 1.2s ease-in-out infinite;
    }

    .map-preview {
        height: 200px;
        position: relative;
        overflow: hidden;
