@code {
    private int _tick = 0;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        // Cycle the highlighted feed row every 2 seconds for the live preview effect
        _timer = new System.Threading.Timer(async _ =>
        {
            _tick = (_tick + 1) % 3;
            await InvokeAsync(StateHasChanged);
        }, null, 2000, 2000);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
