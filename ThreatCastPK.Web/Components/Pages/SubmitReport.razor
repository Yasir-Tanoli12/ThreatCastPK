    }

    .cri-value {
        font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 600;
    }
    .cri-value.green { color: #9fef00; }

    .criteria-and {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
