@* ThreatCastPK.Web/Components/Pages/SubmitReport.razor *@
@page "/submit-report"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Submit Report — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<AuthGuard RequiredRole="Reporter">
<div class="sr-root">
    <div class="bg-grid"></div>
    <div class="scan-line"></div>
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>

    <div class="sr-layout">

        @* ── Left — Form ── *@
        <div class="sr-left">

            @* Page heading *@
            <div class="page-heading">
                <div class="heading-label"> THREAT REPORTING TERMINAL</div>
                <h1 class="heading-title">
                    Submit Attack<br />
                    <span class="heading-accent">Report</span>
                </h1>
                <p class="heading-sub">
                    Document a cyber incident for community intelligence.
                    Reports are cross-verified against AbuseIPDB.
                </p>
            </div>

            @* Toast *@
            @if (!string.IsNullOrEmpty(_toastMessage))
            {
                <div class="toast @_toastType @(_toastVisible ? "toast-show" : "toast-hide")">
                    <span class="toast-icon">@(_toastType == "toast-success" ? "✓" : "⚠")</span>
                    <span>@_toastMessage</span>
                </div>
            }

            @* Form card *@
            <div class="form-card">

                <div class="form-card-header">
                    <span class="fch-prompt">$</span>
                    <span class="fch-title">report.new</span>
                    <span class="fch-cursor">_</span>
                    <div class="fch-right">
                        <span class="fch-badge">
                            <span class="fch-dot"></span>
                            REPORTER
                        </span>
                    </div>
                </div>

                <div class="form-body">

                    @* Row 1 — Attack type + Sector *@
                    <div class="form-row">
                        <div class="field-group">
                            <label class="field-label">
                                <span class="fl-idx">01</span>
                                ATTACK_TYPE
                            </label>
                            <div class="select-wrapper @(_attackTypeFocused ? "focused" : "") @(string.IsNullOrEmpty(_attackType) ? "" : "has-value")">
                                <select class="field-select"
                                        @bind="_attackType"
                                        @onfocus="() => _attackTypeFocused = true"
                                        @onblur="() => _attackTypeFocused = false"
                                        disabled="@_loading">
                                    <option value="">-- SELECT --</option>
                                    @foreach (var t in _attackTypes)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                                <span class="select-arrow">▾</span>
                            </div>
                            @if (!string.IsNullOrEmpty(_attackType))
                            {
                                <div class="attack-type-chip chip-@_attackType.ToLower().Replace(" ","")">
                                    @GetAttackIcon(_attackType) @_attackType
                                </div>
                            }
                        </div>

                        <div class="field-group">
                            <label class="field-label">
                                <span class="fl-idx">02</span>
                                TARGET_SECTOR
                            </label>
                            <div class="select-wrapper @(_sectorFocused ? "focused" : "") @(string.IsNullOrEmpty(_sector) ? "" : "has-value")">
                                <select class="field-select"
                                        @bind="_sector"
                                        @onfocus="() => _sectorFocused = true"
                                        @onblur="() => _sectorFocused = false"
                                        disabled="@_loading">
                                    <option value="">-- SELECT --</option>
                                    @foreach (var s in _sectors)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                                <span class="select-arrow">▾</span>
                            </div>
                        </div>
                    </div>

                    @* Row 2 — City + Severity *@
                    <div class="form-row">
                        <div class="field-group">
                            <label class="field-label">
                                <span class="fl-idx">03</span>
                                AFFECTED_CITY
                            </label>
                            <div class="select-wrapper @(_cityFocused ? "focused" : "") @(string.IsNullOrEmpty(_city) ? "" : "has-value")">
                                <select class="field-select"
                                        @bind="_city"
                                        @onfocus="() => _cityFocused = true"
                                        @onblur="() => _cityFocused = false"
                                        disabled="@_loading">
                                    <option value="">-- SELECT --</option>
                                    @foreach (var c in _cities)
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </select>
                                <span class="select-arrow">▾</span>
                            </div>
                        </div>

                        <div class="field-group">
                            <label class="field-label">
                                <span class="fl-idx">04</span>
                                SEVERITY_LEVEL
                            </label>
                            <div class="severity-row">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    var level = i;
                                    <button type="button"
                                            class="sev-btn @(_severity == level ? "sev-active" : "") sev-@level"
                                            @onclick="() => _severity = level"
                                            disabled="@_loading">
                                        <span class="sev-num">@level</span>
                                        <span class="sev-label">@GetSeverityLabel(level)</span>
                                    </button>
                                }
                            </div>
                            @if (_severity > 0)
                            {
                                <div class="sev-indicator sev-color-@_severity">
                                    @GetSeverityLabel(_severity) — @GetSeverityDesc(_severity)
                                </div>
                            }
                        </div>
                    </div>

                    @* Source IP *@
                    <div class="field-group">
                        <label class="field-label">
                            <span class="fl-idx">05</span>
                            SOURCE_IP
                            <span class="fl-optional">OPTIONAL</span>
                        </label>
                        <div class="input-wrapper @(_ipFocused ? "focused" : "") @(GetIpState())">
                            <span class="input-pre mono">&gt;_</span>
                            <input type="text"
                                   class="field-input mono"
                                   placeholder="e.g. 192.168.1.1"
                                   value="@_sourceIP"
                                   @oninput="OnIpInput"
                                   @onfocus="() => _ipFocused = true"
                                   @onblur="() => _ipFocused = false"
                                   disabled="@_loading" />
                            @if (!string.IsNullOrEmpty(_sourceIP))
                            {
                                <span class="ip-status @(IsValidIP(_sourceIP) ? "valid" : "invalid")">
                                    @(IsValidIP(_sourceIP) ? "✓" : "✗")
                                </span>
                            }
                        </div>
                        <span class="field-hint">
                            Providing a source IP triggers AbuseIPDB reputation check and may enable auto-approval
                        </span>
                    </div>

                    @* Description *@
                    <div class="field-group">
                        <label class="field-label">
                            <span class="fl-idx">06</span>
                            INCIDENT_DESCRIPTION
                            <span class="fl-optional">OPTIONAL</span>
                        </label>
                        <div class="textarea-wrapper @(_descFocused ? "focused" : "")">
                            <textarea class="field-textarea"
                                      placeholder="Describe what you observed — attack vectors, affected systems, timeline, IOCs..."
                                      rows="4"
                                      @bind="_description"
                                      @bind:event="oninput"
                                      @onfocus="() => _descFocused = true"
                                      @onblur="() => _descFocused = false"
                                      disabled="@_loading">
                            </textarea>
                            <div class="textarea-footer">
                                <span class="char-count @(_description.Length > 900 ? "count-warn" : "")">
                                    @_description.Length / 1000
                                </span>
                            </div>
                        </div>
                    </div>

                    @* Pre-submit checklist *@
                    <div class="checklist">
                        <div class="cl-item @(IsAttackValid() ? "cl-done" : "")">
                            <span class="cl-icon">@(IsAttackValid() ? "✓" : "○")</span>
                            Attack type selected
                        </div>
                        <div class="cl-item @(!string.IsNullOrEmpty(_sector) ? "cl-done" : "")">
                            <span class="cl-icon">@(!string.IsNullOrEmpty(_sector) ? "✓" : "○")</span>
                            Target sector selected
                        </div>
                        <div class="cl-item @(!string.IsNullOrEmpty(_city) ? "cl-done" : "")">
                            <span class="cl-icon">@(!string.IsNullOrEmpty(_city) ? "✓" : "○")</span>
                            Affected city selected
                        </div>
                        <div class="cl-item @(_severity > 0 ? "cl-done" : "")">
                            <span class="cl-icon">@(_severity > 0 ? "✓" : "○")</span>
                            Severity level set
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="error-box">
                            <span class="eb-icon">⚠</span>
                            <span>@_errorMessage</span>
                        </div>
                    }

                    <button class="@SubmitBtnClass()"
                            @onclick="HandleSubmit"
                            disabled="@_loading">
                        @if (_loading)
                        {
                            <span class="btn-spinner"></span>
                            <span>TRANSMITTING REPORT...</span>
                        }
                        else
                        {
                            <span class="submit-icon">📡</span>
                            <span>TRANSMIT REPORT</span>
                        }
                    </button>

                    <div class="form-footnote">
                        <a href="/my-reports" class="footnote-link">
                            View my submitted reports →
                        </a>
                    </div>

                </div>
            </div>
        </div>

        @* ── Right — Info panel ── *@
        <div class="sr-right">

            @* Auto-approval info *@
            <div class="info-card">
                <div class="ic-header">
                    <span class="ic-icon">⚡</span>
                    <span class="ic-title">AUTO-APPROVAL ENGINE</span>
                </div>
                <div class="ic-body">
                    <p class="ic-text">
                        Reports meeting both criteria are instantly approved
                        and pushed live to the threat map.
                    </p>
                    <div class="criteria-list">
                        <div class="criteria-item">
                            <div class="cri-bar @(AuthService.IsLoggedIn ? "cri-check" : "")">
                                <span class="cri-label">REPUTATION SCORE</span>
                                <span class="cri-value green">≥ 75</span>
                            </div>
                        </div>
                        <div class="criteria-and">AND</div>
                        <div class="criteria-item">
                            <div class="cri-bar">
                                <span class="cri-label">ABUSEIPDB CONFIDENCE</span>
                                <span class="cri-value green">≥ 80%</span>
                            </div>
                        </div>
                    </div>
                    <div class="ic-note">
                        Reports not meeting criteria go to the admin moderation queue.
                    </div>
                </div>
            </div>

            @* Attack type reference *@
            <div class="info-card">
                <div class="ic-header">
                    <span class="ic-icon">◈</span>
                    <span class="ic-title">ATTACK TYPE REFERENCE</span>
                </div>
                <div class="ic-body ref-list">
                    @foreach (var item in _attackTypeInfo)
                    {
                        <div class="ref-row @(_attackType == item.Name ? "ref-active" : "")">
                            <span class="ref-icon">@item.Icon</span>
                            <div class="ref-info">
                                <span class="ref-name">@item.Name</span>
                                <span class="ref-desc">@item.Desc</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Rate limit info *@
            <div class="info-card info-card-dim">
                <div class="ic-header">
                    <span class="ic-icon">⏱</span>
                    <span class="ic-title">SUBMISSION LIMITS</span>
                </div>
                <div class="ic-body">
                    <div class="limit-row">
                        <span class="limit-label">MAX PER HOUR</span>
                        <span class="limit-value">10 reports</span>
                    </div>
                    <div class="limit-row">
                        <span class="limit-label">DUPLICATE WINDOW</span>
                        <span class="limit-value">24 hours</span>
                    </div>
                    <div class="limit-row">
                        <span class="limit-label">FALSE REPORT PENALTY</span>
                        <span class="limit-value red">-5 reputation</span>
                    </div>
                    <div class="limit-row">
                        <span class="limit-label">APPROVED REPORT REWARD</span>
                        <span class="limit-value green">+10 reputation</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
</AuthGuard>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .sr-root {
        min-height: 100vh;
        background: #0d1117;
        font-family: 'Inter', sans-serif;
        padding: 76px 32px 48px;
        position: relative;
        overflow-x: hidden;
    }

    .bg-grid {
        position: fixed; inset: 0;
        background-image:
            linear-gradient(rgba(159,239,0,0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(159,239,0,0.025) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none; z-index: 0;
    }

    .scan-line {
        position: fixed; top: -2px; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, #9fef00, transparent);
        animation: scan 8s linear infinite; opacity: 0.3;
        z-index: 1; pointer-events: none;
    }

    @@keyframes scan { 0% { top: -2px; } 100% { top: 100vh; } }

    .corner { position: fixed; width: 18px; height: 18px; z-index: 2; pointer-events: none; }
    .corner-tl { top: 14px; left: 14px; border-top: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-tr { top: 14px; right: 14px; border-top: 2px solid #9fef00; border-right: 2px solid #9fef00; }
    .corner-bl { bottom: 14px; left: 14px; border-bottom: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-br { bottom: 14px; right: 14px; border-bottom: 2px solid #9fef00; border-right: 2px solid #9fef00; }

    /* ── Layout ── */
    .sr-layout {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 24px;
        position: relative; z-index: 3;
        animation: fadeInUp 0.5s ease both;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Page heading ── */
    .page-heading { margin-bottom: 28px; }

    .heading-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        color: #9fef00;
        letter-spacing: 2px;
        opacity: 0.7;
        margin-bottom: 12px;
    }

    .heading-title {
        font-size: 40px;
        font-weight: 700;
        color: #e6edf3;
        line-height: 1.1;
        letter-spacing: -1px;
        margin-bottom: 12px;
    }

    .heading-accent { color: #9fef00; }

    .heading-sub {
        font-size: 14px;
        color: #6e7681;
        line-height: 1.6;
        max-width: 500px;
    }

    /* ── Toast ── */
    .toast {
        display: flex; align-items: center; gap: 10px;
        padding: 13px 18px; border-radius: 6px;
        font-family: 'IBM Plex Mono', monospace; font-size: 12px;
        border: 1px solid; margin-bottom: 20px;
        transition: opacity 0.4s, transform 0.4s;
    }
    .toast-success { background: rgba(159,239,0,0.08); border-color: rgba(159,239,0,0.3); color: #9fef00; }
    .toast-error   { background: rgba(255,62,62,0.08); border-color: rgba(255,62,62,0.3); color: #ff3e3e; }
    .toast-show { opacity: 1; transform: translateY(0); }
    .toast-hide { opacity: 0; transform: translateY(-8px); pointer-events: none; }
    .toast-icon { font-size: 14px; flex-shrink: 0; }

    /* ── Form card ── */
    .form-card {
        background: #161b22;
        border: 1px solid #21262d;
        border-radius: 8px;
        overflow: hidden;
    }

    .form-card-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 14px 24px;
        background: #0d1117;
        border-bottom: 1px solid #21262d;
    }

    .fch-prompt { font-family: 'IBM Plex Mono', monospace; font-size: 16px; color: #9fef00; font-weight: 600; }
    .fch-title  { font-family: 'IBM Plex Mono', monospace; font-size: 16px; color: #c9d1d9; font-weight: 600; }
    .fch-cursor {
        font-family: 'IBM Plex Mono', monospace; font-size: 16px; color: #9fef00;
        animation: blink 1s step-end infinite;
    }
    @@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }

    .fch-right { margin-left: auto; }

    .fch-badge {
        display: flex; align-items: center; gap: 6px;
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #9fef00; letter-spacing: 1px;
        background: rgba(159,239,0,0.08);
        border: 1px solid rgba(159,239,0,0.2);
        padding: 3px 10px; border-radius: 3px;
    }

    .fch-dot {
        width: 6px; height: 6px; border-radius: 50%; background: #9fef00;
        animation: blink 1.5s ease-in-out infinite;
    }

    /* ── Form body ── */
    .form-body { padding: 28px; display: flex; flex-direction: column; gap: 24px; }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

    /* ── Field groups ── */
    .field-group { display: flex; flex-direction: column; gap: 8px; }

    .field-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #6e7681; letter-spacing: 2px;
        display: flex; align-items: center; gap: 8px;
    }

    .fl-idx { color: #9fef00; opacity: 0.6; }

    .fl-optional {
        margin-left: auto;
        font-size: 9px; color: #4a5160;
        background: #21262d; padding: 1px 6px; border-radius: 2px;
        letter-spacing: 1px;
    }

    /* ── Select ── */
    .select-wrapper {
        position: relative;
        background: #0d1117;
        border: 1px solid #21262d;
        border-radius: 4px;
        transition: border-color 0.15s, box-shadow 0.15s;
        overflow: hidden;
    }
    .select-wrapper.focused { border-color: #9fef00; box-shadow: 0 0 0 3px rgba(159,239,0,0.07); }
    .select-wrapper.has-value { border-color: rgba(159,239,0,0.3); }

    .field-select {
        width: 100%; padding: 11px 36px 11px 14px;
        background: transparent; border: none; outline: none;
        font-family: 'IBM Plex Mono', monospace; font-size: 13px;
        color: #c9d1d9; cursor: pointer; appearance: none;
    }
    .field-select:disabled { opacity: 0.5; cursor: not-allowed; }
    .field-select option { background: #161b22; color: #c9d1d9; }

    .select-arrow {
        position: absolute; right: 12px; top: 50%;
        transform: translateY(-50%); color: #4a5160;
        font-size: 10px; pointer-events: none;
    }

    /* Attack type chip */
    .attack-type-chip {
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        padding: 4px 10px; border-radius: 3px; align-self: flex-start;
        animation: chipIn 0.2s ease both;
    }
    @@keyframes chipIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }

    .chip-ransomware  { background: rgba(255,62,62,0.1); color: #ff3e3e; border: 1px solid rgba(255,62,62,0.25); }
    .chip-phishing    { background: rgba(255,165,0,0.1); color: #ffa500; border: 1px solid rgba(255,165,0,0.25); }
    .chip-ddos        { background: rgba(0,200,255,0.1); color: #00c8ff; border: 1px solid rgba(0,200,255,0.25); }
    .chip-malware     { background: rgba(191,64,191,0.1); color: #bf40bf; border: 1px solid rgba(191,64,191,0.25); }
    .chip-identitytheft { background: rgba(255,165,0,0.1); color: #ffa500; border: 1px solid rgba(255,165,0,0.25); }
    .chip-other       { background: rgba(110,118,129,0.1); color: #6e7681; border: 1px solid rgba(110,118,129,0.25); }

    /* ── Severity ── */
    .severity-row { display: flex; gap: 6px; }

    .sev-btn {
        flex: 1; padding: 10px 4px;
        background: #0d1117; border: 1px solid #21262d;
        border-radius: 4px; cursor: pointer;
        display: flex; flex-direction: column; align-items: center; gap: 3px;
        transition: all 0.15s;
    }
    .sev-btn:hover { border-color: #30363d; background: #161b22; }
    .sev-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .sev-num {
        font-family: 'IBM Plex Mono', monospace; font-size: 15px;
        font-weight: 600; color: #6e7681;
    }

    .sev-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 8px;
        color: #4a5160; letter-spacing: 1px; text-align: center;
    }

    /* Active states */
    .sev-btn.sev-active.sev-1 { border-color: #9fef00; background: rgba(159,239,0,0.08); }
    .sev-btn.sev-active.sev-1 .sev-num { color: #9fef00; }

    .sev-btn.sev-active.sev-2 { border-color: #7dc700; background: rgba(125,199,0,0.08); }
    .sev-btn.sev-active.sev-2 .sev-num { color: #7dc700; }

    .sev-btn.sev-active.sev-3 { border-color: #ffa500; background: rgba(255,165,0,0.08); }
    .sev-btn.sev-active.sev-3 .sev-num { color: #ffa500; }

    .sev-btn.sev-active.sev-4 { border-color: #ff6b35; background: rgba(255,107,53,0.08); }
    .sev-btn.sev-active.sev-4 .sev-num { color: #ff6b35; }

    .sev-btn.sev-active.sev-5 { border-color: #ff3e3e; background: rgba(255,62,62,0.08); }
    .sev-btn.sev-active.sev-5 .sev-num { color: #ff3e3e; }

    .sev-indicator {
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        padding: 6px 10px; border-radius: 3px;
        background: #0d1117; border: 1px solid #21262d;
        animation: chipIn 0.2s ease both;
    }
    .sev-color-1 { color: #9fef00; border-color: rgba(159,239,0,0.2); }
    .sev-color-2 { color: #7dc700; border-color: rgba(125,199,0,0.2); }
    .sev-color-3 { color: #ffa500; border-color: rgba(255,165,0,0.2); }
    .sev-color-4 { color: #ff6b35; border-color: rgba(255,107,53,0.2); }
    .sev-color-5 { color: #ff3e3e; border-color: rgba(255,62,62,0.2); }

    /* ── Input ── */
    .input-wrapper {
        display: flex; align-items: center;
        background: #0d1117; border: 1px solid #21262d;
        border-radius: 4px;
        transition: border-color 0.15s, box-shadow 0.15s; overflow: hidden;
    }
    .input-wrapper.focused { border-color: #9fef00; box-shadow: 0 0 0 3px rgba(159,239,0,0.07); }
    .input-wrapper.valid-ip   { border-color: rgba(159,239,0,0.4); }
    .input-wrapper.invalid-ip { border-color: rgba(255,62,62,0.3); }

    .input-pre {
        padding: 0 12px; color: #4a5160;
        border-right: 1px solid #21262d; flex-shrink: 0;
        user-select: none; line-height: 44px; font-size: 13px;
    }
