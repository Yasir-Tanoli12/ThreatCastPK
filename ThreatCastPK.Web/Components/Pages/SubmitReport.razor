</style>

@code {
    private string _attackType = string.Empty;
    private string _sector = string.Empty;
    private string _city = string.Empty;
    private int _severity = 0;
    private string _sourceIP = string.Empty;
    private string _description = string.Empty;
    private bool _loading = false;
    private string _errorMessage = string.Empty;
    private string _toastMessage = string.Empty;
    private string _toastType = "toast-success";
    private bool _toastVisible = false;

    private bool _attackTypeFocused = false;
    private bool _sectorFocused = false;
    private bool _cityFocused = false;
    private bool _ipFocused = false;
    private bool _descFocused = false;

    private readonly string[] _attackTypes = { "Ransomware", "Phishing", "DDoS", "IdentityTheft", "Malware", "Other" };
    private readonly string[] _sectors = { "Banking", "Telecom", "Healthcare", "Education", "Government", "Energy", "Other" };
    private readonly string[] _cities = { "Karachi", "Lahore", "Islamabad", "Rawalpindi", "Faisalabad", "Multan", "Peshawar", "Quetta", "Hyderabad", "Gujranwala", "Sialkot", "Abbottabad" };

    private readonly (string Name, string Icon, string Desc)[] _attackTypeInfo = {
        ("Ransomware",    "🔐", "Encrypts files and demands payment"),
        ("Phishing",      "🎣", "Deceptive emails or sites stealing credentials"),
        ("DDoS",          "🌊", "Floods systems to cause service disruption"),
        ("IdentityTheft", "👤", "Unauthorized access to personal/financial data"),
        ("Malware",       "🦠", "Malicious software infection or deployment"),
        ("Other",         "⚠", "Incidents not covered by above categories"),
    };

    private bool IsAttackValid() => !string.IsNullOrEmpty(_attackType);

    private bool CanSubmit() =>
        !string.IsNullOrEmpty(_attackType) &&
        !string.IsNullOrEmpty(_sector) &&
        !string.IsNullOrEmpty(_city) &&
        _severity > 0 &&
        !_loading;

    private string SubmitBtnClass() => _loading ? "submit-loading" :
        CanSubmit() ? "submit-btn" : "submit-btn-disabled";

    private void OnIpInput(ChangeEventArgs e)
    {
        _sourceIP = e.Value?.ToString() ?? string.Empty;
    }

    private static bool IsValidIP(string ip)
    {
        if (string.IsNullOrWhiteSpace(ip)) return false;
        return System.Net.IPAddress.TryParse(ip, out _);
    }

    private string GetIpState()
    {
        if (string.IsNullOrEmpty(_sourceIP)) return string.Empty;
        return IsValidIP(_sourceIP) ? "valid-ip" : "invalid-ip";
    }

    private static string GetAttackIcon(string type) => type switch
    {
        "Ransomware"    => "🔐",
        "Phishing"      => "🎣",
        "DDoS"          => "🌊",
        "IdentityTheft" => "👤",
        "Malware"       => "🦠",
        _               => "⚠"
    };

    private static string GetSeverityLabel(int s) => s switch
    {
        1 => "LOW",
        2 => "MED",
        3 => "HIGH",
        4 => "CRIT",
        5 => "CATA",
        _ => ""
    };

    private static string GetSeverityDesc(int s) => s switch
    {
        1 => "Minor incident, limited impact",
        2 => "Moderate disruption to services",
        3 => "Significant impact, active threat",
        4 => "Critical systems compromised",
        5 => "Catastrophic, widespread damage",
        _ => ""
    };

    private async Task HandleSubmit()
    {
        if (!CanSubmit()) return;
        _errorMessage = string.Empty;
        _loading = true;
        StateHasChanged();

        var error = await ApiService.SubmitReportAsync(new
        {
            attackType  = _attackType,
            targetSector = _sector,
            city        = _city,
            severity    = _severity,
            sourceIP    = string.IsNullOrWhiteSpace(_sourceIP) ? null : _sourceIP,
            description = string.IsNullOrWhiteSpace(_description) ? null : _description
        });

        _loading = false;

        if (error == null)
        {
            // Reset form
            _attackType = _sector = _city = _sourceIP = _description = string.Empty;
            _severity = 0;
            await ShowToast("Report transmitted successfully. Pending verification.", "toast-success");
        }
        else if (error.Contains("429") || error.Contains("Rate limit"))
        {
            _errorMessage = "Rate limit reached — maximum 10 reports per hour.";
        }
        else
        {
            _errorMessage = error;
        }

        StateHasChanged();
    }

    private async Task ShowToast(string message, string type)
    {
        _toastMessage = message; _toastType = type; _toastVisible = true;
        StateHasChanged();
        await Task.Delay(4000);
        _toastVisible = false; StateHasChanged();
        await Task.Delay(500);
        _toastMessage = string.Empty; StateHasChanged();
    }
}
