    }
    .info-card:hover { border-color: #30363d; }
    .info-card-dim { opacity: 0.8; }

    .ic-header {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; background: #0d1117;
        border-bottom: 1px solid #21262d;
    }

    .ic-icon { font-size: 14px; }

    .ic-title {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #9fef00; letter-spacing: 2px; opacity: 0.8;
    }

    .ic-body { padding: 16px; }

    .ic-text { font-size: 12px; color: #6e7681; line-height: 1.6; margin-bottom: 14px; }

    .criteria-list { display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px; }

    .criteria-item { }

    .cri-bar {
        display: flex; align-items: center; justify-content: space-between;
        padding: 8px 12px; background: #0d1117;
        border: 1px solid #21262d; border-radius: 3px;
