    @@keyframes spin { to { transform: rotate(360deg); } }

    .form-footnote { text-align: center; }

    .footnote-link {
        font-family: 'IBM Plex Mono', monospace; font-size: 12px;
        color: #6e7681; text-decoration: none; transition: color 0.15s;
    }
    .footnote-link:hover { color: #9fef00; }

    /* ── Right panel ── */
    .sr-right { display: flex; flex-direction: column; gap: 16px; }

    .info-card {
        background: #161b22; border: 1px solid #21262d;
