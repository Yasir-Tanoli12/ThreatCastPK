</style>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;
    private bool _loading = false;
    private bool _shake = false;
    private bool _showPassword = false;
    private bool _emailFocused = false;
    private bool _passFocused = false;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers
            .ParseQuery(uri.Query);
        if (query.TryGetValue("registered", out var val) && val == "1")
            _successMessage = "Account created successfully. Please sign in.";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLogin();
    }

    private async Task HandleLogin()
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            await TriggerShake("All fields are required.");
            return;
        }

        _loading = true;
        StateHasChanged();

        var error = await AuthService.LoginAsync(_email, _password);

        if (error == null)
        {
            // Redirect to home map on success
            Navigation.NavigateTo("/");
        }
        else
        {
            _loading = false;
            await TriggerShake(error);
        }
    }

    private async Task TriggerShake(string message)
    {
        _errorMessage = message;
        _shake = true;
        StateHasChanged();
        await Task.Delay(450);
        _shake = false;
        StateHasChanged();
    }
}
