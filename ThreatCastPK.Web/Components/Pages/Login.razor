@code {
    [SupplyParameterFromQuery(Name = "verified")]
    public string? Verified { get; set; }

    private bool ShowVerifiedBanner => Verified == "true";

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;
    private bool _loading = false;
    private bool _shake = false;
    private bool _showPassword = false;
    private bool _emailFocused = false;
    private bool _passFocused = false;
    private bool _showResendLink = false;
    private bool _resendLoading = false;
    private string _resendMessage = string.Empty;
    private string GoogleLoginUrl => $"{Configuration["ApiBaseUrl"]}/api/auth/google-login";

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("registered", out var val) && val == "1")
            _successMessage = "Account created! Check your email and click the verification link before signing in.";

        if (query.TryGetValue("email", out var emailVal))
            _email = emailVal.ToString();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLogin();
    }

    private async Task HandleLogin()
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;
        _showResendLink = false;
        _resendMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            await TriggerShake("All fields are required.");
            return;
        }

        _loading = true;
        StateHasChanged();

        var (error, errorCode) = await AuthService.LoginAsync(_email, _password);

        if (error == null)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            _loading = false;
            if (errorCode == "EMAIL_NOT_VERIFIED")
            {
                _showResendLink = true;
                await TriggerShake("Email not verified. Check your inbox or resend the link below.");
            }
            else
            {
                await TriggerShake(error);
            }
        }
    }

    private async Task HandleResendVerification()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;
        _resendLoading = true;
        _resendMessage = string.Empty;
        StateHasChanged();

        var success = await AuthService.ResendVerificationAsync(_email);
        _resendLoading = false;
        _resendMessage = success
            ? "✓ Verification link sent. Check your inbox."
            : "Failed to send. Try again in a moment.";
        StateHasChanged();
    }

    private async Task TriggerShake(string message)
    {
        _errorMessage = message;
        _shake = true;
        StateHasChanged();
        await Task.Delay(450);
        _shake = false;
        StateHasChanged();
    }
}