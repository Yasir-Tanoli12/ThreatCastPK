@* ThreatCastPK.Web/Components/Pages/Login.razor *@
@page "/login"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Sign In — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="tc-page-dark login-page">

    @* ── Background Effects ── *@
    <div class="tc-bg-grid" aria-hidden="true"></div>
    <div class="tc-scanline" aria-hidden="true"></div>
    <div class="tc-corner tc-corner--tl" aria-hidden="true"></div>
    <div class="tc-corner tc-corner--tr" aria-hidden="true"></div>
    <div class="tc-corner tc-corner--bl" aria-hidden="true"></div>
    <div class="tc-corner tc-corner--br" aria-hidden="true"></div>
    <div class="tc-orb" style="width:500px;height:500px;top:-5%;right:-5%;--orb-color:rgba(159,239,0,0.07)" aria-hidden="true"></div>
    <div class="tc-orb" style="width:400px;height:400px;bottom:-10%;left:10%;--orb-color:rgba(0,180,255,0.04);animation-delay:4s;animation-direction:alternate-reverse;animation-duration:20s" aria-hidden="true"></div>
    <div class="tc-particles" aria-hidden="true">
        <span style="left:12%;animation-duration:20s;animation-delay:0s"></span>
        <span style="left:30%;animation-duration:25s;animation-delay:4s"></span>
        <span style="left:52%;animation-duration:18s;animation-delay:2s"></span>
        <span style="left:72%;animation-duration:22s;animation-delay:6s"></span>
        <span style="left:88%;animation-duration:28s;animation-delay:1s"></span>
    </div>
    <div class="tc-vignette" aria-hidden="true"></div>

    @* ── Left Panel: Branding ── *@
    <aside class="login-brand-panel">
        <div class="login-brand-content tc-anim-fade-left">

            <div class="login-logo">
                <div class="login-logo__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>
                    </svg>
                </div>
                <span class="login-logo__text">ThreatCast<span class="login-logo__accent">PK</span></span>
            </div>

            <div class="login-tagline">
                <span class="login-tagline__label">LIVE INTELLIGENCE PLATFORM</span>
                <h1 class="login-tagline__heading">Pakistan's Cyber<br/>Threat Command<br/>Center</h1>
                <p class="login-tagline__desc">Real-time crowdsourced attack intelligence.<br/>Community-driven. AI-verified. Always live.</p>
            </div>

            <div class="login-stats">
                <div class="login-stat">
                    <span class="login-stat__value">24/7</span>
                    <span class="login-stat__label">Monitoring</span>
                </div>
                <div class="login-stats__sep" aria-hidden="true"></div>
                <div class="login-stat">
                    <span class="login-stat__value">12</span>
                    <span class="login-stat__label">Cities</span>
                </div>
                <div class="login-stats__sep" aria-hidden="true"></div>
                <div class="login-stat">
                    <span class="login-stat__value">7</span>
                    <span class="login-stat__label">Sectors</span>
                </div>
            </div>

            <div class="login-ticker">
                <div class="login-ticker__header">
                    <span class="login-ticker__dot"></span>
                    <span class="login-ticker__title">LIVE FEED</span>
                </div>
                <div class="login-ticker__body">
                    <div class="login-ticker__row">
                        <span class="tc-badge tc-badge--ddos">DDoS</span>
                        <span class="login-ticker__city">Karachi</span>
                        <span class="login-ticker__sector">Banking</span>
                        <span class="login-ticker__time">2m ago</span>
                    </div>
                    <div class="login-ticker__row">
                        <span class="tc-badge tc-badge--phishing">Phishing</span>
                        <span class="login-ticker__city">Lahore</span>
                        <span class="login-ticker__sector">Education</span>
                        <span class="login-ticker__time">11m ago</span>
                    </div>
                    <div class="login-ticker__row">
                        <span class="tc-badge tc-badge--ransomware">Ransomware</span>
                        <span class="login-ticker__city">Islamabad</span>
                        <span class="login-ticker__sector">Government</span>
                        <span class="login-ticker__time">34m ago</span>
                    </div>
                </div>
            </div>

        </div>
    </aside>

    @* ── Right Panel: Login Form ── *@
    <main class="login-form-panel">
        <div class="tc-card tc-card--glass tc-card--accent-top tc-card--sweep-border login-form-card @(_shake ? "tc-shake" : "") tc-anim-fade-up">

            <div class="login-mobile-brand">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                <span>ThreatCast<span class="login-logo__accent">PK</span></span>
            </div>

            <div class="login-form-header">
                <div class="login-form-title">
                    <span class="login-form-title__prompt">$</span>
                    <h2 class="login-form-title__text">auth.login</h2>
                    <span class="login-form-title__cursor" aria-hidden="true">_</span>
                </div>
                <p class="login-form-subtitle">Authenticate to access the intelligence dashboard</p>
            </div>

            @if (ShowVerifiedBanner)
            {
                <div class="tc-banner tc-banner--success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>Email verified successfully! You can now log in.</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="tc-banner tc-banner--error">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                    <span>@_errorMessage</span>
                </div>
            }

            @if (_showResendLink)
            {
                <div class="tc-banner tc-banner--warning">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                    <span>Didn't get the email?</span>
                    @if (_resendLoading)
                    {
                        <span class="login-resend-sending">Sending…</span>
                    }
                    else
                    {
                        <button class="tc-banner__action" @onclick="HandleResendVerification">Resend verification email</button>
                    }
                    @if (!string.IsNullOrEmpty(_resendMessage))
                    {
                        <span class="login-resend-result">@_resendMessage</span>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="tc-banner tc-banner--success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>@_successMessage</span>
                </div>
            }

            <div class="login-form-body">

                <div class="tc-field">
                    <label class="tc-field__label" for="login-email">
                        <span class="tc-field__index">01</span> EMAIL
                    </label>
                    <div class="tc-input-group @(_emailFocused ? "is-focused" : "")">
                        <span class="tc-input-group__prefix">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        </span>
                        <input id="login-email" type="email" class="tc-input"
                               placeholder="operator@@domain.pk" autocomplete="email"
                               @bind="_email" @bind:event="oninput"
                               @onfocus="() => _emailFocused = true"
                               @onblur="() => _emailFocused = false"
                               disabled="@_loading" @onkeydown="HandleKeyDown" />
                    </div>
                </div>

                <div class="tc-field">
                    <label class="tc-field__label" for="login-password">
                        <span class="tc-field__index">02</span> PASSWORD
                    </label>
                    <div class="tc-input-group @(_passFocused ? "is-focused" : "")">
                        <span class="tc-input-group__prefix">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <input id="login-password" type="@(_showPassword ? "text" : "password")"
                               class="tc-input" placeholder="••••••••••••" autocomplete="current-password"
                               @bind="_password" @bind:event="oninput"
                               @onfocus="() => _passFocused = true"
                               @onblur="() => _passFocused = false"
                               disabled="@_loading" @onkeydown="HandleKeyDown" />
                        <button type="button" class="tc-input-group__suffix"
                                @onclick="() => _showPassword = !_showPassword"
                                aria-label="@(_showPassword ? "Hide password" : "Show password")">
                            @if (_showPassword)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                            }
                        </button>
                    </div>
                    <div class="tc-field__meta">
                        <a href="/forgot-password">Forgot password?</a>
                    </div>
                </div>

                <button class="tc-btn tc-btn--primary tc-btn--full @(_loading ? "is-loading" : "")"
                        @onclick="HandleLogin" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="tc-spinner"></span>
                        <span>AUTHENTICATING…</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        <span>AUTHENTICATE</span>
                    }
                </button>

                <div class="tc-divider"><span>OR</span></div>

                <a href="@GoogleLoginUrl" class="tc-btn tc-btn--outline tc-btn--full">
                    <svg viewBox="0 0 24 24" width="18" height="18" style="flex-shrink:0">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    <span>CONTINUE WITH GOOGLE</span>
                </a>

                <div class="login-form-footer">
                    <span>No account?</span>
                    <a href="/register">Create an account →</a>
                </div>
            </div>
        </div>

        <div class="login-meta tc-anim-fade-up" style="animation-delay:.15s">
            <span class="login-meta__status"><span class="login-meta__dot"></span> API ONLINE</span>
            <span class="login-meta__sep">//</span>
            <span>JWT · BCrypt</span>
            <span class="login-meta__sep">//</span>
            <span>TLS 1.3</span>
        </div>
    </main>

</div>

<style>
    /* ── Left Panel ── */
    .login-brand-panel {
        flex: 1; display: flex; align-items: center; justify-content: center;
        padding: var(--tc-space-16) var(--tc-space-12);
        position: relative; z-index: 3;
        border-right: 1px solid rgba(33,38,45,0.5);
    }
    .login-brand-content { max-width: 440px; width: 100%; }

    .login-logo { display: flex; align-items: center; gap: var(--tc-space-3); margin-bottom: var(--tc-space-12); }
    .login-logo__icon {
        color: var(--tc-accent); display: flex;
        filter: drop-shadow(0 0 12px rgba(159,239,0,0.5));
        animation: login-glow 4s ease-in-out infinite;
    }
    @@keyframes login-glow {
        0%,100% { filter: drop-shadow(0 0 8px rgba(159,239,0,0.3)); }
        50%     { filter: drop-shadow(0 0 20px rgba(159,239,0,0.7)); }
    }
    .login-logo__text { font-family: var(--tc-font-mono); font-size: var(--tc-text-xl); font-weight: 600; color: var(--tc-text-secondary); letter-spacing: 0.5px; }
    .login-logo__accent { color: var(--tc-accent); }

    .login-tagline { margin-bottom: var(--tc-space-10); }
    .login-tagline__label {
        font-family: var(--tc-font-mono); font-size: var(--tc-text-xs);
        color: var(--tc-accent); letter-spacing: 2.5px;
        margin-bottom: var(--tc-space-4); display: block; opacity: 0.7;
    }
    .login-tagline__heading {
        font-size: var(--tc-text-4xl); font-weight: 700;
        color: var(--tc-text-primary); line-height: 1.15;
        letter-spacing: -0.5px; margin-bottom: var(--tc-space-4);
    }
    .login-tagline__desc { font-size: var(--tc-text-base); color: var(--tc-text-muted); line-height: 1.7; }

    .login-stats {
        display: flex; align-items: center; gap: var(--tc-space-6);
        margin-bottom: var(--tc-space-10); padding: var(--tc-space-5) 0;
        border-top: 1px solid rgba(33,38,45,0.5); border-bottom: 1px solid rgba(33,38,45,0.5);
    }
    .login-stat { display: flex; flex-direction: column; gap: 2px; }
    .login-stat__value { font-family: var(--tc-font-mono); font-size: var(--tc-text-2xl); font-weight: 600; color: var(--tc-accent); text-shadow: 0 0 20px rgba(159,239,0,0.3); }
    .login-stat__label { font-size: var(--tc-text-xs); color: var(--tc-text-muted); letter-spacing: 1px; text-transform: uppercase; }
    .login-stats__sep { width: 1px; height: 32px; background: var(--tc-border); }

    .login-ticker {
        background: rgba(13,17,23,0.5); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(33,38,45,0.6); border-radius: var(--tc-radius-md); overflow: hidden;
    }
    .login-ticker__header {
        display: flex; align-items: center; gap: var(--tc-space-2);
        padding: var(--tc-space-3) var(--tc-space-4);
        border-bottom: 1px solid rgba(33,38,45,0.6); background: rgba(22,27,34,0.4);
    }
    .login-ticker__dot {
        width: 6px; height: 6px; border-radius: 50%; background: var(--tc-accent);
        box-shadow: 0 0 10px rgba(159,239,0,0.6); animation: tc-pulse 1.5s ease-in-out infinite;
    }
    .login-ticker__title { font-family: var(--tc-font-mono); font-size: var(--tc-text-2xs); color: var(--tc-text-muted); letter-spacing: 2px; }
    .login-ticker__body { padding: var(--tc-space-1) 0; }
    .login-ticker__row {
        display: flex; align-items: center; gap: var(--tc-space-3);
        padding: var(--tc-space-2) var(--tc-space-4);
        border-bottom: 1px solid rgba(33,38,45,0.3);
        transition: background var(--tc-ease-fast);
    }
    .login-ticker__row:last-child { border-bottom: none; }
    .login-ticker__row:hover { background: rgba(159,239,0,0.02); }
    .login-ticker__city { font-family: var(--tc-font-mono); font-size: var(--tc-text-sm); color: var(--tc-text-secondary); flex: 1; }
    .login-ticker__sector { font-size: var(--tc-text-xs); color: var(--tc-text-muted); }
    .login-ticker__time { font-family: var(--tc-font-mono); font-size: var(--tc-text-2xs); color: var(--tc-text-faint); flex-shrink: 0; }

    /* ── Right Panel ── */
    .login-form-panel {
        width: 480px; min-width: 400px;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: var(--tc-space-12); position: relative; z-index: 3;
    }
    .login-form-card { width: 100%; }

    .login-mobile-brand {
        display: none; align-items: center; gap: var(--tc-space-2);
        padding: var(--tc-space-4) var(--tc-space-7);
        border-bottom: 1px solid rgba(33,38,45,0.4);
        background: rgba(13,17,23,0.3);
        font-family: var(--tc-font-mono); font-size: var(--tc-text-base);
        font-weight: 600; color: var(--tc-text-secondary);
    }
    .login-mobile-brand svg { color: var(--tc-accent); }

    .login-form-header {
        padding: var(--tc-space-6) var(--tc-space-7);
        border-bottom: 1px solid rgba(33,38,45,0.4);
        background: rgba(13,17,23,0.3);
    }
    .login-form-title { display: flex; align-items: center; gap: var(--tc-space-2); margin-bottom: var(--tc-space-1); }
    .login-form-title__prompt { font-family: var(--tc-font-mono); font-size: var(--tc-text-lg); color: var(--tc-accent); font-weight: 600; }
    .login-form-title__text { font-family: var(--tc-font-mono); font-size: var(--tc-text-lg); font-weight: 600; color: var(--tc-text-secondary); margin: 0; }
    .login-form-title__cursor { font-family: var(--tc-font-mono); font-size: var(--tc-text-lg); color: var(--tc-accent); animation: tc-pulse 1.2s step-end infinite; }
    .login-form-subtitle { font-family: var(--tc-font-mono); font-size: var(--tc-text-sm); color: var(--tc-text-muted); }

    .login-resend-sending { color: var(--tc-text-muted); font-style: italic; }
    .login-resend-result { color: var(--tc-accent); }

    .login-form-body { padding: var(--tc-space-7); display: flex; flex-direction: column; gap: var(--tc-space-5); }

    .login-form-footer {
        display: flex; align-items: center; justify-content: center;
        gap: var(--tc-space-2); font-size: var(--tc-text-sm); color: var(--tc-text-muted);
    }
    .login-form-footer a {
        font-family: var(--tc-font-mono); font-size: var(--tc-text-sm);
        color: var(--tc-accent); text-decoration: none; transition: opacity var(--tc-ease-fast);
    }
    .login-form-footer a:hover { opacity: 0.75; }

    .login-meta {
        display: flex; align-items: center; justify-content: center; gap: var(--tc-space-3);
        margin-top: var(--tc-space-4); font-family: var(--tc-font-mono);
        font-size: var(--tc-text-2xs); color: var(--tc-text-faint); letter-spacing: 1px;
    }
    .login-meta__status { display: flex; align-items: center; gap: 6px; }
    .login-meta__dot {
        width: 5px; height: 5px; border-radius: 50%; background: var(--tc-accent);
        box-shadow: 0 0 8px rgba(159,239,0,0.5); animation: tc-pulse 2.5s ease-in-out infinite;
    }
    .login-meta__sep { color: var(--tc-border); }

    /* ── Responsive ── */
    @@media (max-width: 1280px) {
        .login-brand-panel { padding: var(--tc-space-10) var(--tc-space-8); }
        .login-tagline__heading { font-size: var(--tc-text-3xl); }
    }
    @@media (max-width: 1024px) {
        .login-brand-panel { padding: var(--tc-space-8) var(--tc-space-6); }
        .login-brand-content { max-width: 380px; }
        .login-tagline__heading { font-size: 1.75rem; }
        .login-stat__value { font-size: var(--tc-text-xl); }
        .login-form-panel { width: 440px; min-width: 380px; padding: var(--tc-space-8); }
    }
    @@media (max-width: 900px) {
        .login-page { flex-direction: column; align-items: center; justify-content: center; }
        .login-brand-panel { display: none; }
        .login-mobile-brand { display: flex; }
        .login-form-panel { width: 100%; min-width: unset; max-width: 480px; padding: var(--tc-space-6); }
    }
