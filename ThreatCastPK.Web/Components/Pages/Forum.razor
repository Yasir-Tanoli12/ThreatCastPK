@* ThreatCastPK.Web/Components/Pages/Forum.razor *@
@page "/forum"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject ApiService ApiService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Forum — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="fr-root">

    @* ── Ambient ── *@
    <div class="fr-bg-grid" aria-hidden="true"></div>
    <div class="fr-scan-line" aria-hidden="true"></div>
    <div class="fr-corner fr-corner--tl" aria-hidden="true"></div>
    <div class="fr-corner fr-corner--tr" aria-hidden="true"></div>
    <div class="fr-corner fr-corner--bl" aria-hidden="true"></div>
    <div class="fr-corner fr-corner--br" aria-hidden="true"></div>

    @* ── Mobile filter drawer backdrop ── *@
    @if (_drawerOpen)
    {
        <div class="fr-drawer-backdrop" @onclick="() => _drawerOpen = false" aria-hidden="true"></div>
    }

    @* ── Mobile filter drawer ── *@
    <div class="fr-drawer @(_drawerOpen ? "fr-drawer--open" : "")" role="dialog" aria-label="Filter threads">
        <div class="fr-drawer-header">
            <span class="fr-mono fr-drawer-title">// FILTERS</span>
            <button class="fr-icon-btn" @onclick="() => _drawerOpen = false" aria-label="Close filters">
                @SvgX(16)
            </button>
        </div>
        <div class="fr-drawer-body">
            <div class="fr-drawer-section-label">CATEGORY</div>
            @foreach (var cat in _categories)
            {
                <button class="fr-drawer-cat @(_activeCategory == cat.Name ? "is-active" : "")"
                        @onclick="() => { SetCategory(cat.Name); _drawerOpen = false; }">
                    <span class="fr-drawer-cat__icon" style="color:@GetCategoryColor(cat.Name)" aria-hidden="true">
                        @GetCategorySvg(cat.Name)
                    </span>
                    <span class="fr-drawer-cat__name">@cat.Name</span>
                    <span class="fr-drawer-cat__count">@(_posts?.Count(p => cat.Name == "All" || p.Category == cat.Name) ?? 0)</span>
                </button>
            }
            <div class="fr-drawer-divider"></div>
            <div class="fr-drawer-section-label">SORT BY</div>
            <div class="fr-drawer-sort-group">
                @foreach (var s in new[] { ("new","New"), ("hot","Hot"), ("top","Top") })
                {
                    <button class="fr-drawer-sort @(_sort == s.Item1 ? "is-active" : "")"
                            @onclick="() => { _ = SetSort(s.Item1); _drawerOpen = false; }">
                        @s.Item2
                    </button>
                }
            </div>
        </div>
    </div>

    @* ── Page shell ── *@
    <div class="fr-shell">

        @* ════════════════════════════════════
           LEFT SIDEBAR (desktop)
        ════════════════════════════════════ *@
        <aside class="fr-sidebar" aria-label="Forum navigation">

            <div class="fr-sidebar-brand">
                <div class="fr-mono fr-sidebar-eyebrow">// COMMUNITY</div>
                <h1 class="fr-sidebar-title">Threat<br /><span class="fr-sidebar-accent">Forum</span></h1>
                <p class="fr-sidebar-sub">Share intelligence, discuss incidents, and collaborate with Pakistan's security community.</p>
            </div>

            @* Categories *@
            <nav class="fr-sidebar-card" aria-label="Categories">
                <div class="fr-sidebar-card__header">CATEGORIES</div>
                @foreach (var cat in _categories)
                {
                    <button class="fr-sidebar-cat @(_activeCategory == cat.Name ? "is-active" : "")"
                            @onclick="() => SetCategory(cat.Name)"
                            aria-pressed="@(_activeCategory == cat.Name ? "true" : "false")">
                        <span class="fr-sidebar-cat__bar" style="background:@GetCategoryColor(cat.Name)" aria-hidden="true"></span>
                        <span class="fr-sidebar-cat__icon" style="color:@GetCategoryColor(cat.Name)" aria-hidden="true">
                            @GetCategorySvg(cat.Name)
                        </span>
                        <span class="fr-sidebar-cat__name">@cat.Name</span>
                        <span class="fr-sidebar-cat__count">
                            @(_posts?.Count(p => cat.Name == "All" || p.Category == cat.Name) ?? 0)
                        </span>
                    </button>
                }
            </nav>

            @* Rules *@
            <div class="fr-sidebar-card">
                <div class="fr-sidebar-card__header">COMMUNITY RULES</div>
                <ol class="fr-rules" role="list">
                    <li class="fr-rule"><span class="fr-rule__num" aria-hidden="true">01</span><span class="fr-rule__text">Share verified intelligence only</span></li>
                    <li class="fr-rule"><span class="fr-rule__num" aria-hidden="true">02</span><span class="fr-rule__text">No attribution without evidence</span></li>
                    <li class="fr-rule"><span class="fr-rule__num" aria-hidden="true">03</span><span class="fr-rule__text">Respect operational security</span></li>
                    <li class="fr-rule"><span class="fr-rule__num" aria-hidden="true">04</span><span class="fr-rule__text">No offensive tool sharing</span></li>
                </ol>
            </div>

            @* Auth CTA *@
            @if (!AuthService.IsLoggedIn)
            {
                <div class="fr-auth-cta">
                    <p class="fr-auth-cta__text">Sign in to post and reply</p>
                    <a href="/login" class="fr-btn fr-btn--accent fr-btn--full">Sign In</a>
                </div>
            }

        </aside>

        @* ════════════════════════════════════
           MAIN FEED
        ════════════════════════════════════ *@
        <main class="fr-main">

            @* ── Topbar ── *@
            <div class="fr-topbar">
                <div class="fr-topbar__left">

                    @* Mobile: filter trigger *@
                    <button class="fr-icon-btn fr-mobile-filter-btn"
                            @onclick="() => _drawerOpen = true"
                            aria-label="Open filters"
                            aria-expanded="@(_drawerOpen ? "true" : "false")">
                        @SvgFilter(18)
                        @if (_activeCategory != "All")
                        {
                            <span class="fr-filter-dot" aria-label="Filter active"></span>
                        }
                    </button>

                    <div class="fr-topbar__heading">
                        <h2 class="fr-feed-title">@(_activeCategory == "All" ? "All Discussions" : _activeCategory)</h2>
                        @if (_posts != null)
                        {
                            <span class="fr-feed-count fr-mono" aria-live="polite">
                                @FilteredPosts.Count @(FilteredPosts.Count == 1 ? "thread" : "threads")
                            </span>
                        }
                    </div>
                </div>

                <div class="fr-topbar__right">
                    @* Sort *@
                    <div class="fr-sort-group" role="group" aria-label="Sort threads">
                        @foreach (var s in new[] { ("new","New"), ("hot","Hot"), ("top","Top") })
                        {
                            <button class="fr-sort-btn @(_sort == s.Item1 ? "is-active" : "")"
                                    @onclick='() => _ = SetSort(s.Item1)'
                                    aria-pressed="@(_sort == s.Item1 ? "true" : "false")">
                                @s.Item2
                            </button>
                        }
                    </div>

                    @* Search *@
                    <div class="fr-search @(_searchFocused ? "is-focused" : "")">
                        <span class="fr-search__icon" aria-hidden="true">@SvgSearch(15)</span>
                        <input type="search" class="fr-search__input"
                               placeholder="Search threads..."
                               value="@_searchQuery"
                               @oninput="e => _searchQuery = e.Value?.ToString() ?? string.Empty"
                               @onfocus="() => _searchFocused = true"
                               @onblur="() => _searchFocused = false"
                               aria-label="Search forum threads" />
                        @if (!string.IsNullOrEmpty(_searchQuery))
                        {
                            <button class="fr-search__clear" @onclick="() => _searchQuery = string.Empty" aria-label="Clear search">
                                @SvgX(12)
                            </button>
                        }
                    </div>

                    @if (AuthService.IsLoggedIn)
                    {
                        <button class="fr-btn fr-btn--accent" @onclick="OpenNewPost" aria-label="Create new thread">
                            @SvgPlus(14)
                            <span class="fr-btn-label">New Thread</span>
                        </button>
                    }
                </div>
            </div>

            @* ── Tablet filter strip (between topbar and feed) ── *@
            <div class="fr-cat-strip" role="group" aria-label="Category filter">
                @foreach (var cat in _categories)
                {
                    <button class="fr-cat-chip @(_activeCategory == cat.Name ? "is-active" : "")"
                            @onclick="() => SetCategory(cat.Name)"
                            style="@(_activeCategory == cat.Name ? $"--chip-color:{GetCategoryColor(cat.Name)}" : "")">
                        @cat.Name
                    </button>
                }
            </div>

            @* ── Post feed ── *@
            @if (_loadingPosts)
            {
                <div class="fr-feed" aria-busy="true" aria-label="Loading threads">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="fr-skeleton">
                            <div class="fr-skeleton__bar"></div>
                            <div class="fr-skeleton__body">
                                <div class="fr-skeleton__line fr-skeleton__line--title"></div>
                                <div class="fr-skeleton__line fr-skeleton__line--meta"></div>
                                <div class="fr-skeleton__line fr-skeleton__line--preview"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (_loadError != null)
            {
                <div class="fr-state" role="alert">
                    <div class="fr-state__icon" aria-hidden="true">@SvgAlertTriangle(36)</div>
                    <div class="fr-state__title">Failed to load threads</div>
                    <div class="fr-state__sub">@_loadError</div>
                    <button class="fr-btn fr-btn--outline" @onclick="LoadPosts">
                        @SvgRefresh(14)
                        <span>Retry</span>
                    </button>
                </div>
            }
            else if (FilteredPosts.Count == 0)
            {
                <div class="fr-state" role="status">
                    <div class="fr-state__icon" aria-hidden="true">@SvgMessageSquare(36)</div>
                    <div class="fr-state__title">No threads yet</div>
                    <div class="fr-state__sub">
                        @if (!string.IsNullOrEmpty(_searchQuery))
                        {
                            <span>No results for "<strong>@_searchQuery</strong>"</span>
                        }
                        else
                        {
                            <span>Be the first to start a discussion in this category.</span>
                        }
                    </div>
                    @if (AuthService.IsLoggedIn)
                    {
                        <button class="fr-btn fr-btn--accent" @onclick="OpenNewPost">
                            @SvgPlus(14)
                            <span>Start a thread</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="fr-feed">
                    @foreach (var post in FilteredPosts)
                    {
                        bool isExpanded = _expandedPostId == post.Id;

                        @* ── Thread row ── *@
                        <article class="fr-thread @(isExpanded ? "is-expanded" : "") @(post.IsPinned ? "is-pinned" : "")"
                                 @onclick="() => TogglePost(post.Id)">

                            @* Category accent bar *@
                            <div class="fr-thread__accent" style="background:@GetCategoryColor(post.Category)" aria-hidden="true"></div>

                            @* Vote column *@
                            <div class="fr-vote" @onclick:stopPropagation="true" aria-label="Vote on @post.Title">
                                <button class="fr-vote__btn @(_votedUp.Contains(post.Id) ? "is-up" : "")"
                                        @onclick="() => HandleUpvote(post)"
                                        disabled="@(!AuthService.IsLoggedIn)"
                                        aria-label="Upvote" aria-pressed="@(_votedUp.Contains(post.Id) ? "true" : "false")">
                                    @SvgChevronUp(14)
                                </button>
                                <span class="fr-vote__score @(post.Upvotes - post.Downvotes > 0 ? "is-pos" : post.Upvotes - post.Downvotes < 0 ? "is-neg" : "")"
                                      aria-label="Score: @(post.Upvotes - post.Downvotes)">
                                    @(post.Upvotes - post.Downvotes)
                                </span>
                                <button class="fr-vote__btn @(_votedDown.Contains(post.Id) ? "is-down" : "")"
                                        @onclick="() => HandleDownvote(post)"
                                        disabled="@(!AuthService.IsLoggedIn)"
                                        aria-label="Downvote" aria-pressed="@(_votedDown.Contains(post.Id) ? "true" : "false")">
                                    @SvgChevronDown(14)
                                </button>
                            </div>

                            @* Thread body *@
                            <div class="fr-thread__body">
                                <div class="fr-thread__header">
                                    <div class="fr-thread__badges">
                                        @if (post.IsPinned)
                                        {
                                            <span class="fr-badge fr-badge--pinned" aria-label="Pinned">
                                                @SvgPin(10)
                                                PINNED
                                            </span>
                                        }
                                        <span class="fr-badge fr-badge--cat" style="color:@GetCategoryColor(post.Category);background:@GetCategoryColor(post.Category)1a;border-color:@GetCategoryColor(post.Category)33">
                                            @post.Category
                                        </span>
                                    </div>
                                    <h3 class="fr-thread__title">@post.Title</h3>
                                    <p class="fr-thread__preview">
                                        @(post.Content.Length > 140 ? post.Content[..140] + "…" : post.Content)
                                    </p>
                                </div>

                                <div class="fr-thread__meta">
                                    <div class="fr-thread__author">
                                        <div class="fr-avatar fr-avatar--sm" style="background:@GetAvatarColor(post.AuthorUsername)" aria-hidden="true">
                                            @post.AuthorUsername[..1].ToUpper()
                                        </div>
                                        <span class="fr-author-name fr-author-name--@post.AuthorRole.ToLower()">@post.AuthorUsername</span>
                                        <span class="fr-role-badge fr-role-badge--@post.AuthorRole.ToLower()">@post.AuthorRole</span>
                                        @if (post.AuthorRole is "Reporter" or "Admin")
                                        {
                                            <span class="fr-verified" aria-label="Verified">
                                                @SvgBadgeCheck(11)
                                                VERIFIED
                                            </span>
                                        }
                                    </div>

                                    <div class="fr-thread__stats">
                                        <span class="fr-stat" title="Time posted">
                                            @SvgClock(12)
                                            @GetRelativeTime(post.CreatedAt)
                                        </span>
                                        <span class="fr-stat-sep" aria-hidden="true"></span>
                                        <span class="fr-stat" title="Replies">
                                            @SvgMessageCircle(12)
                                            @post.ReplyCount
                                        </span>
                                        <span class="fr-stat-sep" aria-hidden="true"></span>
                                        <span class="fr-stat" title="Views">
                                            @SvgEye(12)
                                            @post.ViewCount
                                        </span>
                                    </div>
                                </div>
                            </div>

                            @* Expand chevron *@
                            <button class="fr-thread__chevron @(isExpanded ? "is-open" : "")"
                                    aria-label="@(isExpanded ? "Collapse" : "Expand") thread"
                                    aria-expanded="@(isExpanded ? "true" : "false")"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => TogglePost(post.Id)">
                                @SvgChevronDown(16)
                            </button>
                        </article>

                        @* ── Expanded detail panel ── *@
                        @if (isExpanded)
                        {
                            <div class="fr-detail" @onclick:stopPropagation="true" role="region" aria-label="Thread detail: @post.Title">

                                @* Full post *@
                                <div class="fr-detail__post">
                                    <div class="fr-detail__author-row">
                                        <div class="fr-avatar fr-avatar--md" style="background:@GetAvatarColor(post.AuthorUsername)" aria-hidden="true">
                                            @post.AuthorUsername[..1].ToUpper()
                                        </div>
                                        <div class="fr-detail__author-info">
                                            <div class="fr-detail__author-name-row">
                                                <span class="fr-author-name fr-author-name--@post.AuthorRole.ToLower()">@post.AuthorUsername</span>
                                                <span class="fr-role-badge fr-role-badge--@post.AuthorRole.ToLower()">@post.AuthorRole</span>
                                                @if (post.AuthorRole is "Reporter" or "Admin")
                                                {
                                                    <span class="fr-verified">@SvgBadgeCheck(11) VERIFIED</span>
                                                }
                                            </div>
                                            <span class="fr-detail__timestamp fr-mono">@post.CreatedAt.ToString("MMM dd, yyyy · HH:mm UTC")</span>
                                        </div>

                                        @* Admin / flag actions *@
                                        <div class="fr-detail__actions" @onclick:stopPropagation="true">
                                            @if (AuthService.IsAdmin)
                                            {
                                                <button class="fr-action-btn @(post.IsPinned ? "is-pinned" : "")"
                                                        @onclick="() => HandlePin(post)"
                                                        aria-label="@(post.IsPinned ? "Unpin" : "Pin") thread">
                                                    @SvgPin(13)
                                                    <span>@(post.IsPinned ? "Unpin" : "Pin")</span>
                                                </button>
                                            }
                                            @if (AuthService.IsLoggedIn)
                                            {
                                                <button class="fr-action-btn fr-action-btn--flag @(_flagged.Contains(post.Id) ? "is-flagged" : "")"
                                                        @onclick="() => HandleFlag(post.Id)"
                                                        aria-label="Flag thread for review"
                                                        aria-pressed="@(_flagged.Contains(post.Id) ? "true" : "false")">
                                                    @SvgFlag(13)
                                                    <span>@(_flagged.Contains(post.Id) ? "Flagged" : "Flag")</span>
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    @* Markdown content *@
                                    <div class="fr-detail__content markdown-body" id="md-@post.Id"></div>
                                </div>

                                @* Replies *@
                                @if (_loadingReplies)
                                {
                                    <div class="fr-replies-loading" role="status" aria-label="Loading replies">
                                        <div class="fr-spinner fr-spinner--sm" aria-hidden="true"></div>
                                        <span class="fr-mono">Loading replies...</span>
                                    </div>
                                }
                                else if (_currentPostDetail?.Replies.Any() == true)
                                {
                                    <div class="fr-replies">
                                        <div class="fr-replies__header">
                                            <span class="fr-mono fr-replies__count">@_currentPostDetail.Replies.Count @(_currentPostDetail.Replies.Count == 1 ? "REPLY" : "REPLIES")</span>
                                            <div class="fr-replies__rule" aria-hidden="true"></div>
                                        </div>

                                        @foreach (var reply in _currentPostDetail.Replies)
                                        {
                                            <div class="fr-reply">
                                                @* Reply vote *@
                                                <div class="fr-reply__vote" @onclick:stopPropagation="true">
                                                    <button class="fr-vote__btn fr-vote__btn--sm @(_votedUp.Contains(reply.Id) ? "is-up" : "")"
                                                            @onclick="() => HandleUpvoteReply(reply)"
                                                            disabled="@(!AuthService.IsLoggedIn)"
                                                            aria-label="Upvote reply">
                                                        @SvgChevronUp(12)
                                                    </button>
                                                    <span class="fr-vote__score fr-vote__score--sm">@(reply.Upvotes - reply.Downvotes)</span>
                                                    <button class="fr-vote__btn fr-vote__btn--sm @(_votedDown.Contains(reply.Id) ? "is-down" : "")"
                                                            @onclick="() => HandleDownvoteReply(reply)"
                                                            disabled="@(!AuthService.IsLoggedIn)"
                                                            aria-label="Downvote reply">
                                                        @SvgChevronDown(12)
                                                    </button>
                                                </div>

                                                <div class="fr-avatar fr-avatar--xs" style="background:@GetAvatarColor(reply.AuthorUsername)" aria-hidden="true">
                                                    @reply.AuthorUsername[..1].ToUpper()
                                                </div>

                                                <div class="fr-reply__body">
                                                    <div class="fr-reply__meta">
                                                        <span class="fr-author-name fr-author-name--@reply.AuthorRole.ToLower()">@reply.AuthorUsername</span>
                                                        <span class="fr-role-badge fr-role-badge--@reply.AuthorRole.ToLower()">@reply.AuthorRole</span>
                                                        @if (reply.AuthorRole is "Reporter" or "Admin")
                                                        {
                                                            <span class="fr-verified">@SvgBadgeCheck(10) VERIFIED</span>
                                                        }
                                                        <span class="fr-reply__time fr-mono">@GetRelativeTime(reply.CreatedAt)</span>
                                                    </div>
                                                    <p class="fr-reply__text">@reply.Content</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @* Reply composer *@
                                @if (AuthService.IsLoggedIn)
                                {
                                    <div class="fr-composer">
                                        <div class="fr-composer__header">
                                            <div class="fr-avatar fr-avatar--xs" style="background:@GetAvatarColor(AuthService.Username)" aria-hidden="true">
                                                @(AuthService.Username?.Length > 0 ? AuthService.Username[..1].ToUpper() : "?")
                                            </div>
                                            <span class="fr-mono fr-composer__label">WRITE A REPLY</span>
                                        </div>
                                        <div class="fr-composer__box @(_replyFocused ? "is-focused" : "")">
                                            <textarea class="fr-composer__textarea"
                                                      placeholder="Share your intelligence or analysis..."
                                                      rows="3"
                                                      @bind="_replyContent"
                                                      @bind:event="oninput"
                                                      @onfocus="() => _replyFocused = true"
                                                      @onblur="() => _replyFocused = false"
                                                      disabled="@_replyLoading"
                                                      aria-label="Reply content"
                                                      maxlength="2000"></textarea>
                                        </div>
                                        @if (!string.IsNullOrEmpty(_replyError))
                                        {
                                            <div class="fr-inline-error" role="alert">
                                                @SvgAlertTriangle(12)
                                                <span>@_replyError</span>
                                            </div>
                                        }
                                        <div class="fr-composer__footer">
                                            <span class="fr-composer__char fr-mono">@_replyContent.Length / 2000</span>
                                            <button class="fr-btn fr-btn--accent @(_replyLoading ? "is-loading" : "")"
                                                    @onclick="() => SubmitReply(post.Id)"
                                                    disabled="@(_replyLoading || string.IsNullOrWhiteSpace(_replyContent))"
                                                    aria-label="Post reply">
                                                @if (_replyLoading)
                                                {
                                                    <span class="fr-spinner fr-spinner--sm" aria-hidden="true"></span>
                                                    <span>Posting...</span>
                                                }
                                                else
                                                {
                                                    @SvgSend(14)
                                                    <span>Post Reply</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="fr-reply-cta">
                                        <span>Sign in to join this discussion</span>
                                        <a href="/login" class="fr-btn fr-btn--ghost">Sign In</a>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }

        </main>
    </div>

    @* ════════════════════════════════════
       NEW THREAD MODAL
    ════════════════════════════════════ *@
    @if (_showNewPost)
    {
        <div class="fr-modal-backdrop" @onclick="CloseNewPost" aria-hidden="true"></div>
        <div class="fr-modal" role="dialog" aria-modal="true" aria-label="Create new thread" @onclick:stopPropagation="true">
            <div class="fr-modal__header">
                <div class="fr-modal__title-row">
                    <span class="fr-mono fr-modal__prompt">$</span>
                    <span class="fr-mono fr-modal__title">forum.new_thread</span>
                    <span class="fr-mono fr-modal__cursor" aria-hidden="true">_</span>
                </div>
                <button class="fr-icon-btn" @onclick="CloseNewPost" aria-label="Close">@SvgX(16)</button>
            </div>
            <div class="fr-modal__body">

                <div class="fr-field">
                    <label class="fr-field__label" for="fr-cat-select">
                        <span class="fr-field__idx" aria-hidden="true">01</span>
                        CATEGORY
                    </label>
                    <div class="fr-select-wrap @(_catFocused ? "is-focused" : "")">
                        <select id="fr-cat-select" class="fr-select"
                                @bind="_newPostCategory"
                                @onfocus="() => _catFocused = true"
                                @onblur="() => _catFocused = false">
                            @foreach (var cat in _categories.Where(c => c.Name != "All"))
                            {
                                <option value="@cat.Name">@cat.Name</option>
                            }
                        </select>
                        <span class="fr-select-arrow" aria-hidden="true">@SvgChevronDown(12)</span>
                    </div>
                </div>

                <div class="fr-field">
                    <label class="fr-field__label" for="fr-post-title">
                        <span class="fr-field__idx" aria-hidden="true">02</span>
                        THREAD TITLE
                    </label>
                    <div class="fr-input-wrap @(_titleFocused ? "is-focused" : "")">
                        <input id="fr-post-title" type="text" class="fr-input"
                               placeholder="What's your thread about?"
                               @bind="_newPostTitle" @bind:event="oninput"
                               @onfocus="() => _titleFocused = true"
                               @onblur="() => _titleFocused = false"
                               maxlength="200" />
                    </div>
                    <span class="fr-field__hint-right fr-mono">@_newPostTitle.Length / 200</span>
                </div>

                <div class="fr-field">
                    <label class="fr-field__label" for="fr-post-content">
                        <span class="fr-field__idx" aria-hidden="true">03</span>
                        CONTENT
                        <span class="fr-field__md-hint">Markdown supported</span>
                    </label>
                    <div class="fr-textarea-wrap @(_contentFocused ? "is-focused" : "")">
                        <textarea id="fr-post-content" class="fr-textarea"
                                  placeholder="Share your intelligence, analysis, or question... **bold**, *italic*, `code`"
                                  rows="6"
                                  @bind="_newPostContent" @bind:event="oninput"
                                  @onfocus="() => _contentFocused = true"
                                  @onblur="() => _contentFocused = false"></textarea>
                        <div class="fr-textarea-footer">
                            <span class="fr-mono @(_newPostContent.Length > 4500 ? "fr-count--warn" : "fr-count")">
                                @_newPostContent.Length / 5000
                            </span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_newPostError))
                {
                    <div class="fr-inline-error" role="alert">
                        @SvgAlertTriangle(13)
                        <span>@_newPostError</span>
                    </div>
                }

                <div class="fr-modal__actions">
                    <button class="fr-btn fr-btn--ghost" @onclick="CloseNewPost">Cancel</button>
                    <button class="fr-btn fr-btn--accent @(_newPostLoading ? "is-loading" : "")"
                            @onclick="SubmitNewPost"
                            disabled="@(_newPostLoading || string.IsNullOrWhiteSpace(_newPostTitle) || string.IsNullOrWhiteSpace(_newPostContent))"
                            aria-label="Publish thread">
                        @if (_newPostLoading)
                        {
                            <span class="fr-spinner fr-spinner--sm" aria-hidden="true"></span>
                            <span>Publishing...</span>
                        }
                        else
                        {
                            @SvgSend(14)
                            <span>Publish Thread</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    @* ════════════════════════════════════
       FLAG MODAL
    ════════════════════════════════════ *@
    @if (_showFlagModal)
    {
        <div class="fr-modal-backdrop" @onclick="() => _showFlagModal = false" aria-hidden="true"></div>
        <div class="fr-modal fr-modal--sm" role="dialog" aria-modal="true" aria-label="Flag thread" @onclick:stopPropagation="true">
            <div class="fr-modal__header">
                <div class="fr-modal__title-row">
                    @SvgFlag(15)
                    <span class="fr-mono fr-modal__title">Flag thread</span>
                </div>
                <button class="fr-icon-btn" @onclick="() => _showFlagModal = false" aria-label="Close">@SvgX(16)</button>
            </div>
            <div class="fr-modal__body">
                <div class="fr-field">
                    <label class="fr-field__label" for="fr-flag-reason">REASON</label>
                    <div class="fr-select-wrap">
                        <select id="fr-flag-reason" class="fr-select" @bind="_flagReason">
                            <option value="Misinformation">Misinformation</option>
                            <option value="Harmful content">Harmful content</option>
                            <option value="Spam">Spam</option>
                            <option value="Offensive tool sharing">Offensive tool sharing</option>
                            <option value="Other">Other</option>
                        </select>
                        <span class="fr-select-arrow" aria-hidden="true">@SvgChevronDown(12)</span>
                    </div>
                </div>
                <div class="fr-modal__actions">
                    <button class="fr-btn fr-btn--ghost" @onclick="() => _showFlagModal = false">Cancel</button>
                    <button class="fr-btn fr-btn--danger" @onclick="SubmitFlag">Submit Flag</button>
                </div>
            </div>
        </div>
    }

</div>

@* ═══════════════════════════════════════
   INLINE SVG ICON HELPERS
═══════════════════════════════════════ *@
@code {
    RenderFragment SvgSearch(int s)     => b => b.AddMarkupContent(0, $"<svg width='{s}' height='{s}' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><circle cx='11' cy='11' r='8'/><path d='m21 21-4.35-4.35'/></svg>");
