@* ThreatCastPK.Web/Components/Pages/Forum.razor *@
@page "/forum"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Forum — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="forum-root">
    <div class="bg-grid"></div>
    <div class="scan-line"></div>
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>

    <div class="forum-layout">

        @* ── Left sidebar ── *@
        <aside class="forum-sidebar">

            <div class="sidebar-brand">
                <div class="sb-label">// COMMUNITY</div>
                <h1 class="sb-title">Threat<br /><span class="sb-accent">Forum</span></h1>
                <p class="sb-sub">
                    Share intelligence, discuss incidents, and collaborate with
                    Pakistan's security community.
                </p>
            </div>

            <div class="sidebar-card">
                <div class="sc-header">CATEGORIES</div>
                @foreach (var cat in _categories)
                {
                    <button class="cat-btn @(_activeCategory == cat.Name ? "cat-active" : "")"
                            @onclick="() => SetCategory(cat.Name)">
                        <span class="cat-icon">@cat.Icon</span>
                        <span class="cat-name">@cat.Name</span>
                        <span class="cat-count">@(_posts?.Count(p => cat.Name == "All" || p.Category == cat.Name) ?? 0)</span>
                    </button>
                }
            </div>

            <div class="sidebar-card">
                <div class="sc-header">COMMUNITY RULES</div>
                <div class="rules-list">
                    <div class="rule-item">
                        <span class="rule-num">01</span>
                        <span class="rule-text">Share verified intelligence only</span>
                    </div>
                    <div class="rule-item">
                        <span class="rule-num">02</span>
                        <span class="rule-text">No attribution without evidence</span>
                    </div>
                    <div class="rule-item">
                        <span class="rule-num">03</span>
                        <span class="rule-text">Respect operational security</span>
                    </div>
                    <div class="rule-item">
                        <span class="rule-num">04</span>
                        <span class="rule-text">No offensive tool sharing</span>
                    </div>
                </div>
            </div>

            @if (!AuthService.IsLoggedIn)
            {
                <div class="sidebar-auth-cta">
                    <div class="sac-text">Sign in to post and reply</div>
                    <a href="/login" class="sac-btn">Sign In →</a>
                </div>
            }

        </aside>

        @* ── Main content ── *@
        <main class="forum-main">

            @* Top bar *@
            <div class="forum-topbar">
                <div class="ftb-left">
                    <div class="ftb-title">
                        @(_activeCategory == "All" ? "All Discussions" : _activeCategory)
                    </div>
                    @if (_posts != null)
                    {
                        <div class="ftb-count">
                            @FilteredPosts.Count @(FilteredPosts.Count == 1 ? "thread" : "threads")
                        </div>
                    }
                </div>
                <div class="ftb-right">
                    @* Search *@
                    <div class="search-box @(_searchFocused ? "focused" : "")">
                        <span class="search-icon">⌕</span>
                        <input type="text" class="search-input"
                               placeholder="Search threads..."
                               value="@_searchQuery"
                               @oninput="e => { _searchQuery = e.Value?.ToString() ?? string.Empty; }"
                               @onfocus="() => _searchFocused = true"
                               @onblur="() => _searchFocused = false" />
                    </div>
                    @if (AuthService.IsLoggedIn)
                    {
                        <button class="new-post-btn" @onclick="OpenNewPost">
                            + NEW THREAD
                        </button>
                    }
                </div>
            </div>

            @* Post list *@
            @if (_loadingPosts)
            {
                <div class="posts-list">
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="post-skeleton">
                            <div class="sk-avatar"></div>
                            <div class="sk-body">
                                <div class="sk-line sk-title"></div>
                                <div class="sk-line sk-meta"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (_loadError != null)
            {
                <div class="state-box">
                    <div class="sb-icon">⚠</div>
                    <div class="sb-title">FAILED TO LOAD</div>
                    <div class="sb-sub">@_loadError</div>
                    <button class="sb-btn" @onclick="LoadPosts">↺ Retry</button>
                </div>
            }
            else if (FilteredPosts.Count == 0)
            {
                <div class="state-box">
                    <div class="sb-icon">💬</div>
                    <div class="sb-title">NO THREADS YET</div>
                    <div class="sb-sub">
                        @if (!string.IsNullOrEmpty(_searchQuery))
                        {
                            <span>No results for "@_searchQuery"</span>
                        }
                        else
                        {
                            <span>Be the first to start a discussion in this category.</span>
                        }
                    </div>
                    @if (AuthService.IsLoggedIn)
                    {
                        <button class="sb-btn" @onclick="OpenNewPost">+ Start a thread</button>
                    }
                </div>
            }
            else
            {
                <div class="posts-list">
                    @foreach (var post in FilteredPosts)
                    {
                        <div class="post-card @(_expandedPostId == post.Id ? "post-expanded" : "")"
                             @onclick="() => TogglePost(post.Id)">

                            @* Author avatar *@
                            <div class="pc-avatar" style="background:@GetAvatarColor(post.AuthorUsername)">
                                @post.AuthorUsername[..1].ToUpper()
                            </div>

                            @* Post content *@
                            <div class="pc-body">
                                <div class="pc-top">
                                    <div class="pc-title-row">
                                        <span class="pc-title">@post.Title</span>
                                        <span class="cat-pill cat-@post.Category.ToLower().Replace(" ","").Replace("&","")">
                                            @post.Category
                                        </span>
                                    </div>
                                    <div class="pc-preview">
                                        @(post.Content.Length > 120
                                            ? post.Content[..120] + "…"
                                            : post.Content)
                                    </div>
                                </div>
                                <div class="pc-meta">
                                    <span class="pc-author">
                                        <span class="author-name role-@post.AuthorRole.ToLower()">
                                            @post.AuthorUsername
                                        </span>
                                        <span class="author-role-badge role-badge-@post.AuthorRole.ToLower()">
                                            @post.AuthorRole.ToUpper()
                                        </span>
                                    </span>
                                    <span class="pc-dot">·</span>
                                    <span class="pc-time">@GetRelativeTime(post.CreatedAt)</span>
                                    <span class="pc-dot">·</span>
                                    <span class="pc-replies">
                                        💬 @post.ReplyCount @(post.ReplyCount == 1 ? "reply" : "replies")
                                    </span>
                                </div>
                            </div>

                            <div class="pc-chevron @(_expandedPostId == post.Id ? "chevron-open" : "")">
                                ▾
                            </div>
                        </div>

                        @* Expanded post detail *@
                        @if (_expandedPostId == post.Id)
                        {
                            <div class="post-detail" @onclick:stopPropagation="true">

                                @* Full post content *@
                                <div class="pd-content">
                                    <div class="pd-author-row">
                                        <div class="pd-avatar" style="background:@GetAvatarColor(post.AuthorUsername)">
                                            @post.AuthorUsername[..1].ToUpper()
                                        </div>
                                        <div class="pd-author-info">
                                            <span class="pd-username role-@post.AuthorRole.ToLower()">
                                                @post.AuthorUsername
                                            </span>
                                            <span class="pd-time">@post.CreatedAt.ToString("MMM dd, yyyy HH:mm UTC")</span>
                                        </div>
                                        <span class="author-role-badge role-badge-@post.AuthorRole.ToLower() ml-auto">
                                            @post.AuthorRole.ToUpper()
                                        </span>
                                    </div>
                                    <div class="pd-text">@post.Content</div>
                                </div>

                                @* Replies *@
                                @if (_loadingReplies)
                                {
                                    <div class="replies-loading">
                                        <div class="rl-spinner"></div>
                                        <span>Loading replies...</span>
                                    </div>
                                }
                                else if (_currentPostDetail != null && _currentPostDetail.Replies.Any())
                                {
                                    <div class="replies-section">
                                        <div class="replies-header">
                                            @(_currentPostDetail?.Replies.Count ?? 0)
                                            @(_currentPostDetail.Replies.Count == 1 ? "REPLY" : "REPLIES")
                                        </div>
                                        @foreach (var reply in _currentPostDetail?.Replies ?? new())
                                        {
                                            <div class="reply-item">
                                                <div class="ri-avatar" style="background:@GetAvatarColor(reply.AuthorUsername)">
                                                    @reply.AuthorUsername[..1].ToUpper()
                                                </div>
                                                <div class="ri-body">
                                                    <div class="ri-meta">
                                                        <span class="ri-author role-@reply.AuthorRole.ToLower()">
                                                            @reply.AuthorUsername
                                                        </span>
                                                        <span class="author-role-badge role-badge-@reply.AuthorRole.ToLower()">
                                                            @reply.AuthorRole.ToUpper()
                                                        </span>
                                                        <span class="ri-time">@GetRelativeTime(reply.CreatedAt)</span>
                                                    </div>
                                                    <div class="ri-text">@reply.Content</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @* Reply input *@
                                @if (AuthService.IsLoggedIn)
                                {
                                    <div class="reply-input-section">
                                        <div class="ris-header">WRITE A REPLY</div>
                                        <div class="ris-box @(_replyFocused ? "focused" : "")">
                                            <textarea class="ris-textarea"
                                                      placeholder="Share your intelligence or analysis..."
                                                      rows="3"
                                                      @bind="_replyContent"
                                                      @bind:event="oninput"
                                                      @onfocus="() => _replyFocused = true"
                                                      @onblur="() => _replyFocused = false"
                                                      disabled="@_replyLoading">
                                            </textarea>
                                        </div>
                                        @if (!string.IsNullOrEmpty(_replyError))
                                        {
                                            <div class="ris-error">⚠ @_replyError</div>
                                        }
                                        <div class="ris-actions">
                                            <span class="ris-char">@_replyContent.Length / 2000</span>
                                            <button class="ris-btn @(_replyLoading ? "ris-loading" : "")"
                                                    @onclick="() => SubmitReply(post.Id)"
                                                    disabled="@(_replyLoading || string.IsNullOrWhiteSpace(_replyContent))">
                                                @if (_replyLoading)
                                                {
                                                    <span class="btn-spinner-sm"></span>
                                                    <span>POSTING...</span>
                                                }
                                                else
                                                {
                                                    <span>POST REPLY →</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="reply-login-cta">
                                        <span>Sign in to reply to this thread</span>
                                        <a href="/login" class="rlc-link">Sign In →</a>
                                    </div>
                                }

                            </div>
                        }
                    }
                </div>
            }

        </main>
    </div>

    @* ── New Post Modal ── *@
    @if (_showNewPost)
    {
        <div class="modal-backdrop" @onclick="CloseNewPost"></div>
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="mh-title-row">
                    <span class="mh-prompt">$</span>
                    <span class="mh-title">forum.new_thread</span>
                    <span class="mh-cursor">_</span>
                </div>
                <button class="mh-close" @onclick="CloseNewPost">✕</button>
            </div>

            <div class="modal-body">

                <div class="field-group">
                    <label class="field-label">
                        <span class="fl-idx">01</span> CATEGORY
                    </label>
                    <div class="select-wrapper @(_catFocused ? "focused" : "")">
                        <select class="field-select"
                                @bind="_newPostCategory"
                                @onfocus="() => _catFocused = true"
                                @onblur="() => _catFocused = false">
                            @foreach (var cat in _categories.Where(c => c.Name != "All"))
                            {
                                <option value="@cat.Name">@cat.Icon @cat.Name</option>
                            }
                        </select>
                        <span class="select-arrow">▾</span>
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label">
                        <span class="fl-idx">02</span> THREAD TITLE
                    </label>
                    <div class="input-wrapper @(_titleFocused ? "focused" : "")">
                        <input type="text" class="field-input"
                               placeholder="What's your thread about?"
                               @bind="_newPostTitle"
                               @bind:event="oninput"
                               @onfocus="() => _titleFocused = true"
                               @onblur="() => _titleFocused = false"
                               maxlength="200" />
                    </div>
                    <span class="field-hint-right">@_newPostTitle.Length / 200</span>
                </div>

                <div class="field-group">
                    <label class="field-label">
                        <span class="fl-idx">03</span> CONTENT
                    </label>
                    <div class="textarea-wrapper @(_contentFocused ? "focused" : "")">
                        <textarea class="field-textarea"
                                  placeholder="Share your intelligence, analysis, or question..."
                                  rows="6"
                                  @bind="_newPostContent"
                                  @bind:event="oninput"
                                  @onfocus="() => _contentFocused = true"
                                  @onblur="() => _contentFocused = false">
                        </textarea>
                        <div class="textarea-footer">
                            <span class="char-count @(_newPostContent.Length > 4500 ? "count-warn" : "")">
                                @_newPostContent.Length / 5000
                            </span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_newPostError))
                {
                    <div class="modal-error">⚠ @_newPostError</div>
                }

                <div class="modal-actions">
                    <button class="modal-cancel" @onclick="CloseNewPost">CANCEL</button>
                    <button class="modal-submit @(_newPostLoading ? "loading" : "")"
                            @onclick="SubmitNewPost"
                            disabled="@(_newPostLoading || string.IsNullOrWhiteSpace(_newPostTitle) || string.IsNullOrWhiteSpace(_newPostContent))">
                        @if (_newPostLoading)
                        {
                            <span class="btn-spinner-sm"></span>
                            <span>POSTING...</span>
                        }
                        else
                        {
                            <span>PUBLISH THREAD →</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .forum-root {
        min-height: 100vh; background: #0d1117;
        font-family: 'Inter', sans-serif;
        padding: 72px 0 0; position: relative; overflow-x: hidden;
    }

    .bg-grid {
        position: fixed; inset: 0;
        background-image:
            linear-gradient(rgba(159,239,0,0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(159,239,0,0.025) 1px, transparent 1px);
        background-size: 40px 40px; pointer-events: none; z-index: 0;
    }

    .scan-line {
        position: fixed; top: -2px; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, #9fef00, transparent);
        animation: scan 8s linear infinite; opacity: 0.3;
        z-index: 1; pointer-events: none;
    }

    .corner { position: fixed; width: 18px; height: 18px; z-index: 2; pointer-events: none; }
    .corner-tl { top: 14px; left: 14px; border-top: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-tr { top: 14px; right: 14px; border-top: 2px solid #9fef00; border-right: 2px solid #9fef00; }
    .corner-bl { bottom: 14px; left: 14px; border-bottom: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-br { bottom: 14px; right: 14px; border-bottom: 2px solid #9fef00; border-right: 2px solid #9fef00; }

    /* ── Layout ── */
    .forum-layout {
        max-width: 1200px; margin: 0 auto;
        display: grid; grid-template-columns: 260px 1fr;
        gap: 0; min-height: calc(100vh - 72px);
        position: relative; z-index: 3;
    }

    /* ── Sidebar ── */
    .forum-sidebar {
        border-right: 1px solid #21262d;
        padding: 32px 24px;
        display: flex; flex-direction: column; gap: 20px;
        position: sticky; top: 72px; height: calc(100vh - 72px);
        overflow-y: auto;
    }

    .sidebar-brand { padding-bottom: 4px; }

    .sb-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #9fef00; letter-spacing: 2px; opacity: 0.7; margin-bottom: 10px;
    }

    .sb-title {
        font-size: 32px; font-weight: 700; color: #e6edf3;
        line-height: 1.1; letter-spacing: -0.5px; margin-bottom: 10px;
    }

    .sb-accent { color: #9fef00; }

    .sb-sub { font-size: 12px; color: #6e7681; line-height: 1.6; }

    .sidebar-card {
        background: #161b22; border: 1px solid #21262d;
        border-radius: 8px; overflow: hidden;
    }

    .sc-header {
        font-family: 'IBM Plex Mono', monospace; font-size: 9px;
        color: #4a5160; letter-spacing: 2px; padding: 10px 14px;
        background: #0d1117; border-bottom: 1px solid #21262d;
    }

    .cat-btn {
        width: 100%; display: flex; align-items: center; gap: 10px;
        padding: 10px 14px; background: none; border: none;
        border-bottom: 1px solid #21262d; cursor: pointer;
        transition: background 0.1s; text-align: left;
    }
    .cat-btn:last-child { border-bottom: none; }
    .cat-btn:hover { background: #0d1117; }

    .cat-active { background: rgba(159,239,0,0.04) !important; }
    .cat-active .cat-name { color: #9fef00 !important; }

    .cat-icon { font-size: 14px; flex-shrink: 0; }

    .cat-name {
        font-size: 13px; color: #c9d1d9; flex: 1;
        transition: color 0.1s;
    }

    .cat-count {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #4a5160; background: #21262d;
        padding: 1px 6px; border-radius: 8px;
    }

    .rules-list { padding: 4px 0; }

    .rule-item {
        display: flex; gap: 10px; align-items: flex-start;
        padding: 8px 14px; border-bottom: 1px solid #21262d;
    }
    .rule-item:last-child { border-bottom: none; }

    .rule-num {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #9fef00; opacity: 0.5; flex-shrink: 0;
    }

    .rule-text { font-size: 12px; color: #6e7681; line-height: 1.4; }

    .sidebar-auth-cta {
        background: rgba(159,239,0,0.05); border: 1px solid rgba(159,239,0,0.2);
        border-radius: 8px; padding: 16px;
        display: flex; flex-direction: column; gap: 10px; align-items: center;
        text-align: center;
    }

    .sac-text { font-size: 12px; color: #6e7681; }

    .sac-btn {
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        font-weight: 600; color: #0d1117; background: #9fef00;
        padding: 7px 16px; border-radius: 4px; text-decoration: none;
        letter-spacing: 1px; transition: opacity 0.15s;
    }
    .sac-btn:hover { opacity: 0.88; }

    /* ── Main ── */
    .forum-main { padding: 24px 32px; }

    /* ── Topbar ── */
    .forum-topbar {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; margin-bottom: 20px; flex-wrap: wrap;
    }

    .ftb-left { display: flex; align-items: baseline; gap: 12px; }

    .ftb-title {
        font-size: 20px; font-weight: 700; color: #e6edf3; letter-spacing: -0.3px;
    }

    .ftb-count {
        font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #4a5160;
    }

    .ftb-right { display: flex; align-items: center; gap: 10px; }

    .search-box {
        display: flex; align-items: center;
        background: #161b22; border: 1px solid #21262d;
        border-radius: 4px; overflow: hidden; min-width: 220px;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .search-box.focused {
        border-color: #9fef00; box-shadow: 0 0 0 3px rgba(159,239,0,0.07);
    }

    .search-icon {
        padding: 0 10px; color: #4a5160; font-size: 16px;
        border-right: 1px solid #21262d; line-height: 36px;
    }

    .search-input {
        flex: 1; background: transparent; border: none; outline: none;
        padding: 8px 10px; font-family: 'Inter', sans-serif;
        font-size: 13px; color: #c9d1d9; caret-color: #9fef00;
    }
    .search-input::placeholder { color: #4a5160; }

    .new-post-btn {
        padding: 8px 16px; background: #9fef00; border: none; border-radius: 4px;
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        font-weight: 700; color: #0d1117; cursor: pointer; letter-spacing: 1.5px;
        white-space: nowrap;
        transition: opacity 0.15s, box-shadow 0.15s;
    }
    .new-post-btn:hover { opacity: 0.9; box-shadow: 0 4px 16px rgba(159,239,0,0.2); }

    /* ── Post cards ── */
    .posts-list { display: flex; flex-direction: column; gap: 0; }

    .post-card {
        display: flex; align-items: flex-start; gap: 14px;
        padding: 18px 16px; background: #161b22;
        border: 1px solid #21262d; border-bottom: none;
        cursor: pointer; transition: background 0.1s, border-color 0.15s;
        animation: fadeInUp 0.4s ease both;
    }
    .post-card:first-child { border-radius: 8px 8px 0 0; }
    .posts-list > .post-card:last-child,
    .posts-list > .post-detail:last-child + .post-card { border-radius: 0 0 8px 8px; border-bottom: 1px solid #21262d; }
    .posts-list > *:last-child { border-bottom: 1px solid #21262d; border-radius: 0 0 8px 8px; }
    .post-card:hover { background: rgba(159,239,0,0.02); border-color: #30363d; }
    .post-expanded { border-color: rgba(159,239,0,0.3) !important; background: rgba(159,239,0,0.02) !important; }

    .pc-avatar {
        width: 40px; height: 40px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-family: 'IBM Plex Mono', monospace; font-size: 16px;
        font-weight: 700; color: white; flex-shrink: 0;
    }

    .pc-body { flex: 1; min-width: 0; }

    .pc-top { margin-bottom: 8px; }

    .pc-title-row {
        display: flex; align-items: center; gap: 10px;
        margin-bottom: 5px; flex-wrap: wrap;
    }

    .pc-title {
        font-size: 15px; font-weight: 600; color: #e6edf3;
        line-height: 1.3; flex: 1;
    }

    .cat-pill {
        font-family: 'IBM Plex Mono', monospace; font-size: 9px;
        font-weight: 600; padding: 2px 8px; border-radius: 3px;
        letter-spacing: 1px; flex-shrink: 0; white-space: nowrap;
    }

    .cat-general        { background: rgba(110,118,129,0.12); color: #6e7681; border: 1px solid #21262d; }
    .cat-threatintel    { background: rgba(255,62,62,0.1); color: #ff3e3e; border: 1px solid rgba(255,62,62,0.2); }
    .cat-malwareanalysis { background: rgba(191,64,191,0.1); color: #bf40bf; border: 1px solid rgba(191,64,191,0.2); }
