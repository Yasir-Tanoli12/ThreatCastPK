<style>
/* ══════════════════════════════════════════════
   DESIGN TOKENS
══════════════════════════════════════════════ */
:root {
    --fr-bg:            #0d1117;
    --fr-surface:       #161b22;
    --fr-surface-2:     #1c2230;
    --fr-border:        #21262d;
    --fr-border-hover:  #30363d;

    --fr-text:          #e6edf3;
    --fr-text-2:        #8b949e;
    --fr-text-3:        #4a5160;

    --fr-accent:        #9fef00;
    --fr-accent-dim:    rgba(159,239,0,0.10);
    --fr-accent-border: rgba(159,239,0,0.22);

    --fr-blue:          #00c8ff;
    --fr-orange:        #ffa500;
    --fr-red:           #ff3e3e;
    --fr-purple:        #bf40bf;

    --fr-cat-general:   #8b949e;
    --fr-cat-intel:     #ff3e3e;
    --fr-cat-malware:   #bf40bf;
    --fr-cat-incident:  #ffa500;
    --fr-cat-tools:     #00c8ff;

    --fr-radius-sm:     4px;
    --fr-radius-md:     6px;
    --fr-radius-lg:     8px;

    --fr-font:          'Inter', system-ui, sans-serif;
    --fr-mono:          'IBM Plex Mono', 'Fira Code', monospace;

    --fr-dur:           150ms;
    --fr-ease:          cubic-bezier(0.16, 1, 0.3, 1);

    --fr-sidebar-w:     252px;
    --fr-topbar-h:      56px;
    --fr-page-top:      56px; /* navbar height */
}

/* ══════════════════════════════════════════════
   RESET
══════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
button { font-family: inherit; cursor: pointer; }
a { text-decoration: none; }
svg { display: block; flex-shrink: 0; }

/* ══════════════════════════════════════════════
   ROOT
══════════════════════════════════════════════ */
.fr-root {
    min-height: 100vh;
    background: var(--fr-bg);
    font-family: var(--fr-font);
    padding-top: var(--fr-page-top);
    position: relative;
    overflow-x: hidden;
    color: var(--fr-text);
}
.fr-mono { font-family: var(--fr-mono); }

/* ══════════════════════════════════════════════
   AMBIENT
══════════════════════════════════════════════ */
.fr-bg-grid {
    position: fixed; inset: 0;
    background-image:
        linear-gradient(rgba(159,239,0,0.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(159,239,0,0.018) 1px, transparent 1px);
    background-size: 44px 44px;
    pointer-events: none; z-index: 0;
}
.fr-scan-line {
    position: fixed; top: -2px; left: 0; right: 0; height: 1.5px;
    background: linear-gradient(90deg, transparent, var(--fr-accent), transparent);
    animation: fr-scan 10s linear infinite; opacity: 0.2;
    z-index: 1; pointer-events: none;
}
.fr-corner { position: fixed; width: 14px; height: 14px; z-index: 2; pointer-events: none; opacity: 0.4; }
.fr-corner--tl { top: 10px; left: 10px; border-top: 1.5px solid var(--fr-accent); border-left: 1.5px solid var(--fr-accent); }
.fr-corner--tr { top: 10px; right: 10px; border-top: 1.5px solid var(--fr-accent); border-right: 1.5px solid var(--fr-accent); }
.fr-corner--bl { bottom: 10px; left: 10px; border-bottom: 1.5px solid var(--fr-accent); border-left: 1.5px solid var(--fr-accent); }
.fr-corner--br { bottom: 10px; right: 10px; border-bottom: 1.5px solid var(--fr-accent); border-right: 1.5px solid var(--fr-accent); }

@@keyframes fr-scan { 0% { top: -2px; } 100% { top: 100vh; } }

@@media (prefers-reduced-motion: reduce) {
    .fr-scan-line { display: none; }
    .fr-thread, .fr-detail, .fr-skeleton { animation: none !important; }
    .fr-spinner { animation: none !important; }
}

/* ══════════════════════════════════════════════
   PAGE SHELL — 3 column grid (desktop)
══════════════════════════════════════════════ */
.fr-shell {
    max-width: 1200px; margin: 0 auto;
    display: grid;
    grid-template-columns: var(--fr-sidebar-w) 1fr;
    min-height: calc(100vh - var(--fr-page-top));
    position: relative; z-index: 3;
}

/* ══════════════════════════════════════════════
   SIDEBAR
══════════════════════════════════════════════ */
.fr-sidebar {
    border-right: 1px solid var(--fr-border);
    padding: 28px 18px 40px;
    display: flex; flex-direction: column; gap: 18px;
    position: sticky; top: var(--fr-page-top);
    height: calc(100vh - var(--fr-page-top));
    overflow-y: auto;
    scrollbar-width: thin; scrollbar-color: var(--fr-border) transparent;
}
.fr-sidebar::-webkit-scrollbar { width: 3px; }
.fr-sidebar::-webkit-scrollbar-thumb { background: var(--fr-border); }

.fr-sidebar-eyebrow {
    font-size: 9px; letter-spacing: 2.5px;
    color: var(--fr-accent); opacity: 0.7; margin-bottom: 8px;
}
.fr-sidebar-title {
    font-size: 26px; font-weight: 700; color: var(--fr-text);
    line-height: 1.15; letter-spacing: -0.5px; margin-bottom: 8px;
}
.fr-sidebar-accent { color: var(--fr-accent); }
.fr-sidebar-sub { font-size: 12px; color: var(--fr-text-3); line-height: 1.65; }

.fr-sidebar-card {
    background: var(--fr-surface); border: 1px solid var(--fr-border);
    border-radius: var(--fr-radius-lg); overflow: hidden;
}
.fr-sidebar-card__header {
    font-family: var(--fr-mono); font-size: 9px; letter-spacing: 2.5px;
    color: var(--fr-text-3); padding: 9px 14px;
    background: rgba(0,0,0,0.18); border-bottom: 1px solid var(--fr-border);
}

/* Category buttons in sidebar */
.fr-sidebar-cat {
    display: flex; align-items: center; gap: 9px;
    width: 100%; padding: 9px 14px;
    background: none; border: none;
    border-bottom: 1px solid var(--fr-border);
    transition: background var(--fr-dur);
    text-align: left; position: relative;
    overflow: hidden;
}
.fr-sidebar-cat:last-child { border-bottom: none; }
.fr-sidebar-cat:hover { background: rgba(0,0,0,0.12); }
.fr-sidebar-cat:focus-visible { outline: 2px solid var(--fr-accent); outline-offset: -2px; }
.fr-sidebar-cat.is-active { background: rgba(159,239,0,0.03); }
.fr-sidebar-cat.is-active .fr-sidebar-cat__name { color: var(--fr-accent); }

/* The signature element: left accent bar per category */
.fr-sidebar-cat__bar {
    position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    opacity: 0; transition: opacity var(--fr-dur);
    border-radius: 0 2px 2px 0;
}
.fr-sidebar-cat.is-active .fr-sidebar-cat__bar { opacity: 1; }

.fr-sidebar-cat__icon { display: flex; align-items: center; width: 16px; flex-shrink: 0; }
.fr-sidebar-cat__name { font-size: 12.5px; color: var(--fr-text-2); flex: 1; transition: color var(--fr-dur); }
.fr-sidebar-cat__count {
    font-family: var(--fr-mono); font-size: 10px; color: var(--fr-text-3);
    background: var(--fr-border); padding: 1px 6px; border-radius: 20px;
    transition: background var(--fr-dur), color var(--fr-dur);
}
.fr-sidebar-cat.is-active .fr-sidebar-cat__count { background: var(--fr-accent-dim); color: var(--fr-accent); }

/* Rules */
.fr-rules { padding: 4px 0; }
.fr-rule {
    display: flex; gap: 10px; align-items: flex-start;
    padding: 8px 14px; border-bottom: 1px solid var(--fr-border);
}
.fr-rule:last-child { border-bottom: none; }
.fr-rule__num { font-family: var(--fr-mono); font-size: 9px; color: var(--fr-accent); opacity: 0.5; flex-shrink: 0; padding-top: 1px; }
.fr-rule__text { font-size: 12px; color: var(--fr-text-3); line-height: 1.5; }

/* Auth CTA */
.fr-auth-cta {
    background: var(--fr-accent-dim); border: 1px solid var(--fr-accent-border);
    border-radius: var(--fr-radius-lg); padding: 16px;
    display: flex; flex-direction: column; gap: 10px; align-items: center; text-align: center;
}
.fr-auth-cta__text { font-size: 12px; color: var(--fr-text-3); }

/* ══════════════════════════════════════════════
   MAIN COLUMN
══════════════════════════════════════════════ */
.fr-main { display: flex; flex-direction: column; min-width: 0; }

/* ══════════════════════════════════════════════
   TOPBAR
══════════════════════════════════════════════ */
.fr-topbar {
    position: sticky; top: var(--fr-page-top); z-index: 20;
    background: rgba(13,17,23,0.92);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--fr-border);
    padding: 10px 24px;
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    flex-wrap: wrap;
}

.fr-topbar__left  { display: flex; align-items: center; gap: 12px; }
.fr-topbar__right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

.fr-topbar__heading { display: flex; align-items: baseline; gap: 10px; }
.fr-feed-title { font-size: 17px; font-weight: 700; color: var(--fr-text); letter-spacing: -0.3px; }
.fr-feed-count  { font-size: 10px; letter-spacing: 1px; color: var(--fr-text-3); }

/* Mobile filter button */
.fr-mobile-filter-btn {
    display: none; position: relative;
    width: 36px; height: 36px;
    background: var(--fr-surface); border: 1px solid var(--fr-border);
    border-radius: var(--fr-radius-md); color: var(--fr-text-2);
    align-items: center; justify-content: center;
    transition: border-color var(--fr-dur), color var(--fr-dur);
}
.fr-mobile-filter-btn:hover { border-color: var(--fr-border-hover); color: var(--fr-text); }
.fr-filter-dot {
    position: absolute; top: 5px; right: 5px;
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--fr-accent); border: 1.5px solid var(--fr-bg);
}

/* Sort group */
.fr-sort-group {
    display: flex; gap: 1px;
    background: var(--fr-surface); border: 1px solid var(--fr-border);
    border-radius: var(--fr-radius-md); padding: 3px; flex-shrink: 0;
}
.fr-sort-btn {
    padding: 5px 12px; background: transparent; border: none;
    border-radius: var(--fr-radius-sm);
    font-family: var(--fr-mono); font-size: 10px; letter-spacing: 1px;
    color: var(--fr-text-3);
    transition: background var(--fr-dur), color var(--fr-dur);
}
.fr-sort-btn:hover { color: var(--fr-text-2); }
.fr-sort-btn:focus-visible { outline: 2px solid var(--fr-accent); outline-offset: -1px; }
.fr-sort-btn.is-active { background: var(--fr-accent-dim); color: var(--fr-accent); }

/* Search */
.fr-search {
    display: flex; align-items: center;
    background: var(--fr-surface); border: 1px solid var(--fr-border);
    border-radius: var(--fr-radius-md); overflow: hidden;
    min-width: 180px; max-width: 240px;
    transition: border-color var(--fr-dur), box-shadow var(--fr-dur);
}
.fr-search.is-focused {
    border-color: var(--fr-accent); box-shadow: 0 0 0 3px rgba(159,239,0,0.07);
}
.fr-search__icon {
    display: flex; align-items: center;
    padding: 0 10px; color: var(--fr-text-3);
    border-right: 1px solid var(--fr-border); align-self: stretch; flex-shrink: 0;
}
.fr-search__input {
    flex: 1; background: none; border: none; outline: none;
    padding: 8px 10px; font-size: 13px; color: var(--fr-text);
    caret-color: var(--fr-accent); min-width: 0;
}
.fr-search__input::placeholder { color: var(--fr-text-3); }
.fr-search__input::-webkit-search-cancel-button { display: none; }
.fr-search__clear {
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; background: none; border: none;
    color: var(--fr-text-3); transition: color var(--fr-dur); flex-shrink: 0;
}
.fr-search__clear:hover { color: var(--fr-red); }

/* ══════════════════════════════════════════════
   TABLET CATEGORY STRIP
   Hidden on desktop (sidebar handles it)
   Visible on tablet
══════════════════════════════════════════════ */
.fr-cat-strip {
    display: none;
    padding: 10px 24px;
    gap: 6px; flex-wrap: wrap;
    border-bottom: 1px solid var(--fr-border);
    background: var(--fr-surface);
}
.fr-cat-chip {
    padding: 5px 12px;
    background: none; border: 1px solid var(--fr-border);
    border-radius: 20px;
    font-size: 12px; color: var(--fr-text-3);
    transition: all var(--fr-dur);
    white-space: nowrap;
}
.fr-cat-chip:hover { border-color: var(--fr-border-hover); color: var(--fr-text-2); }
.fr-cat-chip:focus-visible { outline: 2px solid var(--fr-accent); }
.fr-cat-chip.is-active {
    background: var(--chip-color, var(--fr-accent));
    border-color: transparent;
    color: var(--fr-bg); font-weight: 600;
}

/* ══════════════════════════════════════════════
   FEED
══════════════════════════════════════════════ */
.fr-feed {
    display: flex; flex-direction: column;
    padding: 16px 24px 48px;
    gap: 1px;
    margin-top: 50px;
}

/* ══════════════════════════════════════════════
   THREAD ROW
   Signature: left accent bar encodes category
══════════════════════════════════════════════ */
.fr-thread {
    display: flex; align-items: flex-start; gap: 0;
    background: var(--fr-surface);
    border: 1px solid var(--fr-border);
    border-radius: var(--fr-radius-md);
    margin-bottom: 6px;
    cursor: pointer;
    transition: border-color var(--fr-dur), background var(--fr-dur);
    position: relative;
    overflow: hidden;
    animation: fr-fade-up 0.35s var(--fr-ease) both;
}
.fr-thread:hover { border-color: var(--fr-border-hover); background: rgba(255,255,255,0.012); }
.fr-thread:focus-visible { outline: 2px solid var(--fr-accent); outline-offset: 2px; }
.fr-thread.is-expanded {
    border-color: rgba(159,239,0,0.25); background: rgba(159,239,0,0.012);
    border-radius: var(--fr-radius-md) var(--fr-radius-md) 0 0;
    margin-bottom: 0;
}
.fr-thread.is-pinned { border-left-color: var(--fr-orange); }

/* Category accent bar — THE signature element */
.fr-thread__accent {
    width: 3px; flex-shrink: 0; align-self: stretch;
    border-radius: 3px 0 0 3px;
    opacity: 0.7;
}

/* Vote column */
.fr-vote {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    padding: 14px 10px 14px 12px; flex-shrink: 0; min-width: 44px;
}
.fr-vote__btn {
    display: flex; align-items: center; justify-content: center;
    width: 26px; height: 26px;
    background: none; border: 1px solid transparent;
    border-radius: var(--fr-radius-sm); color: var(--fr-text-3);
    transition: color var(--fr-dur), background var(--fr-dur), border-color var(--fr-dur);
}
.fr-vote__btn:hover:not(:disabled) { color: var(--fr-accent); background: var(--fr-accent-dim); border-color: var(--fr-accent-border); }
.fr-vote__btn:disabled { opacity: 0.3; cursor: default; }
.fr-vote__btn:focus-visible { outline: 2px solid var(--fr-accent); outline-offset: 1px; }
.fr-vote__btn.is-up { color: var(--fr-accent); }
.fr-vote__btn.is-down { color: var(--fr-red); }
.fr-vote__btn--sm { width: 22px; height: 22px; }
.fr-vote__score {
    font-family: var(--fr-mono); font-size: 12px; font-weight: 600;
    color: var(--fr-text-3); line-height: 1;
}
.fr-vote__score.is-pos { color: var(--fr-accent); }
.fr-vote__score.is-neg { color: var(--fr-red); }
.fr-vote__score--sm { font-size: 10px; }

/* Thread body */
.fr-thread__body { flex: 1; min-width: 0; padding: 14px 14px 14px 4px; }
.fr-thread__header { margin-bottom: 10px; }

.fr-thread__badges { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; flex-wrap: wrap; }

.fr-thread__title {
    font-size: 14.5px; font-weight: 600; color: var(--fr-text);
    line-height: 1.4; margin-bottom: 5px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}

.fr-thread__preview {
    font-size: 12.5px; color: var(--fr-text-3); line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}

.fr-thread__meta {
    display: flex; align-items: center; justify-content: space-between;
    gap: 10px; flex-wrap: wrap;
}

.fr-thread__author { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.fr-thread__stats  { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

.fr-stat {
    display: flex; align-items: center; gap: 4px;
    font-family: var(--fr-mono); font-size: 11px; color: var(--fr-text-3);
}
.fr-stat-sep {
    width: 3px; height: 3px; border-radius: 50%;
    background: var(--fr-border);
}

/* Chevron */
.fr-thread__chevron {
    display: flex; align-items: center; justify-content: center;
    width: 36px; flex-shrink: 0; align-self: stretch;
    background: none; border: none; color: var(--fr-text-3);
    transition: transform var(--fr-dur) var(--fr-ease), color var(--fr-dur);
}
.fr-thread__chevron:hover { color: var(--fr-text-2); }
.fr-thread__chevron:focus-visible { outline: 2px solid var(--fr-accent); outline-offset: -2px; }
.fr-thread__chevron.is-open { transform: rotate(180deg); color: var(--fr-accent); }

/* ══════════════════════════════════════════════
   BADGES
══════════════════════════════════════════════ */
.fr-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-family: var(--fr-mono); font-size: 9px; font-weight: 700;
    padding: 2px 7px; border-radius: 3px; letter-spacing: 1px; border: 1px solid;
}
.fr-badge--pinned { color: var(--fr-orange); background: rgba(255,165,0,0.08); border-color: rgba(255,165,0,0.22); }
.fr-badge--cat    { /* color/bg/border set inline via category color */ border-radius: 20px; font-size: 9px; }

/* ══════════════════════════════════════════════
   AUTHOR / ROLE
══════════════════════════════════════════════ */
.fr-avatar {
    border-radius: var(--fr-radius-sm);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--fr-mono); font-weight: 700; color: #fff; flex-shrink: 0;
}
.fr-avatar--xs { width: 24px; height: 24px; font-size: 10px; }
.fr-avatar--sm { width: 28px; height: 28px; font-size: 11px; }
.fr-avatar--md { width: 34px; height: 34px; font-size: 14px; }

.fr-author-name { font-size: 12px; font-weight: 600; }
.fr-author-name--public     { color: var(--fr-text-3); }
.fr-author-name--registered { color: var(--fr-text-2); }
.fr-author-name--reporter   { color: var(--fr-accent); }
.fr-author-name--admin      { color: var(--fr-orange); }

.fr-role-badge {
    font-family: var(--fr-mono); font-size: 8.5px; font-weight: 700;
    padding: 1px 5px; border-radius: 3px; letter-spacing: 1px; border: 1px solid;
}
.fr-role-badge--public     { color: var(--fr-text-3); background: rgba(74,81,96,0.1); border-color: var(--fr-border); }
.fr-role-badge--registered { color: var(--fr-blue);   background: rgba(0,200,255,0.08); border-color: rgba(0,200,255,0.2); }
.fr-role-badge--reporter   { color: var(--fr-accent); background: var(--fr-accent-dim); border-color: var(--fr-accent-border); }
.fr-role-badge--admin      { color: var(--fr-orange); background: rgba(255,165,0,0.08); border-color: rgba(255,165,0,0.22); }

.fr-verified {
    display: inline-flex; align-items: center; gap: 3px;
    font-family: var(--fr-mono); font-size: 8.5px; font-weight: 700;
    color: var(--fr-blue); background: rgba(0,200,255,0.06);
    border: 1px solid rgba(0,200,255,0.18); padding: 1px 5px; border-radius: 3px; letter-spacing: 0.5px;
}

/* ══════════════════════════════════════════════
   EXPANDED DETAIL PANEL
══════════════════════════════════════════════ */
.fr-detail {
    background: var(--fr-bg); border: 1px solid rgba(159,239,0,0.2);
    border-top: none; border-radius: 0 0 var(--fr-radius-md) var(--fr-radius-md);
    margin-bottom: 6px;
    animation: fr-expand 0.2s var(--fr-ease) both;
}

.fr-detail__post {
    padding: 20px;
    border-bottom: 1px solid var(--fr-border);
}

.fr-detail__author-row {
    display: flex; align-items: center; gap: 10px; margin-bottom: 16px; flex-wrap: wrap;
}
.fr-detail__author-info { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
.fr-detail__author-name-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.fr-detail__timestamp { font-size: 10px; letter-spacing: 0.5px; color: var(--fr-text-3); }

.fr-detail__actions { display: flex; gap: 8px; margin-left: auto; flex-shrink: 0; }
.fr-action-btn {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 10px; border-radius: var(--fr-radius-sm);
    font-family: var(--fr-mono); font-size: 10px; font-weight: 600; letter-spacing: 1px;
    border: 1px solid; transition: all var(--fr-dur);
    color: var(--fr-text-3); background: transparent; border-color: var(--fr-border);
}
.fr-action-btn:hover { color: var(--fr-orange); border-color: rgba(255,165,0,0.3); background: rgba(255,165,0,0.06); }
.fr-action-btn.is-pinned { color: var(--fr-orange); border-color: rgba(255,165,0,0.35); background: rgba(255,165,0,0.1); }
.fr-action-btn--flag:hover { color: var(--fr-red); border-color: rgba(255,62,62,0.3); background: rgba(255,62,62,0.06); }
.fr-action-btn--flag.is-flagged { color: var(--fr-red); border-color: rgba(255,62,62,0.3); background: rgba(255,62,62,0.08); }

/* Markdown */
.fr-detail__content.markdown-body { font-size: 14px; color: var(--fr-text-2); line-height: 1.8; word-break: break-word; }

/* ══════════════════════════════════════════════
   REPLIES
══════════════════════════════════════════════ */
.fr-replies-loading {
    display: flex; align-items: center; gap: 10px;
    padding: 16px 20px; font-size: 12px; letter-spacing: 1px; color: var(--fr-text-3);
}
.fr-replies { padding: 0 20px; }
.fr-replies__header {
    display: flex; align-items: center; gap: 12px; padding: 14px 0 10px;
}
.fr-replies__count { font-size: 9px; letter-spacing: 2px; color: var(--fr-text-3); flex-shrink: 0; }
.fr-replies__rule { flex: 1; height: 1px; background: var(--fr-border); }

.fr-reply {
    display: flex; gap: 10px;
    padding: 14px 0; border-bottom: 1px solid var(--fr-border);
}
.fr-reply:last-child { border-bottom: none; }
.fr-reply__vote { display: flex; flex-direction: column; align-items: center; gap: 1px; flex-shrink: 0; }
.fr-reply__body { flex: 1; min-width: 0; }
.fr-reply__meta { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; flex-wrap: wrap; }
.fr-reply__time { font-size: 10px; letter-spacing: 0.5px; color: var(--fr-text-3); margin-left: auto; }
.fr-reply__text { font-size: 13px; color: var(--fr-text-2); line-height: 1.7; word-break: break-word; }

/* ══════════════════════════════════════════════
   REPLY COMPOSER
══════════════════════════════════════════════ */
.fr-composer {
    padding: 16px 20px;
    border-top: 1px solid var(--fr-border);
}
.fr-composer__header {
    display: flex; align-items: center; gap: 8px; margin-bottom: 10px;
}
.fr-composer__label { font-size: 9px; letter-spacing: 2px; color: var(--fr-text-3); }
.fr-composer__box {
    background: var(--fr-surface); border: 1px solid var(--fr-border);
    border-radius: var(--fr-radius-md); overflow: hidden;
    transition: border-color var(--fr-dur), box-shadow var(--fr-dur);
}
.fr-composer__box.is-focused { border-color: var(--fr-accent); box-shadow: 0 0 0 3px rgba(159,239,0,0.06); }
.fr-composer__textarea {
    width: 100%; background: none; border: none; outline: none;
    padding: 12px 14px; font-family: var(--fr-font); font-size: 13px;
    color: var(--fr-text); resize: none; caret-color: var(--fr-accent); line-height: 1.6;
}
.fr-composer__textarea::placeholder { color: var(--fr-text-3); }
.fr-composer__footer {
    display: flex; align-items: center; justify-content: flex-end; gap: 10px; margin-top: 8px;
}
.fr-composer__char { font-size: 10px; letter-spacing: 0.5px; color: var(--fr-text-3); }

.fr-reply-cta {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px; border-top: 1px solid var(--fr-border);
    font-size: 13px; color: var(--fr-text-3);
}

/* ══════════════════════════════════════════════
   INLINE ERROR
══════════════════════════════════════════════ */
.fr-inline-error {
    display: flex; align-items: center; gap: 7px;
    font-family: var(--fr-mono); font-size: 11.5px; color: var(--fr-red);
    background: rgba(255,62,62,0.06); border: 1px solid rgba(255,62,62,0.18);
    border-radius: var(--fr-radius-sm); padding: 9px 12px; margin-top: 8px;
}

/* ══════════════════════════════════════════════
   BUTTONS
══════════════════════════════════════════════ */
.fr-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    padding: 8px 16px; border-radius: var(--fr-radius-sm);
    font-family: var(--fr-mono); font-size: 11px; font-weight: 600; letter-spacing: 1.5px;
    border: 1px solid transparent;
    transition: all var(--fr-dur); white-space: nowrap; cursor: pointer;
}
.fr-btn:focus-visible { outline: 2px solid var(--fr-accent); outline-offset: 2px; }
.fr-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.fr-btn--full { width: 100%; }

.fr-btn--accent { background: var(--fr-accent); color: var(--fr-bg); border-color: transparent; }
.fr-btn--accent:hover:not(:disabled) { opacity: 0.88; transform: translateY(-1px); }
.fr-btn--accent.is-loading { background: var(--fr-surface); color: var(--fr-text-3); }

.fr-btn--outline {
    background: transparent; color: var(--fr-text-2); border-color: var(--fr-border);
}
.fr-btn--outline:hover:not(:disabled) { border-color: var(--fr-border-hover); color: var(--fr-text); }

.fr-btn--ghost {
    background: var(--fr-surface); color: var(--fr-text-3); border-color: var(--fr-border);
}
.fr-btn--ghost:hover:not(:disabled) { color: var(--fr-text-2); border-color: var(--fr-border-hover); }

.fr-btn--danger { background: rgba(255,62,62,0.08); color: var(--fr-red); border-color: rgba(255,62,62,0.22); }
.fr-btn--danger:hover:not(:disabled) { background: rgba(255,62,62,0.15); border-color: var(--fr-red); }

.fr-icon-btn {
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; color: var(--fr-text-3);
    border-radius: var(--fr-radius-sm); padding: 4px;
    transition: color var(--fr-dur);
}
.fr-icon-btn:hover { color: var(--fr-text); }
.fr-icon-btn:focus-visible { outline: 2px solid var(--fr-accent); outline-offset: 2px; }

/* ══════════════════════════════════════════════
   SPINNER
══════════════════════════════════════════════ */
.fr-spinner {
    border-radius: 50%; border: 2px solid rgba(255,255,255,0.2);
    border-top-color: currentColor;
    animation: fr-spin 0.7s linear infinite; flex-shrink: 0;
}
.fr-spinner--sm { width: 13px; height: 13px; }
@@keyframes fr-spin { to { transform: rotate(360deg); } }

/* ══════════════════════════════════════════════
   STATE BOXES (empty / error)
══════════════════════════════════════════════ */
.fr-state {
    display: flex; flex-direction: column; align-items: center;
    padding: 72px 40px; margin: 16px 24px;
    background: var(--fr-surface); border: 1px solid var(--fr-border);
    border-radius: var(--fr-radius-lg); text-align: center; gap: 10px;
}
.fr-state__icon { color: var(--fr-text-3); opacity: 0.35; margin-bottom: 4px; }
.fr-state__title { font-family: var(--fr-mono); font-size: 12px; letter-spacing: 2px; color: var(--fr-text-3); }
.fr-state__sub { font-size: 13px; color: var(--fr-text-3); max-width: 360px; line-height: 1.6; }
.fr-state__sub strong { color: var(--fr-text-2); }

/* ══════════════════════════════════════════════
   SKELETONS
══════════════════════════════════════════════ */
.fr-skeleton {
    display: flex; gap: 14px; padding: 18px;
    background: var(--fr-surface); border: 1px solid var(--fr-border);
    border-radius: var(--fr-radius-md); margin-bottom: 6px;
    overflow: hidden; position: relative;
}
.fr-skeleton::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.025) 50%, transparent 100%);
    animation: fr-shimmer 1.8s ease-in-out infinite;
}
.fr-skeleton__bar { width: 3px; border-radius: 3px; background: var(--fr-border); align-self: stretch; flex-shrink: 0; }
.fr-skeleton__body { flex: 1; display: flex; flex-direction: column; gap: 8px; justify-content: center; }
.fr-skeleton__line { background: var(--fr-border); border-radius: 3px; }
.fr-skeleton__line--title   { height: 16px; width: 65%; }
.fr-skeleton__line--meta    { height: 10px; width: 30%; }
.fr-skeleton__line--preview { height: 11px; width: 85%; }

@@keyframes fr-shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }

/* ══════════════════════════════════════════════
   MODAL
══════════════════════════════════════════════ */
.fr-modal-backdrop {
    position: fixed; inset: 0; z-index: 100;
    background: rgba(0,0,0,0.75);
    backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
    animation: fr-fade 0.15s ease both;
}
.fr-modal {
    position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 560px; max-width: calc(100vw - 32px); max-height: 90vh; overflow-y: auto;
    background: var(--fr-surface); border: 1px solid var(--fr-border);
    border-radius: var(--fr-radius-lg); z-index: 101;
    animation: fr-modal-in 0.2s var(--fr-ease) both;
}
.fr-modal--sm { width: 380px; }
.fr-modal__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px; background: rgba(0,0,0,0.2);
    border-bottom: 1px solid var(--fr-border);
    position: sticky; top: 0; z-index: 1;
    backdrop-filter: blur(8px);
}
.fr-modal__title-row { display: flex; align-items: center; gap: 8px; }
.fr-modal__prompt { font-size: 15px; color: var(--fr-accent); font-weight: 600; }
.fr-modal__title  { font-size: 15px; color: var(--fr-text-2); font-weight: 600; }
.fr-modal__cursor { font-size: 15px; color: var(--fr-accent); animation: fr-blink 1s step-end infinite; }
.fr-modal__body   { padding: 20px; display: flex; flex-direction: column; gap: 16px; }
.fr-modal__actions { display: flex; gap: 8px; justify-content: flex-end; }

/* ══════════════════════════════════════════════
   FORM FIELDS (inside modal)
══════════════════════════════════════════════ */
.fr-field { display: flex; flex-direction: column; gap: 6px; }
.fr-field__label {
    display: flex; align-items: center; gap: 7px;
    font-family: var(--fr-mono); font-size: 9.5px; letter-spacing: 2px; color: var(--fr-text-3);
}
.fr-field__idx { color: var(--fr-accent); opacity: 0.55; }
.fr-field__md-hint { font-size: 9px; color: var(--fr-text-3); font-style: italic; letter-spacing: 0; }
.fr-field__hint-right { font-family: var(--fr-mono); font-size: 9.5px; color: var(--fr-text-3); text-align: right; }

.fr-input-wrap {
    display: flex; align-items: center;
    background: var(--fr-bg); border: 1px solid var(--fr-border);
    border-radius: var(--fr-radius-sm); overflow: hidden;
    transition: border-color var(--fr-dur), box-shadow var(--fr-dur);
}
.fr-input-wrap.is-focused { border-color: var(--fr-accent); box-shadow: 0 0 0 3px rgba(159,239,0,0.07); }
.fr-input {
    flex: 1; background: none; border: none; outline: none;
    padding: 11px 13px; font-family: var(--fr-mono); font-size: 13px;
    color: var(--fr-text); caret-color: var(--fr-accent);
}
.fr-input::placeholder { color: var(--fr-text-3); }

.fr-select-wrap {
    position: relative; background: var(--fr-bg);
    border: 1px solid var(--fr-border); border-radius: var(--fr-radius-sm);
    overflow: hidden; transition: border-color var(--fr-dur), box-shadow var(--fr-dur);
}
.fr-select-wrap.is-focused { border-color: var(--fr-accent); box-shadow: 0 0 0 3px rgba(159,239,0,0.07); }
.fr-select {
    width: 100%; padding: 11px 36px 11px 13px;
    background: transparent; border: none; outline: none;
    font-family: var(--fr-mono); font-size: 13px; color: var(--fr-text);
    appearance: none; cursor: pointer;
}
.fr-select option { background: var(--fr-surface); color: var(--fr-text); }
.fr-select-arrow {
    position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
    color: var(--fr-text-3); pointer-events: none; display: flex; align-items: center;
}

.fr-textarea-wrap {
    background: var(--fr-bg); border: 1px solid var(--fr-border);
    border-radius: var(--fr-radius-sm); overflow: hidden;
    transition: border-color var(--fr-dur), box-shadow var(--fr-dur);
}
.fr-textarea-wrap.is-focused { border-color: var(--fr-accent); box-shadow: 0 0 0 3px rgba(159,239,0,0.07); }
.fr-textarea {
    width: 100%; background: none; border: none; outline: none;
    padding: 12px 13px; font-family: var(--fr-font); font-size: 13px;
    color: var(--fr-text); resize: none; caret-color: var(--fr-accent); line-height: 1.65;
}
.fr-textarea::placeholder { color: var(--fr-text-3); }
.fr-textarea-footer { display: flex; justify-content: flex-end; padding: 5px 12px; border-top: 1px solid var(--fr-border); }
.fr-count { font-family: var(--fr-mono); font-size: 10px; color: var(--fr-text-3); }
.fr-count--warn { font-family: var(--fr-mono); font-size: 10px; color: var(--fr-orange); }

/* ══════════════════════════════════════════════
   MOBILE DRAWER
══════════════════════════════════════════════ */
.fr-drawer-backdrop {
    display: none;
    position: fixed; inset: 0; background: rgba(0,0,0,0.65); z-index: 40;
    animation: fr-fade 0.18s ease both;
}
.fr-drawer {
    display: none;
    position: fixed; top: 0; left: 0; bottom: 0;
    width: min(300px, 85vw);
    background: var(--fr-surface); border-right: 1px solid var(--fr-border);
    z-index: 50; overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.22s var(--fr-ease);
    flex-direction: column;
}
.fr-drawer--open { transform: translateX(0); }

.fr-drawer-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px; border-bottom: 1px solid var(--fr-border);
    background: rgba(0,0,0,0.2); position: sticky; top: 0;
    backdrop-filter: blur(8px);
}
.fr-drawer-title { font-size: 10px; letter-spacing: 2.5px; color: var(--fr-accent); }
.fr-drawer-body  { padding: 14px; display: flex; flex-direction: column; gap: 4px; }
.fr-drawer-section-label { font-family: var(--fr-mono); font-size: 9px; letter-spacing: 2px; color: var(--fr-text-3); padding: 10px 2px 4px; }
.fr-drawer-divider { height: 1px; background: var(--fr-border); margin: 8px 0; }

.fr-drawer-cat {
    display: flex; align-items: center; gap: 10px;
    width: 100%; padding: 10px 12px; background: none;
    border: none; border-radius: var(--fr-radius-md); transition: background var(--fr-dur);
    text-align: left;
}
.fr-drawer-cat:hover { background: rgba(255,255,255,0.04); }
.fr-drawer-cat.is-active { background: var(--fr-accent-dim); }
.fr-drawer-cat.is-active .fr-drawer-cat__name { color: var(--fr-accent); }
.fr-drawer-cat__icon { display: flex; width: 18px; flex-shrink: 0; }
.fr-drawer-cat__name { font-size: 13px; color: var(--fr-text-2); flex: 1; }
.fr-drawer-cat__count { font-family: var(--fr-mono); font-size: 10px; color: var(--fr-text-3); }

.fr-drawer-sort-group { display: flex; gap: 6px; flex-wrap: wrap; }
.fr-drawer-sort {
    padding: 7px 16px; background: var(--fr-bg); border: 1px solid var(--fr-border);
    border-radius: 20px; font-family: var(--fr-mono); font-size: 11px; letter-spacing: 1px;
    color: var(--fr-text-3); transition: all var(--fr-dur);
}
.fr-drawer-sort:hover { border-color: var(--fr-border-hover); color: var(--fr-text-2); }
.fr-drawer-sort.is-active { background: var(--fr-accent-dim); color: var(--fr-accent); border-color: var(--fr-accent-border); }

/* ══════════════════════════════════════════════
   FOCUS RING GLOBAL
══════════════════════════════════════════════ */
:focus-visible { outline: 2px solid var(--fr-accent); outline-offset: 2px; }

/* ══════════════════════════════════════════════
   ANIMATIONS
══════════════════════════════════════════════ */
@@keyframes fr-fade-up { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
@@keyframes fr-expand   { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:translateY(0); } }
@@keyframes fr-modal-in { from { opacity:0; transform:translate(-50%,-48%); } to { opacity:1; transform:translate(-50%,-50%); } }
@@keyframes fr-fade     { from { opacity:0; } to { opacity:1; } }
@@keyframes fr-blink    { 0%,100%{opacity:1} 50%{opacity:0} }

/* ══════════════════════════════════════════════
   RESPONSIVE — TABLET (≤960px)
   Sidebar hidden, filter strip visible
══════════════════════════════════════════════ */
@@media (max-width: 960px) {
    .fr-shell { grid-template-columns: 1fr; }
    .fr-sidebar { display: none; }
    .fr-cat-strip { display: flex; }
    .fr-topbar { padding: 10px 16px; }
    .fr-feed { padding: 12px 16px 40px; }
    .fr-state { margin: 12px 16px; }
    .fr-search { min-width: 140px; max-width: 200px; }
}

/* ══════════════════════════════════════════════
   RESPONSIVE — MOBILE (≤600px)
   Drawer replaces all navigation
   Cards redesigned for touch
══════════════════════════════════════════════ */
@@media (max-width: 600px) {
    :root { --fr-page-top: 56px; }

    .fr-corner { display: none; }
    .fr-cat-strip { display: none; }

    /* Show mobile filter btn */
    .fr-mobile-filter-btn { display: flex; }

    /* Show drawers */
    .fr-drawer { display: flex; }
    .fr-drawer-backdrop { display: block; }

    /* Topbar: compact */
    .fr-topbar { padding: 8px 12px; gap: 8px; }
    .fr-topbar__right { gap: 8px; }
    .fr-sort-group { display: none; }  /* sort moves to drawer on mobile */
    .fr-search { min-width: 0; max-width: none; flex: 1; }
    .fr-btn-label { display: none; }  /* icon-only new thread btn */
    .fr-btn--accent { padding: 8px 10px; }

    /* Feed */
    .fr-feed { padding: 10px 10px 36px; gap: 0; }

    /* Thread cards: more vertical on mobile */
    .fr-thread { gap: 0; border-radius: var(--fr-radius-md); margin-bottom: 8px; }
    .fr-vote { padding: 12px 8px; min-width: 38px; }
    .fr-thread__body { padding: 12px 8px 12px 4px; }
    .fr-thread__title { font-size: 13.5px; }
    .fr-thread__preview { display: none; }  /* hide preview on mobile — keeps cards compact */
    .fr-thread__stats { display: none; }    /* stats shown on expanded view */
    .fr-thread__chevron { width: 30px; }

    /* Detail panel */
    .fr-detail__post { padding: 14px; }
    .fr-detail__actions { flex-wrap: wrap; gap: 6px; }
    .fr-replies { padding: 0 14px; }
    .fr-composer { padding: 12px 14px; }

    /* Modal */
    .fr-modal { max-height: 95vh; }
    .fr-modal__body { padding: 14px; gap: 14px; }

    /* State */
    .fr-state { padding: 48px 20px; margin: 10px; }
    .fr-state__icon svg { width: 28px; height: 28px; }
}
</style>

@code {
    private List<PostResponseDTO>? _posts;
    private PostResponseDTO? _currentPostDetail;
    private bool _loadingPosts = true;
    private bool _loadingReplies = false;
    private string? _loadError;
    private string _activeCategory = "All";
    private string _searchQuery = string.Empty;
    private bool _searchFocused = false;
    private Guid? _expandedPostId;
    private string _sort = "new";
    private bool _drawerOpen = false;

    private bool _showNewPost = false;
    private string _newPostTitle = string.Empty;
    private string _newPostContent = string.Empty;
    private string _newPostCategory = "General";
    private bool _newPostLoading = false;
    private string _newPostError = string.Empty;
    private bool _titleFocused = false;
    private bool _contentFocused = false;
    private bool _catFocused = false;

    private string _replyContent = string.Empty;
    private bool _replyLoading = false;
    private bool _replyFocused = false;
    private string _replyError = string.Empty;

    private HashSet<Guid> _votedUp   = new();
    private HashSet<Guid> _votedDown = new();
    private HashSet<Guid> _flagged   = new();

    private bool _showFlagModal = false;
    private Guid _flagTargetId;
    private string _flagReason = "Misinformation";

    private record CategoryItem(string Name);
    private readonly CategoryItem[] _categories =
    {
        new("All"), new("General"), new("Threat Intel"),
        new("Malware Analysis"), new("Incident Reports"), new("Tools & Resources"),
    };

    private List<PostResponseDTO> FilteredPosts
    {
        get
        {
            if (_posts == null) return new();
            var list = _activeCategory == "All"
                ? _posts.AsEnumerable()
                : _posts.Where(p => p.Category == _activeCategory);
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.ToLower();
                list = list.Where(p =>
                    p.Title.ToLower().Contains(q) ||
                    p.Content.ToLower().Contains(q) ||
                    p.AuthorUsername.ToLower().Contains(q));
            }
            return list.ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitializeAsync();
            await LoadPosts();
            StateHasChanged();
        }
    }

    private async Task LoadPosts()
    {
        _loadingPosts = true; _loadError = null; StateHasChanged();
        var (data, error) = await ApiService.GetForumPostsAsync(_activeCategory, _sort);
        _loadingPosts = false;
        if (error != null) _loadError = error;
        else _posts = data ?? new();
        StateHasChanged();
    }

    private async Task SetSort(string sort)
    {
        _sort = sort;
        await LoadPosts();
    }

    private async Task TogglePost(Guid id)
    {
        if (_expandedPostId == id)
        {
            _expandedPostId = null; _currentPostDetail = null;
            _replyContent = _replyError = string.Empty;
            return;
        }
        _expandedPostId = id;
        _replyContent = _replyError = string.Empty;
        _loadingReplies = true; StateHasChanged();
        var (detail, _) = await ApiService.GetForumPostAsync(id);
        _currentPostDetail = detail; _loadingReplies = false; StateHasChanged();
        if (detail != null)
        {
            await Task.Delay(50);
            try
            {
                await JS.InvokeVoidAsync("eval",
                    $"(function(){{var el=document.getElementById('md-{id}');if(el&&window.marked)el.innerHTML=marked.parse({System.Text.Json.JsonSerializer.Serialize(detail.Content)});}})()" );
            }
            catch { /* marked not loaded — graceful fallback */ }
        }
    }

    private void SetCategory(string cat)
    {
        _activeCategory = cat; _expandedPostId = null; _ = LoadPosts();
    }

    private void OpenNewPost()
    {
        _newPostTitle = _newPostContent = _newPostError = string.Empty;
        _newPostCategory = "General"; _showNewPost = true;
    }

    private void CloseNewPost() { _showNewPost = false; _newPostError = string.Empty; }

    private async Task SubmitNewPost()
    {
        _newPostError = string.Empty;
        if (string.IsNullOrWhiteSpace(_newPostTitle))   { _newPostError = "Title is required."; return; }
        if (string.IsNullOrWhiteSpace(_newPostContent)) { _newPostError = "Content is required."; return; }
        _newPostLoading = true;
        var error = await ApiService.CreateForumPostAsync(_newPostTitle, _newPostContent, _newPostCategory);
        _newPostLoading = false;
        if (error != null) _newPostError = error;
        else { CloseNewPost(); await LoadPosts(); }
    }

    private async Task SubmitReply(Guid postId)
    {
        _replyError = string.Empty;
        if (string.IsNullOrWhiteSpace(_replyContent)) return;
        _replyLoading = true;
        var error = await ApiService.CreateReplyAsync(postId, _replyContent);
        _replyLoading = false;
        if (error != null) { _replyError = error; }
        else
        {
            _replyContent = string.Empty;
            var (detail, _) = await ApiService.GetForumPostAsync(postId);
            _currentPostDetail = detail;
            var post = _posts?.FirstOrDefault(p => p.Id == postId);
            if (post != null) post.ReplyCount = _currentPostDetail?.Replies.Count ?? 0;
        }
        StateHasChanged();
    }

    private async Task HandleUpvote(PostResponseDTO post)
    {
        if (_votedUp.Contains(post.Id)) return;
        _votedDown.Remove(post.Id); _votedUp.Add(post.Id); post.Upvotes++;
        StateHasChanged(); await ApiService.UpvotePostAsync(post.Id);
    }
    private async Task HandleDownvote(PostResponseDTO post)
    {
        if (_votedDown.Contains(post.Id)) return;
        _votedUp.Remove(post.Id); _votedDown.Add(post.Id); post.Downvotes++;
        StateHasChanged(); await ApiService.DownvotePostAsync(post.Id);
    }
    private async Task HandleUpvoteReply(ReplyResponseDTO reply)
    {
        if (_votedUp.Contains(reply.Id)) return;
        _votedDown.Remove(reply.Id); _votedUp.Add(reply.Id); reply.Upvotes++;
        StateHasChanged(); await ApiService.UpvotePostAsync(reply.Id);
    }
    private async Task HandleDownvoteReply(ReplyResponseDTO reply)
    {
        if (_votedDown.Contains(reply.Id)) return;
        _votedUp.Remove(reply.Id); _votedDown.Add(reply.Id); reply.Downvotes++;
        StateHasChanged(); await ApiService.DownvotePostAsync(reply.Id);
    }
    private async Task HandlePin(PostResponseDTO post)
    {
        await ApiService.TogglePinPostAsync(post.Id); post.IsPinned = !post.IsPinned; StateHasChanged();
    }
    private void HandleFlag(Guid postId)
    {
        _flagTargetId = postId; _flagReason = "Misinformation"; _showFlagModal = true;
    }
    private async Task SubmitFlag()
    {
        _showFlagModal = false; _flagged.Add(_flagTargetId);
        await ApiService.FlagPostAsync(_flagTargetId, _flagReason); StateHasChanged();
    }

    private static string GetAvatarColor(string u)
    {
        var colors = new[] { "#1a472a","#1e3a5f","#4a1942","#2d2b55","#3d2b1f","#1a3a3a","#2b3a1a","#3a1a2b" };
        return colors[Math.Abs(u.GetHashCode()) % colors.Length];
    }

    private static string GetCategoryColor(string cat) => cat switch
    {
        "Threat Intel"      => "#ff3e3e",
        "Malware Analysis"  => "#bf40bf",
        "Incident Reports"  => "#ffa500",
        "Tools & Resources" => "#00c8ff",
        _                   => "#8b949e",
    };

    private static string GetRelativeTime(DateTime dt)
    {
        var d = DateTime.UtcNow - dt;
        if (d.TotalMinutes < 1)  return "just now";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24)   return $"{(int)d.TotalHours}h ago";
        if (d.TotalDays < 7)     return $"{(int)d.TotalDays}d ago";
        return dt.ToString("MMM dd, yyyy");
    }
}
