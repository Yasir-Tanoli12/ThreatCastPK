@code {
    private List<PostResponseDTO>? _posts;
    private PostResponseDTO? _currentPostDetail;
    private bool _loadingPosts = true;
    private bool _loadingReplies = false;
    private string? _loadError;
    private string _activeCategory = "All";
    private string _searchQuery = string.Empty;
    private bool _searchFocused = false;
    private Guid? _expandedPostId;

    private bool _showNewPost = false;
    private string _newPostTitle = string.Empty;
    private string _newPostContent = string.Empty;
    private string _newPostCategory = "General";
    private bool _newPostLoading = false;
    private string _newPostError = string.Empty;
    private bool _titleFocused = false;
    private bool _contentFocused = false;
    private bool _catFocused = false;

    private string _replyContent = string.Empty;
    private bool _replyLoading = false;
    private bool _replyFocused = false;
    private string _replyError = string.Empty;

    private record CategoryItem(string Name, string Icon);

    private readonly CategoryItem[] _categories = {
        new("All",              "◈"),
        new("General",          "💬"),
        new("Threat Intel",     "🔍"),
        new("Malware Analysis", "🦠"),
        new("Incident Reports", "🚨"),
        new("Tools & Resources","⚙"),
    };

    private List<PostResponseDTO> FilteredPosts
    {
        get
        {
            if (_posts == null) return new();
            var list = _activeCategory == "All"
                ? _posts
                : _posts.Where(p => p.Category == _activeCategory).ToList();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.ToLower();
                list = list.Where(p =>
                    p.Title.ToLower().Contains(q) ||
                    p.Content.ToLower().Contains(q) ||
                    p.AuthorUsername.ToLower().Contains(q)
                ).ToList();
            }
            return list;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitializeAsync();
            await LoadPosts();
            StateHasChanged();
        }
    }

    private async Task LoadPosts()
    {
        _loadingPosts = true; _loadError = null;
        StateHasChanged();
        var (data, error) = await ApiService.GetForumPostsAsync();
        _loadingPosts = false;
        if (error != null) _loadError = error;
        else _posts = data ?? new();
        StateHasChanged();
    }

    private async Task TogglePost(Guid id)
    {
        if (_expandedPostId == id)
        {
            _expandedPostId = null;
            _currentPostDetail = null;
            _replyContent = string.Empty;
            _replyError = string.Empty;
            return;
        }

        _expandedPostId = id;
        _replyContent = string.Empty;
        _replyError = string.Empty;
        _loadingReplies = true;
        StateHasChanged();

        var (detail, _) = await ApiService.GetForumPostAsync(id);
        _currentPostDetail = detail;
        _loadingReplies = false;
        StateHasChanged();
    }

    private void SetCategory(string cat)
    {
        _activeCategory = cat;
        _expandedPostId = null;
    }

    private void OpenNewPost()
    {
        _newPostTitle = _newPostContent = _newPostError = string.Empty;
        _newPostCategory = "General";
        _showNewPost = true;
    }

    private void CloseNewPost()
    {
        _showNewPost = false;
        _newPostError = string.Empty;
    }

    private async Task SubmitNewPost()
    {
        _newPostError = string.Empty;
        if (string.IsNullOrWhiteSpace(_newPostTitle))
        { _newPostError = "Title is required."; return; }
        if (string.IsNullOrWhiteSpace(_newPostContent))
        { _newPostError = "Content is required."; return; }

        _newPostLoading = true;
        var error = await ApiService.CreateForumPostAsync(_newPostTitle, _newPostContent, _newPostCategory);
        _newPostLoading = false;

        if (error != null) { _newPostError = error; }
        else
        {
            CloseNewPost();
            await LoadPosts();
        }
    }

    private async Task SubmitReply(Guid postId)
    {
        _replyError = string.Empty;
        if (string.IsNullOrWhiteSpace(_replyContent)) return;

        _replyLoading = true;
        var error = await ApiService.CreateReplyAsync(postId, _replyContent);
        _replyLoading = false;

        if (error != null) { _replyError = error; }
        else
        {
            _replyContent = string.Empty;
            // Refresh the post detail to show new reply
            var (detail, _) = await ApiService.GetForumPostAsync(postId);
            _currentPostDetail = detail;
            // Also update reply count in list
            var post = _posts?.FirstOrDefault(p => p.Id == postId);
            if (post != null) post.ReplyCount = _currentPostDetail?.Replies.Count ?? 0;
        }
        StateHasChanged();
    }

    private static string GetAvatarColor(string username)
    {
        var colors = new[] { "#1a472a","#1e3a5f","#4a1942","#2d2b55","#3d2b1f","#1a3a3a","#2b3a1a","#3a1a2b" };
        return colors[Math.Abs(username.GetHashCode()) % colors.Length];
    }

    private static string GetRelativeTime(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 1)  return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24)   return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7)     return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("MMM dd, yyyy");
    }
}
