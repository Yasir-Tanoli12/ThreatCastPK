    .an-skel-bar {
        flex: 1;
        border-radius: 3px 3px 0 0;
    }

    .an-skel-donut {
        width: 170px;
        height: 170px;
        border-radius: 50%;
    }

    .an-table-skel {
        padding: 4px 0;
    }

    .an-table-skel__row {
        display: flex;
        gap: 20px;
        padding: 12px 20px;
