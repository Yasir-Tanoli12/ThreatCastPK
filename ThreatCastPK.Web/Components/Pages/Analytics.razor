    .an-type-chip--other         { background: rgba(110,118,129,0.08);color: var(--tc-text-muted);border-color: rgba(110,118,129,0.18); }

    /* ── Severity badges ── */
    .an-sev-badge {
        width: 26px; height: 26px;
        border-radius: var(--tc-radius-sm);
        display: flex; align-items: center; justify-content: center;
        font-family: var(--tc-font-mono);
        font-size: var(--tc-text-sm);
        font-weight: 700;
    }

    .an-sev--1 { background: rgba(159,239,0,0.1);  color: var(--tc-accent); }
    .an-sev--2 { background: rgba(125,199,0,0.1);  color: #7dc700; }
    .an-sev--3 { background: rgba(255,165,0,0.1);  color: var(--tc-warning); }
