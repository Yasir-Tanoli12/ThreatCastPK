    .an-risk-badge--low      { background: rgba(159,239,0,0.08);  color: var(--tc-accent);  border-color: rgba(159,239,0,0.25); }
    .an-risk-badge--medium   { background: rgba(255,165,0,0.08);  color: var(--tc-warning);  border-color: rgba(255,165,0,0.25); }
    .an-risk-badge--high     { background: rgba(255,107,53,0.08); color: #ff6b35;            border-color: rgba(255,107,53,0.25); }
    .an-risk-badge--critical { background: rgba(255,62,62,0.1);   color: var(--tc-danger);   border-color: rgba(255,62,62,0.3);
                               box-shadow: 0 0 8px rgba(255,62,62,0.15); }

    .an-sector__name {
        font-size: var(--tc-text-sm);
        font-weight: 600;
        color: var(--tc-text-secondary);
