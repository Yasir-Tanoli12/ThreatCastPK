        .an-table__td--hide-sm { display: none; }
    }

    @@media (max-width: 480px) {
        .an-stats { grid-template-columns: 1fr 1fr; }
        .an-stat { padding: 14px; }
        .an-stat__value { font-size: 1.25rem; }
        .an-sector-grid { grid-template-columns: 1fr 1fr; }
        .an-header__title { font-size: 1.5rem; }
        .an-chart-card__body { padding: 12px; }
    }
