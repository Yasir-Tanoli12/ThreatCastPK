    .an-sector--low      { border-left-color: rgba(159,239,0,0.4); }
    .an-sector--medium   { border-left-color: rgba(255,165,0,0.4); }
    .an-sector--high     { border-left-color: rgba(255,107,53,0.4); }
    .an-sector--critical { border-left-color: rgba(255,62,62,0.5); box-shadow: 0 0 16px rgba(255,62,62,0.06); }

    .an-sector:hover.an-sector--low      { border-left-color: var(--tc-accent); }
    .an-sector:hover.an-sector--medium   { border-left-color: var(--tc-warning); }
    .an-sector:hover.an-sector--high     { border-left-color: #ff6b35; }
    .an-sector:hover.an-sector--critical { border-left-color: var(--tc-danger); box-shadow: 0 0 24px rgba(255,62,62,0.1), 0 6px 24px rgba(0,0,0,0.3); }

    .an-sector__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .an-sector__icon {
        width: 30px; height: 30px;
        border-radius: var(--tc-radius-md);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .an-sector-icon--banking    { background: rgba(0,200,255,0.08);  color: #00c8ff;           border: 1px solid rgba(0,200,255,0.15); }
    .an-sector-icon--telecom    { background: rgba(159,239,0,0.08);  color: var(--tc-accent);  border: 1px solid rgba(159,239,0,0.15); }
    .an-sector-icon--healthcare { background: rgba(255,62,62,0.08);  color: var(--tc-danger);  border: 1px solid rgba(255,62,62,0.15); }
    .an-sector-icon--education  { background: rgba(255,165,0,0.08);  color: var(--tc-warning); border: 1px solid rgba(255,165,0,0.15); }
    .an-sector-icon--government { background: rgba(191,64,191,0.08); color: #bf40bf;           border: 1px solid rgba(191,64,191,0.15); }
    .an-sector-icon--energy     { background: rgba(255,207,0,0.08);  color: #ffc800;           border: 1px solid rgba(255,207,0,0.15); }
