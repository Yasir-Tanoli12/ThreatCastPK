@* ThreatCastPK.Web/Components/Pages/Analytics.razor *@
@page "/analytics"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject ApiService ApiService

<PageTitle>Analytics — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="analytics">

    @* ── Background effects ── *@
    <div class="tc-bg-grid" aria-hidden="true"></div>
    <div class="tc-scanline" aria-hidden="true"></div>
    <div class="tc-corner tc-corner--tl" aria-hidden="true"></div>
    <div class="tc-corner tc-corner--tr" aria-hidden="true"></div>
    <div class="tc-corner tc-corner--bl" aria-hidden="true"></div>
    <div class="tc-corner tc-corner--br" aria-hidden="true"></div>
    <div class="tc-orb" style="width:550px;height:550px;top:5%;right:-8%;--orb-color:rgba(159,239,0,0.05)" aria-hidden="true"></div>
    <div class="tc-orb" style="width:420px;height:420px;bottom:10%;left:-5%;--orb-color:rgba(0,180,255,0.035);animation-delay:5s;animation-direction:alternate-reverse;animation-duration:22s" aria-hidden="true"></div>
    <div class="tc-particles" aria-hidden="true">
        <span style="left:10%;animation-duration:24s;animation-delay:0s"></span>
        <span style="left:28%;animation-duration:20s;animation-delay:5s"></span>
        <span style="left:55%;animation-duration:26s;animation-delay:2s"></span>
        <span style="left:78%;animation-duration:22s;animation-delay:7s"></span>
        <span style="left:92%;animation-duration:18s;animation-delay:3s"></span>
    </div>
    <div class="tc-vignette" aria-hidden="true"></div>

    @* ── Content ── *@
    <div class="an-inner">

        @* ═══ HEADER ═══ *@
        <header class="an-header">
            <div class="an-header__left">
                <span class="an-header__label">THREAT INTELLIGENCE DASHBOARD</span>
                <h1 class="an-header__title">
                    Threat <span class="an-header__accent">Analytics</span>
                </h1>
                <p class="an-header__sub">
                    Aggregated cyber threat data across Pakistan's critical infrastructure.
                </p>
            </div>
            <div class="an-header__right">
                <div class="an-live-badge">
                    <span class="an-live-badge__dot"></span>
                    LIVE DATA
                </div>
            </div>
        </header>

        @* ═══ STAT CARDS ═══ *@
        <div class="an-stats">
            @if (_statsLoading)
            {
                @for (int i = 0; i < 4; i++)
                {
                    <div class="an-stat an-stat--skeleton">
                        <div class="tc-skeleton" style="width:32px;height:32px;border-radius:8px"></div>
                        <div class="tc-skeleton" style="width:55%;height:28px;margin-top:8px"></div>
                        <div class="tc-skeleton" style="width:70%;height:10px;margin-top:6px"></div>
                        <div class="tc-skeleton" style="width:45%;height:10px;margin-top:4px"></div>
                    </div>
                }
            }
            else
            {
                <div class="an-stat an-stat--green">
                    <div class="an-stat__icon an-stat__icon--green">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/></svg>
                    </div>
                    <span class="an-stat__value an-stat__value--green">@_totalToday</span>
                    <span class="an-stat__label">EVENTS TODAY</span>
                    <span class="an-stat__sub">Active threats</span>
                </div>

                <div class="an-stat an-stat--cyan">
                    <div class="an-stat__icon an-stat__icon--cyan">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <span class="an-stat__value an-stat__value--cyan">@_topCity</span>
                    <span class="an-stat__label">TOP TARGET CITY</span>
                    <span class="an-stat__sub">Most attacked</span>
                </div>

                <div class="an-stat an-stat--orange">
                    <div class="an-stat__icon an-stat__icon--orange">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
                    </div>
                    <span class="an-stat__value an-stat__value--orange">@_topType</span>
                    <span class="an-stat__label">DOMINANT ATTACK</span>
                    <span class="an-stat__sub">Most common type</span>
                </div>

                <div class="an-stat an-stat--red">
                    <div class="an-stat__icon an-stat__icon--red">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                    </div>
                    <span class="an-stat__value an-stat__value--red">@_topSector</span>
                    <span class="an-stat__label">HIGHEST RISK SECTOR</span>
                    <span class="an-stat__sub">Critical exposure</span>
                </div>
            }
        </div>

        @* ═══ CHARTS ROW — city bar + donut ═══ *@
        <div class="an-charts-row">

            <div class="an-chart-card">
                <div class="an-chart-card__header">
                    <div class="an-chart-card__titles">
                        <span class="an-chart-card__label">ATTACKS BY CITY</span>
                        <span class="an-chart-card__sub">Last 7 days</span>
                    </div>
                    @if (_chartsLoading)
                    {
                        <div class="an-chart-card__loader"></div>
                    }
                </div>
                <div class="an-chart-card__body">
                    @if (_chartsLoading)
                    {
                        <div class="an-skel-bars">
                            @for (int i = 0; i < 8; i++)
                            {
                                var h = 40 + (i % 4) * 30;
                                <div class="an-skel-bar tc-skeleton" style="height:@(h)px"></div>
                            }
                        </div>
                    }
                    else
                    {
                        <canvas id="cityChart" height="220"></canvas>
                    }
                </div>
            </div>

            <div class="an-chart-card an-chart-card--sm">
                <div class="an-chart-card__header">
                    <div class="an-chart-card__titles">
                        <span class="an-chart-card__label">ATTACK DISTRIBUTION</span>
                        <span class="an-chart-card__sub">By type</span>
                    </div>
                </div>
                <div class="an-chart-card__body an-chart-card__body--center">
                    @if (_chartsLoading)
                    {
                        <div class="an-skel-donut tc-skeleton"></div>
                    }
                    else
                    {
                        <canvas id="typeChart" height="200"></canvas>
                    }
                </div>
                @if (!_chartsLoading)
                {
                    <div class="an-donut-legend">
                        @foreach (var item in _typeData)
                        {
                            <div class="an-donut-legend__item">
                                <span class="an-donut-legend__dot" style="background:@item.Color;box-shadow:0 0 6px @(item.Color)44"></span>
                                <span class="an-donut-legend__name">@item.Label</span>
                                <span class="an-donut-legend__val">@item.Value</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* ═══ TREND CHART ═══ *@
        <div class="an-chart-card an-chart-card--full">
            <div class="an-chart-card__header">
                <div class="an-chart-card__titles">
                    <span class="an-chart-card__label">ATTACK TREND</span>
                    <span class="an-chart-card__sub">Last 30 days — daily event count</span>
                </div>
            </div>
            <div class="an-chart-card__body">
                @if (_chartsLoading)
                {
                    <div class="an-skel-wave tc-skeleton" style="height:140px;border-radius:6px"></div>
                }
                else
                {
                    <canvas id="trendChart" height="160"></canvas>
                }
            </div>
        </div>

        @* ═══ SECTOR RISK ═══ *@
        <section class="an-sector-section">
            <div class="an-section-header">
                <span class="an-section-header__label">SECTOR RISK LEVELS</span>
                <span class="an-section-header__sub">Updated every 30 minutes by ML analysis</span>
            </div>

            <div class="an-sector-grid">
                @if (_sectorLoading)
                {
                    @for (int i = 0; i < 7; i++)
                    {
                        <div class="an-sector an-sector--skeleton">
                            <div class="tc-skeleton" style="width:28px;height:28px;border-radius:6px"></div>
                            <div class="tc-skeleton" style="width:65%;height:14px;margin-top:8px"></div>
                            <div class="tc-skeleton" style="width:100%;height:3px;margin-top:8px;border-radius:2px"></div>
                            <div class="tc-skeleton" style="width:50%;height:10px;margin-top:4px"></div>
                        </div>
                    }
                }
                else
                {
                    @foreach (var sector in _sectorData)
                    {
                        <div class="an-sector an-sector--@sector.Risk.ToLower()">
                            <div class="an-sector__top">
                                <span class="an-sector__icon an-sector-icon--@sector.Name.ToLower()">
                                    @GetSectorSvg(sector.Name)
                                </span>
                                <span class="an-sector__risk-badge an-risk-badge--@sector.Risk.ToLower()">
                                    @sector.Risk.ToUpper()
                                </span>
                            </div>
                            <span class="an-sector__name">@sector.Name</span>
                            <div class="an-sector__bar">
                                <div class="an-sector__bar-fill an-bar-fill--@sector.Risk.ToLower()"
                                     style="width:@sector.FillPercent%"></div>
                            </div>
                            <span class="an-sector__events">@sector.EventCount events (24h)</span>
                        </div>
                    }
                }
            </div>
        </section>

        @* ═══ HIGH-SEVERITY TABLE ═══ *@
        <div class="an-chart-card">
            <div class="an-chart-card__header">
                <div class="an-chart-card__titles">
                    <span class="an-chart-card__label">RECENT HIGH-SEVERITY EVENTS</span>
                    <span class="an-chart-card__sub">Severity 4+ in last 24 hours</span>
                </div>
            </div>

            @if (_chartsLoading)
            {
                <div class="an-table-skel">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="an-table-skel__row">
                            <div class="tc-skeleton" style="width:60px;height:12px"></div>
                            <div class="tc-skeleton" style="width:100px;height:18px;border-radius:3px"></div>
                            <div class="tc-skeleton" style="width:70px;height:12px"></div>
                            <div class="tc-skeleton" style="width:80px;height:12px"></div>
                            <div class="tc-skeleton" style="width:26px;height:26px;border-radius:4px"></div>
                        </div>
                    }
                </div>
            }
            else if (_recentEvents.Count == 0)
            {
                <div class="an-no-events">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" />
                    </svg>
                    <span>No high-severity events in the last 24 hours</span>
                </div>
            }
            else
            {
                <div class="an-table">
                    <div class="an-table__header">
                        <span class="an-table__th">TIME</span>
                        <span class="an-table__th">ATTACK</span>
                        <span class="an-table__th">CITY</span>
                        <span class="an-table__th an-table__th--hide-sm">SECTOR</span>
                        <span class="an-table__th">SEV</span>
                        <span class="an-table__th an-table__th--hide-sm">SOURCE</span>
                    </div>
                    @foreach (var ev in _recentEvents)
                    {
                        <div class="an-table__row">
                            <span class="an-table__td an-table__td--time">@ev.Time</span>
                            <span class="an-table__td">
                                <span class="an-type-chip an-type-chip--@ev.Type.ToLower().Replace(" ","")">
                                    @GetAttackSvg(ev.Type) @ev.Type
                                </span>
                            </span>
                            <span class="an-table__td an-table__td--city">@ev.City</span>
                            <span class="an-table__td an-table__td--sector an-table__td--hide-sm">@ev.Sector</span>
                            <span class="an-table__td">
                                <span class="an-sev-badge an-sev--@ev.Severity">@ev.Severity</span>
                            </span>
                            <span class="an-table__td an-table__td--source an-table__td--hide-sm">@ev.Source</span>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>

<style>
    /* ══════════════════════════════════════════════════════════════════
       ANALYTICS PAGE — ThreatCast PK
       Glassmorphism · Staggered Reveals · Premium Cards
       ══════════════════════════════════════════════════════════════════ */

    .analytics {
        min-height: 100vh;
        background:
            radial-gradient(ellipse at 70% 15%, rgba(159,239,0,0.025) 0%, transparent 50%),
            radial-gradient(ellipse at 25% 75%, rgba(0,180,255,0.018) 0%, transparent 50%),
            var(--tc-bg-base);
        font-family: var(--tc-font-sans);
        padding: 76px 32px 64px;
        position: relative;
        overflow-x: hidden;
    }

    .an-inner {
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* ── Staggered entrance ── */
    .an-inner > * {
        animation: tc-fade-up 0.5s cubic-bezier(0.4,0,0.2,1) both;
    }
    .an-inner > *:nth-child(1) { animation-delay: 0s; }
    .an-inner > *:nth-child(2) { animation-delay: 0.06s; }
    .an-inner > *:nth-child(3) { animation-delay: 0.12s; }
    .an-inner > *:nth-child(4) { animation-delay: 0.18s; }
    .an-inner > *:nth-child(5) { animation-delay: 0.24s; }
    .an-inner > *:nth-child(6) { animation-delay: 0.30s; }
    .an-inner > *:nth-child(7) { animation-delay: 0.36s; }

    /* ══════════════════════════════════════════════════════════════════
       HEADER
       ══════════════════════════════════════════════════════════════════ */
    .an-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        padding-top: 40px;
        padding-bottom: 8px;
    }

    .an-header__label {
        font-family: var(--tc-font-mono);
        font-size: var(--tc-text-xs);
        color: var(--tc-accent);
        letter-spacing: 2.5px;
        opacity: 0.6;
        margin-bottom: var(--tc-space-3);
        display: block;
    }

    .an-header__title {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--tc-text-primary);
        line-height: 1.1;
        letter-spacing: -1px;
        margin-bottom: var(--tc-space-3);
    }

    .an-header__accent { color: var(--tc-accent); }

    .an-header__sub {
        font-size: var(--tc-text-base);
        color: var(--tc-text-muted);
        line-height: 1.5;
    }

    .an-live-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px;
        background: rgba(159,239,0,0.05);
        border: 1px solid rgba(159,239,0,0.2);
        border-radius: var(--tc-radius-full);
        font-family: var(--tc-font-mono);
        font-size: 9px;
        color: var(--tc-accent);
        letter-spacing: 2px;
    }

    .an-live-badge__dot {
        width: 7px; height: 7px;
        border-radius: 50%;
        background: var(--tc-accent);
        box-shadow: 0 0 10px rgba(159,239,0,0.7);
        animation: tc-pulse 1.3s ease-in-out infinite;
    }

    /* ══════════════════════════════════════════════════════════════════
       STAT CARDS
       ══════════════════════════════════════════════════════════════════ */
    .an-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .an-stat {
        background: rgba(22,27,34,0.55);
        backdrop-filter: blur(16px) saturate(1.3);
        -webkit-backdrop-filter: blur(16px) saturate(1.3);
        border: 1px solid rgba(33,38,45,0.6);
        border-radius: var(--tc-radius-lg);
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 0;
        transition: all var(--tc-ease-smooth);
        position: relative;
        overflow: hidden;
        border-left: 3px solid transparent;
    }

    .an-stat:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 28px rgba(0,0,0,0.35), var(--tc-glow);
    }

    .an-stat--green  { border-left-color: rgba(159,239,0,0.4); }
    .an-stat--cyan   { border-left-color: rgba(0,200,255,0.4); }
    .an-stat--orange { border-left-color: rgba(255,165,0,0.4); }
    .an-stat--red    { border-left-color: rgba(255,62,62,0.4); }
    .an-stat--skeleton { border-left-color: var(--tc-border); padding: 20px; }

    /* Hover accent glow line at top */
    .an-stat::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 1px;
        background: linear-gradient(90deg, var(--tc-accent), transparent);
        opacity: 0;
        transition: opacity var(--tc-ease-smooth);
    }
    .an-stat:hover::after { opacity: 0.5; }

    .an-stat__icon {
        width: 36px; height: 36px;
        border-radius: var(--tc-radius-md);
        display: flex; align-items: center; justify-content: center;
        margin-bottom: var(--tc-space-3);
    }

    .an-stat__icon--green  { background: rgba(159,239,0,0.1);  color: var(--tc-accent);  border: 1px solid rgba(159,239,0,0.2); }
    .an-stat__icon--cyan   { background: rgba(0,200,255,0.1);  color: #00c8ff;           border: 1px solid rgba(0,200,255,0.2); }
    .an-stat__icon--orange { background: rgba(255,165,0,0.1);  color: var(--tc-warning);  border: 1px solid rgba(255,165,0,0.2); }
    .an-stat__icon--red    { background: rgba(255,62,62,0.1);  color: var(--tc-danger);   border: 1px solid rgba(255,62,62,0.2); }

    .an-stat__value {
        font-family: var(--tc-font-mono);
        font-size: 1.65rem;
        font-weight: 600;
        line-height: 1;
    }

    .an-stat__value--green  { color: var(--tc-accent);  text-shadow: 0 0 18px rgba(159,239,0,0.25); }
    .an-stat__value--cyan   { color: #00c8ff;           text-shadow: 0 0 18px rgba(0,200,255,0.25); }
    .an-stat__value--orange { color: var(--tc-warning);  text-shadow: 0 0 18px rgba(255,165,0,0.25); }
    .an-stat__value--red    { color: var(--tc-danger);   text-shadow: 0 0 18px rgba(255,62,62,0.25); }

    .an-stat__label {
        font-family: var(--tc-font-mono);
        font-size: 8px;
        color: var(--tc-text-muted);
        letter-spacing: 2px;
        margin-top: var(--tc-space-2);
    }

    .an-stat__sub {
        font-size: var(--tc-text-xs);
        color: var(--tc-text-muted);
        margin-top: 2px;
    }

    /* ══════════════════════════════════════════════════════════════════
       CHART CARDS — GLASS
       ══════════════════════════════════════════════════════════════════ */
    .an-charts-row {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 16px;
    }

    .an-chart-card {
        background: rgba(22,27,34,0.55);
        backdrop-filter: blur(16px) saturate(1.3);
        -webkit-backdrop-filter: blur(16px) saturate(1.3);
        border: 1px solid rgba(33,38,45,0.6);
        border-radius: var(--tc-radius-lg);
        overflow: hidden;
        transition: border-color var(--tc-ease-smooth), box-shadow var(--tc-ease-smooth);
    }

    .an-chart-card:hover {
        border-color: rgba(33,38,45,0.9);
        box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    }

    .an-chart-card--full { width: 100%; }

    .an-chart-card__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        background: rgba(13,17,23,0.4);
        border-bottom: 1px solid rgba(33,38,45,0.5);
    }

    .an-chart-card__titles {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .an-chart-card__label {
        font-family: var(--tc-font-mono);
        font-size: 9px;
        color: var(--tc-accent);
        letter-spacing: 2px;
        opacity: 0.7;
    }

    .an-chart-card__sub {
        font-size: var(--tc-text-xs);
        color: var(--tc-text-muted);
    }

    .an-chart-card__loader {
        width: 10px; height: 10px;
        border-radius: 50%;
        border: 2px solid var(--tc-border);
        border-top-color: var(--tc-accent);
        animation: tc-spin 0.8s linear infinite;
    }

    .an-chart-card__body {
        padding: 20px;
    }

    .an-chart-card__body--center {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ── Donut legend ── */
    .an-donut-legend {
        padding: 0 20px 16px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .an-donut-legend__item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 3px 0;
    }

    .an-donut-legend__dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .an-donut-legend__name {
        font-size: var(--tc-text-sm);
