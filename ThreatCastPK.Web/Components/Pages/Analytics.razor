    .an-sev--5 { background: rgba(255,62,62,0.14); color: var(--tc-danger); box-shadow: 0 0 10px rgba(255,62,62,0.2); }

    /* ── No events ── */
    .an-no-events {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 28px 20px;
        font-family: var(--tc-font-mono);
        font-size: var(--tc-text-sm);
        color: var(--tc-accent);
    }

    .an-no-events svg {
        flex-shrink: 0;
        filter: drop-shadow(0 0 6px rgba(159,239,0,0.3));
    }

    /* ══════════════════════════════════════════════════════════════════
       RESPONSIVE
       ══════════════════════════════════════════════════════════════════ */
    @@media (max-width: 1100px) {
        .an-sector-grid { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
    }

    @@media (max-width: 1024px) {
        .an-stats { grid-template-columns: repeat(2, 1fr); }
        .an-charts-row { grid-template-columns: 1fr; }
    }

    @@media (max-width: 768px) {
        .analytics { padding: 72px 16px 40px; }
        .an-header { padding-top: 24px; }
        .an-header__title { font-size: 1.75rem; }
