</style>

@code {
    private bool _statsLoading = true;
    private bool _chartsLoading = true;
    private bool _sectorLoading = true;

    private int _totalToday = 0;
    private string _topCity = "—";
    private string _topType = "—";
    private string _topSector = "—";

    private record TypeDataItem(string Label, int Value, string Color);
    private List<TypeDataItem> _typeData = new();

    private record SectorDataItem(string Name, string Icon, string Risk, int EventCount, int FillPercent);
    private List<SectorDataItem> _sectorData = new();

    private record EventItem(string Time, string Type, string TypeIcon, string City, string Sector, int Severity, string Source);
    private List<EventItem> _recentEvents = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadData();
    }

    private async Task LoadData()
{
    _statsLoading = true;
    StateHasChanged();

    var (stats, _) = await ApiService.GetStatsAsync();
    if (stats != null)
    {
        _totalToday = stats.TotalToday;
        _topCity    = stats.TopCity;
        _topType    = stats.TopAttackType;
        _topSector  = stats.TopSector;
    }

    _statsLoading = false;
    StateHasChanged();

    _chartsLoading = true;
    StateHasChanged();

    var (typeData, _)   = await ApiService.GetByTypeAsync();
    var (recentData, _) = await ApiService.GetRecentEventsAsync();

    var typeColors = new Dictionary<string, string>
    {
        ["Ransomware"]    = "#ff3e3e",
        ["Phishing"]      = "#ffa500",
        ["DDoS"]          = "#00c8ff",
        ["Malware"]       = "#bf40bf",
        ["IdentityTheft"] = "#ff6b35",
        ["Other"]         = "#6e7681"
    };

    _typeData = (typeData ?? new()).Select(t => new TypeDataItem(
        t.AttackType,
        t.Count,
        typeColors.GetValueOrDefault(t.AttackType, "#6e7681")
    )).ToList();

    // Fill in zeros for missing types
    foreach (var (key, color) in typeColors)
        if (!_typeData.Any(t => t.Label == key))
            _typeData.Add(new TypeDataItem(key, 0, color));

    var typeIconMap = new Dictionary<string, string>
    {
        ["Ransomware"]    = "🔐", ["Phishing"] = "🎣",
        ["DDoS"]          = "🌊", ["Malware"]  = "🦠",
        ["IdentityTheft"] = "👤", ["Other"]    = "⚠"
    };

    _recentEvents = (recentData ?? new()).Select(e => new EventItem(
        e.Time, e.AttackType,
        typeIconMap.GetValueOrDefault(e.AttackType, "⚠"),
        e.City, e.TargetSector, e.Severity, e.Source
    )).ToList();

    _chartsLoading = false;
    StateHasChanged();

    await Task.Delay(100);

    // Fetch city and trend data for charts
    var (cityData, _)  = await ApiService.GetByCityAsync();
    var (trendData, _) = await ApiService.GetTrendAsync();

    var allCities = new[] { "Karachi","Lahore","Islamabad","Rawalpindi",
                            "Faisalabad","Peshawar","Multan","Quetta" };

    var cityValues = allCities
        .Select(c => cityData?.FirstOrDefault(x => x.City == c)?.Count ?? 0)
        .ToArray();

    var trendLabels = Enumerable.Range(0, 30)
        .Select(i => DateTime.UtcNow.AddDays(-29 + i).ToString("MMM d"))
        .ToArray();

    var trendValues = trendLabels
        .Select(label => trendData?.FirstOrDefault(x => x.Date == label)?.Count ?? 0)
        .ToArray();

    await RenderCharts(allCities, cityValues, trendLabels, trendValues);

    // Sector risk
    _sectorLoading = true;
    StateHasChanged();

    var (sectorData, _) = await ApiService.GetSectorRiskAsync();

    var sectorIcons = new Dictionary<string, string>
    {
        ["Banking"] = "🏦", ["Telecom"] = "📡", ["Healthcare"] = "🏥",
        ["Education"] = "🎓", ["Government"] = "🏛",
        ["Energy"] = "⚡", ["Other"] = "◈"
    };

    var fillMap = new Dictionary<string, int>
    {
        ["Low"] = 15, ["Medium"] = 45, ["High"] = 75, ["Critical"] = 100
    };

    _sectorData = (sectorData ?? new()).Select(s => new SectorDataItem(
        s.Sector,
        sectorIcons.GetValueOrDefault(s.Sector, "◈"),
        s.RiskLevel,
        s.EventCount,
        fillMap.GetValueOrDefault(s.RiskLevel, 15)
    )).ToList();

    _sectorLoading = false;
    StateHasChanged();
}

    private async Task RenderCharts(string[] cityLabels, int[] cityData,
    string[] trendLabels, int[] trendData)
{
    try
    {
        var typeLabels = _typeData.Select(t => t.Label).ToArray();
        var typeValues = _typeData.Select(t => t.Value).ToArray();
        var typeColors = _typeData.Select(t => t.Color).ToArray();

        await JS.InvokeVoidAsync("tcpkCharts.renderAll",
            cityLabels, cityData,
            typeLabels, typeValues, typeColors,
            trendLabels, trendData);
    }
    catch { }
}
}
