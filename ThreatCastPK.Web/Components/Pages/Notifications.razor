@* ThreatCastPK.Web/Components/Pages/Notifications.razor *@
@page "/notifications"
@rendermode InteractiveServer
@inject AuthService AuthService
@using ThreatCastPK.Web.Services
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject ApiService ApiService
@implements IDisposable

<PageTitle>Notifications — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<AuthGuard>
<div class="notif-root">
    <div class="bg-grid"></div>
    <div class="scan-line"></div>
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>

    <div class="notif-inner">

        @* ── Header ── *@
        <div class="page-header">
            <div class="ph-left">
                <div class="ph-label"> ALERT FEED</div>
                <h1 class="ph-title">
                    Threat <span class="ph-accent">Notifications</span>
                </h1>
                <p class="ph-sub">
                    Real-time alerts matching your subscribed threat filters.
                </p>
            </div>
            <div class="ph-right">
                @if (NotificationService.All.Any())
                {
                    <div class="header-actions">
                        @if (NotificationService.UnreadCount > 0)
                        {
                            <button class="mark-read-btn" @onclick="MarkAllRead">
                                ✓ MARK ALL READ
                            </button>
                        }
                        <button class="clear-btn" @onclick="ClearAll">
                            ✕ CLEAR ALL
                        </button>
                    </div>
                }
            </div>
        </div>

        @* ── Stats ── *@
        <div class="notif-stats">
            <div class="ns-item">
                <span class="ns-val">@NotificationService.All.Count</span>
                <span class="ns-label">TOTAL</span>
            </div>
            <div class="ns-divider"></div>
            <div class="ns-item">
                <span class="ns-val unread">@NotificationService.UnreadCount</span>
                <span class="ns-label">UNREAD</span>
            </div>
            <div class="ns-divider"></div>
            <div class="ns-item">
                <span class="ns-val read">@(NotificationService.All.Count - NotificationService.UnreadCount)</span>
                <span class="ns-label">READ</span>
            </div>
            <div class="ns-divider"></div>
            <div class="ns-status">
                <span class="ns-dot"></span>
                <span class="ns-status-text">LIVE — connected to SignalR</span>
            </div>
        </div>

        @* ── Filter tabs ── *@
        <div class="filter-bar">
            <div class="filter-tabs">
                <button class="filter-tab @(_filter == "all" ? "tab-active" : "")"
                        @onclick='() => _filter = "all"'>
                    ALL
                    <span class="tab-count @(_filter == "all" ? "tab-count-active" : "")">
                        @NotificationService.All.Count
                    </span>
                </button>
                <button class="filter-tab @(_filter == "unread" ? "tab-active" : "")"
                        @onclick='() => _filter = "unread"'>
                    UNREAD
                    <span class="tab-count @(_filter == "unread" ? "tab-count-active" : "")">
                        @NotificationService.UnreadCount
                    </span>
                </button>
                <button class="filter-tab @(_filter == "read" ? "tab-active" : "")"
                        @onclick='() => _filter = "read"'>
                    READ
                    <span class="tab-count @(_filter == "read" ? "tab-count-active" : "")">
                        @(NotificationService.All.Count - NotificationService.UnreadCount)
                    </span>
                </button>
            </div>
        </div>

        @* ── Notification list ── *@
        @{
            var displayed = _filter switch
            {
                "unread" => NotificationService.All.Where(n => !n.IsRead).ToList(),
                "read"   => NotificationService.All.Where(n => n.IsRead).ToList(),
                _        => NotificationService.All.ToList()
            };
        }

        @if (!displayed.Any())
        {
            <div class="empty-state">
                @if (_filter == "unread")
                {
                    <div class="es-icon">✓</div>
                    <div class="es-title">ALL CAUGHT UP</div>
                    <div class="es-sub">No unread notifications. You're up to date.</div>
                }
                else if (_filter == "read")
                {
                    <div class="es-icon">○</div>
                    <div class="es-title">NO READ NOTIFICATIONS</div>
                    <div class="es-sub">You haven't read any notifications yet.</div>
                }
                else
                {
                    <div class="es-icon">🔔</div>
                    <div class="es-title">NO NOTIFICATIONS YET</div>
                    <div class="es-sub">
                        Alerts will appear here when attacks match your subscriptions.
                    </div>
                    <a href="/subscriptions" class="es-cta">
                        ⚡ Set up alert subscriptions →
                    </a>
                }
            </div>
        }
        else
        {
            <div class="notif-list">
                @foreach (var notif in displayed)
                {
                    <div class="notif-item @(!notif.IsRead ? "notif-unread" : "notif-read")"
                         @onclick="() => MarkRead(notif.Id)">

                        @* Severity / type icon *@
                        <div class="ni-icon-col">
                            <div class="ni-icon @GetNotifColor(notif.Message)">
                                @GetNotifIcon(notif.Message)
                            </div>
                            @if (!notif.IsRead)
                            {
                                <div class="ni-unread-dot"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="ni-content">
                            <div class="ni-message">
                                @((MarkupString)HighlightMessage(notif.Message))
                            </div>
                            <div class="ni-meta">
                                <span class="ni-time">@GetRelativeTime(notif.ReceivedAt)</span>
                                @if (!notif.IsRead)
                                {
                                    <span class="ni-new-badge">NEW</span>
                                }
                            </div>
                        </div>

                        @* Action *@
                        <div class="ni-actions">
                            <button class="ni-dismiss"
                                    title="Mark as read"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => MarkRead(notif.Id)">
                                ✓
                            </button>
                        </div>

                    </div>
                }
            </div>
        }

        @* ── Subscription CTA ── *@
        <div class="sub-cta-card">
            <div class="scc-left">
                <div class="scc-icon">⚡</div>
                <div class="scc-text">
                    <div class="scc-title">Customize your alert filters</div>
                    <div class="scc-sub">
                        Get notified for specific attack types, cities, and sectors.
                        Up to 3 subscriptions.
                    </div>
                </div>
            </div>
            <a href="/subscriptions" class="scc-btn">
                MANAGE SUBSCRIPTIONS →
            </a>
        </div>

    </div>
</div>
</AuthGuard>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .notif-root {
        min-height: 100vh;
        background: #0d1117;
        font-family: 'Inter', sans-serif;
        padding: 76px 32px 64px;
        position: relative; overflow-x: hidden;
    }

    .bg-grid {
        position: fixed; inset: 0;
        background-image:
            linear-gradient(rgba(159,239,0,0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(159,239,0,0.025) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none; z-index: 0;
    }

    .scan-line {
        position: fixed; top: -2px; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, #9fef00, transparent);
        animation: scan 8s linear infinite; opacity: 0.3;
        z-index: 1; pointer-events: none;
    }
    @@keyframes scan { 0% { top: -2px; } 100% { top: 100vh; } }

    .corner { position: fixed; width: 18px; height: 18px; z-index: 2; pointer-events: none; }
    .corner-tl { top: 14px; left: 14px; border-top: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-tr { top: 14px; right: 14px; border-top: 2px solid #9fef00; border-right: 2px solid #9fef00; }
    .corner-bl { bottom: 14px; left: 14px; border-bottom: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-br { bottom: 14px; right: 14px; border-bottom: 2px solid #9fef00; border-right: 2px solid #9fef00; }

    .notif-inner {
        max-width: 800px; margin: 0 auto;
        position: relative; z-index: 3;
        animation: fadeInUp 0.5s ease both;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Header ── */
    .page-header {
        display: flex; align-items: flex-end;
        justify-content: space-between; margin-bottom: 24px;
        flex-wrap: wrap; gap: 16px;
    }

    .ph-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        color: #9fef00; letter-spacing: 2px; opacity: 0.7; margin-bottom: 10px;
    }

    .ph-title {
        font-size: 40px; font-weight: 700; color: #e6edf3;
        line-height: 1.1; letter-spacing: -1px; margin-bottom: 10px;
    }

    .ph-accent { color: #9fef00; }
    .ph-sub { font-size: 14px; color: #6e7681; }

    .header-actions { display: flex; gap: 8px; }

    .mark-read-btn {
        padding: 8px 16px; background: rgba(159,239,0,0.08);
        border: 1px solid rgba(159,239,0,0.3); border-radius: 4px;
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        color: #9fef00; cursor: pointer; letter-spacing: 1px;
        transition: background 0.15s;
    }
    .mark-read-btn:hover { background: rgba(159,239,0,0.15); }

    .clear-btn {
        padding: 8px 16px; background: transparent;
        border: 1px solid #21262d; border-radius: 4px;
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        color: #6e7681; cursor: pointer; letter-spacing: 1px;
        transition: border-color 0.15s, color 0.15s;
    }
    .clear-btn:hover { border-color: #ff3e3e; color: #ff3e3e; }

    /* ── Stats ── */
    .notif-stats {
        display: flex; align-items: center; gap: 20px;
        padding: 16px 20px; background: #161b22;
        border: 1px solid #21262d; border-radius: 8px;
        margin-bottom: 20px;
    }

    .ns-item { display: flex; flex-direction: column; align-items: center; gap: 2px; }

    .ns-val {
        font-family: 'IBM Plex Mono', monospace; font-size: 22px;
        font-weight: 600; color: #c9d1d9;
    }
    .ns-val.unread { color: #9fef00; text-shadow: 0 0 10px rgba(159,239,0,0.3); }
    .ns-val.read   { color: #6e7681; }

    .ns-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 9px;
        color: #4a5160; letter-spacing: 2px;
    }

    .ns-divider { width: 1px; height: 32px; background: #21262d; }

    .ns-status {
        margin-left: auto; display: flex; align-items: center; gap: 8px;
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #4a5160; letter-spacing: 1px;
    }

    .ns-dot {
        width: 7px; height: 7px; border-radius: 50%; background: #9fef00;
        animation: blink 1.5s ease-in-out infinite;
        box-shadow: 0 0 6px rgba(159,239,0,0.5);
    }
    @@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.2; } }

    .ns-status-text { color: #9fef00; }

    /* ── Filter tabs ── */
    .filter-bar { margin-bottom: 16px; }

    .filter-tabs { display: flex; gap: 4px; }

    .filter-tab {
        display: flex; align-items: center; gap: 7px;
        padding: 8px 14px; background: transparent;
        border: 1px solid #21262d; border-radius: 4px; cursor: pointer;
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        color: #6e7681; letter-spacing: 1px; transition: all 0.15s;
    }
    .filter-tab:hover { border-color: #30363d; color: #c9d1d9; }

    .tab-active {
        background: rgba(159,239,0,0.08) !important;
        border-color: rgba(159,239,0,0.4) !important;
        color: #9fef00 !important;
    }

    .tab-count {
        font-size: 10px; background: #21262d;
        padding: 1px 6px; border-radius: 8px; color: #6e7681;
    }
    .tab-count-active { background: rgba(159,239,0,0.15); color: #9fef00; }

    /* ── Empty state ── */
    .empty-state {
        display: flex; flex-direction: column; align-items: center;
        padding: 80px 40px; background: #161b22;
        border: 1px solid #21262d; border-radius: 8px;
        text-align: center; gap: 12px;
    }

    .es-icon { font-size: 40px; opacity: 0.4; margin-bottom: 4px; }

    .es-title {
        font-family: 'IBM Plex Mono', monospace; font-size: 14px;
        font-weight: 600; color: #6e7681; letter-spacing: 2px;
    }

    .es-sub { font-size: 13px; color: #4a5160; max-width: 360px; line-height: 1.6; }

    .es-cta {
        margin-top: 8px; padding: 10px 20px;
        background: rgba(159,239,0,0.08); border: 1px solid rgba(159,239,0,0.3);
        border-radius: 4px; font-family: 'IBM Plex Mono', monospace;
        font-size: 11px; color: #9fef00; text-decoration: none;
        letter-spacing: 1px; transition: background 0.15s;
    }
    .es-cta:hover { background: rgba(159,239,0,0.14); }

    /* ── Notification list ── */
    .notif-list {
        background: #161b22; border: 1px solid #21262d;
        border-radius: 8px; overflow: hidden; margin-bottom: 20px;
    }

    .notif-item {
        display: flex; align-items: flex-start; gap: 14px;
        padding: 16px 20px; border-bottom: 1px solid #21262d;
        cursor: pointer; transition: background 0.1s;
        position: relative;
    }
    .notif-item:last-child { border-bottom: none; }

    .notif-unread {
        background: rgba(159,239,0,0.02);
        border-left: 3px solid #9fef00 !important;
    }
    .notif-unread:hover { background: rgba(159,239,0,0.04); }

    .notif-read { border-left: 3px solid transparent; }
    .notif-read:hover { background: #0d1117; }

    /* ── Notif icon col ── */
    .ni-icon-col {
        position: relative; flex-shrink: 0;
    }

    .ni-icon {
        width: 36px; height: 36px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px; flex-shrink: 0;
    }

    .ni-icon.color-red    { background: rgba(255,62,62,0.12); border: 1px solid rgba(255,62,62,0.2); }
    .ni-icon.color-orange { background: rgba(255,165,0,0.12); border: 1px solid rgba(255,165,0,0.2); }
    .ni-icon.color-blue   { background: rgba(0,200,255,0.12); border: 1px solid rgba(0,200,255,0.2); }
    .ni-icon.color-purple { background: rgba(191,64,191,0.12); border: 1px solid rgba(191,64,191,0.2); }
    .ni-icon.color-green  { background: rgba(159,239,0,0.1); border: 1px solid rgba(159,239,0,0.2); }
    .ni-icon.color-grey   { background: rgba(110,118,129,0.12); border: 1px solid rgba(110,118,129,0.2); }

    .ni-unread-dot {
        position: absolute; top: -3px; right: -3px;
        width: 8px; height: 8px; border-radius: 50%;
        background: #9fef00; border: 2px solid #161b22;
    }

    /* ── Notif content ── */
    .ni-content { flex: 1; min-width: 0; }

    .ni-message {
        font-size: 13px; color: #c9d1d9;
        line-height: 1.55; margin-bottom: 6px;
    }

    .ni-message :global(.hl-city)   { color: #00c8ff; font-weight: 600; }
    .ni-message :global(.hl-type)   { color: #ff3e3e; font-weight: 600; font-family: 'IBM Plex Mono', monospace; font-size: 12px; }
    .ni-message :global(.hl-sector) { color: #ffa500; font-weight: 600; }
    .ni-message :global(.hl-sev)    { color: #9fef00; font-family: 'IBM Plex Mono', monospace; font-size: 12px; }

    .ni-meta { display: flex; align-items: center; gap: 10px; }

    .ni-time {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #4a5160; letter-spacing: 0.5px;
    }

    .ni-new-badge {
        font-family: 'IBM Plex Mono', monospace; font-size: 9px;
        font-weight: 700; color: #9fef00; letter-spacing: 1px;
        background: rgba(159,239,0,0.1); border: 1px solid rgba(159,239,0,0.25);
        padding: 1px 6px; border-radius: 2px;
    }

    /* ── Notif actions ── */
    .ni-actions { flex-shrink: 0; }

    .ni-dismiss {
        width: 28px; height: 28px; border-radius: 4px;
        background: transparent; border: 1px solid #21262d;
        color: #4a5160; cursor: pointer; font-size: 12px;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s;
    }
    .ni-dismiss:hover { border-color: #9fef00; color: #9fef00; background: rgba(159,239,0,0.06); }

    /* ── Subscription CTA ── */
    .sub-cta-card {
        display: flex; align-items: center; justify-content: space-between;
        gap: 20px; padding: 20px 24px;
        background: #161b22; border: 1px solid #21262d;
        border-radius: 8px; flex-wrap: wrap;
        transition: border-color 0.2s;
    }
    .sub-cta-card:hover { border-color: #30363d; }

    .scc-left { display: flex; align-items: center; gap: 14px; }

    .scc-icon {
        font-size: 22px; width: 40px; height: 40px;
        background: rgba(159,239,0,0.08); border: 1px solid rgba(159,239,0,0.2);
        border-radius: 8px; display: flex; align-items: center;
        justify-content: center; flex-shrink: 0;
    }

    .scc-title { font-size: 14px; font-weight: 600; color: #c9d1d9; margin-bottom: 3px; }
    .scc-sub   { font-size: 12px; color: #6e7681; }

    .scc-btn {
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        font-weight: 600; color: #0d1117; background: #9fef00;
        border-radius: 4px; padding: 10px 18px; text-decoration: none;
        letter-spacing: 1px; white-space: nowrap;
        transition: opacity 0.15s, box-shadow 0.15s;
    }
    .scc-btn:hover { opacity: 0.88; box-shadow: 0 4px 16px rgba(159,239,0,0.2); }

    /* ── Responsive ── */
    @@media (max-width: 600px) {
        .notif-root { padding: 72px 16px 40px; }
        .ph-title { font-size: 30px; }
        .notif-stats { flex-wrap: wrap; gap: 12px; }
        .ns-status { margin-left: 0; width: 100%; }
        .sub-cta-card { flex-direction: column; align-items: flex-start; }
        .scc-btn { width: 100%; text-align: center; }
    }
</style>

@code {
    private string _filter = "all";

    protected override void OnInitialized()
{
    NotificationService.OnChange += OnNotificationsChanged;
}

protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender) return;
    await AuthService.InitializeAsync();
    var (data, _) = await ApiService.GetNotificationsAsync();
    if (data != null)
    {
        foreach (var n in data)
        {
            NotificationService.AddNotification(new NotificationPayload
            {
                Id       = n.Id,
                Message  = n.Message,
                CreatedAt = n.CreatedAt,
                NotificationType = n.NotificationType
            });
        }
    }
    StateHasChanged();
}

    private void MarkRead(Guid id) => NotificationService.MarkAsRead(id);

    private void MarkAllRead() => NotificationService.MarkAllAsRead();

    private void ClearAll() => NotificationService.ClearAll();

    private void OnNotificationsChanged() => InvokeAsync(StateHasChanged);

    // Determine icon color based on message content
    private static string GetNotifColor(string message)
    {
        var m = message.ToLower();
        if (m.Contains("ransomware") || m.Contains("severity 5") || m.Contains("critical")) return "color-red";
        if (m.Contains("phishing") || m.Contains("identity") || m.Contains("severity 4")) return "color-orange";
        if (m.Contains("ddos")) return "color-blue";
        if (m.Contains("malware")) return "color-purple";
        if (m.Contains("approved")) return "color-green";
        return "color-grey";
    }

    private static string GetNotifIcon(string message)
    {
        var m = message.ToLower();
        if (m.Contains("ransomware")) return "🔐";
        if (m.Contains("phishing"))   return "🎣";
        if (m.Contains("ddos"))       return "🌊";
        if (m.Contains("malware"))    return "🦠";
        if (m.Contains("identity"))   return "👤";
        if (m.Contains("approved"))   return "✓";
        return "⚠";
    }

    // Wraps key terms in colored spans
    private static string HighlightMessage(string message)
    {
        var cities = new[] { "Karachi", "Lahore", "Islamabad", "Rawalpindi", "Faisalabad",
                             "Multan", "Peshawar", "Quetta", "Hyderabad", "Gujranwala",
                             "Sialkot", "Abbottabad" };
        var types = new[] { "DDoS", "Ransomware", "Phishing", "Malware", "Identity Theft" };
        var sectors = new[] { "Banking", "Telecom", "Healthcare", "Education",
                              "Government", "Energy" };

        var result = message;

        foreach (var city in cities)
            result = result.Replace(city, $"<span class='hl-city'>{city}</span>");

        foreach (var type in types)
            result = result.Replace(type, $"<span class='hl-type'>{type}</span>");

        foreach (var sector in sectors)
            result = result.Replace(sector, $"<span class='hl-sector'>{sector}</span>");

        // Highlight severity numbers
        for (int i = 1; i <= 5; i++)
            result = result.Replace($"Severity {i}", $"<span class='hl-sev'>Severity {i}</span>");

        return result;
    }

    private static string GetRelativeTime(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds}s ago";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24)   return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    public void Dispose()
    {
        NotificationService.OnChange -= OnNotificationsChanged;
    }
}
