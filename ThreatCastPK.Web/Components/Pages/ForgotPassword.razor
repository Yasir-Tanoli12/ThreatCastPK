@page "/forgot-password"
@rendermode InteractiveServer
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Forgot Password — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="fp-root">
    <div class="bg-grid"></div>
    <div class="scan-line"></div>
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>

    <div class="fp-center">
        <div class="form-card @(_shake ? "shake" : "")">

            <div class="form-header">
                <a href="/login" class="back-link">← back to login</a>
                <div class="form-title-row">
                    <span class="form-prompt">$</span>
                    <h2 class="form-title">auth.reset</h2>
                    <span class="form-cursor">_</span>
                </div>
                <p class="form-subtitle">Enter your email to receive a reset link</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="error-banner">
                    <span>⚠</span>
                    <span>@_errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="success-banner">
                    <span>✓</span>
                    <span>@_successMessage</span>
                </div>
            }

            <div class="form-body">
                @if (!_sent)
                {
                    <div class="field-group">
                        <label class="field-label">
                            <span class="label-index">01</span>
                            EMAIL_ADDRESS
                        </label>
                        <div class="input-wrapper @(_focused ? "focused" : "")">
                            <span class="input-prefix">@@</span>
                            <input type="email"
                                   class="field-input"
                                   placeholder="operator@domain.pk"
                                   @bind="_email"
                                   @bind:event="oninput"
                                   @onfocus="() => _focused = true"
                                   @onblur="() => _focused = false"
                                   disabled="@_loading"
                                   @onkeydown="HandleKeyDown" />
                        </div>
                    </div>

                    <button class="submit-btn @(_loading ? "loading" : "")"
                            @onclick="HandleSubmit"
                            disabled="@(_loading || string.IsNullOrWhiteSpace(_email))">
                        @if (_loading)
                        {
                            <span class="btn-spinner"></span>
                            <span>SENDING...</span>
                        }
                        else
                        {
                            <span>SEND RESET LINK</span>
                            <span class="btn-arrow">→</span>
                        }
                    </button>
                }
                else
                {
                    <div class="sent-state">
                        <div class="sent-icon">📬</div>
                        <p class="sent-text">Check your inbox at <strong>@_email</strong></p>
                        <p class="sent-sub">The link expires in 1 hour. Check your spam folder if you don't see it.</p>
                        <button class="resend-btn" @onclick="() => _sent = false">
                            Try a different email
                        </button>
                    </div>
                }

                <div class="form-footer-links">
                    <span class="footer-text">Remembered it?</span>
                    <a href="/login" class="footer-link">Sign in →</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .fp-root {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0d1117;
        position: relative;
        overflow: hidden;
        font-family: 'Inter', sans-serif;
    }

    .bg-grid {
        position: fixed; inset: 0;
        background-image:
            linear-gradient(rgba(159,239,0,0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(159,239,0,0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none; z-index: 0;
    }

    .scan-line {
        position: fixed; top: -2px; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, #9fef00, transparent);
        animation: scan 6s linear infinite; opacity: 0.4; z-index: 1; pointer-events: none;
    }

    @@keyframes scan { 0% { top: -2px; } 100% { top: 100vh; } }

    .corner { position: fixed; width: 20px; height: 20px; z-index: 2; pointer-events: none; }
    .corner-tl { top: 16px; left: 16px; border-top: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-tr { top: 16px; right: 16px; border-top: 2px solid #9fef00; border-right: 2px solid #9fef00; }
    .corner-bl { bottom: 16px; left: 16px; border-bottom: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-br { bottom: 16px; right: 16px; border-bottom: 2px solid #9fef00; border-right: 2px solid #9fef00; }

    .fp-center {
        width: 440px;
        position: relative;
        z-index: 3;
        animation: fadeInUp 0.6s ease both;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .form-card {
        background: #161b22;
        border: 1px solid #21262d;
        border-radius: 8px;
        overflow: hidden;
    }

    .shake { animation: shake 0.4s ease !important; }

    @@keyframes shake {
        0%,100% { transform: translateX(0); }
        20% { transform: translateX(-8px); }
        40% { transform: translateX(8px); }
        60% { transform: translateX(-5px); }
        80% { transform: translateX(5px); }
    }

    .form-header {
        padding: 20px 28px 18px;
        border-bottom: 1px solid #21262d;
        background: #0d1117;
    }

    .back-link {
        display: inline-block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px; color: #4a5160;
        text-decoration: none; letter-spacing: 1px;
        margin-bottom: 12px; transition: color 0.15s;
    }
    .back-link:hover { color: #9fef00; }

    .form-title-row { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
    .form-prompt { font-family: 'IBM Plex Mono', monospace; font-size: 17px; color: #9fef00; font-weight: 600; }
    .form-title  { font-family: 'IBM Plex Mono', monospace; font-size: 17px; font-weight: 600; color: #c9d1d9; }
    .form-cursor { font-family: 'IBM Plex Mono', monospace; font-size: 17px; color: #9fef00; animation: blink 1s step-end infinite; }

    @@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }

    .form-subtitle { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #6e7681; }

    .error-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 28px;
        background: rgba(255,62,62,0.08);
        border-bottom: 1px solid rgba(255,62,62,0.2);
        font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #ff3e3e;
    }

    .success-banner {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 28px;
        background: rgba(159,239,0,0.08);
        border-bottom: 1px solid rgba(159,239,0,0.2);
        font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #9fef00;
    }

    .form-body { padding: 24px 28px; display: flex; flex-direction: column; gap: 18px; }

    .field-group { display: flex; flex-direction: column; gap: 7px; }

    .field-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #6e7681; letter-spacing: 2px;
        display: flex; align-items: center; gap: 8px;
    }

    .label-index { color: #9fef00; opacity: 0.6; }

    .input-wrapper {
        display: flex; align-items: center;
        background: #0d1117; border: 1px solid #21262d;
        border-radius: 4px; transition: border-color 0.15s, box-shadow 0.15s; overflow: hidden;
    }

    .input-wrapper.focused {
        border-color: #9fef00;
        box-shadow: 0 0 0 3px rgba(159,239,0,0.08);
    }

    .input-prefix {
        padding: 0 12px; font-size: 13px; color: #4a5160;
        border-right: 1px solid #21262d; flex-shrink: 0;
        user-select: none; line-height: 44px;
    }

    .field-input {
        flex: 1; background: transparent; border: none; outline: none;
        padding: 11px 14px;
        font-family: 'IBM Plex Mono', monospace; font-size: 13px;
        color: #c9d1d9; caret-color: #9fef00;
    }

    .field-input::placeholder { color: #4a5160; }
    .field-input:disabled { opacity: 0.5; cursor: not-allowed; }

    .submit-btn {
        width: 100%; padding: 13px 20px;
        background: #9fef00; border: none; border-radius: 4px;
        font-family: 'IBM Plex Mono', monospace; font-size: 12px; font-weight: 600;
        color: #0d1117; letter-spacing: 2px; cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: 10px;
        transition: opacity 0.15s, transform 0.1s, box-shadow 0.15s;
    }

    .submit-btn:hover:not(:disabled) {
        opacity: 0.92; transform: translateY(-1px);
        box-shadow: 0 4px 20px rgba(159,239,0,0.3);
    }

    .submit-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .submit-btn.loading { background: #21262d; color: #6e7681; }
    .btn-arrow { font-size: 14px; }

    .btn-spinner {
        width: 13px; height: 13px;
        border: 2px solid #4a5160; border-top-color: #9fef00;
        border-radius: 50%; animation: spin 0.7s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    .sent-state {
        display: flex; flex-direction: column;
        align-items: center; gap: 12px;
        padding: 16px 0; text-align: center;
    }

    .sent-icon { font-size: 40px; }

    .sent-text {
        font-size: 14px; color: #c9d1d9; line-height: 1.5;
    }

    .sent-sub {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px; color: #6e7681; line-height: 1.6;
    }

    .resend-btn {
        background: none; border: 1px solid #21262d; border-radius: 3px;
        padding: 7px 16px;
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        color: #6e7681; cursor: pointer; transition: border-color 0.15s, color 0.15s;
    }

    .resend-btn:hover { border-color: #6e7681; color: #c9d1d9; }

    .form-footer-links {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        padding-top: 4px; border-top: 1px solid #21262d; margin-top: 4px; padding-top: 16px;
    }

    .footer-text { font-size: 13px; color: #6e7681; }

    .footer-link {
        font-family: 'IBM Plex Mono', monospace; font-size: 12px;
        color: #9fef00; text-decoration: none; transition: opacity 0.15s;
    }

    .footer-link:hover { opacity: 0.75; }

    @@media (max-width: 500px) {
        .fp-center { width: 100%; padding: 0 16px; }
    }
</style>

@code {
    private string _email = string.Empty;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;
    private bool _loading = false;
    private bool _shake = false;
    private bool _focused = false;
    private bool _sent = false;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleSubmit();
    }

    private async Task HandleSubmit()
    {
        _errorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(_email)) return;

        _loading = true;
        StateHasChanged();

        var error = await ApiService.PostAsync("/api/auth/forgot-password", new { email = _email });

        _loading = false;

        if (error == null)
        {
            _sent = true;
        }
        else
        {
            _errorMessage = error;
            _shake = true;
            StateHasChanged();
            await Task.Delay(450);
            _shake = false;
        }

        StateHasChanged();
    }
}