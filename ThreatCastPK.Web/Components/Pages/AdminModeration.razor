@code {
    private List<ModerationReportResponse> _queue = new();
    private bool _loading = true;
    private string? _loadError;
    private int _pendingCount = 0;
    private int _approvedToday = 0;
    private int _rejectedToday = 0;

    private Guid? _expandedId;
    private Guid? _actioningId;
    private Guid? _approvingId;
    private bool _actionLoading = false;
    private string _actionError = string.Empty;
    private string _rejectReason = string.Empty;
    private bool _rejectReasonFocused = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadQueue();
            StateHasChanged();
        }
    }

    private async Task LoadQueue()
    {
        _loading = true; _loadError = null;
        StateHasChanged();

        var (data, error) = await ApiService.GetModerationQueueAsync();
        _loading = false;

        if (error != null) { _loadError = error; }
        else
        {
            _queue = data ?? new();
            _pendingCount = _queue.Count;
            _approvedToday = 0;
            _rejectedToday = 0;
        }
        StateHasChanged();
    }

    private void ToggleExpand(Guid id)
    {
        if (_expandedId == id)
        {
            _expandedId = null;
            CancelAction();
        }
        else
        {
            _expandedId = id;
            CancelAction();
        }
    }

    private void StartReject(Guid id)
    {
        _actioningId = id;
        _rejectReason = string.Empty;
        _actionError = string.Empty;
    }

    private void CancelAction()
    {
        _actioningId = null;
        _rejectReason = string.Empty;
        _actionError = string.Empty;
    }

    private async Task ApproveReport(Guid id)
    {
        _actionLoading = true;
        _approvingId = id;
        _actionError = string.Empty;
        StateHasChanged();

        var error = await ApiService.ApproveReportAsync(id);
        _actionLoading = false;
        _approvingId = null;

        if (error != null)
        {
            _actionError = error;
        }
        else
        {
            _queue.RemoveAll(r => r.Id == id);
            _pendingCount = _queue.Count;
            _approvedToday++;
            _expandedId = null;
        }
        StateHasChanged();
    }

    private async Task ConfirmReject(Guid id)
    {
        if (string.IsNullOrWhiteSpace(_rejectReason))
        {
            _actionError = "Rejection reason is required.";
            return;
        }

        _actionLoading = true;
        _actionError = string.Empty;
        StateHasChanged();

        var error = await ApiService.RejectReportAsync(id, _rejectReason);
        _actionLoading = false;

        if (error != null)
        {
            _actionError = error;
        }
        else
        {
            _queue.RemoveAll(r => r.Id == id);
            _pendingCount = _queue.Count;
            _rejectedToday++;
            _expandedId = null;
            CancelAction();
        }
        StateHasChanged();
    }

    private static string GetAvatarColor(string username)
    {
        var colors = new[] { "#1a472a", "#1e3a5f", "#4a1942", "#2d2b55", "#3d2b1f", "#1a3a3a", "#2b3a1a", "#3a1a2b" };
        return colors[Math.Abs(username.GetHashCode()) % colors.Length];
    }

    private static string GetRepColor(int rep) =>
        rep >= 75 ? "rep-green" : rep >= 30 ? "rep-yellow" : "rep-grey";

    private static string GetAttackIcon(string type) => type switch
    {
        "Ransomware" => "🔐",
        "Phishing" => "🎣",
        "DDoS" => "🌊",
        "IdentityTheft" => "👤",
        "Malware" => "🦠",
        _ => "⚠"
    };

    private static string GetSeverityLabel(int s) => s switch
    {
        1 => "Low",
        2 => "Medium",
        3 => "High",
        4 => "Critical",
        5 => "Catastrophic",
        _ => ""
    };

    private static string GetRelativeTime(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }
}