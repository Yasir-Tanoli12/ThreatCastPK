@* ThreatCastPK.Web/Components/Pages/AdminModeration.razor *@
@page "/admin/moderation"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Moderation Queue — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<AuthGuard RequiredRole="Admin">
    <div class="admin-root">
        <div class="bg-grid"></div>
        <div class="scan-line"></div>
        <div class="corner corner-tl"></div>
        <div class="corner corner-tr"></div>
        <div class="corner corner-bl"></div>
        <div class="corner corner-br"></div>

        <div class="admin-inner">

            @* ── Admin sub-nav ── *@
            <div class="admin-subnav">
                <NavLink href="/admin/moderation" class="subnav-link" ActiveClass="subnav-active" Match="NavLinkMatch.All">
                    <span>🛡</span> Moderation Queue
                    @if (_pendingCount > 0)
                    {
                        <span class="subnav-badge">@_pendingCount</span>
                    }
                </NavLink>
                <NavLink href="/admin/users" class="subnav-link" ActiveClass="subnav-active">
                    <span>👥</span> User Management
                </NavLink>
                <NavLink href="/admin/auditlog" class="subnav-link" ActiveClass="subnav-active">
                    <span>📋</span> Audit Log
                </NavLink>
            </div>

            @* ── Header ── *@
            <div class="page-header">
                <div class="ph-left">
                    <div class="ph-label">// ADMIN PANEL</div>
                    <h1 class="ph-title">
                        Moderation <span class="ph-accent">Queue</span>
                    </h1>
                    <p class="ph-sub">
                        Review and action community-submitted threat reports pending verification.
                    </p>
                </div>
                <div class="ph-right">
                    <button class="refresh-btn" @onclick="LoadQueue" disabled="@_loading">
                        @if (_loading)
                        {
                            <span class="btn-spinner-sm"></span>
                        }
                        else
                        {
                            <span>↺</span>
                        }
                        REFRESH
                    </button>
                </div>
            </div>

            @* Stats strip ── *@
            <div class="stats-strip">
                <div class="ss-item">
                    <span class="ss-val orange">@_pendingCount</span>
                    <span class="ss-label">PENDING REVIEW</span>
                </div>
                <div class="ss-div"></div>
                <div class="ss-item">
                    <span class="ss-val green">@_approvedToday</span>
                    <span class="ss-label">APPROVED TODAY</span>
                </div>
                <div class="ss-div"></div>
                <div class="ss-item">
                    <span class="ss-val red">@_rejectedToday</span>
                    <span class="ss-label">REJECTED TODAY</span>
                </div>
                <div class="ss-div"></div>
                <div class="ss-status">
                    <span class="ss-dot @(_pendingCount > 0 ? "dot-orange" : "dot-green")"></span>
                    <span class="ss-status-text">
                        @(_pendingCount > 0 ? $"{_pendingCount} reports need attention" : "Queue is clear")
                    </span>
                </div>
            </div>

            @* ML Queue Warning Banner *@
            @if (_queue.Any(r => r.IsMlAnomaly))
            {
                <div class="ml-queue-warning">
                    <div class="mq-header">
                        <span class="mq-blink">⚡</span>
                        <span>ML WARNING: Coordinated Attack Campaign isolated in current Pending queue!</span>
                    </div>
                    <div class="mq-details">
                        The Isolation Forest model detected @(_queue.Count(r => r.IsMlAnomaly)) reports sharing suspicious network,
                        geographic, and threat signature profiles. Please prioritize these review requests.
                    </div>
                </div>
            }

            @* ── Main content ── *@
            @if (_loading)
            {
                <div class="queue-list">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="skeleton-card">
                            <div class="sk-row">
                                <div class="sk-block sk-reporter"></div>
                                <div class="sk-block sk-type"></div>
                                <div class="sk-block sk-city"></div>
                                <div class="sk-block sk-sev"></div>
                                <div class="sk-block sk-actions"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (_loadError != null)
            {
                <div class="state-box">
                    <div class="sb-icon">⚠</div>
                    <div class="sb-title">FAILED TO LOAD QUEUE</div>
                    <div class="sb-sub">@_loadError</div>
                    <button class="sb-btn" @onclick="LoadQueue">↺ Retry</button>
                </div>
            }
            else if (_queue.Count == 0)
            {
                <div class="empty-queue">
                    <div class="eq-icon-wrap">
                        <div class="eq-icon">✓</div>
                        <div class="eq-glow"></div>
                    </div>
                    <div class="eq-title">QUEUE IS CLEAR</div>
                    <div class="eq-sub">All submitted reports have been reviewed. No action required.</div>
                    <div class="eq-tips">
                        <div class="tip-header">// MODERATION GUIDELINES</div>
                        <div class="tip-item">
                            <span class="tip-num">01</span>
                            <span>Verify the source IP against external threat intelligence before approving.</span>
                        </div>
                        <div class="tip-item">
                            <span class="tip-num">02</span>
                            <span>Check for duplicate events in the same city and attack type window.</span>
                        </div>
                        <div class="tip-item">
                            <span class="tip-num">03</span>
                            <span>Review reporter reputation score — low scores indicate unreliable submissions.</span>
                        </div>
                        <div class="tip-item">
                            <span class="tip-num">04</span>
                            <span>Always provide a clear rejection reason to help reporters improve.</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="queue-list">
                    @foreach (var report in _queue)
                    {
                        <div class="report-card @(_expandedId == report.Id ? "card-expanded" : "")">

                            @* ── Collapsed header ── *@
                            <div class="rc-header" @onclick="() => ToggleExpand(report.Id)">

                                <div class="rc-reporter">
                                    <div class="reporter-avatar" style="background:@GetAvatarColor(report.ReporterUsername)">
                                        @report.ReporterUsername[..1].ToUpper()
                                    </div>
                                    <div class="reporter-info">
                                        <span class="reporter-name">@report.ReporterUsername</span>
                                        <div class="reporter-rep">
                                            <span class="rep-label">REP</span>
                                            <span class="rep-value @GetRepColor(report.ReporterReputation)">
                                                @report.ReporterReputation
                                            </span>
                                            @if (report.ReporterReputation >= 75)
                                            {
                                                <span class="rep-trusted">TRUSTED</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="rc-type">
                                    <span class="type-chip chip-@report.AttackType.ToLower().Replace(" ", "")">
                                        @GetAttackIcon(report.AttackType) @report.AttackType
                                    </span>
                                    @if (report.IsMlAnomaly)
                                    {
                                        <span class="ml-anomaly-badge">ML ANOMALY</span>
                                    }
                                </div>

                                <div class="rc-location">
                                    <span class="city-dot"></span>
                                    <span class="city-name">@report.City</span>
                                </div>

                                <div class="rc-sector">
                                    <span class="sector-label">@report.TargetSector</span>
                                </div>

                                <div class="rc-sev">
                                    <span class="sev-badge sev-@report.Severity">@report.Severity</span>
                                </div>

                                <div class="rc-time">
                                    <span class="time-val">@GetRelativeTime(report.SubmittedAt)</span>
                                </div>

                                <div class="rc-chevron @(_expandedId == report.Id ? "chevron-open" : "")">▾</div>
                            </div>

                            @* ── Expanded detail ── *@
                            @if (_expandedId == report.Id)
                            {
                                <div class="rc-detail">

                                    <div class="detail-grid">

                                        @* Left — full report info *@
                                        <div class="detail-left">

                                            <div class="detail-section">
                                                <div class="ds-label">REPORT DETAILS</div>
                                                <div class="detail-fields">
                                                    <div class="df-row">
                                                        <span class="df-key">REPORT ID</span>
                                                        <span class="df-val mono">@report.Id.ToString()[..8]…</span>
                                                    </div>
                                                    <div class="df-row">
                                                        <span class="df-key">SUBMITTED</span>
                                                        <span class="df-val mono">@report.SubmittedAt.ToString("yyyy-MM-dd HH:mm UTC")</span>
                                                    </div>
                                                    <div class="df-row">
                                                        <span class="df-key">ATTACK TYPE</span>
                                                        <span class="df-val">@report.AttackType</span>
                                                    </div>
                                                    <div class="df-row">
                                                        <span class="df-key">TARGET SECTOR</span>
                                                        <span class="df-val">@report.TargetSector</span>
                                                    </div>
                                                    <div class="df-row">
                                                        <span class="df-key">CITY</span>
                                                        <span class="df-val">@report.City</span>
                                                    </div>
                                                    <div class="df-row">
                                                        <span class="df-key">SEVERITY</span>
                                                        <span class="df-val">
                                                            <span class="sev-badge sev-@report.Severity">@report.Severity</span>
                                                            — @GetSeverityLabel(report.Severity)
                                                        </span>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(report.SourceIP))
                                                    {
                                                        <div class="df-row">
                                                            <span class="df-key">SOURCE IP</span>
                                                            <span class="df-val mono ip-val">@report.SourceIP</span>
                                                        </div>
                                                    }
                                                    @if (report.IsMlAnomaly)
                                                    {
                                                        <div class="df-row ml-alert-row">
                                                            <span class="df-key font-warning">ML STATUS</span>
                                                            <span class="df-val text-warning font-weight-bold">ANOMALOUS (Isolation Forest Flagged)</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrEmpty(report.Description))
                                            {
                                                <div class="detail-section">
                                                    <div class="ds-label">INCIDENT DESCRIPTION</div>
                                                    <div class="desc-box">@report.Description</div>
                                                </div>
                                            }

                                        </div>

                                        @* Right — reporter info + actions *@
                                        <div class="detail-right">

                                            <div class="detail-section">
                                                <div class="ds-label">REPORTER PROFILE</div>
                                                <div class="reporter-card">
                                                    <div class="reporter-avatar-lg" style="background:@GetAvatarColor(report.ReporterUsername)">
                                                        @report.ReporterUsername[..1].ToUpper()
                                                    </div>
                                                    <div class="rc-info">
                                                        <div class="rc-username">@report.ReporterUsername</div>
                                                        <div class="rc-rep-row">
                                                            <span class="rc-rep-label">Reputation</span>
                                                            <span class="rc-rep-val @GetRepColor(report.ReporterReputation)">
                                                                @report.ReporterReputation pts
                                                            </span>
                                                        </div>
                                                        <div class="rep-bar-track">
                                                            <div class="rep-bar-fill"
                                                                 style="width:@(Math.Min(report.ReporterReputation, 100))%">
                                                            </div>
                                                        </div>
                                                        <div class="rc-threshold">
                                                            Auto-approval threshold: 75 pts
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            @* Decision panel *@
                                            <div class="decision-panel">
                                                <div class="ds-label">MODERATION DECISION</div>

                                                @if (_actioningId == report.Id)
                                                {
                                                    <div class="reject-form">
                                                        <div class="rf-label">REJECTION REASON <span class="rf-required">*</span></div>
                                                        <div class="textarea-wrapper @(_rejectReasonFocused ? "focused" : "")">
                                                            <textarea class="reject-textarea"
                                                                      placeholder="Explain why this report is being rejected..."
                                                                      rows="3"
                                                                      @bind="_rejectReason"
                                                                      @bind:event="oninput"
                                                                      @onfocus="() => _rejectReasonFocused = true"
                                                                      @onblur="() => _rejectReasonFocused = false">
                                                                                        </textarea>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(_actionError))
                                                        {
                                                            <div class="action-error">⚠ @_actionError</div>
                                                        }
                                                        <div class="rf-actions">
                                                            <button class="btn-cancel-reject"
                                                                    @onclick="CancelAction">
                                                                CANCEL
                                                            </button>
                                                            <button class="btn-confirm-reject @(_actionLoading ? "loading" : "")"
                                                                    @onclick="() => ConfirmReject(report.Id)"
                                                                    disabled="@(_actionLoading || string.IsNullOrWhiteSpace(_rejectReason))">
                                                                @if (_actionLoading)
                                                                {
                                                                    <span class="btn-spinner-sm"></span>
                                                                    <span>REJECTING...</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>✕ CONFIRM REJECTION</span>
                                                                }
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="decision-btns">
                                                        <button class="btn-approve @(_actionLoading ? "loading" : "")"
                                                                @onclick="() => ApproveReport(report.Id)"
                                                                disabled="@_actionLoading">
                                                            @if (_actionLoading && _approvingId == report.Id)
                                                            {
                                                                <span class="btn-spinner-sm"></span>
                                                                <span>APPROVING...</span>
                                                            }
                                                            else
                                                            {
                                                                <span>✓ APPROVE</span>
                                                            }
                                                        </button>
                                                        <button class="btn-reject"
                                                                @onclick="() => StartReject(report.Id)"
                                                                disabled="@_actionLoading">
                                                            <span>✕ REJECT</span>
                                                        </button>
                                                    </div>
                                                    <div class="decision-hint">
                                                        Approve adds the event to the live map and awards +10 reputation.
                                                        Reject removes the report and deducts 5 reputation.
                                                    </div>
                                                }
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</AuthGuard>

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .admin-root {
        min-height: 100vh;
        background: #0d1117;
        font-family: 'Inter', sans-serif;
        padding: 56px 0 64px;
        position: relative;
        overflow-x: hidden;
    }

    .bg-grid {
        position: fixed;
        inset: 0;
        background-image: linear-gradient(rgba(159,239,0,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(159,239,0,0.025) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: 0;
    }

    .scan-line {
        position: fixed;
        top: -2px;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #9fef00, transparent);
        animation: scan 8s linear infinite;
        opacity: 0.25;
        z-index: 1;
        pointer-events: none;
    }

    .corner {
        position: fixed;
        width: 16px;
        height: 16px;
        z-index: 2;
        pointer-events: none;
    }

    .corner-tl {
        top: 12px;
        left: 12px;
        border-top: 2px solid #ffa500;
        border-left: 2px solid #ffa500;
    }

    .corner-tr {
        top: 12px;
        right: 12px;
        border-top: 2px solid #ffa500;
        border-right: 2px solid #ffa500;
    }

    .corner-bl {
        bottom: 12px;
        left: 12px;
        border-bottom: 2px solid #ffa500;
        border-left: 2px solid #ffa500;
    }

    .corner-br {
        bottom: 12px;
        right: 12px;
        border-bottom: 2px solid #ffa500;
        border-right: 2px solid #ffa500;
    }

    .admin-subnav {
        background: #161b22;
        border-bottom: 1px solid #21262d;
        display: flex;
        align-items: center;
        gap: 0;
        padding: 0 32px;
        position: sticky;
        top: 56px;
        z-index: 10;
    }

    .subnav-link {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 14px 18px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        color: #6e7681;
        text-decoration: none;
        letter-spacing: 1px;
        border-bottom: 2px solid transparent;
        transition: color 0.15s, border-color 0.15s;
        white-space: nowrap;
    }

        .subnav-link:hover {
            color: #c9d1d9;
        }

    .subnav-active {
        color: #ffa500 !important;
        border-bottom-color: #ffa500 !important;
    }

    .subnav-badge {
        background: #ffa500;
        color: #0d1117;
        font-size: 9px;
        font-weight: 700;
        padding: 1px 5px;
        border-radius: 8px;
        min-width: 16px;
        text-align: center;
    }

    .admin-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 32px 0;
        position: relative;
        z-index: 3;
        animation: fadeInUp 0.4s ease both;
    }

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .ph-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        color: #ffa500;
        letter-spacing: 2px;
        opacity: 0.8;
        margin-bottom: 8px;
    }

    .ph-title {
        font-size: 36px;
        font-weight: 700;
        color: #e6edf3;
        line-height: 1.1;
        letter-spacing: -0.5px;
        margin-bottom: 8px;
    }

    .ph-accent {
        color: #ffa500;
    }

    .ph-sub {
        font-size: 13px;
        color: #6e7681;
    }

    .refresh-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: transparent;
        border: 1px solid #21262d;
        border-radius: 4px;
        cursor: pointer;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        color: #6e7681;
        letter-spacing: 1px;
        transition: border-color 0.15s, color 0.15s;
    }

        .refresh-btn:hover:not(:disabled) {
            border-color: #9fef00;
            color: #9fef00;
        }

        .refresh-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .stats-strip {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 14px 20px;
        background: #161b22;
        border: 1px solid #21262d;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .ss-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
        align-items: center;
    }

    .ss-val {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 24px;
        font-weight: 600;
    }

        .ss-val.orange {
            color: #ffa500;
            text-shadow: 0 0 10px rgba(255,165,0,0.3);
        }

        .ss-val.green {
            color: #9fef00;
        }

        .ss-val.red {
            color: #ff3e3e;
        }

    .ss-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 9px;
        color: #4a5160;
        letter-spacing: 2px;
    }

    .ss-div {
        width: 1px;
        height: 32px;
        background: #21262d;
    }

    .ss-status {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ss-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        animation: blink 1.5s ease-in-out infinite;
    }

    .dot-orange {
        background: #ffa500;
        box-shadow: 0 0 6px rgba(255,165,0,0.5);
    }

    .dot-green {
        background: #9fef00;
        box-shadow: 0 0 6px rgba(159,239,0,0.5);
    }

    .ss-status-text {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        color: #6e7681;
    }

    .empty-queue {
        background: #161b22;
        border: 1px solid #21262d;
        border-radius: 8px;
        padding: 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        text-align: center;
    }

    .eq-icon-wrap {
        position: relative;
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .eq-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(159,239,0,0.08);
        border: 2px solid rgba(159,239,0,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        position: relative;
        z-index: 1;
    }

    .eq-glow {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: #9fef00;
        opacity: 0.08;
        filter: blur(16px);
        animation: blink 3s ease-in-out infinite;
    }

    .eq-title {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 16px;
        font-weight: 600;
        color: #9fef00;
        letter-spacing: 2px;
    }

    .eq-sub {
        font-size: 13px;
        color: #6e7681;
        max-width: 400px;
    }

    .eq-tips {
        width: 100%;
        max-width: 560px;
        background: #0d1117;
        border: 1px solid #21262d;
        border-radius: 6px;
        overflow: hidden;
        text-align: left;
        margin-top: 8px;
    }

    .tip-header {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 9px;
        color: #4a5160;
        letter-spacing: 2px;
        padding: 10px 16px;
        background: #161b22;
        border-bottom: 1px solid #21262d;
    }

    .tip-item {
        display: flex;
        gap: 12px;
        padding: 10px 16px;
        border-bottom: 1px solid #21262d;
        align-items: flex-start;
    }

        .tip-item:last-child {
            border-bottom: none;
        }

    .tip-num {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        color: #ffa500;
        opacity: 0.6;
        flex-shrink: 0;
    }

    .tip-item span:last-child {
        font-size: 12px;
        color: #6e7681;
        line-height: 1.5;
    }

    .queue-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .report-card {
        background: #161b22;
        border: 1px solid #21262d;
        border-radius: 8px;
        overflow: hidden;
        transition: border-color 0.15s;
    }

        .report-card:hover {
            border-color: #30363d;
        }

    .card-expanded {
        border-color: rgba(255,165,0,0.3) !important;
    }

    .rc-header {
        display: grid;
        grid-template-columns: 200px 160px 120px 110px 54px 90px 28px;
        align-items: center;
        gap: 0;
        padding: 14px 20px;
