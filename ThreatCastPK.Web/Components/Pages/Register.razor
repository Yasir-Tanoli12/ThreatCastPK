@* ThreatCastPK.Web/Components/Pages/Register.razor *@
@page "/register"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Register — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div class="reg-root">

    @* Animated grid *@
    <div class="bg-grid"></div>
    <div class="scan-line"></div>

    @* Corner decorations *@
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>

    @* Left panel — form *@
    <div class="left-panel">

        <div class="form-card @(_shake ? "shake" : "")">

            <div class="form-header">
                <a href="/" class="back-link">← back to map</a>
                <div class="form-title-row">
                    <span class="form-prompt">$</span>
                    <h2 class="form-title">auth.register</h2>
                    <span class="form-cursor">_</span>
                </div>
                <p class="form-subtitle">Create your operator account</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="error-banner">
                    <span class="error-icon">⚠</span>
                    <span>@_errorMessage</span>
                </div>
            }

            <div class="form-body">

                @* Step indicator *@
                <div class="step-bar">
                    <div class="step @(_currentStep >= 1 ? "active" : "") @(_currentStep > 1 ? "done" : "")">
                        <span class="step-num">@(_currentStep > 1 ? "✓" : "01")</span>
                        <span class="step-label">IDENTITY</span>
                    </div>
                    <div class="step-line @(_currentStep > 1 ? "filled" : "")"></div>
                    <div class="step @(_currentStep >= 2 ? "active" : "")">
                        <span class="step-num">02</span>
                        <span class="step-label">CREDENTIALS</span>
                    </div>
                </div>

                @if (_currentStep == 1)
                {
                    @* Step 1 — Identity *@
                    <div class="step-content" key="step1">

                        <div class="field-group">
                            <label class="field-label">
                                <span class="label-index">01</span>
                                USERNAME
                            </label>
                            <div class="input-wrapper @(_usernameFocused ? "focused" : "") @(GetUsernameState())">
                                <span class="input-prefix">◈</span>
                                <input
    type="text"
    class="field-input"
    @bind="_username"
    @bind:event="oninput"
    @onfocus="() => _usernameFocused = true"
    @onblur="ValidateUsername"
    disabled="@_loading" />
                                @if (!string.IsNullOrEmpty(_username))
                                {
                                    <span class="input-status @(IsUsernameValid() ? "valid" : "invalid")">
                                        @(IsUsernameValid() ? "✓" : "✗")
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_usernameError))
                            {
                                <span class="field-error">@_usernameError</span>
                            }
                            else if (!string.IsNullOrEmpty(_username) && IsUsernameValid())
                            {
                                <span class="field-hint valid">Callsign available</span>
                            }
                            else
                            {
                                <span class="field-hint">3–30 characters, letters/numbers/underscores only</span>
                            }
                        </div>

                        <div class="field-group">
                            <label class="field-label">
                                <span class="label-index">02</span>
                                EMAIL_ADDRESS
                            </label>
                            <div class="input-wrapper @(_emailFocused ? "focused" : "") @(GetEmailState())">
                                <span class="input-prefix">@@</span>
                                <input
    type="email"
    class="field-input"
    @bind="_email"
    @bind:event="oninput"
    @onfocus="() => _emailFocused = true"
    @onblur="ValidateEmail"
    disabled="@_loading" />
                                @if (!string.IsNullOrEmpty(_email))
                                {
                                    <span class="input-status @(IsEmailValid() ? "valid" : "invalid")">
                                        @(IsEmailValid() ? "✓" : "✗")
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_emailError))
                            {
                                <span class="field-error">@_emailError</span>
                            }
                        </div>

                        <button class="@NextBtnClass()" @onclick="GoToStep2" disabled="@(!CanGoToStep2())">
                            <span>CONTINUE</span>
                            <span class="btn-arrow">→</span>
                        </button>

                    </div>
                }
                else
                {
                    @* Step 2 — Credentials *@
                    <div class="step-content" key="step2">

                        <div class="field-group">
                            <label class="field-label">
                                <span class="label-index">03</span>
                                PASSWORD
                            </label>
                            <div class="input-wrapper @(_passFocused ? "focused" : "")">
                                <span class="input-prefix">🔒</span>
                                <input
                                    type="@(_showPassword ? "text" : "password")"
                                    class="field-input"
                                    placeholder="min. 8 characters"
                                    @bind="_password"
                                    @bind:event="oninput"
                                    @onfocus="() => _passFocused = true"
                                    @onblur="() => _passFocused = false"
                                    disabled="@_loading" />
                                <button type="button" class="toggle-pass"
                                        @onclick="() => _showPassword = !_showPassword">
                                    @(_showPassword ? "HIDE" : "SHOW")
                                </button>
                            </div>

                            @* Password strength meter *@
                            @if (!string.IsNullOrEmpty(_password))
                            {
                                var strength = GetPasswordStrength();
                                <div class="strength-bar">
                                    <div class="strength-track">
                                        <div class="strength-fill s-@strength.Level"
                                             style="width: @(strength.Percent)%"></div>
                                    </div>
                                    <span class="strength-label s-text-@strength.Level">
                                        @strength.Label
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="field-group">
                            <label class="field-label">
                                <span class="label-index">04</span>
                                CONFIRM_PASSWORD
                            </label>
                            <div class="input-wrapper @(_confirmFocused ? "focused" : "") @(GetConfirmState())">
                                <span class="input-prefix">🔑</span>
                                <input
                                    type="@(_showConfirm ? "text" : "password")"
                                    class="field-input"
                                    placeholder="re-enter password"
                                    @bind="_confirmPassword"
                                    @bind:event="oninput"
                                    @onfocus="() => _confirmFocused = true"
                                    @onblur="() => _confirmFocused = false"
                                    disabled="@_loading" />
                                <button type="button" class="toggle-pass"
                                        @onclick="() => _showConfirm = !_showConfirm">
                                    @(_showConfirm ? "HIDE" : "SHOW")
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(_confirmPassword) && _password != _confirmPassword)
                            {
                                <span class="field-error">Passwords do not match</span>
                            }
                        </div>

                        @* Terms acknowledgment *@
                        <div class="terms-row">
                            <label class="checkbox-label">
                                <input type="checkbox" class="checkbox-input"
                                       @bind="_termsAccepted" />
                                <span class="checkbox-box @(_termsAccepted ? "checked" : "")">
                                    @(_termsAccepted ? "✓" : "")
                                </span>
                                <span class="terms-text">
                                    I understand this platform is for cyber threat reporting only
                                </span>
                            </label>
                        </div>

                        <div class="step2-btns">
                            <button class="back-step-btn" @onclick="() => _currentStep = 1"
                                    disabled="@_loading">
                                ← BACK
                            </button>

                            <button class="submit-btn @(_loading ? "loading" : "")"
                                    @onclick="HandleRegister"
                                    disabled="@(!CanSubmit() || _loading)">
                                @if (_loading)
                                {
                                    <span class="btn-spinner"></span>
                                    <span>CREATING...</span>
                                }
                                else
                                {
                                    <span>CREATE ACCOUNT</span>
                                    <span class="btn-arrow">→</span>
                                }
                            </button>
                        </div>

                    </div>
                }
                <div class="divider-row">
    <div class="divider-line"></div>
    <span class="divider-text">OR</span>
    <div class="divider-line"></div>
</div>

<a href="@GoogleLoginUrl" class="google-btn">
    <svg class="g-icon" viewBox="0 0 24 24" width="18" height="18">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
    </svg>
    <span>CONTINUE WITH GOOGLE</span>
</a>
                <div class="form-footer-links">
                    <span class="footer-text">Already registered?</span>
                    <a href="/login" class="footer-link">Sign in →</a>
                </div>

            </div>
        </div>

        <div class="form-meta">
            <span class="meta-item">
                <span class="meta-dot green"></span>
                REGISTRATION OPEN
            </span>
            <span class="meta-sep">//</span>
            <span class="meta-item">BCrypt · PBKDF2</span>
            <span class="meta-sep">//</span>
            <span class="meta-item">DATA ENCRYPTED</span>
        </div>

    </div>

    @* Right panel — info *@
    <div class="right-panel">
        <div class="right-content">

            <div class="brand-block">
                <div class="hex-icon">◈</div>
                <div class="brand-name">ThreatCast<span class="brand-pk">PK</span></div>
            </div>

            <h2 class="right-heading">Join the<br />Intelligence<br />Network</h2>

            <div class="roles-list">
                <div class="role-card">
                    <div class="role-icon public">👁</div>
                    <div class="role-info">
                        <div class="role-name">Public Viewer</div>
                        <div class="role-desc">View live threat map, browse analytics, read forum</div>
                    </div>
                    <div class="role-badge default">DEFAULT</div>
                </div>

                <div class="role-connector"></div>

                <div class="role-card">
                    <div class="role-icon reporter">📡</div>
                    <div class="role-info">
                        <div class="role-name">Reporter</div>
                        <div class="role-desc">Submit attack reports, earn reputation points, get auto-approved</div>
                    </div>
                    <div class="role-badge request">REQUEST</div>
                </div>

                <div class="role-connector"></div>

                <div class="role-card">
                    <div class="role-icon admin">⚡</div>
                    <div class="role-info">
                        <div class="role-name">Admin</div>
                        <div class="role-desc">Moderate reports, manage users, inject verified events</div>
                    </div>
                    <div class="role-badge invite">INVITE ONLY</div>
                </div>
            </div>

            <div class="right-footnote">
                <span class="fn-dot"></span>
                Reports are verified against AbuseIPDB — false reports reduce your reputation score.
            </div>

        </div>
    </div>

</div>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .reg-root {
        min-height: 100vh;
        display: flex;
        background: #0d1117;
        position: relative;
        overflow: hidden;
        font-family: 'Inter', sans-serif;
    }

    .bg-grid {
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(159,239,0,0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(159,239,0,0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: 0;
    }

    .scan-line {
        position: fixed;
        top: -2px;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #9fef00, transparent);
        animation: scan 6s linear infinite;
        opacity: 0.4;
        z-index: 1;
        pointer-events: none;
    }

    @@keyframes scan {
        0%   { top: -2px; }
        100% { top: 100vh; }
    }

    .corner {
        position: fixed;
        width: 20px;
        height: 20px;
        z-index: 2;
        pointer-events: none;
    }
    .corner-tl { top: 16px; left: 16px; border-top: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-tr { top: 16px; right: 16px; border-top: 2px solid #9fef00; border-right: 2px solid #9fef00; }
    .corner-bl { bottom: 16px; left: 16px; border-bottom: 2px solid #9fef00; border-left: 2px solid #9fef00; }
    .corner-br { bottom: 16px; right: 16px; border-bottom: 2px solid #9fef00; border-right: 2px solid #9fef00; }

    /* ── Left panel (form side) ── */
    .left-panel {
        width: 520px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 48px 40px;
        position: relative;
        z-index: 3;
        border-right: 1px solid #21262d;
    }

    /* ── Form card ── */
    .form-card {
        width: 100%;
        background: #161b22;
        border: 1px solid #21262d;
        border-radius: 8px;
        overflow: hidden;
        animation: fadeInUp 0.6s ease both;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .shake { animation: shake 0.4s ease !important; }

    @@keyframes shake {
        0%,100% { transform: translateX(0); }
        20%     { transform: translateX(-8px); }
        40%     { transform: translateX(8px); }
        60%     { transform: translateX(-5px); }
        80%     { transform: translateX(5px); }
    }

    /* ── Form header ── */
    .form-header {
        padding: 20px 28px 18px;
        border-bottom: 1px solid #21262d;
        background: #0d1117;
    }

    .back-link {
        display: inline-block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        color: #4a5160;
        text-decoration: none;
        letter-spacing: 1px;
        margin-bottom: 12px;
        transition: color 0.15s;
    }
    .back-link:hover { color: #9fef00; }

    .form-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

    .form-prompt {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 17px;
        color: #9fef00;
        font-weight: 600;
    }

    .form-title {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 17px;
        font-weight: 600;
        color: #c9d1d9;
    }

    .form-cursor {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 17px;
        color: #9fef00;
        animation: blink 1s step-end infinite;
    }

    @@keyframes blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0; }
    }

    .form-subtitle {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 12px;
        color: #6e7681;
    }

    /* ── Error banner ── */
    .error-banner {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 28px;
        background: rgba(255,62,62,0.08);
        border-bottom: 1px solid rgba(255,62,62,0.2);
        font-family: 'IBM Plex Mono', monospace;
        font-size: 12px;
        color: #ff3e3e;
    }
    .error-icon { flex-shrink: 0; }

    /* ── Form body ── */
    .form-body {
        padding: 24px 28px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    /* ── Step bar ── */
    .step-bar {
        display: flex;
        align-items: center;
        gap: 0;
        margin-bottom: 4px;
    }

    .step {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .step-num {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 1px solid #21262d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        color: #4a5160;
        transition: all 0.3s;
    }

    .step.active .step-num {
        border-color: #9fef00;
        color: #9fef00;
        background: rgba(159,239,0,0.08);
    }

    .step.done .step-num {
        border-color: #9fef00;
        background: #9fef00;
        color: #0d1117;
        font-weight: 700;
    }

    .step-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        color: #4a5160;
        letter-spacing: 1px;
        transition: color 0.3s;
    }

    .step.active .step-label { color: #9fef00; }
    .step.done .step-label { color: #6e7681; }

    .step-line {
        flex: 1;
        height: 1px;
        background: #21262d;
        margin: 0 12px;
        transition: background 0.3s;
    }

    .step-line.filled { background: #9fef00; }

    /* ── Step content ── */
    .step-content {
        display: flex;
        flex-direction: column;
        gap: 18px;
        animation: stepIn 0.3s ease both;
    }

    @@keyframes stepIn {
        from { opacity: 0; transform: translateX(12px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    /* ── Field groups ── */
    .field-group { display: flex; flex-direction: column; gap: 7px; }

    .field-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        color: #6e7681;
        letter-spacing: 2px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .label-index { color: #9fef00; opacity: 0.6; }

    .input-wrapper {
        display: flex;
        align-items: center;
        background: #0d1117;
        border: 1px solid #21262d;
        border-radius: 4px;
        transition: border-color 0.15s, box-shadow 0.15s;
        overflow: hidden;
    }

    .input-wrapper.focused {
        border-color: #9fef00;
        box-shadow: 0 0 0 3px rgba(159,239,0,0.08);
    }

    .input-wrapper.valid-state { border-color: rgba(159,239,0,0.4); }
    .input-wrapper.invalid-state { border-color: rgba(255,62,62,0.4); }

    .input-prefix {
        padding: 0 12px;
        font-size: 13px;
        color: #4a5160;
        border-right: 1px solid #21262d;
        flex-shrink: 0;
        user-select: none;
        line-height: 44px;
    }

    .field-input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        padding: 11px 14px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 13px;
        color: #c9d1d9;
        caret-color: #9fef00;
    }

    .field-input::placeholder { color: #4a5160; }
    .field-input:disabled { opacity: 0.5; cursor: not-allowed; }

    .input-status {
        padding: 0 12px;
        font-size: 14px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .input-status.valid  { color: #9fef00; }
    .input-status.invalid { color: #ff3e3e; }

    .field-error {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        color: #ff3e3e;
    }

    .field-hint {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        color: #4a5160;
    }

    .field-hint.valid { color: #9fef00; }

    .toggle-pass {
        background: none;
        border: none;
        border-left: 1px solid #21262d;
        padding: 0 12px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 9px;
        color: #4a5160;
        cursor: pointer;
        letter-spacing: 1px;
        height: 100%;
        transition: color 0.15s;
    }
    .toggle-pass:hover { color: #9fef00; }

    /* ── Password strength ── */
    .strength-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 2px;
    }

    .strength-track {
        flex: 1;
        height: 3px;
        background: #21262d;
        border-radius: 2px;
        overflow: hidden;
    }

    .strength-fill {
        height: 100%;
        border-radius: 2px;
        transition: width 0.3s ease;
    }

    .strength-fill.s-weak   { background: #ff3e3e; }
    .strength-fill.s-medium { background: #ffa500; }
    .strength-fill.s-strong { background: #9fef00; }

    .strength-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        letter-spacing: 1px;
        flex-shrink: 0;
    }

    .s-text-weak   { color: #ff3e3e; }
    .s-text-medium { color: #ffa500; }
    .s-text-strong { color: #9fef00; }

    /* ── Terms row ── */
    .terms-row { padding: 4px 0; }

    .checkbox-label {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        cursor: pointer;
    }

    .checkbox-input { display: none; }

    .checkbox-box {
        width: 16px;
        height: 16px;
        border: 1px solid #21262d;
        border-radius: 3px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 700;
        flex-shrink: 0;
        margin-top: 1px;
        transition: all 0.15s;
        background: #0d1117;
    }

    .checkbox-box.checked {
        background: #9fef00;
        border-color: #9fef00;
        color: #0d1117;
    }

    .terms-text {
        font-size: 12px;
        color: #6e7681;
        line-height: 1.5;
    }

    /* ── Buttons ── */
    .next-btn {
        width: 100%;
        padding: 13px 20px;
        background: #9fef00;
        border: none;
        border-radius: 4px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 12px;
        font-weight: 600;
        color: #0d1117;
        letter-spacing: 2px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: opacity 0.15s, transform 0.1s, box-shadow 0.15s;
    }

    .next-btn:hover:not(:disabled) {
        opacity: 0.92;
        transform: translateY(-1px);
        box-shadow: 0 4px 20px rgba(159,239,0,0.3);
    }

    .next-btn:disabled { opacity: 0.35; cursor: not-allowed; }

