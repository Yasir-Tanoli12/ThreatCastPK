@code {
    private string _username = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _loading = false;
    private bool _shake = false;
    private bool _showPassword = false;
    private bool _showConfirm = false;
    private bool _termsAccepted = false;
    private bool _usernameFocused = false;
    private bool _emailFocused = false;
    private bool _passFocused = false;
    private bool _confirmFocused = false;
    private string _usernameError = string.Empty;
    private string _emailError = string.Empty;
    private int _currentStep = 1;
    private string GoogleLoginUrl => $"{Configuration["ApiBaseUrl"]}/api/auth/google-login";

    private bool IsUsernameValid()
    {
        if (string.IsNullOrWhiteSpace(_username)) return false;
        return _username.Length >= 3
            && _username.Length <= 30
            && System.Text.RegularExpressions.Regex.IsMatch(_username, @"^[a-zA-Z0-9_]+$");
    }

    private bool IsEmailValid()
    {
        if (string.IsNullOrWhiteSpace(_email)) return false;
        return _email.Contains('@') && _email.Contains('.');
    }

    private void ValidateUsername()
    {
        _usernameFocused = false;
        if (string.IsNullOrWhiteSpace(_username)) { _usernameError = string.Empty; return; }
        if (_username.Length < 3) { _usernameError = "Minimum 3 characters required"; return; }
        if (_username.Length > 30) { _usernameError = "Maximum 30 characters allowed"; return; }
        if (!System.Text.RegularExpressions.Regex.IsMatch(_username, @"^[a-zA-Z0-9_]+$"))
        { _usernameError = "Letters, numbers, and underscores only"; return; }
        _usernameError = string.Empty;
        StateHasChanged();
    }

    private void ValidateEmail()
    {
        _emailFocused = false;
        if (string.IsNullOrWhiteSpace(_email)) { _emailError = string.Empty; return; }
        if (!IsEmailValid()) { _emailError = "Enter a valid email address"; return; }
        _emailError = string.Empty;
        StateHasChanged();
    }

    private string GetUsernameState()
    {
        if (string.IsNullOrEmpty(_username)) return string.Empty;
        return IsUsernameValid() ? "is-valid" : "is-invalid";
    }

    private string GetEmailState()
    {
        if (string.IsNullOrEmpty(_email)) return string.Empty;
        return IsEmailValid() ? "is-valid" : "is-invalid";
    }

    private string GetConfirmState()
    {
        if (string.IsNullOrEmpty(_confirmPassword)) return string.Empty;
        return _password == _confirmPassword ? "is-valid" : "is-invalid";
    }

    private bool CanGoToStep2()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_email))
            return false;
        if (_username.Length < 3 || _username.Length > 30)
            return false;
        if (!System.Text.RegularExpressions.Regex.IsMatch(_username, @"^[a-zA-Z0-9_]+$"))
            return false;
        if (!_email.Contains('@') || !_email.Contains('.'))
            return false;
        return true;
    }

    private bool CanSubmit()
        => CanGoToStep2()
           && _password.Length >= 8
           && _password == _confirmPassword
           && _termsAccepted;

    private void GoToStep2()
    {
        ValidateUsername();
        ValidateEmail();
        if (!CanGoToStep2()) return;
        _currentStep = 2;
    }

    private record StrengthResult(string Level, int Percent, string Label);

    private StrengthResult GetPasswordStrength()
    {
        var p = _password;
        int score = 0;
        if (p.Length >= 8) score++;
        if (p.Length >= 12) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(p, @"[A-Z]")) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(p, @"[0-9]")) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(p, @"[^a-zA-Z0-9]")) score++;

        return score switch
        {
            <= 2 => new("weak", 33, "WEAK"),
            <= 3 => new("medium", 66, "MEDIUM"),
            _ => new("strong", 100, "STRONG")
        };
    }

    private async Task HandleRegister()
    {
        _errorMessage = string.Empty;
        if (!CanSubmit()) return;

        _loading = true;
        StateHasChanged();

        var error = await AuthService.RegisterAsync(_username, _email, _password);

        if (error == null)
        {
            Navigation.NavigateTo("/login?registered=1&email=" + Uri.EscapeDataString(_email));
        }
        else
        {
            _loading = false;
            await TriggerShake(error);
        }
    }

    private async Task TriggerShake(string message)
    {
        _errorMessage = message;
        _shake = true;
        StateHasChanged();
        await Task.Delay(450);
        _shake = false;
        StateHasChanged();
    }
}