@* ThreatCastPK.Web/Components/Pages/Dashboard.razor *@
@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject SignalRService SignalRService
@inject ApiService ApiService
@inject AuthService AuthService
@implements IAsyncDisposable

<PageTitle>Live Threat Map — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="dash">

    @* ═══════ LEFT SIDEBAR ═══════ *@
    <aside class="dash-sidebar tc-scrollbar">

        @* ── Brand header ── *@
        <div class="sb-header">
            <div class="sb-brand">
                <span class="sb-brand__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </span>
                <span class="sb-brand__name">ThreatCast<span class="sb-brand__pk">PK</span></span>
            </div>
            <div class="sb-live-badge">
                <span class="sb-live-badge__dot"></span>
                LIVE
            </div>
        </div>

        @* ── Stats row ── *@
        <div class="sb-stats">
            <div class="sb-stat sb-stat--green">
                <span class="sb-stat__val">@_totalEvents</span>
                <span class="sb-stat__label">TODAY</span>
            </div>
            <div class="sb-stat sb-stat--cyan">
                <span class="sb-stat__val">@_activeNow</span>
                <span class="sb-stat__label">ACTIVE</span>
            </div>
            <div class="sb-stat sb-stat--orange">
                <span class="sb-stat__val">@_cities</span>
                <span class="sb-stat__label">CITIES</span>
            </div>
        </div>

        @* ── Live feed ticker ── *@
        <div class="sb-feed">
            <div class="sb-feed__header">
                <div class="sb-feed__title">
                    <span class="sb-feed__dot"></span>
                    <span>LIVE FEED</span>
                </div>
                <span class="sb-feed__count">@_tickerItems.Count events</span>
            </div>

            @if (_tickerItems.Count == 0)
            {
                <div class="sb-feed__empty">
                    <span class="sb-feed__empty-pulse"></span>
                    <span>Monitoring for threats…</span>
                </div>
            }
            else
            {
                <div class="sb-feed__list tc-scrollbar">
                    @foreach (var item in _tickerItems.Take(30))
                    {
                        <div class="feed-item @(item.IsNew ? "feed-item--new" : "")">
                            <div class="feed-item__sev-bar feed-item__sev-bar--@item.Severity"></div>
                            <div class="feed-item__body">
                                <div class="feed-item__top">
                                    <span class="feed-chip feed-chip--@item.AttackType.ToLower().Replace(" ","")">
                                        @GetAttackSvg(item.AttackType) @item.AttackType
                                    </span>
                                    <span class="feed-item__sev-num feed-sev--@item.Severity">@item.Severity</span>
                                </div>
                                <div class="feed-item__bottom">
                                    <span class="feed-item__city">@item.City</span>
                                    <span class="feed-item__sep">·</span>
                                    <span class="feed-item__sector">@item.Sector</span>
                                    <span class="feed-item__time">@GetRelativeTime(item.OccurredAt)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* ── Sector risk ── *@
        <div class="sb-sectors">
            <div class="sb-sectors__header">SECTOR RISK</div>
            <div class="sb-sectors__list">
                @foreach (var sector in _sectorRisks)
                {
                    <div class="sector-row">
                        <span class="sector-row__icon sector-icon--@sector.Name.ToLower()">
                            @GetSectorSvg(sector.Name)
                        </span>
                        <span class="sector-row__name">@sector.Name</span>
                        <span class="sector-row__badge risk--@sector.Risk.ToLower()">@sector.Risk.ToUpper()</span>
                    </div>
                }
            </div>
        </div>

        @* ── Auth CTA ── *@
        @if (!AuthService.IsLoggedIn)
        {
            <div class="sb-cta">
                <p class="sb-cta__text">Sign in to submit reports and set alerts</p>
                <div class="sb-cta__btns">
                    <a href="/login" class="sb-cta__login">LOGIN</a>
                    <a href="/register" class="sb-cta__register">REGISTER</a>
                </div>
            </div>
        }

    </aside>

    @* ═══════ MAP AREA ═══════ *@
    <main class="dash-map">

        @* ── Floating controls (glass) ── *@
        <div class="map-bar">
            <div class="map-bar__left">
                <span class="map-bar__title">PAKISTAN CYBER THREAT MAP</span>
                <div class="map-bar__filters">
                    @foreach (var f in new[] { "1h", "6h", "24h", "7d" })
                    {
                        <button class="filter-pill @(_timeFilter == f ? "filter-pill--active" : "")"
                                @onclick="() => SetTimeFilter(f)">
                            @f.ToUpper()
                        </button>
                    }
                </div>
            </div>
            <div class="map-bar__right">
                <div class="map-bar__legend">
                    <span class="legend-item"><span class="legend-dot legend-dot--low"></span>Low</span>
                    <span class="legend-item"><span class="legend-dot legend-dot--high"></span>High</span>
                    <span class="legend-item"><span class="legend-dot legend-dot--crit"></span>Critical</span>
                </div>
                @if (AuthService.IsReporter)
                {
                    <a href="/submit-report" class="tc-btn tc-btn--primary map-report-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14" /><path d="M12 5v14" />
                        </svg>
                        REPORT
                    </a>
                }
            </div>
        </div>

        @* ── Leaflet container ── *@
        <div id="threatmap" class="dash-map__canvas"></div>

        @* ── Campaign alerts (glass) ── *@
        @if (_activeCampaigns.Count > 0)
        {
            <div class="campaign-stack">
                @foreach (var c in _activeCampaigns.Take(3))
                {
                    <div class="campaign campaign--@c.AlertLevel.ToLower()">
                        <div class="campaign__header">
                            <svg class="campaign__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                                <path d="M12 9v4" /><path d="M12 17h.01" />
                            </svg>
                            <span class="campaign__title">COORDINATED ATTACK — @c.AlertLevel.ToUpper()</span>
                        </div>
                        <div class="campaign__body">
                            @if (c.AnomalyCount > 0)
                            {
                                <span>ML flagged <strong>@c.AnomalyCount</strong> anomalous events out of @c.TotalEvents. </span>
                            }
                            @if (!string.IsNullOrEmpty(c.AffectedSectors))
                            {
                                <span>Targeting: <strong>@c.AffectedSectors</strong>. </span>
                            }
                            @if (!string.IsNullOrEmpty(c.AffectedCities))
                            {
                                <span>Cities: <strong>@c.AffectedCities</strong>. </span>
                            }
                            @if (!string.IsNullOrEmpty(c.IpRange) && c.IpRange != "Multiple")
                            {
                                <span>IP block: <strong>@c.IpRange</strong>.</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @* ── Loading overlay ── *@
        @if (_mapLoading)
        {
            <div class="map-loading">
                <div class="map-loading__spinner"></div>
                <span class="map-loading__text">INITIALIZING THREAT MAP…</span>
            </div>
        }

        @* ── Floating event counter ── *@
        <div class="map-counter">
            <span class="map-counter__dot"></span>
            <span class="map-counter__text"><strong class="map-counter__num">@_tickerItems.Count</strong> events on map</span>
        </div>

        @* ── Mobile stats (sidebar hidden on mobile) ── *@
        <div class="mobile-stats">
            <div class="mobile-stats__item">
                <span class="mobile-stats__val mobile-stats__val--green">@_totalEvents</span>
                <span class="mobile-stats__label">TODAY</span>
            </div>
            <div class="mobile-stats__sep"></div>
            <div class="mobile-stats__item">
                <span class="mobile-stats__val mobile-stats__val--cyan">@_activeNow</span>
                <span class="mobile-stats__label">ACTIVE</span>
            </div>
            <div class="mobile-stats__sep"></div>
            <div class="mobile-stats__item">
                <span class="mobile-stats__val mobile-stats__val--orange">@_cities</span>
                <span class="mobile-stats__label">CITIES</span>
            </div>
        </div>

    </main>

</div>

<style>
    /* ══════════════════════════════════════════════════════════════════
       DASHBOARD — ThreatCast PK
       Glassmorphism · Floating Controls · Premium Ticker
       ══════════════════════════════════════════════════════════════════ */

    /* ── Root layout ── */
    .dash {
        display: flex;
        height: 100vh;
        padding-top: 56px;
        background: var(--tc-bg-base);
        font-family: var(--tc-font-sans);
        overflow: hidden;
    }

    /* ══════════════════════════════════════════════════════════════════
       SIDEBAR
       ══════════════════════════════════════════════════════════════════ */
    .dash-sidebar {
        width: 290px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
        z-index: 2;
        background: var(--tc-bg-base);
        border-right: 1px solid rgba(159,239,0,0.06);
    }

    /* Subtle top accent glow */
    .dash-sidebar::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 120px;
        background: linear-gradient(180deg, rgba(159,239,0,0.025) 0%, transparent 100%);
        pointer-events: none;
        z-index: 0;
    }

    /* ── Brand header ── */
    .sb-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border-bottom: 1px solid var(--tc-border);
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }

    .sb-brand {
        display: flex; align-items: center; gap: 8px;
    }

    .sb-brand__icon {
        display: flex; color: var(--tc-accent);
        filter: drop-shadow(0 0 8px rgba(159,239,0,0.4));
    }

    .sb-brand__name {
        font-family: var(--tc-font-mono);
        font-size: var(--tc-text-sm);
        font-weight: 600;
        color: var(--tc-text-secondary);
        letter-spacing: 0.5px;
    }
    .sb-brand__pk { color: var(--tc-accent); }

    .sb-live-badge {
        display: flex; align-items: center; gap: 5px;
        font-family: var(--tc-font-mono);
        font-size: 8px;
        color: var(--tc-accent);
        letter-spacing: 2px;
        background: rgba(159,239,0,0.06);
        border: 1px solid rgba(159,239,0,0.2);
        padding: 3px 8px;
        border-radius: var(--tc-radius-full);
    }

    .sb-live-badge__dot {
        width: 5px; height: 5px;
        border-radius: 50%;
        background: var(--tc-accent);
        box-shadow: 0 0 8px rgba(159,239,0,0.7);
        animation: tc-pulse 1.2s ease-in-out infinite;
    }

    /* ── Stats ── */
    .sb-stats {
        display: flex; gap: 6px;
        padding: 10px 12px;
        border-bottom: 1px solid var(--tc-border);
        flex-shrink: 0;
        position: relative; z-index: 1;
    }

    .sb-stat {
        flex: 1;
        display: flex; flex-direction: column; align-items: center;
        gap: 3px;
        padding: 10px 4px;
        background: rgba(22,27,34,0.5);
        border: 1px solid rgba(33,38,45,0.5);
        border-radius: var(--tc-radius-md);
        transition: border-color var(--tc-ease-smooth), box-shadow var(--tc-ease-smooth);
    }

    .sb-stat:hover { border-color: rgba(33,38,45,0.8); }

    .sb-stat--green  { border-top: 2px solid rgba(159,239,0,0.3); }
    .sb-stat--cyan   { border-top: 2px solid rgba(0,200,255,0.3); }
    .sb-stat--orange { border-top: 2px solid rgba(255,165,0,0.3); }

    .sb-stat__val {
        font-family: var(--tc-font-mono);
        font-size: var(--tc-text-xl);
        font-weight: 600;
        line-height: 1;
    }

    .sb-stat--green  .sb-stat__val { color: var(--tc-accent);  text-shadow: 0 0 16px rgba(159,239,0,0.25); }
    .sb-stat--cyan   .sb-stat__val { color: #00c8ff;           text-shadow: 0 0 16px rgba(0,200,255,0.25); }
    .sb-stat--orange .sb-stat__val { color: var(--tc-warning);  text-shadow: 0 0 16px rgba(255,165,0,0.25); }

    .sb-stat__label {
        font-family: var(--tc-font-mono);
        font-size: 7px;
        color: var(--tc-text-faint);
        letter-spacing: 2px;
    }

    /* ── Live feed ── */
    .sb-feed {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
        position: relative; z-index: 1;
    }

    .sb-feed__header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 8px 14px;
        background: rgba(22,27,34,0.4);
        border-bottom: 1px solid var(--tc-border);
        flex-shrink: 0;
    }

    .sb-feed__title {
        display: flex; align-items: center; gap: 6px;
        font-family: var(--tc-font-mono);
        font-size: 8px;
        color: var(--tc-accent);
        letter-spacing: 2px;
        opacity: 0.8;
    }

    .sb-feed__dot {
        width: 5px; height: 5px;
        border-radius: 50%;
        background: var(--tc-accent);
        box-shadow: 0 0 6px rgba(159,239,0,0.6);
        animation: tc-pulse 1.5s ease-in-out infinite;
    }

    .sb-feed__count {
        font-family: var(--tc-font-mono);
        font-size: 9px;
        color: var(--tc-text-faint);
    }

    .sb-feed__empty {
        display: flex; align-items: center; gap: 10px;
        padding: 20px 14px;
        font-family: var(--tc-font-mono);
        font-size: var(--tc-text-xs);
        color: var(--tc-text-faint);
    }

    .sb-feed__empty-pulse {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: var(--tc-text-faint);
        animation: tc-pulse 2s ease-in-out infinite;
        flex-shrink: 0;
    }

    .sb-feed__list {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* ── Feed item ── */
    .feed-item {
        display: flex; align-items: stretch; gap: 0;
        padding: 0;
        border-bottom: 1px solid rgba(22,27,34,0.8);
        transition: background var(--tc-ease-fast);
        cursor: default;
    }

    .feed-item:hover { background: rgba(159,239,0,0.015); }

    .feed-item--new {
        animation: dash-slide-in 0.4s cubic-bezier(0.4,0,0.2,1) both;
        background: rgba(159,239,0,0.025) !important;
    }

    .feed-item__sev-bar {
        width: 3px;
        flex-shrink: 0;
        border-radius: 0;
    }

    .feed-item__sev-bar--1 { background: var(--tc-accent); box-shadow: inset 0 0 4px rgba(159,239,0,0.3); }
    .feed-item__sev-bar--2 { background: #7dc700; }
    .feed-item__sev-bar--3 { background: var(--tc-warning); box-shadow: inset 0 0 4px rgba(255,165,0,0.3); }
    .feed-item__sev-bar--4 { background: #ff6b35; }
    .feed-item__sev-bar--5 { background: var(--tc-danger); box-shadow: inset 0 0 4px rgba(255,62,62,0.4); }

    .feed-item__body {
        flex: 1; min-width: 0;
        display: flex; flex-direction: column;
        gap: 4px; padding: 8px 10px;
    }

    .feed-item__top {
        display: flex; align-items: center; justify-content: space-between; gap: 6px;
    }

    .feed-chip {
        font-family: var(--tc-font-mono);
        font-size: 9px; font-weight: 500;
        padding: 2px 6px;
        border-radius: 3px;
        display: inline-flex; align-items: center; gap: 4px;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .feed-chip--ransomware   { background: rgba(255,62,62,0.08);  color: var(--tc-danger);  border-color: rgba(255,62,62,0.15); }
    .feed-chip--phishing     { background: rgba(255,165,0,0.08);  color: var(--tc-warning); border-color: rgba(255,165,0,0.15); }
    .feed-chip--ddos         { background: rgba(0,200,255,0.08);  color: #00c8ff;           border-color: rgba(0,200,255,0.15); }
    .feed-chip--malware      { background: rgba(191,64,191,0.08); color: #bf40bf;           border-color: rgba(191,64,191,0.15); }
    .feed-chip--identitytheft{ background: rgba(255,165,0,0.08);  color: var(--tc-warning); border-color: rgba(255,165,0,0.15); }
    .feed-chip--other        { background: rgba(110,118,129,0.08);color: var(--tc-text-muted);border-color: rgba(110,118,129,0.15); }

    .feed-item__sev-num {
        width: 20px; height: 20px;
        border-radius: 4px;
        display: flex; align-items: center; justify-content: center;
        font-family: var(--tc-font-mono);
        font-size: 10px; font-weight: 700;
        flex-shrink: 0;
    }

    .feed-sev--1 { background: rgba(159,239,0,0.1);  color: var(--tc-accent); }
    .feed-sev--2 { background: rgba(125,199,0,0.1);  color: #7dc700; }
    .feed-sev--3 { background: rgba(255,165,0,0.1);  color: var(--tc-warning); }
    .feed-sev--4 { background: rgba(255,107,53,0.1);  color: #ff6b35; }
    .feed-sev--5 { background: rgba(255,62,62,0.12); color: var(--tc-danger); box-shadow: 0 0 8px rgba(255,62,62,0.15); }

    .feed-item__bottom {
        display: flex; align-items: center; gap: 4px;
        font-family: var(--tc-font-mono); font-size: 10px;
        overflow: hidden;
    }

    .feed-item__city { color: var(--tc-text-secondary); white-space: nowrap; }
    .feed-item__sep  { color: var(--tc-text-faint); font-size: 8px; }
    .feed-item__sector { color: var(--tc-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .feed-item__time { margin-left: auto; color: var(--tc-text-faint); font-size: 9px; flex-shrink: 0; }

    /* ── Sectors ── */
    .sb-sectors {
        border-top: 1px solid var(--tc-border);
        flex-shrink: 0;
        position: relative; z-index: 1;
    }

    .sb-sectors__header {
        font-family: var(--tc-font-mono);
        font-size: 8px;
        color: var(--tc-text-faint);
        letter-spacing: 2px;
        padding: 8px 14px;
        background: rgba(22,27,34,0.4);
        border-bottom: 1px solid var(--tc-border);
    }

    .sector-row {
        display: flex; align-items: center; gap: 8px;
        padding: 6px 14px;
        border-bottom: 1px solid rgba(22,27,34,0.6);
        transition: background var(--tc-ease-fast);
    }
    .sector-row:last-child { border-bottom: none; }
    .sector-row:hover { background: rgba(159,239,0,0.012); }

    .sector-row__icon {
        width: 26px; height: 26px;
        border-radius: var(--tc-radius-sm);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .sector-icon--banking    { background: rgba(0,200,255,0.08);  color: #00c8ff;           border: 1px solid rgba(0,200,255,0.15); }
    .sector-icon--telecom    { background: rgba(159,239,0,0.08);  color: var(--tc-accent);  border: 1px solid rgba(159,239,0,0.15); }
    .sector-icon--healthcare { background: rgba(255,62,62,0.08);  color: var(--tc-danger);  border: 1px solid rgba(255,62,62,0.15); }
    .sector-icon--education  { background: rgba(255,165,0,0.08);  color: var(--tc-warning); border: 1px solid rgba(255,165,0,0.15); }
    .sector-icon--government { background: rgba(191,64,191,0.08); color: #bf40bf;           border: 1px solid rgba(191,64,191,0.15); }
    .sector-icon--energy     { background: rgba(255,207,0,0.08);  color: #ffc800;           border: 1px solid rgba(255,207,0,0.15); }
    .sector-icon--other      { background: rgba(110,118,129,0.08);color: var(--tc-text-muted);border: 1px solid rgba(110,118,129,0.15); }

    .sector-row__name { font-size: var(--tc-text-sm); color: var(--tc-text-secondary); flex: 1; }

    .sector-row__badge {
        font-family: var(--tc-font-mono);
        font-size: 7px; font-weight: 700;
        padding: 2px 6px;
        border-radius: 3px;
        letter-spacing: 1px;
        border: 1px solid;
        flex-shrink: 0;
    }

    .risk--low      { background: rgba(159,239,0,0.08); color: var(--tc-accent);  border-color: rgba(159,239,0,0.2); }
    .risk--medium   { background: rgba(255,165,0,0.08); color: var(--tc-warning); border-color: rgba(255,165,0,0.2); }
    .risk--high     { background: rgba(255,107,53,0.08);color: #ff6b35;           border-color: rgba(255,107,53,0.2); }
    .risk--critical { background: rgba(255,62,62,0.1);  color: var(--tc-danger);  border-color: rgba(255,62,62,0.25);
                      box-shadow: 0 0 8px rgba(255,62,62,0.1); }

    /* ── Auth CTA ── */
    .sb-cta {
        margin: 10px;
        padding: 12px;
        background: rgba(159,239,0,0.02);
        border: 1px solid rgba(159,239,0,0.1);
        border-radius: var(--tc-radius-md);
        display: flex; flex-direction: column; gap: 10px;
        flex-shrink: 0;
