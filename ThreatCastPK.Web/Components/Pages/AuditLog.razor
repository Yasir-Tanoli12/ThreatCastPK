@* ThreatCastPK.Web/Components/Pages/AuditLog.razor *@
@page "/admin/auditlog"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject ApiService ApiService

<PageTitle>Audit Log — ThreatCast PK</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<AuthGuard RequiredRole="Admin">
<div class="audit-root">
    <div class="bg-grid"></div>
    <div class="scan-line"></div>
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>

    <div class="audit-inner">

        @* ── Admin sub-nav ── *@
        <div class="admin-subnav">
            <NavLink href="/admin/moderation" class="subnav-link" ActiveClass="subnav-active">
                <span>🛡</span> Moderation Queue
            </NavLink>
            <NavLink href="/admin/users" class="subnav-link" ActiveClass="subnav-active">
                <span>👥</span> User Management
            </NavLink>
            <NavLink href="/admin/auditlog" class="subnav-link" ActiveClass="subnav-active" Match="NavLinkMatch.All">
                <span>📋</span> Audit Log
            </NavLink>
        </div>

        @* ── Header ── *@
        <div class="page-header">
            <div class="ph-left">
                <div class="ph-label"> ADMIN PANEL</div>
                <h1 class="ph-title">
                    Audit <span class="ph-accent">Log</span>
                </h1>
                <p class="ph-sub">
                    Immutable record of all administrative actions performed on the platform.
                </p>
            </div>
            <div class="ph-right">
                <div class="header-meta">
                    <div class="meta-item">
                        <span class="meta-dot green"></span>
                        <span class="meta-text">APPEND-ONLY</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-dot orange"></span>
                        <span class="meta-text">ADMIN ACCESS ONLY</span>
                    </div>
                </div>
            </div>
        </div>

        @* ── Stats + filter bar ── *@
        <div class="controls-row">

            @* Stats *@
            <div class="log-stats">
                <div class="ls-item">
                    <span class="ls-val">@_totalLogs</span>
                    <span class="ls-label">TOTAL ENTRIES</span>
                </div>
                <div class="ls-div"></div>
                <div class="ls-item">
                    <span class="ls-val green">@_logsToday</span>
                    <span class="ls-label">TODAY</span>
                </div>
                <div class="ls-div"></div>
                <div class="ls-item">
                    <span class="ls-val blue">@_page / @_totalPages</span>
                    <span class="ls-label">PAGE</span>
                </div>
            </div>

            @* Filters *@
            <div class="filter-group">
                @* Action filter *@
                <div class="select-wrapper @(_actionFilterFocused ? "focused" : "")">
                    <select class="filter-select"
                            @bind="_actionFilter"
                            @onfocus="() => _actionFilterFocused = true"
                            @onblur="() => { _actionFilterFocused = false; _ = LoadLogs(); }">
                        <option value="">ALL ACTIONS</option>
                        @foreach (var action in _availableActions)
                        {
                            <option value="@action">@action</option>
                        }
                    </select>
                    <span class="select-arrow">▾</span>
                </div>

                @* Search *@
                <div class="search-box @(_searchFocused ? "focused" : "")">
                    <span class="search-icon">⌕</span>
                    <input type="text" class="search-input"
                           placeholder="Search admin or details..."
                           value="@_searchQuery"
                           @oninput="OnSearchInput"
                           @onfocus="() => _searchFocused = true"
                           @onblur="() => _searchFocused = false" />
                    @if (!string.IsNullOrEmpty(_searchQuery))
                    {
                        <button class="search-clear"
                                @onclick="() => { _searchQuery = string.Empty; }">✕</button>
                    }
                </div>

                <button class="refresh-btn" @onclick="LoadLogs" disabled="@_loading">
                    @if (_loading) { <span class="btn-spinner-sm"></span> }
                    else { <span>↺</span> }
                </button>
            </div>

        </div>

        @* ── Log content ── *@
        @if (_loading && _logs.Count == 0)
        {
            <div class="log-table">
                <div class="table-header">
                    <div class="th th-time">TIMESTAMP</div>
                    <div class="th th-admin">ADMIN</div>
                    <div class="th th-action">ACTION</div>
                    <div class="th th-details">DETAILS</div>
                </div>
                @for (int i = 0; i < 10; i++)
                {
                    <div class="skeleton-row">
                        <div class="sk-line sk-time"></div>
                        <div class="sk-line sk-admin"></div>
                        <div class="sk-line sk-action"></div>
                        <div class="sk-line sk-details"></div>
                    </div>
                }
            </div>
        }
        else if (_loadError != null)
        {
            <div class="state-box">
                <div class="sb-icon">⚠</div>
                <div class="sb-title">FAILED TO LOAD</div>
                <div class="sb-sub">@_loadError</div>
                <button class="sb-btn" @onclick="LoadLogs">↺ Retry</button>
            </div>
        }
        else if (FilteredLogs.Count == 0)
        {
            <div class="empty-log">
                <div class="el-terminal">
                    <div class="el-bar">
                        <span class="el-dot red"></span>
                        <span class="el-dot orange"></span>
                        <span class="el-dot green"></span>
                        <span class="el-title">audit_log.db</span>
                    </div>
                    <div class="el-body">
                        <div class="el-line">
                            <span class="el-prompt">$</span>
                            <span class="el-cmd">SELECT * FROM audit_logs WHERE ...</span>
                        </div>
                        <div class="el-line">
                            <span class="el-result">
                                @if (!string.IsNullOrEmpty(_searchQuery) || !string.IsNullOrEmpty(_actionFilter))
                                {
                                    <span>→ 0 rows returned. No entries match the current filter.</span>
                                }
                                else
                                {
                                    <span>→ 0 rows returned. No admin actions have been recorded yet.</span>
                                }
                            </span>
                        </div>
                        <div class="el-line blink-line">
                            <span class="el-prompt">$</span>
                            <span class="el-cursor">█</span>
                        </div>
                    </div>
                </div>
                <div class="el-note">
                    Admin actions such as approving reports, suspending users, and
                    publishing advisories are automatically recorded here.
                </div>
            </div>
        }
        else
        {
            <div class="log-table">
                <div class="table-header">
                    <div class="th th-time">TIMESTAMP</div>
                    <div class="th th-admin">ADMIN</div>
                    <div class="th th-action">ACTION</div>
                    <div class="th th-details">DETAILS</div>
                </div>

                @foreach (var log in FilteredLogs)
                {
                    <div class="log-row @(log.IsNew ? "row-new" : "")">
                        <div class="td td-time">
                            <div class="time-main">@log.PerformedAt.ToString("HH:mm:ss")</div>
                            <div class="time-date">@log.PerformedAt.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="td td-admin">
                            <div class="admin-avatar" style="background:@GetAvatarColor(log.AdminUsername)">
                                @log.AdminUsername[..1].ToUpper()
                            </div>
                            <span class="admin-name">@log.AdminUsername</span>
                        </div>
                        <div class="td td-action">
                            <span class="action-badge action-@GetActionCategory(log.Action)">
                                @GetActionIcon(log.Action)
                                @FormatAction(log.Action)
                            </span>
                        </div>
                        <div class="td td-details">
                            <span class="details-text">@log.Details</span>
                        </div>
                    </div>
                }
            </div>

            @* Pagination *@
            @if (_totalPages > 1)
            {
                <div class="pagination">
                    <button class="page-btn"
                            @onclick="() => GoToPage(_page - 1)"
                            disabled="@(_page <= 1 || _loading)">
                        ← PREV
                    </button>

                    <div class="page-info">
                        <span class="pi-page">@_page</span>
                        <span class="pi-sep">/</span>
                        <span class="pi-total">@_totalPages</span>
                        <span class="pi-label">PAGES</span>
                    </div>

                    <div class="page-jumps">
                        @foreach (var p in GetPageNumbers())
                        {
                            var pg = p;
                            @if (pg == -1)
                            {
                                <span class="page-ellipsis">…</span>
                            }
                            else
                            {
                                <button class="page-num @(pg == _page ? "page-current" : "")"
                                        @onclick="() => GoToPage(pg)"
                                        disabled="@_loading">
                                    @pg
                                </button>
                            }
                        }
                    </div>

                    <button class="page-btn"
                            @onclick="() => GoToPage(_page + 1)"
                            disabled="@(_page >= _totalPages || _loading)">
                        NEXT →
                    </button>
                </div>
            }

            @* Result count *@
            <div class="result-count">
                Showing entries @((_page - 1) * _pageSize + 1)–@(Math.Min(_page * _pageSize, _totalLogs))
                of <span class="rc-num">@_totalLogs</span> total
                @if (!string.IsNullOrEmpty(_actionFilter))
                {
                    <span> · filtered by <span class="rc-filter">@_actionFilter</span></span>
                }
            </div>
        }

    </div>
</div>
</AuthGuard>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .audit-root {
        min-height: 100vh; background: #0d1117;
        font-family: 'Inter', sans-serif;
        padding: 10px 0 64px; position: relative; overflow-x: hidden;
    }

    .bg-grid {
        position: fixed; inset: 0;
        background-image:
            linear-gradient(rgba(159,239,0,0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(159,239,0,0.025) 1px, transparent 1px);
        background-size: 40px 40px; pointer-events: none; z-index: 0;
    }

    .scan-line {
        position: fixed; top: -2px; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, #9fef00, transparent);
        animation: scan 8s linear infinite; opacity: 0.25;
        z-index: 1; pointer-events: none;
    }

    .corner { position: fixed; width: 16px; height: 16px; z-index: 2; pointer-events: none; }
    .corner-tl { top: 12px; left: 12px; border-top: 2px solid #ffa500; border-left: 2px solid #ffa500; }
    .corner-tr { top: 12px; right: 12px; border-top: 2px solid #ffa500; border-right: 2px solid #ffa500; }
    .corner-bl { bottom: 12px; left: 12px; border-bottom: 2px solid #ffa500; border-left: 2px solid #ffa500; }
    .corner-br { bottom: 12px; right: 12px; border-bottom: 2px solid #ffa500; border-right: 2px solid #ffa500; }

    /* ── Admin sub-nav ── */
    .admin-subnav {
        background: #161b22; border-bottom: 1px solid #21262d;
        display: flex; align-items: center; gap: 0; padding: 0 32px;
        position: sticky; top: 56px; z-index: 10;
    }

    .subnav-link {
        display: flex; align-items: center; gap: 7px;
        padding: 14px 18px; font-family: 'IBM Plex Mono', monospace;
        font-size: 11px; color: #6e7681; text-decoration: none;
        letter-spacing: 1px; border-bottom: 2px solid transparent;
        transition: color 0.15s, border-color 0.15s; white-space: nowrap;
    }
    .subnav-link:hover { color: #c9d1d9; }
    .subnav-active { color: #ffa500 !important; border-bottom-color: #ffa500 !important; }

    /* ── Inner ── */
    .audit-inner {
        max-width: 1200px; margin: 0 auto;
        padding: 28px 32px 0; position: relative; z-index: 3;
        animation: fadeInUp 0.4s ease both;
    }

    @@keyframes fadeInUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes scan     { 0% { top: -2px; } 100% { top: 100vh; } }
    @@keyframes shimmer  { 0%,100% { opacity: 0.6; } 50% { opacity: 0.3; } }
    @@keyframes spin     { to { transform: rotate(360deg); } }
    @@keyframes blink    { 0%,100% { opacity: 1; } 50% { opacity: 0; } }
    @@keyframes newRow   { from { background: rgba(159,239,0,0.06); } to { background: transparent; } }

    /* ── Header ── */
    .page-header {
        display: flex; align-items: flex-start; justify-content: space-between;
        margin-bottom: 20px; flex-wrap: wrap; gap: 16px; margin-top: 70px;
    }

    .ph-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #ffa500; letter-spacing: 2px; opacity: 0.8; margin-bottom: 8px;
    }

    .ph-title {
        font-size: 36px; font-weight: 700; color: #e6edf3;
        line-height: 1.1; letter-spacing: -0.5px; margin-bottom: 8px;
    }

    .ph-accent { color: #ffa500; }
    .ph-sub { font-size: 13px; color: #6e7681; }

    .header-meta { display: flex; flex-direction: column; gap: 8px; }

    .meta-item {
        display: flex; align-items: center; gap: 8px;
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #4a5160; letter-spacing: 1px;
    }

    .meta-dot {
        width: 7px; height: 7px; border-radius: 50%;
    }
    .meta-dot.green  { background: #9fef00; box-shadow: 0 0 5px rgba(159,239,0,0.5); }
    .meta-dot.orange { background: #ffa500; box-shadow: 0 0 5px rgba(255,165,0,0.5); }

    /* ── Controls row ── */
    .controls-row {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; margin-bottom: 16px; flex-wrap: wrap;
    }

    .log-stats {
        display: flex; align-items: center; gap: 16px;
        padding: 12px 18px; background: #161b22;
        border: 1px solid #21262d; border-radius: 6px;
    }

    .ls-item { display: flex; flex-direction: column; align-items: center; gap: 2px; }

    .ls-val {
        font-family: 'IBM Plex Mono', monospace; font-size: 18px; font-weight: 600; color: #c9d1d9;
    }
    .ls-val.green { color: #9fef00; }
    .ls-val.blue  { color: #00c8ff; }

    .ls-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 8px;
        color: #4a5160; letter-spacing: 2px;
    }

    .ls-div { width: 1px; height: 28px; background: #21262d; }

    .filter-group { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

    /* Select */
    .select-wrapper {
        position: relative; background: #161b22;
        border: 1px solid #21262d; border-radius: 4px;
        transition: border-color 0.15s, box-shadow 0.15s; overflow: hidden;
    }
    .select-wrapper.focused {
        border-color: #9fef00; box-shadow: 0 0 0 3px rgba(159,239,0,0.07);
    }

    .filter-select {
        padding: 8px 32px 8px 12px; background: transparent; border: none; outline: none;
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #c9d1d9; cursor: pointer; appearance: none; letter-spacing: 1px;
    }
    .filter-select option { background: #161b22; color: #c9d1d9; }

    .select-arrow {
        position: absolute; right: 10px; top: 50%;
        transform: translateY(-50%); color: #4a5160;
        font-size: 10px; pointer-events: none;
    }

    /* Search */
    .search-box {
        display: flex; align-items: center; background: #161b22;
        border: 1px solid #21262d; border-radius: 4px; overflow: hidden;
        min-width: 220px;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .search-box.focused {
        border-color: #9fef00; box-shadow: 0 0 0 3px rgba(159,239,0,0.07);
    }

    .search-icon {
        padding: 0 10px; color: #4a5160; font-size: 15px;
        border-right: 1px solid #21262d; line-height: 36px; flex-shrink: 0;
    }

    .search-input {
        flex: 1; background: transparent; border: none; outline: none;
        padding: 8px 10px; font-family: 'IBM Plex Mono', monospace;
        font-size: 11px; color: #c9d1d9; caret-color: #9fef00;
    }
    .search-input::placeholder { color: #4a5160; }

    .search-clear {
        padding: 0 10px; background: none; border: none;
        color: #4a5160; cursor: pointer; font-size: 10px;
        transition: color 0.15s; height: 100%;
    }
    .search-clear:hover { color: #ff3e3e; }

    .refresh-btn {
        display: flex; align-items: center; justify-content: center;
        width: 34px; height: 34px; background: transparent;
        border: 1px solid #21262d; border-radius: 4px; cursor: pointer;
        color: #6e7681; font-size: 14px;
        transition: border-color 0.15s, color 0.15s;
    }
    .refresh-btn:hover:not(:disabled) { border-color: #9fef00; color: #9fef00; }
    .refresh-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ── Log table ── */
    .log-table {
        background: #161b22; border: 1px solid #21262d;
        border-radius: 8px; overflow: hidden; margin-bottom: 12px;
    }

    .table-header {
        display: grid;
        grid-template-columns: 140px 150px 180px 1fr;
        padding: 10px 20px; background: #0d1117;
        border-bottom: 1px solid #21262d;
    }

    .th {
        font-family: 'IBM Plex Mono', monospace; font-size: 9px;
        color: #4a5160; letter-spacing: 2px; font-weight: 600;
    }

    .log-row {
        display: grid;
        grid-template-columns: 140px 150px 180px 1fr;
        padding: 12px 20px; border-bottom: 1px solid #21262d;
        align-items: center; transition: background 0.1s;
    }
    .log-row:last-child { border-bottom: none; }
    .log-row:hover { background: rgba(159,239,0,0.015); }

    .row-new { animation: newRow 2s ease forwards; }

    .td { display: flex; align-items: center; gap: 8px; }

    /* Time cell */
    .td-time { flex-direction: column; align-items: flex-start; gap: 1px; }
    .time-main {
        font-family: 'IBM Plex Mono', monospace; font-size: 13px;
        font-weight: 600; color: #c9d1d9;
    }
    .time-date {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: #4a5160;
    }

    /* Admin cell */
    .admin-avatar {
        width: 26px; height: 26px; border-radius: 5px;
        display: flex; align-items: center; justify-content: center;
        font-family: 'IBM Plex Mono', monospace; font-size: 11px;
        font-weight: 700; color: white; flex-shrink: 0;
    }

    .admin-name {
        font-size: 13px; font-weight: 600; color: #ffa500;
    }

    /* Action badge */
    .action-badge {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        font-weight: 600; padding: 4px 9px; border-radius: 3px;
        letter-spacing: 0.5px; display: flex; align-items: center; gap: 5px;
        white-space: nowrap;
    }

    .action-approve   { background: rgba(159,239,0,0.1); color: #9fef00; border: 1px solid rgba(159,239,0,0.25); }
    .action-reject    { background: rgba(255,62,62,0.1); color: #ff3e3e; border: 1px solid rgba(255,62,62,0.25); }
    .action-user      { background: rgba(0,200,255,0.1); color: #00c8ff; border: 1px solid rgba(0,200,255,0.25); }
    .action-advisory  { background: rgba(255,165,0,0.1); color: #ffa500; border: 1px solid rgba(255,165,0,0.25); }
    .action-suspend   { background: rgba(255,62,62,0.1); color: #ff3e3e; border: 1px solid rgba(255,62,62,0.25); }
    .action-other     { background: rgba(110,118,129,0.1); color: #6e7681; border: 1px solid #21262d; }

    /* Details cell */
    .details-text { font-size: 12px; color: #c9d1d9; line-height: 1.4; }

    /* ── Empty state ── */
    .empty-log {
        background: #161b22; border: 1px solid #21262d;
        border-radius: 8px; padding: 32px;
        display: flex; flex-direction: column; align-items: center; gap: 20px;
        text-align: center;
    }

    .el-terminal {
        width: 100%; max-width: 540px; background: #0d1117;
        border: 1px solid #21262d; border-radius: 6px; overflow: hidden;
    }

    .el-bar {
        display: flex; align-items: center; gap: 6px;
        padding: 8px 14px; background: #161b22;
        border-bottom: 1px solid #21262d;
    }

    .el-dot {
        width: 8px; height: 8px; border-radius: 50%;
    }
    .el-dot.red    { background: #ff5f57; }
    .el-dot.orange { background: #febc2e; }
    .el-dot.green  { background: #28c840; }

    .el-title {
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #6e7681; margin-left: 8px; letter-spacing: 1px;
    }

    .el-body { padding: 16px; display: flex; flex-direction: column; gap: 8px; }

    .el-line { display: flex; align-items: center; gap: 8px; }

    .el-prompt {
        font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #9fef00;
    }

    .el-cmd {
        font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #c9d1d9;
    }

    .el-result {
        font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #6e7681;
        padding-left: 16px;
    }

    .el-cursor {
        font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #9fef00;
        animation: blink 1s step-end infinite;
    }

    .el-note { font-size: 12px; color: #4a5160; max-width: 480px; line-height: 1.6; }

    /* ── Skeleton ── */
    .skeleton-row {
        display: grid;
        grid-template-columns: 140px 150px 180px 1fr;
        padding: 13px 20px; border-bottom: 1px solid #21262d;
        align-items: center; gap: 0;
        animation: shimmer 1.5s ease-in-out infinite;
    }

    .sk-line { background: #21262d; border-radius: 2px; height: 12px; }
    .sk-time    { width: 100px; }
    .sk-admin   { width: 100px; }
    .sk-action  { width: 120px; height: 20px; border-radius: 3px; }
    .sk-details { width: 80%; }

    /* ── Pagination ── */
    .pagination {
        display: flex; align-items: center; gap: 8px;
        margin-bottom: 10px; flex-wrap: wrap;
    }

    .page-btn {
        padding: 7px 14px; background: transparent;
        border: 1px solid #21262d; border-radius: 4px; cursor: pointer;
        font-family: 'IBM Plex Mono', monospace; font-size: 10px;
        color: #6e7681; letter-spacing: 1px;
        transition: border-color 0.15s, color 0.15s;
    }
    .page-btn:hover:not(:disabled) { border-color: #9fef00; color: #9fef00; }
    .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    .page-info {
        display: flex; align-items: baseline; gap: 4px;
        font-family: 'IBM Plex Mono', monospace;
    }

    .pi-page  { font-size: 16px; font-weight: 700; color: #9fef00; }
