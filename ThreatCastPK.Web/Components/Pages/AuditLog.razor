@code {
    private record AuditLogEntry(
        Guid Id, string AdminUsername, string Action,
        string Details, DateTime PerformedAt, bool IsNew = false);

    private List<AuditLogEntry> _logs = new();
    private bool _loading = true;
    private string? _loadError;

    private int _totalLogs = 0;
    private int _totalPages = 1;
    private int _logsToday = 0;
    private int _page = 1;
    private const int _pageSize = 50;

    private string _actionFilter = string.Empty;
    private string _searchQuery = string.Empty;
    private bool _searchFocused = false;
    private bool _actionFilterFocused = false;

    private List<string> _availableActions = new();

    private List<AuditLogEntry> FilteredLogs
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchQuery)) return _logs;
            var q = _searchQuery.ToLower();
            return _logs.Where(l =>
                l.AdminUsername.ToLower().Contains(q) ||
                l.Details.ToLower().Contains(q) ||
                l.Action.ToLower().Contains(q)
            ).ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadActions();
            await LoadLogs();
            StateHasChanged();
        }
    }

    private async Task LoadActions()
    {
        var (data, _) = await ApiService.GetAsync<List<string>>("/api/auditlog/actions");
        if (data != null) _availableActions = data;
    }

    private async Task LoadLogs()
    {
        _loading = true; _loadError = null;
        StateHasChanged();

        var url = $"/api/auditlog?page={_page}&pageSize={_pageSize}";
        if (!string.IsNullOrEmpty(_actionFilter))
            url += $"&action={Uri.EscapeDataString(_actionFilter)}";

        var (data, error) = await ApiService.GetAsync<AuditLogApiResponse>(url);
        _loading = false;

        if (error != null)
        {
            _loadError = error;
        }
        else if (data != null)
        {
            _totalLogs  = data.Total;
            _totalPages = data.TotalPages;
            _logs = data.Logs.Select(l => new AuditLogEntry(
                l.Id, l.AdminUsername, l.Action, l.Details, l.PerformedAt
            )).ToList();

            _logsToday = _logs.Count(l => l.PerformedAt.Date == DateTime.UtcNow.Date);
        }

        StateHasChanged();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages) return;
        _page = page;
        await LoadLogs();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        if (_totalPages <= 7)
        {
            for (int i = 1; i <= _totalPages; i++) pages.Add(i);
            return pages;
        }

        pages.Add(1);
        if (_page > 3) pages.Add(-1); // ellipsis

        for (int i = Math.Max(2, _page - 1); i <= Math.Min(_totalPages - 1, _page + 1); i++)
            pages.Add(i);

        if (_page < _totalPages - 2) pages.Add(-1); // ellipsis
        pages.Add(_totalPages);

        return pages;
    }

    // ── Action helpers ──

    private static string GetActionCategory(string action)
    {
        if (action.Contains("Approve")) return "approve";
        if (action.Contains("Reject"))  return "reject";
        if (action.Contains("Suspend") || action.Contains("Unsuspend")) return "suspend";
        if (action.Contains("User") || action.Contains("Reporter")) return "user";
        if (action.Contains("Advisory")) return "advisory";
        return "other";
    }

    private static string GetActionIcon(string action)
    {
        if (action.Contains("Approve"))   return "✓";
        if (action.Contains("Reject"))    return "✕";
        if (action.Contains("Suspend"))   return "⛔";
        if (action.Contains("Unsuspend")) return "✓";
        if (action.Contains("Grant"))     return "📡";
        if (action.Contains("Revoke"))    return "✕";
        if (action.Contains("Advisory"))  return "📢";
        return "◈";
    }

    private static string FormatAction(string action)
    {
        // Convert PascalCase to spaced e.g. "ApproveReport" → "APPROVE REPORT"
        var spaced = System.Text.RegularExpressions.Regex.Replace(
            action, "([A-Z])", " $1").Trim();
        return spaced.ToUpper();
    }

    private static string GetAvatarColor(string username)
    {
        var colors = new[] { "#1a472a","#1e3a5f","#4a1942","#2d2b55","#3d2b1f","#1a3a3a" };
        return colors[Math.Abs(username.GetHashCode()) % colors.Length];
    }

    // ── API response shape ──
    private class AuditLogApiResponse
    {
        public int Total { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalPages { get; set; }
        public List<AuditLogItem> Logs { get; set; } = new();
    }

    private class AuditLogItem
    {
        public Guid Id { get; set; }
        public string AdminUsername { get; set; } = string.Empty;
        public string Action { get; set; } = string.Empty;
        public string Details { get; set; } = string.Empty;
        public DateTime PerformedAt { get; set; }
    }
}
