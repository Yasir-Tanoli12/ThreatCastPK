@* ThreatCastPK.Web/Components/Layout/NavBar.razor *@
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@implements IDisposable

<nav class="tcpk-navbar">
    <div class="navbar-inner">

        @* Logo *@
        <a href="/" class="navbar-logo">
            <span class="logo-hex">◈</span>
            <span class="logo-text">ThreatCast <span class="logo-pk">PK</span></span>
        </a>

        @* Center links *@
        <div class="navbar-links desktop-only">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" ActiveClass="nav-link-active">
                Live Map
            </NavLink>
            <NavLink href="/analytics" class="nav-link" ActiveClass="nav-link-active">
                Analytics
            </NavLink>
            @if (AuthService.IsLoggedIn)
            {
                <NavLink href="/forum" class="nav-link" ActiveClass="nav-link-active">
                    Forum
                </NavLink>
            }
        </div>

        @* Right side *@
        <div class="navbar-right">

            @if (AuthService.IsLoggedIn)
            {
                @* Bell *@
                <a href="/notifications" class="bell-btn" title="Notifications">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    @if (NotificationService.UnreadCount > 0)
                    {
                        <span class="bell-badge">
                            @(NotificationService.UnreadCount > 9 ? "9+" : NotificationService.UnreadCount.ToString())
                        </span>
                    }
                </a>

                @* Submit report button — reporter + admin only *@
                @if (AuthService.IsReporter)
                {
                    <a href="/submit-report" class="btn-submit desktop-only">
                        + SUBMIT REPORT
                    </a>
                }

                @* Avatar with hover + click dropdown *@
                <div class="avatar-wrapper"
                     @onmouseenter="OpenDropdown"
                     @onmouseleave="ScheduleClose">
                    <button class="avatar-btn" @onclick="ToggleDropdown">
                        <div class="avatar-circle" style="background:@GetAvatarBg(AuthService.Role)">
                            <span style="color:@GetAvatarColor(AuthService.Role)">
                                @GetInitials(AuthService.Username)
                            </span>
                        </div>
                        <span class="avatar-name desktop-only">@AuthService.Username</span>
                        <span class="avatar-chevron @(_dropdownOpen ? "open" : "")">▾</span>
                    </button>

                    @if (_dropdownOpen)
                    {
                        <div class="avatar-dropdown"
                             @onmouseenter="CancelClose"
                             @onmouseleave="ScheduleClose">

                            <div class="dropdown-header">
                                <div class="dh-avatar" style="background:@GetAvatarBg(AuthService.Role)">
                                    <span style="color:@GetAvatarColor(AuthService.Role)">
                                        @GetInitials(AuthService.Username)
                                    </span>
                                </div>
                                <div class="dh-info">
                                    <span class="dh-username">@AuthService.Username</span>
                                    <span class="dh-role role-@AuthService.Role.ToLower()">
                                        @GetRoleIcon(AuthService.Role) @AuthService.Role.ToUpper()
                                    </span>
                                </div>
                            </div>

                            <div class="dropdown-divider"></div>

                            <a href="/profile" class="dropdown-item" @onclick="CloseDropdown">
                                <span class="di-icon">◈</span> Profile &amp; Settings
                            </a>
                            <a href="/notifications" class="dropdown-item" @onclick="CloseDropdown">
                                <span class="di-icon">🔔</span> Notifications
                                @if (NotificationService.UnreadCount > 0)
                                {
                                    <span class="di-badge">@NotificationService.UnreadCount</span>
                                }
                            </a>
                            <a href="/subscriptions" class="dropdown-item" @onclick="CloseDropdown">
                                <span class="di-icon">⚡</span> Subscriptions
                            </a>
                            <a href="/glossary" class="dropdown-item" @onclick="CloseDropdown">
                                <span class="di-icon">📖</span> Glossary
                            </a>

                            @if (AuthService.IsReporter)
                            {
                                <div class="dropdown-divider"></div>
                                <div class="dropdown-section-label reporter-label">REPORTER</div>
                                <a href="/my-reports" class="dropdown-item dropdown-reporter"
                                   @onclick="CloseDropdown">
                                    <span class="di-icon">📋</span> My Reports
                                </a>
                            }

                            @if (AuthService.IsAdmin)
                            {
                                <div class="dropdown-divider"></div>
                                <div class="dropdown-section-label admin-label">ADMIN</div>
                                <a href="/admin/moderation" class="dropdown-item dropdown-admin"
                                   @onclick="CloseDropdown">
                                    <span class="di-icon">🛡</span> Moderation Queue
                                </a>
                                <a href="/admin/users" class="dropdown-item dropdown-admin"
                                   @onclick="CloseDropdown">
                                    <span class="di-icon">👥</span> User Management
                                </a>
                                <a href="/admin/auditlog" class="dropdown-item dropdown-admin"
                                   @onclick="CloseDropdown">
                                    <span class="di-icon">📋</span> Audit Log
                                </a>
                            }

                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item dropdown-logout" @onclick="Logout">
                                <span class="di-icon">→</span> Sign Out
                            </button>

                        </div>
                    }
                </div>
            }
            else
            {
                <a href="/glossary" class="glossary-link desktop-only">Glossary</a>
                <a href="/login" class="btn-ghost desktop-only">Login</a>
                <a href="/register" class="btn-solid desktop-only">Register</a>
            }

            @* Hamburger *@
            <button class="hamburger mobile-only" @onclick="ToggleMobileMenu" aria-label="Menu">
                <span class="ham-line @(_mobileOpen ? "open" : "")"></span>
                <span class="ham-line @(_mobileOpen ? "open" : "")"></span>
                <span class="ham-line @(_mobileOpen ? "open" : "")"></span>
            </button>
        </div>
    </div>

    @* Mobile menu *@
    @if (_mobileOpen)
    {
        <div class="mobile-menu">

            @if (AuthService.IsLoggedIn)
            {
                <div class="mobile-user-row">
                    <div class="mu-avatar" style="background:@GetAvatarBg(AuthService.Role)">
                        <span style="color:@GetAvatarColor(AuthService.Role)">
                            @GetInitials(AuthService.Username)
                        </span>
                    </div>
                    <div class="mu-info">
                        <span class="mu-username">@AuthService.Username</span>
                        <span class="mu-role role-@AuthService.Role.ToLower()">
                            @GetRoleIcon(AuthService.Role) @AuthService.Role.ToUpper()
                        </span>
                    </div>
                </div>
                <div class="mobile-divider"></div>
            }

            <div class="mobile-section-label">NAVIGATION</div>
            <a href="/" class="mobile-link" @onclick="CloseMobileMenu">◉ Live Map</a>
            <a href="/analytics" class="mobile-link" @onclick="CloseMobileMenu">◉ Analytics</a>
            <a href="/glossary" class="mobile-link" @onclick="CloseMobileMenu">◉ Glossary</a>

            @if (AuthService.IsLoggedIn)
            {
                <a href="/forum" class="mobile-link" @onclick="CloseMobileMenu">◉ Forum</a>
                <div class="mobile-divider"></div>
                <div class="mobile-section-label">ACCOUNT</div>
                <a href="/profile" class="mobile-link" @onclick="CloseMobileMenu">◈ Profile &amp; Settings</a>
                <a href="/notifications" class="mobile-link" @onclick="CloseMobileMenu">
                    🔔 Notifications
                    @if (NotificationService.UnreadCount > 0)
                    {
                        <span class="mobile-badge">@NotificationService.UnreadCount</span>
                    }
                </a>
                <a href="/subscriptions" class="mobile-link" @onclick="CloseMobileMenu">⚡ Subscriptions</a>
            }

            @if (AuthService.IsReporter)
            {
                <div class="mobile-divider"></div>
                <div class="mobile-section-label reporter-label">REPORTER</div>
                <a href="/submit-report" class="mobile-link mobile-reporter" @onclick="CloseMobileMenu">
                    📡 Submit Report
                </a>
                <a href="/my-reports" class="mobile-link mobile-reporter" @onclick="CloseMobileMenu">
                    📋 My Reports
                </a>
            }

            @if (AuthService.IsAdmin)
            {
                <div class="mobile-divider"></div>
                <div class="mobile-section-label admin-label">ADMIN</div>
                <a href="/admin/moderation" class="mobile-link mobile-admin" @onclick="CloseMobileMenu">🛡 Moderation Queue</a>
                <a href="/admin/users" class="mobile-link mobile-admin" @onclick="CloseMobileMenu">👥 User Management</a>
                <a href="/admin/auditlog" class="mobile-link mobile-admin" @onclick="CloseMobileMenu">📋 Audit Log</a>
            }

            <div class="mobile-divider"></div>

            @if (AuthService.IsLoggedIn)
            {
                <button class="mobile-logout" @onclick="Logout">→ Sign Out</button>
            }
            else
            {
                <a href="/login" class="mobile-link" @onclick="CloseMobileMenu">Login</a>
                <a href="/register" class="mobile-btn-solid" @onclick="CloseMobileMenu">Register</a>
            }
        </div>
    }
</nav>

@if (_dropdownOpen || _mobileOpen)
{
    <div class="nav-backdrop" @onclick="CloseAll"></div>
}

<style>
    .tcpk-navbar {
        position: fixed; top: 0; left: 0; right: 0;
        z-index: 1000; background: #0d1117;
        border-bottom: 1px solid #21262d;
        font-family: 'Inter', sans-serif;
    }

    .navbar-inner {
        max-width: 1400px; margin: 0 auto;
        height: 56px; display: flex; align-items: center;
        padding: 0 24px; gap: 24px;
    }

    .navbar-logo {
        display: flex; align-items: center; gap: 8px;
        text-decoration: none; flex-shrink: 0;
    }

    .logo-hex { color: #9fef00; font-size: 20px; }

    .logo-text {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 15px; font-weight: 600; color: #c9d1d9;
    }

    .logo-pk { color: #9fef00; }

    .navbar-links {
        display: flex; align-items: center;
        gap: 2px; flex: 1;
    }

    .nav-link {
        font-size: 13px; color: #6e7681;
        text-decoration: none; padding: 6px 11px;
        border-radius: 4px; border-bottom: 2px solid transparent;
        transition: color 0.15s; white-space: nowrap;
    }
    .nav-link:hover { color: #c9d1d9; }
    .nav-link-active { color: #9fef00 !important; border-bottom-color: #9fef00; }

    .navbar-right {
        display: flex; align-items: center;
        gap: 10px; flex-shrink: 0;
    }

    .glossary-link {
        font-size: 13px; color: #6e7681;
        text-decoration: none; padding: 6px 8px;
        transition: color 0.15s;
    }
    .glossary-link:hover { color: #c9d1d9; }

    .btn-ghost {
        font-size: 13px; color: #c9d1d9; text-decoration: none;
        padding: 6px 14px; border: 1px solid #21262d;
        border-radius: 4px; white-space: nowrap;
        transition: border-color 0.15s;
    }
    .btn-ghost:hover { border-color: #6e7681; }

    .btn-solid {
        font-size: 13px; font-weight: 600; color: #0d1117;
        text-decoration: none; padding: 6px 14px;
        background: #9fef00; border-radius: 4px;
        white-space: nowrap; transition: opacity 0.15s;
    }
    .btn-solid:hover { opacity: 0.88; }

    .btn-submit {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px; font-weight: 700; color: #0d1117;
        text-decoration: none; padding: 7px 14px;
        background: #9fef00; border-radius: 4px;
        white-space: nowrap; letter-spacing: 1px;
        display: flex; align-items: center; gap: 6px;
        transition: opacity 0.15s, box-shadow 0.15s;
    }
    .btn-submit:hover { opacity: 0.9; box-shadow: 0 3px 12px rgba(159,239,0,0.25); }

    .bell-btn {
        position: relative; display: flex;
        align-items: center; justify-content: center;
        width: 34px; height: 34px; border-radius: 6px;
        border: 1px solid #21262d; color: #6e7681;
        text-decoration: none; transition: color 0.15s, border-color 0.15s;
    }
    .bell-btn:hover { color: #c9d1d9; border-color: #30363d; }

    .bell-badge {
        position: absolute; top: -4px; right: -4px;
        background: #ff3e3e; color: white;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 9px; font-weight: 700;
        min-width: 16px; height: 16px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        padding: 0 3px; border: 2px solid #0d1117;
    }

    .avatar-wrapper { position: relative; }

    .avatar-btn {
        display: flex; align-items: center; gap: 8px;
        background: transparent; border: 1px solid #21262d;
        border-radius: 20px; padding: 3px 10px 3px 3px;
        cursor: pointer; transition: border-color 0.15s;
    }
    .avatar-btn:hover { border-color: #9fef00; }

    .avatar-circle {
        width: 28px; height: 28px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px; font-weight: 700; flex-shrink: 0;
    }

    .avatar-name {
        font-size: 12px; color: #c9d1d9;
        font-family: 'Inter', sans-serif; max-width: 80px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    .avatar-chevron {
        font-size: 10px; color: #6e7681;
        transition: transform 0.2s;
    }
    .avatar-chevron.open { transform: rotate(180deg); }

    .avatar-dropdown {
        position: absolute; top: calc(100% + 8px); right: 0;
        width: 224px; background: #161b22;
        border: 1px solid #21262d; border-radius: 8px;
        z-index: 1001; overflow: hidden;
        box-shadow: 0 12px 32px rgba(0,0,0,0.5);
        animation: dropIn 0.15s ease both;
    }

    @@keyframes dropIn {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .dropdown-header {
        display: flex; align-items: center; gap: 10px;
        padding: 14px 16px; background: #0d1117;
    }

    .dh-avatar {
        width: 34px; height: 34px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 13px; font-weight: 700; flex-shrink: 0;
    }

    .dh-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }

    .dh-username {
        font-size: 13px; font-weight: 600; color: #e6edf3;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .dh-role {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px; letter-spacing: 1px;
    }

    .role-registered { color: #00c8ff; }
    .role-reporter   { color: #9fef00; }
    .role-admin      { color: #ffa500; }
    .role-public     { color: #6e7681; }

    .dropdown-divider { height: 1px; background: #21262d; }

    .dropdown-section-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 9px; color: #4a5160;
        letter-spacing: 2px; padding: 8px 16px 4px;
    }

    .admin-label    { color: rgba(255,165,0,0.6); }
    .reporter-label { color: rgba(159,239,0,0.6); }

    .dropdown-item {
        display: flex; align-items: center; gap: 9px;
        width: 100%; padding: 9px 16px;
        font-family: 'Inter', sans-serif; font-size: 13px;
        color: #c9d1d9; text-decoration: none;
        background: none; border: none; text-align: left;
        cursor: pointer; transition: background 0.1s;
    }
    .dropdown-item:hover { background: #21262d; }

    .di-icon {
        font-size: 13px; width: 16px;
        text-align: center; flex-shrink: 0; opacity: 0.7;
    }

    .di-badge {
        margin-left: auto; background: #ff3e3e; color: white;
        font-family: 'IBM Plex Mono', monospace; font-size: 9px;
        font-weight: 700; padding: 1px 5px; border-radius: 8px;
    }

    .dropdown-reporter { color: #9fef00; }
    .dropdown-reporter:hover { background: rgba(159,239,0,0.05); }

    .dropdown-admin { color: #ffa500; }
    .dropdown-admin:hover { background: rgba(255,165,0,0.05); }

    .dropdown-logout { color: #ff3e3e; }
    .dropdown-logout:hover { background: rgba(255,62,62,0.05); }

    .hamburger {
        display: none; flex-direction: column;
        justify-content: center; gap: 5px;
        width: 34px; height: 34px; background: transparent;
        border: 1px solid #21262d; border-radius: 6px;
        cursor: pointer; padding: 7px;
        transition: border-color 0.15s;
    }
    .hamburger:hover { border-color: #9fef00; }

    .ham-line {
        display: block; height: 1.5px; background: #6e7681;
        border-radius: 2px; transition: all 0.25s;
        transform-origin: center;
    }
    .ham-line.open:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .ham-line.open:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .ham-line.open:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

    .mobile-menu {
        display: none; background: #161b22;
        border-top: 1px solid #21262d;
        padding: 8px 0 16px;
        max-height: calc(100vh - 56px); overflow-y: auto;
        animation: slideDown 0.2s ease both;
    }

    @@keyframes slideDown {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .mobile-user-row {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 20px;
    }

    .mu-avatar {
        width: 36px; height: 36px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 13px; font-weight: 700; flex-shrink: 0;
    }

    .mu-info { display: flex; flex-direction: column; gap: 2px; }

    .mu-username { font-size: 14px; font-weight: 600; color: #e6edf3; }

    .mu-role {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px; letter-spacing: 1px;
    }

    .mobile-divider { height: 1px; background: #21262d; margin: 6px 0; }

    .mobile-section-label {
        font-family: 'IBM Plex Mono', monospace; font-size: 9px;
        color: #4a5160; letter-spacing: 2px; padding: 8px 20px 4px;
    }

    .mobile-link {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 20px; font-size: 14px;
        color: #c9d1d9; text-decoration: none;
        transition: background 0.1s;
    }
    .mobile-link:hover { background: #21262d; }

    .mobile-reporter { color: #9fef00; }
    .mobile-admin    { color: #ffa500; }

    .mobile-badge {
        margin-left: auto; background: #ff3e3e; color: white;
        font-family: 'IBM Plex Mono', monospace; font-size: 9px;
        font-weight: 700; padding: 1px 6px; border-radius: 8px;
    }

    .mobile-logout {
        width: 100%; padding: 10px 20px;
        background: none; border: none;
        font-family: 'IBM Plex Mono', monospace; font-size: 13px;
        color: #ff3e3e; text-align: left; cursor: pointer;
        letter-spacing: 1px; transition: background 0.1s;
    }
    .mobile-logout:hover { background: rgba(255,62,62,0.06); }

    .mobile-btn-solid {
        display: block; margin: 8px 20px 0; padding: 11px 20px;
        background: #9fef00; color: #0d1117;
        font-family: 'IBM Plex Mono', monospace; font-size: 12px;
        font-weight: 700; text-align: center; text-decoration: none;
        border-radius: 4px; letter-spacing: 1px;
    }

    .nav-backdrop { position: fixed; inset: 0; z-index: 999; }

    .desktop-only { display: flex; }
    .mobile-only  { display: none; }

    @@media (max-width: 768px) {
        .desktop-only { display: none !important; }
        .mobile-only  { display: flex !important; }
        .mobile-menu  { display: block; }
        .navbar-inner { padding: 0 16px; gap: 12px; }
    }

    @@media (max-width: 1024px) and (min-width: 769px) {
        .nav-link { padding: 6px 8px; font-size: 12px; }
        .avatar-name { display: none; }
    }
</style>

@code {
    private bool _dropdownOpen = false;
    private bool _mobileOpen = false;
    private System.Threading.CancellationTokenSource? _closeCts;

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += OnStateChanged;
        NotificationService.OnChange += OnStateChanged;
    }

    private void OpenDropdown()
    {
        _closeCts?.Cancel();
        _dropdownOpen = true;
    }

    private void ScheduleClose()
    {
        _closeCts?.Cancel();
        _closeCts = new System.Threading.CancellationTokenSource();
        var token = _closeCts.Token;
        _ = Task.Delay(180).ContinueWith(_ =>
        {
            if (!token.IsCancellationRequested)
                InvokeAsync(() => { _dropdownOpen = false; StateHasChanged(); });
        });
    }

    private void CancelClose()
    {
        _closeCts?.Cancel();
    }

    private void ToggleDropdown()
    {
        _closeCts?.Cancel();
        _dropdownOpen = !_dropdownOpen;
        if (_dropdownOpen) _mobileOpen = false;
    }

    private void ToggleMobileMenu()
    {
        _mobileOpen = !_mobileOpen;
        if (_mobileOpen) _dropdownOpen = false;
    }

    private void CloseDropdown() { _dropdownOpen = false; }
    private void CloseMobileMenu() { _mobileOpen = false; }
    private void CloseAll() { _dropdownOpen = false; _mobileOpen = false; }

    private async Task Logout()
    {
        CloseAll();
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private static string GetInitials(string username)
    {
        if (string.IsNullOrEmpty(username)) return "?";
        return username.Length >= 2 ? username[..2].ToUpper() : username[..1].ToUpper();
    }

    private static string GetAvatarBg(string role) => role switch
    {
        "Admin"    => "#3d2b1f",
        "Reporter" => "#1a472a",
        _          => "#1e3a5f"
    };

    private static string GetAvatarColor(string role) => role switch
    {
        "Admin"    => "#ffa500",
        "Reporter" => "#9fef00",
        _          => "#85b7eb"
    };

    private static string GetRoleIcon(string role) => role switch
    {
        "Admin"    => "⚡",
        "Reporter" => "📡",
        _          => "◈"
    };

    public void Dispose()
    {
        _closeCts?.Cancel();
        AuthService.OnAuthStateChanged -= OnStateChanged;
        NotificationService.OnChange -= OnStateChanged;
    }
}