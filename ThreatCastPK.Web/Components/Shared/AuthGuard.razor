@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation

@if (_checked)
{
    @if (_authorized)
    {
        @ChildContent
    }
    else
    {
        @* Show nothing — redirect handles it *@
    }
}
else
{
    @* Loading state while checking auth *@
    <div class="authguard-loading">
        <div class="ag-spinner"></div>
        <div class="ag-text">VERIFYING ACCESS...</div>
    </div>
}

<style>
    .authguard-loading {
        min-height: 100vh;
        background: #0d1117;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        font-family: 'IBM Plex Mono', monospace;
    }

    .ag-spinner {
        width: 32px;
        height: 32px;
        border: 2px solid #21262d;
        border-top-color: #9fef00;
        border-radius: 50%;
        animation: ag-spin 0.8s linear infinite;
    }

    @@keyframes ag-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .ag-text {
        font-size: 11px;
        color: #4a5160;
        letter-spacing: 2px;
    }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Optional — if set, also checks role
    // e.g. RequiredRole="Admin" or RequiredRole="Reporter"
    [Parameter] public string? RequiredRole { get; set; }

    // Where to redirect if not authorized
    [Parameter] public string RedirectTo { get; set; } = "/login";

    private bool _checked = false;
    private bool _authorized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Initialize reads localStorage via JS interop
        // Must be in OnAfterRenderAsync — JS interop is not available during prerender
        await AuthService.InitializeAsync();

        if (!AuthService.IsLoggedIn)
        {
            // Not logged in — redirect to login with return URL
            var returnUrl = Uri.EscapeDataString(Navigation.Uri);
            Navigation.NavigateTo($"{RedirectTo}?returnUrl={returnUrl}", replace: true);
            return;
        }

        // Role check if required
        if (!string.IsNullOrEmpty(RequiredRole))
        {
            bool hasRole = RequiredRole switch
            {
                "Admin" => AuthService.IsAdmin,
                "Reporter" => AuthService.IsReporter,
                _ => AuthService.IsLoggedIn
            };

            if (!hasRole)
            {
                // Logged in but wrong role — redirect to home
                Navigation.NavigateTo("/", replace: true);
                return;
            }
        }

        _authorized = true;
        _checked = true;
        StateHasChanged();
    }
}